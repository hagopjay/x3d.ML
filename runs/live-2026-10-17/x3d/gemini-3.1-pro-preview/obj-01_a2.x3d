<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='4'/>
    <meta name='title' content='Red PBR Sphere'/>
    <meta name='description' content='A red PBR sphere of radius 1 on a grey ground plane with a directional light.'/>
  </head>
  <Scene>
    <Viewpoint description='Main Viewpoint' position='0 3 10' orientation='1 0 0 -0.2'/>
    <DirectionalLight direction='-0.5 -1 -0.5' intensity='1' color='1 1 1' global='true'/>
    <Transform>
      <Shape>
        <Box size='20 0.1 20'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.5 0.5 0.5' metallic='0.1' roughness='0.8'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation='0 1.05 0'>
      <Shape>
        <Sphere radius='1'/>
        <Appearance>
          <PhysicalMaterial baseColor='1 0 0' metallic='0.6' roughness='0.3'/>
        </Appearance>
      </Shape>
    </Transform>
  </Scene>
</X3D>