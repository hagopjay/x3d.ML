  <Scene>
    <Viewpoint description='Simple House View' position='0 5 10' orientation='1 0 0 0.785'/>
    <Transform DEF='House' translation='0 0 0'>
      <!-- House Body -->
      <Shape DEF='Body'>
        <Box size='4 3 4'/>
        <Appearance>
          <Material diffuseColor='0.8 0.8 0.8'/>
        </Appearance>
      </Shape>
      <!-- Roof -->
      <Transform translation='0 1.5 0'>
        <Shape DEF='Roof'>
          <IndexedFaceSet coordIndex='0 1 2 3 -1 0 1 4 -1 1 2 4 -1 2 3 4 -1' solid='true'>
            <Coordinate DEF='RoofCoords' point='-2 0 -2  2 0 -2  2 0 2  -2 0 2  0 1.5 0'/>
          </IndexedFaceSet>
          <Appearance>
            <Material diffuseColor='0.5 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
      <!-- Door -->
      <Transform translation='0 -0.5 2.01'>
        <Shape DEF='Door'>
          <Box size='1 1.5 0.1'/>
          <Appearance>
            <Material diffuseColor='0.4 0.2 0'/>
          </Appearance>
        </Shape>
      </Transform>
      <!-- Windows -->
      <Transform translation='-1.5 -0.5 2.01'>
        <Shape DEF='WindowLeft'>
          <Box size='0.8 0.8 0.1'/>
          <Appearance>
            <Material transparency='0.5' diffuseColor='0.5 0.7 1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='1.5 -0.5 2.01'>
        <Shape DEF='WindowRight'>
          <Box size='0.8 0.8 0.1'/>
          <Appearance>
            <Material transparency='0.5' diffuseColor='0.5 0.7 1'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
  </Scene>
