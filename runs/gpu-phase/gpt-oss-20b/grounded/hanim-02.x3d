  <Scene>
    <HAnimHumanoid DEF='RightArmFigure' version='2.0'>
      <HAnimJoint DEF='humanoidRoot' name='humanoidRoot' translation='0 0 0'>
        <HAnimJoint DEF='rightShoulder' name='rightShoulder' translation='0.2 1.5 0'>
          <HAnimSegment DEF='rightUpperArm' name='rightUpperArm'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.8 0.5 0.3'/>
              </Appearance>
              <Box size='0.15 0.4 0.15'/>
            </Shape>
          </HAnimSegment>
        </HAnimJoint>
      </HAnimJoint>
    </HAnimHumanoid>
    <TimeSensor DEF='waveClock' cycleInterval='2' loop='true'/>
    <OrientationInterpolator DEF='waveAnim' key='0 0.5 1' keyValue='0 0 0 1 0 0 0.5 1 0 0 0 1'/>
    <ROUTE fromNode='waveClock' fromField='fraction_changed' toNode='waveAnim' toField='set_fraction'/>
    <ROUTE fromNode='waveAnim' fromField='value_changed' toNode='rightShoulder' toField='set_orientation'/>
    <Viewpoint description='Right Arm Wave View' position='0 1.5 2' orientation='0 1 0 0'/>
  </Scene>
</X3D>