      <HAnimSegment containerField='segments' USE='PelvisSegment'/>
      <HAnimSegment containerField='segments' USE='RightThigh'/>
      <HAnimSegment containerField='segments' USE='RightCalf'/>
      <HAnimSegment containerField='segments' USE='RightFoot'/>
      <HAnimSegment containerField='segments' USE='LeftThigh'/>
