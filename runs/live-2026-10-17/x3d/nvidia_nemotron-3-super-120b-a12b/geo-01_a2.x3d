<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='1'/>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2284 -80.4234 630'/>
    <GeoViewpoint geoSystem='"GD" "WE"' position='37.2284 -80.4234 630' description='Virginia Tech Drillfield Viewpoint'/>
    <!-- Flagpole -->
    <Transform>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.6 0.6 0.6'/>
        </Appearance>
        <Cylinder radius='0.05' height='10'/>
      </Shape>
    </Transform>
    <!-- Red flag at top of pole -->
    <Transform translation='0 10 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='1 0 0'/>
        </Appearance>
        <Box size='2 1.5 0.01'/>
      </Shape>
    </Transform>
    <Viewpoint description='Default view' position='0 20 30'/>
  </Scene>
</X3D>