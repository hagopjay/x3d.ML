<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Desk lamp with swaying upper arm' position='0 1.5 3' orientation='0 1 0 -0.5'/>
    <!-- Desk surface -->
    <Transform translation='0 0 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.55 0.35 0.2' roughness='0.8' metallicity='0.0'/>
        </Appearance>
        <Box size='1 0.02 0.6'/>
      </Shape>
    </Transform>
    <!-- Lamp base -->
    <Transform translation='0 0.025 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.2 0.2 0.2' roughness='0.3' metallicity='0.9'/>
        </Appearance>
        <Cylinder radius='0.1' height='0.05'/>
      </Shape>
    </Transform>
    <!-- Lower arm -->
    <Transform translation='0 0.175 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.3 0.3 0.3' roughness='0.4' metallicity='0.8'/>
        </Appearance>
        <Cylinder radius='0.02' height='0.3'/>
      </Shape>
    </Transform>
    <!-- Upper arm (animated) -->
    <Transform DEF='UpperArm' translation='0 0.475 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.3 0.3 0.3' roughness='0.4' metallicity='0.8'/>
        </Appearance>
        <Cylinder radius='0.02' height='0.3'/>
      </Shape>
      <!-- Shade -->
      <Transform translation='0 0.3 0' rotation='1 0 0 3.14159'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.8 0.7 0.6' roughness='0.9' metallicity='0.0'/>
          </Appearance>
          <Cone bottomRadius='0.15' height='0.2'/>
        </Shape>
        <!-- SpotLight inside shade pointing down -->
        <SpotLight location='0 0.1 0' direction='0 -1 0' radius='0.5' cutOffAngle='0.785' beamWidth='0.5' intensity='1' color='1 0.95 0.9'/>
      </Transform>
    </Transform>
    <!-- Animation: sway upper arm -->
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='Sway' key='0 0.5 1' keyValue='0 0 1 0  0 0 1 0.3  0 0 1 0'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Sway' toField='set_fraction'/>
    <ROUTE fromNode='Sway' fromField='value_changed' toNode='UpperArm' toField='rotation'/>
  </Scene>
</X3D>