    </Transform>
    <TimeSensor DEF="EarthTime" cycleInterval="20" loop="true"/>
    <OrientationInterpolator DEF="EarthRot" key="0 1" keyValue="0 1 0 0 0 1 0 6.28318530718"/>
    <ROUTE fromNode="EarthTime" fromField="fraction_changed" toNode="EarthRot" toField="set_fraction"/>
    <ROUTE fromNode="EarthRot" fromField="value_changed" toNode="EarthSphere" toField="set_rotation"/>
