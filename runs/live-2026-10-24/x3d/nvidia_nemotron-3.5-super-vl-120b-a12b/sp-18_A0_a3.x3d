    </Transform>
    <Transform translation='0 0.25 4'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>

    <TimeSensor DEF='FishTS1' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='FishOI1' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot1' translation='0 0.5 0'>
      <Transform translation='1 0 0' rotation='0 0 1 1.5707963'>
        <Shape>
          <Appearance><Material diffuseColor='1 0.5 0'/></Appearance>
          <Cone bottomRadius='0.08' height='0.2'/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE fromNode='FishTS1' fromField='fraction_changed' toNode='FishOI1' toField='set_fraction'/>
    <ROUTE fromNode='FishOI1' fromField='value_changed' toNode='FishPivot1' toField='rotation'/>

    <TimeSensor DEF='FishTS2' cycleInterval='5' loop='true'/>
    <OrientationInterpolator DEF='FishOI2' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot2' translation='0 1 0'>
