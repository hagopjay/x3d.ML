<Appearance>
<Material diffuseColor='0.5 0.3 0.1'/>
</Appearance>
<Box size='0.1 2 0.1'/>
</Shape>
</Transform>
</Transform>
</Group>
<OrientationInterpolator DEF='DoorRotation' key='0 1' keyValue='0 1 0 0 0 1 0 1.5708'/>
<TimeSensor DEF='DoorTimer' cycleInterval='2' loop='false'/>
<ROUTE fromNode='DoorTimer' fromField='fractionComplete' toNode='DoorRotation' toField='set_fraction'/>
<ROUTE fromNode='DoorRotation' fromField='value' toNode='DoorHinge' toField='rotation'/>
