<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <meta name="title" content="Greek Temple"/>
    <meta name="creator" content="X3D Author"/>
    <meta name="description" content="A Greek temple with base, columns, roof, pediments, marble tones, low sun, green ground."/>
  </head>
  <Scene>
    <!-- Dummy shapes to hold Material DEFs -->
    <Shape>
      <Appearance>
        <Material DEF="Marble" diffuseColor="0.9 0.85 0.8" specularColor="0.3 0.3 0.3" shininess="0.5"/>
      </Appearance>
      <Box size="0 0 0"/>
    </Shape>
    <Shape>
      <Appearance>
        <Material DEF="GreenGround" diffuseColor="0.2 0.6 0.2"/>
      </Appearance>
      <Box size="0 0 0"/>
    </Shape>

    <Group DEF="Column">
      <Shape>
        <Appearance>
          <Material USE="Marble"/>
        </Appearance>
        <Cylinder radius="0.5" height="6" top="true" bottom="true" side="true"/>
      </Shape>
    </Group>
    <Transform translation="0 -0.05 0">
      <Shape>
        <Appearance>
          <Material USE="GreenGround"/>
        </Appearance>
        <Box size="100 0.1 100"/>
      </Shape>
    </Transform>
    <Transform translation="0 0.25 0">
      <Shape>
        <Appearance>
          <Material USE="Marble"/>
        </Appearance>
        <Box size="20 0.5 12"/>
      </Shape>
    </Transform>
    <Transform translation="0 0.75 0">
      <Shape>
        <Appearance>
          <Material USE="Marble"/>
        </Appearance>
        <Box size="18 0.5 10"/>
      </Shape>
    </Transform>
    <Transform translation="0 1.25 0">
      <Shape>
        <Appearance>
          <Material USE="Marble"/>
        </Appearance>
        <Box size="16 0.5 8"/>
      </Shape>
    </Transform>
    <Transform translation="-8.75 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="-6.25 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="-3.75 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="-1.25 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="1.25 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="3.75 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="6.25 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="8.75 4.5 -5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="-8.75 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="-6.25 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="-3.75 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="-1.25 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="1.25 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="3.75 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="6.25 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="8.75 4.5 5">
      <Group USE="Column"/>
    </Transform>
    <Transform translation="0 7.75 0">
      <Shape>
        <Appearance>
          <Material USE="Marble"/>
        </Appearance>
        <Box size="16 0.5 8"/>
      </Shape>
    </Transform>
    <Transform translation="0 0 0">
      <Shape>
        <Appearance>
          <Material USE="Marble"/>
        </Appearance>
        <IndexedFaceSet coordIndex="0 1 2 -1 3 5 4 -1 0 3 5 2 -1 1 2 5 4 -1 0 4 3 -1">
          <Coordinate point="-8 7.5 -4  8 7.5 -4  0 10.5 -4  -8 7.5 -4.5  8 7.5 -4.5  0 10.5 -4.5"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <Transform translation="0 0 0">
      <Shape>
        <Appearance>
          <Material USE="Marble"/>
        </Appearance>
        <IndexedFaceSet coordIndex="0 1 2 -1 3 5 4 -1 0 3 5 2 -1 1 2 5 4 -1 0 4 3 -1">
          <Coordinate point="-8 7.5 4  8 7.5 4  0 10.5 4  -8 7.5 4.5  8 7.5 4.5  0 10.5 4.5"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <DirectionalLight direction="-0.3 -0.5 -0.7" color="1 1 1" intensity="0.8"/>
    <Viewpoint position="0 10 20" description="Greek Temple"/>
  </Scene>
</X3D>