<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<head>
<component name='Shape' level='2'/>
</head>
<Scene>
<Viewpoint description='Newton Cradle' position='0 0 10'/>
<Background skyColor='0.8 0.8 0.8'/>
<!-- Frame -->
<Transform translation='0 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='0 0 0'/>
</Appearance>
<Box size='4.2 0.05 0.05'/>
</Shape>
</Transform>
<!-- Leftmost ball (animated) -->
<Transform DEF='leftPivot' translation='-2 0 0'>
<Transform translation='0 -1 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.2 0.2 0.2'/>
</Appearance>
<Cylinder radius='0.02' height='2'/>
</Shape>
</Transform>
<Transform translation='0 -2 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0.7 0.7 0.7' roughness='0.1'/>
</Appearance>
<Sphere radius='0.2'/>
</Shape>
</Transform>
</Transform>
<!-- Second ball (static) -->
<Transform translation='-1 0 0'>
<Transform translation='0 -1 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.2 0.2 0.2'/>
</Appearance>
<Cylinder radius='0.02' height='2'/>
</Shape>
</Transform>
<Transform translation='0 -2 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0.7 0.7 0.7' roughness='0.1'/>
</Appearance>
<Sphere radius='0.2'/>
</Shape>
</Transform>
</Transform>
<!-- Middle ball (static) -->
<Transform translation='0 0 0'>
<Transform translation='0 -1 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.2 0.2 0.2'/>
</Appearance>
<Cylinder radius='0.02' height='2'/>
</Shape>
</Transform>
<Transform translation='0 -2 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0.7 0.7 0.7' roughness='0.1'/>
</Appearance>
<Sphere radius='0.2'/>
</Shape>
</Transform>
</Transform>
<!-- Fourth ball (static) -->
<Transform translation='1 0 0'>
<Transform translation='0 -1 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.2 0.2 0.2'/>
</Appearance>
<Cylinder radius='0.02' height='2'/>
</Shape>
</Transform>
<Transform translation='0 -2 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0.7 0.7 0.7' roughness='0.1'/>
</Appearance>
<Sphere radius='0.2'/>
</Shape>
</Transform>
</Transform>
<!-- Rightmost ball (animated) -->
<Transform DEF='rightPivot' translation='2 0 0'>
<Transform translation='0 -1 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.2 0.2 0.2'/>
</Appearance>
<Cylinder radius='0.02' height='2'/>
</Shape>
</Transform>
<Transform translation='0 -2 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0.7 0.7 0.7' roughness='0.1'/>
</Appearance>
<Sphere radius='0.2'/>
</Shape>
</Transform>
</Transform>
<!-- Animation -->
<TimeSensor DEF='clock' cycleInterval='4' loop='true'/>
<OrientationInterpolator DEF='leftSwing' key='0 0.25 0.5 0.5 1' keyValue='0 0 1 0 0 0 1 -0.5 0 0 1 0 0 0 1 0 0 0 1 0'/>
<OrientationInterpolator DEF='rightSwing' key='0 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 0 0 0 1 0.5 0 0 1 0'/>
<ROUTE fromNode='clock' fromField='fraction_changed' toNode='leftSwing' toField='set_fraction'/>
<ROUTE fromNode='clock' fromField='fraction_changed' toNode='rightSwing' toField='set_fraction'/>
<ROUTE fromNode='leftSwing' fromField='value_changed' toNode='leftPivot' toField='rotation'/>
<ROUTE fromNode='rightSwing' fromField='value_changed' toNode='rightPivot' toField='rotation'/>
</Scene>
</X3D>