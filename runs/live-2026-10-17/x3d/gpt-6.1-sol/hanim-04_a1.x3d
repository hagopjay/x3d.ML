      keyValue='0 0 1 0, 0 0 1 0.2, 0 0 1 0.75, 0 0 1 0.2, 0 0 1 0.75, 0 0 1 0.2, 0 0 1 0'/>

    <ROUTE fromNode='WaveTouch' fromField='touchTime' toNode='WaveClock' toField='set_startTime'/>
    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='ShoulderMotion' toField='set_fraction'/>
    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='ElbowMotion' toField='set_fraction'/>
    <ROUTE fromNode='ShoulderMotion' fromField='value_changed' toNode='LeftShoulder' toField='set_rotation'/>
    <ROUTE fromNode='ElbowMotion' fromField='value_changed' toNode='LeftElbow' toField='set_rotation'/>
