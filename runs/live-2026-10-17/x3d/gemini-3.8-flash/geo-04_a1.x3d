<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='2'/>
  </head>
  <Scene>
    <Viewpoint description='Overview View' position='0 70 120' orientation='1 0 0 -0.55'/>
    <GeoViewpoint description='Torgersen Hall Aerial View' geoSystem='"GD" "WE"' position='37.2285 -80.419448 760' orientation='1 0 0 -0.6'/>

    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.229984 -80.419448 635'>
      <Transform translation='0 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.3 0.45 0.25'/>
          </Appearance>
          <Box size='140 1 140'/>
        </Shape>
      </Transform>
      <Transform translation='-25 12.5 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.55 0.3 0.25'/>
          </Appearance>
          <Box size='35 25 30'/>
        </Shape>
      </Transform>
      <Transform translation='10 16 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.4 0.45 0.5' transparency='0.2'/>
          </Appearance>
          <Box size='35 10 12'/>
        </Shape>
      </Transform>
      <Transform translation='40 10 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.55 0.3 0.25'/>
          </Appearance>
          <Box size='25 20 28'/>
        </Shape>
      </Transform>
    </GeoLocation>

    <GeoLocation DEF='DroneLocation' geoSystem='"GD" "WE"' geoCoords='37.2295 -80.4199 685'>
      <Transform>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.9 0.2 0.1'/>
          </Appearance>
          <Box size='2 0.6 2'/>
