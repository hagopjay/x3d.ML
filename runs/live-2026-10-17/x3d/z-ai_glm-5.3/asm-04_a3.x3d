<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Street lamp at night' position='8 4 12' orientation='0.22 0.98 0 0.53' centerOfRotation='1.2 5.5 0'/>
    <NavigationInfo headlight='false' type='"EXAMINE" "ANY"'/>

    <!-- Ground -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Box size='40 0.1 40'/>
        <Appearance>
          <Material diffuseColor='0.12 0.12 0.15'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Lamp base -->
    <Transform translation='0 0.15 0'>
      <Shape>
        <Cylinder radius='0.5' height='0.3'/>
        <Appearance>
          <Material diffuseColor='0.25 0.25 0.28'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Pole -->
    <Transform translation='0 3.05 0'>
      <Shape>
        <Cylinder radius='0.1' height='5.5'/>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.23' specularColor='0.4 0.4 0.4' shininess='0.5'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Pole cap -->
    <Transform translation='0 5.82 0'>
      <Shape>
        <Sphere radius='0.13'/>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.23'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Arm -->
    <Transform translation='0.6 5.8 0' rotation='0 0 1 1.5708'>
      <Shape>
        <Cylinder radius='0.07' height='1.2'/>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.23'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Lamp shade -->
    <Transform translation='1.2 5.55 0'>
      <Shape>
        <Cone bottomRadius='0.45' height='0.5'/>
        <Appearance>
          <Material diffuseColor='0.15 0.15 0.17'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Bulb -->
    <Transform translation='1.2 5.28 0'>
      <Shape>
        <Sphere radius='0.16'/>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.2' emissiveColor='1 0.85 0.5'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Point light at the top, on by default -->
    <PointLight on='true' color='1 0.9 0.75' intensity='1' ambientIntensity='0.3' location='1.2 5.15 0' radius='30' attenuation='0 0.15 0'/>
  </Scene>
</X3D>