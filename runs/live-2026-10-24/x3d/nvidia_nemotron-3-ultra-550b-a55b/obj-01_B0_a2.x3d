<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
    <meta name="title" content="Red PBR Sphere on Grey Ground"/>
    <meta name="description" content="A simple X3D 4.0 scene with a red PBR sphere on a grey ground plane, directional light, and a named viewpoint."/>
  </head>
  <Scene>
    <Viewpoint DEF="MainView" description="Red PBR Sphere on Grey Ground" position="0 5 10" orientation="0 1 0 -0.5"/>
    <DirectionalLight direction="0 -1 -1" color="1 1 1" intensity="1"/>
    <Transform translation="0 -0.05 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.5 0.5 0.5" roughness="0.8" metallic="0.0"/>
        </Appearance>
        <Box size="100 0.1 100"/>
      </Shape>
    </Transform>
    <Transform translation="0 1 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="1 0 0" roughness="0.3" metallic="0.5"/>
        </Appearance>
        <Sphere radius="1"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>