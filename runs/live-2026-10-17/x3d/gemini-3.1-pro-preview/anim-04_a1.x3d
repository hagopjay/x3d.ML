<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='description' content='A sphere whose colour cycles red, green, blue over 6 seconds using a ColorInterpolator.'/>
  </head>
  <Scene>
    <Viewpoint description='Color Cycling Sphere View' position='0 0 7'/>
    <Shape>
      <Appearance>
        <Material DEF='SphereMaterial' diffuseColor='1 0 0'/>
      </Appearance>
      <Sphere radius='2'/>
    </Shape>
    <TimeSensor DEF='Timer' cycleInterval='6' loop='true'/>
    <ColorInterpolator DEF='ColorChanger' key='0 0.3333 0.6667 1' keyValue='1 0 0 0 1 0 0 0 1 1 0 0'/>
    <ROUTE fromNode='Timer' fromField='fraction_changed' toNode='ColorChanger' toField='set_fraction'/>
    <ROUTE fromNode='ColorChanger' fromField='value_changed' toNode='SphereMaterial' toField='diffuseColor'/>
  </Scene>
</X3D>