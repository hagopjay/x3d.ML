<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Windmill on grassy hill' position='0 10 20' orientation='0 1 0 3.14'/>
    <Background skyColor='0.5 0.7 1.0'/>
    <NavigationInfo type='["EXAMINE","ANY"]'/>
    <!-- Grassy hill -->
    <Transform translation='-4 0 -4'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.6 0.2'/>
        </Appearance>
        <ElevationGrid xDimension='5' zDimension='5' xSpacing='2' zSpacing='2' height='0 0 0 0 0 0 1 2 1 0 0 2 5 2 0 0 1 2 1 0 0 0 0 0 0'/>
      </Shape>
    </Transform>
    <!-- Windmill -->
    <Transform translation='0 5 0'>
      <!-- Tower -->
      <Transform translation='0 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 1 1'/>
          </Appearance>
          <Cone bottomRadius='1.5' height='10'/>
        </Shape>
      </Transform>
      <!-- Roof -->
      <Transform translation='0 10 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.2 0.2 0.2'/>
          </Appearance>
          <Cone bottomRadius='1.8' height='3'/>
        </Shape>
      </Transform>
      <!-- Blades -->
      <Transform DEF='Blades' translation='0 10 0'>
        <Transform rotation='0 1 0 0'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
            <Box size='6 0.2 0.5'/>
          </Shape>
        </Transform>
        <Transform rotation='0 1 0 1.5708'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
            <Box size='6 0.2 0.5'/>
          </Shape>
        </Transform>
        <Transform rotation='0 1 0 3.1416'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
            <Box size='6 0.2 0.5'/>
          </Shape>
        </Transform>
        <Transform rotation='0 1 0 4.7124'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
            <Box size='6 0.2 0.5'/>
          </Shape>
        </Transform>
      </Transform>
    </Transform>
    <!-- Animation -->
    <TimeSensor DEF='Clock' cycleInterval='8' loop='true'/>
    <OrientationInterpolator DEF='Spin' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.5708 0 1 0 3.1416 0 1 0 4.7124 0 1 0 6.2832'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Spin' toField='set_fraction'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='Blades' toField='rotation'/>
  </Scene>
</X3D>