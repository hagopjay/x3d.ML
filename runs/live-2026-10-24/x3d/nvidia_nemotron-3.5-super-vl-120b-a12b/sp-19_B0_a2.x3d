          <Material diffuseColor="0.7 0.7 0.7"/>
        </Appearance>
      </Shape>
      <Transform translation="-0.7 0.2 0.8" rotation="0 0 1 1.57079632679">
        <Shape>
          <Cylinder radius="0.2" height="0.4"/>
          <Appearance>
            <Material diffuseColor="0.1 0.1 0.1"/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation="0.7 0.2 0.8" rotation="0 0 1 1.57079632679">
