<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <WorldInfo title='Simple House'/>
    <Background skyColor='0.65 0.82 0.96'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Viewpoint description='House front and roof' position='6 4.2 9' orientation='-0.330 0.938 0.110 0.634' centerOfRotation='0 1.7 0'/>
    <DirectionalLight direction='-1 -2 -1' intensity='0.9'/>

    <!-- Named parts are defined here and instantiated below. -->
    <Switch whichChoice='-1'>
      <Shape DEF='HouseBody'>
        <Appearance>
          <Material diffuseColor='0.88 0.75 0.54'/>
        </Appearance>
        <Box size='3 2.4 2.4'/>
      </Shape>

      <Shape DEF='PyramidRoof'>
        <Appearance>
          <Material diffuseColor='0.58 0.16 0.10'/>
        </Appearance>
        <IndexedFaceSet coordIndex='0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1 3 2 1 0 -1' creaseAngle='0'>
          <Coordinate point='-1.8 0 1.5, 1.8 0 1.5, 1.8 0 -1.5, -1.8 0 -1.5, 0 1.5 0'/>
        </IndexedFaceSet>
      </Shape>

      <Shape DEF='Door'>
        <Appearance>
          <Material diffuseColor='0.30 0.14 0.06'/>
        </Appearance>
        <Box size='0.65 1.35 0.08'/>
      </Shape>

      <Shape DEF='LeftWindow'>
        <Appearance>
          <Material diffuseColor='0.25 0.65 0.88' specularColor='0.8 0.8 0.8' shininess='0.7'/>
        </Appearance>
        <Box size='0.65 0.65 0.08'/>
      </Shape>

      <Shape DEF='RightWindow'>
        <Appearance>
          <Material diffuseColor='0.25 0.65 0.88' specularColor='0.8 0.8 0.8' shininess='0.7'/>
        </Appearance>
        <Box size='0.65 0.65 0.08'/>
      </Shape>
    </Switch>

    <Transform translation='0 1.2 0'>
      <Shape USE='HouseBody'/>
    </Transform>
    <Transform translation='0 2.4 0'>
      <Shape USE='PyramidRoof'/>
    </Transform>
    <Transform translation='0 0.675 1.23'>
      <Shape USE='Door'/>
    </Transform>
    <Transform translation='-0.95 1.5 1.23'>
      <Shape USE='LeftWindow'/>
    </Transform>
    <Transform translation='0.95 1.5 1.23'>
      <Shape USE='RightWindow'/>
    </Transform>

    <Transform translation='0 -0.06 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.30 0.52 0.24'/>
        </Appearance>
        <Box size='10 0.1 10'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>