<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
  </head>
  <Scene>
    <Viewpoint description="Planetarium view" position="0 0 20"/>
    <Shape>
      <Sphere radius="1.5"/>
      <Appearance>
        <UnlitMaterial emissiveColor="1 1 0"/>
      </Appearance>
    </Shape>
    <Transform DEF="Orbit1">
      <TimeSensor DEF="TS1" cycleInterval="10" loop="true"/>
      <OrientationInterpolator DEF="OI1" key="0 1" keyValue="0 1 0 0 0 1 0 6.283185"/>
      <ROUTE fromNode="TS1" fromField="fraction_changed" toNode="OI1" toField="set_fraction"/>
      <ROUTE fromNode="OI1" fromField="value_changed" toNode="Orbit1" toField="rotation"/>
      <Transform translation="5 0 0">
        <Shape>
          <Sphere radius="0.5"/>
          <Appearance>
            <PhysicalMaterial baseColor="1 0 0"/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <Transform DEF="Orbit2">
      <TimeSensor DEF="TS2" cycleInterval="20" loop="true"/>
      <OrientationInterpolator DEF="OI2" key="0 1" keyValue="0 1 0 0 0 1 0 6.283185"/>
      <ROUTE fromNode="TS2" fromField="fraction_changed" toNode="OI2" toField="set_fraction"/>
      <ROUTE fromNode="OI2" fromField="value_changed" toNode="Orbit2" toField="rotation"/>
      <Transform translation="8 0 0">
        <Shape>
          <Sphere radius="0.8"/>
          <Appearance>
            <PhysicalMaterial baseColor="0 0 1"/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <Transform DEF="Orbit3">
      <TimeSensor DEF="TS3" cycleInterval="30" loop="true"/>
      <OrientationInterpolator DEF="OI3" key="0 1" keyValue="0 1 0 0 0 1 0 6.283185"/>
      <ROUTE fromNode="TS3" fromField="fraction_changed" toNode="OI3" toField="set_fraction"/>
      <ROUTE fromNode="OI3" fromField="value_changed" toNode="Orbit3" toField="rotation"/>
      <Transform translation="12 0 0">
        <Shape>
          <Sphere radius="1.2"/>
          <Appearance>
            <PhysicalMaterial baseColor="0 1 0"/>
          </Appearance>
        </Shape>
        <Shape>
          <Cylinder radius="2.4" height="0.02" top="true" bottom="true" side="false"/>
          <Appearance>
            <PhysicalMaterial baseColor="0.7 0.7 0.7" transparency="0.3"/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <Transform DEF="Orbit4">
      <TimeSensor DEF="TS4" cycleInterval="40" loop="true"/>
      <OrientationInterpolator DEF="OI4" key="0 1" keyValue="0 1 0 0 0 1 0 6.283185"/>
      <ROUTE fromNode="TS4" fromField="fraction_changed" toNode="OI4" toField="set_fraction"/>
      <ROUTE fromNode="OI4" fromField="value_changed" toNode="Orbit4" toField="rotation"/>
      <Transform translation="15 0 0">
        <Shape>
          <Sphere radius="0.6"/>
          <Appearance>
            <PhysicalMaterial baseColor="1 1 1"/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
  </Scene>
</X3D>