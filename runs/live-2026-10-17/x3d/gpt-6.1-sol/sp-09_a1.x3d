<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Castle of the Red Banner'/>
    <meta name='description' content='Four roofed corner towers, crenellated stone walls, a shadowed gatehouse, and an animated red flag above a green lawn.'/>
  </head>
  <Scene>
    <WorldInfo title='Castle of the Red Banner'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
    <Background skyColor='0.48 0.70 0.87'/>
    <Viewpoint description='Castle from the lawn' position='18 13 24' orientation='-0.433 0.890 0.144 0.716' centerOfRotation='0 3 0'/>
    <DirectionalLight direction='-0.5 -1 -0.4' intensity='0.95' color='1 0.94 0.82'/>
    <DirectionalLight direction='0.7 -0.5 0.5' intensity='0.4' color='0.68 0.80 1'/>

    <Transform translation='0 -0.2 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.23 0.43 0.16'/>
        </Appearance>
        <Box size='40 0.4 36'/>
      </Shape>
    </Transform>

    <Transform translation='0 0.025 9.5'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.56 0.51 0.40'/>
        </Appearance>
        <Box size='2.5 0.05 9'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.03 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.49 0.47 0.40'/>
        </Appearance>
        <Box size='9.5 0.06 9.5'/>
      </Shape>
    </Transform>

    <!-- A reusable wall contains a solid box and nine box merlons. -->
    <Transform translation='0 0 -5'>
      <Group DEF='CrenellatedWall'>
        <Transform translation='0 1.5 0'>
          <Shape>
            <Appearance DEF='Stone'>
              <Material diffuseColor='0.61 0.58 0.49' specularColor='0.12 0.11 0.09' shininess='0.12'/>
            </Appearance>
            <Box size='10 3 0.7'/>
          </Shape>
        </Transform>
        <Transform translation='-4.4 3.4 0'>
          <Shape DEF='Merlon'>
            <Appearance USE='Stone'/>
            <Box size='0.65 0.8 0.8'/>
          </Shape>
        </Transform>
        <Transform translation='-3.3 3.4 0'><Shape USE='Merlon'/></Transform>
        <Transform translation='-2.2 3.4 0'><Shape USE='Merlon'/></Transform>
        <Transform translation='-1.1 3.4 0'><Shape USE='Merlon'/></Transform>
        <Transform translation='0 3.4 0'><Shape USE='Merlon'/></Transform>
        <Transform translation='1.1 3.4 0'><Shape USE='Merlon'/></Transform>
        <Transform translation='2.2 3.4 0'><Shape USE='Merlon'/></Transform>
        <Transform translation='3.3 3.4 0'><Shape USE='Merlon'/></Transform>
        <Transform translation='4.4 3.4 0'><Shape USE='Merlon'/></Transform>
      </Group>
    </Transform>
    <Transform translation='-5 0 0' rotation='0 1 0 1.570796'>
      <Group USE='CrenellatedWall'/>
    </Transform>
    <Transform translation='5 0 0' rotation='0 1 0 1.570796'>
      <Group USE='CrenellatedWall'/>
    </Transform>
    <Transform translation='-3.4 0 5' scale='0.32 1 1'>
      <Group USE='CrenellatedWall'/>
    </Transform>
    <Transform translation='3.4 0 5' scale='0.32 1 1'>
      <Group USE='CrenellatedWall'/>
    </Transform>

    <!-- Four corner towers; the front-right tower rises above the others. -->
    <Transform translation='-5 0 -5'>
      <Group DEF='CornerTower'>
        <Transform translation='0 2.5 0'>
          <Shape>
            <Appearance USE='Stone'/>
            <Cylinder radius='1.15' height='5'/>
          </Shape>
        </Transform>
        <Transform translation='0 0.25 0'>
          <Shape>
            <Appearance USE='Stone'/>
            <Cylinder radius='1.3' height='0.5'/>
          </Shape>
        </Transform>
        <Transform translation='0 4.85 0'>
          <Shape>
            <Appearance USE='Stone'/>
            <Cylinder radius='1.27' height='0.35'/>
          </Shape>
        </Transform>
        <Transform translation='0 6 0'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.20 0.25 0.29' specularColor='0.22 0.24 0.26' shininess='0.25'/>
            </Appearance>
            <Cone bottomRadius='1.55' height='2.2'/>
          </Shape>
        </Transform>
        <Transform translation='0 3.55 1.145'>
          <Shape>
            <Appearance DEF='Shadow'>
              <Material diffuseColor='0.035 0.029 0.023'/>
            </Appearance>
            <Box size='0.25 0.95 0.04'/>
          </Shape>
        </Transform>
      </Group>
    </Transform>
    <Transform translation='5 0 -5'>
      <Group USE='CornerTower'/>
    </Transform>
    <Transform translation='-5 0 5'>
      <Group USE='CornerTower'/>
    </Transform>
    <Transform translation='5 0 5' scale='1 1.23 1'>
      <Group USE='CornerTower'/>
    </Transform>

    <!-- The doorway is recessed behind two piers and a broad stone lintel. -->
    <Transform translation='-1.45 1.5 5.15'>
      <Shape DEF='GatePier'>
        <Appearance USE='Stone'/>
        <Box size='0.7 3 1.8'/>
      </Shape>
    </Transform>
    <Transform translation='1.45 1.5 5.15'>
      <Shape USE='GatePier'/>
    </Transform>
    <Transform translation='0 3.7 5.15'>
      <Shape>
        <Appearance USE='Stone'/>
        <Box size='3.6 1.4 1.8'/>
      </Shape>
    </Transform>
    <Transform translation='0 1.5 4.86'>
      <Shape>
        <Appearance USE='Shadow'/>
        <Box size='2.2 3 0.08'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.07 5.25'>
      <Shape>
        <Appearance USE='Stone'/>
        <Box size='2.2 0.14 2.1'/>
      </Shape>
    </Transform>
    <Transform translation='-1.45 4.8 5.15'><Shape USE='Merlon'/></Transform>
    <Transform translation='0 4.8 5.15'><Shape USE='Merlon'/></Transform>
    <Transform translation='1.45 4.8 5.15'><Shape USE='Merlon'/></Transform>

    <!-- A gently turning, rippled red banner crowns the tallest tower. -->
    <Transform translation='5 9.3 5'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.35 0.24 0.11' specularColor='0.4 0.3 0.15'/>
        </Appearance>
        <Cylinder radius='0.045' height='2.4'/>
      </Shape>
    </Transform>
    <Transform translation='5 10.55 5'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.61 0.18' specularColor='0.6 0.5 0.2'/>
        </Appearance>
        <Sphere radius='0.1'/>
      </Shape>
    </Transform>
    <Transform translation='5 10.3 5'>
      <Transform DEF='BannerMotion'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.78 0.025 0.035' emissiveColor='0.06 0 0'/>
          </Appearance>
          <IndexedFaceSet solid='false' coordIndex='0 1 5 4 -1 1 2 6 5 -1 2 3 7 6 -1'>
            <Coordinate point='0 0 0, 0.65 -0.04 0.13, 1.3 0.02 -0.1, 2 -0.12 0.08, 0 -0.95 0, 0.65 -1.0 0.13, 1.3 -0.93 -0.1, 2 -1.08 0.08'/>
          </IndexedFaceSet>
        </Shape>
      </Transform>
    </Transform>
    <TimeSensor DEF='FlagClock' cycleInterval='5' loop='true'/>
    <OrientationInterpolator DEF='FlagSway' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 -0.18, 0 1 0 0.04, 0 1 0 0.2, 0 1 0 -0.03, 0 1 0 -0.18'/>
    <ROUTE fromNode='FlagClock' fromField='fraction_changed' toNode='FlagSway' toField='set_fraction'/>
    <ROUTE fromNode='FlagSway' fromField='value_changed' toNode='BannerMotion' toField='set_rotation'/>
  </Scene>
</X3D>