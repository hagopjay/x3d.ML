  <Scene>
    <!-- Ground Plane -->
    <Shape>
      <Appearance>
        <Material diffuseColor='0.5 0.5 0.5'/>
      </Appearance>
      <Box size='10 0.1 10'/>
    </Shape>

    <!-- Red PBR Sphere -->
    <Transform translation='0 1.5 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColorFactor='1 0 0' roughnessFactor='0.5' metallicFactor='0.8'/>
        </Appearance>
        <Sphere radius='1'/>
