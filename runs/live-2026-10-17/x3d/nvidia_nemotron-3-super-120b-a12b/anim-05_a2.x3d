<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <Viewpoint description='Three rotating cubes' position='0 0 5'/>
    <!-- Cube 1 -->
    <Transform DEF='Cube1Transform' translation='-2 0 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='1 0 0'/>
        </Appearance>
        <Box size='1 1 1'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='TS1' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='OI1' key='0 1' keyValue='0 0 1 0 0 0 1 6.283185307179586'/>
    <ROUTE fromNode='TS1' fromField='fraction_changed' toNode='OI1' toField='set_fraction'/>
    <ROUTE fromNode='OI1' fromField='value_changed' toNode='Cube1Transform' toField='rotation'/>
    <!-- Cube 2 -->
    <Transform DEF='Cube2Transform' translation='0 0 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0 1 0'/>
        </Appearance>
        <Box size='1 1 1'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='TS2' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='OI2' key='0 1' keyValue='0 0 1 0 0 0 1 6.283185307179586'/>
    <ROUTE fromNode='TS2' fromField='fraction_changed' toNode='OI2' toField='set_fraction'/>
    <ROUTE fromNode='OI2' fromField='value_changed' toNode='Cube2Transform' toField='rotation'/>
    <!-- Cube 3 -->
    <Transform DEF='Cube3Transform' translation='2 0 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0 0 1'/>
        </Appearance>
        <Box size='1 1 1'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='TS3' cycleInterval='8' loop='true'/>
    <OrientationInterpolator DEF='OI3' key='0 1' keyValue='0 0 1 0 0 0 1 6.283185307179586'/>
    <ROUTE fromNode='TS3' fromField='fraction_changed' toNode='OI3' toField='set_fraction'/>
    <ROUTE fromNode='OI3' fromField='value_changed' toNode='Cube3Transform' toField='rotation'/>
  </Scene>
</X3D>