    </Transform>
    <Transform translation='-3 7.4 -9'><Shape USE='MerlonX'/></Transform>
    <Transform translation='0 7.4 -9'><Shape USE='MerlonX'/></Transform>
    <Transform translation='3 7.4 -9'><Shape USE='MerlonX'/></Transform>
    <Transform translation='6 7.4 -9'><Shape USE='MerlonX'/></Transform>

    <!-- Single Merlon for Z-axis walls -->
    <Transform translation='9 7.4 -6'>
