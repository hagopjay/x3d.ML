<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <!-- White tile definition -->
    <Shape DEF='WhiteTile'>
      <Appearance>
        <Material diffuseColor='1 1 1'/>
      </Appearance>
      <Box size='1 0.1 1'/>
    </Shape>
    <!-- Black tile definition -->
    <Shape DEF='BlackTile'>
      <Appearance>
        <Material diffuseColor='0 0 0'/>
      </Appearance>
      <Box size='1 0.1 1'/>
    </Shape>

    <!-- Board squares -->
    <Transform translation='-3.5 0.05 -3.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-2.5 0.05 -3.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-1.5 0.05 -3.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-0.5 0.05 -3.5'><USE node='BlackTile'/></Transform>
    <Transform translation='0.5 0.05 -3.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='1.5 0.05 -3.5'><USE node='BlackTile'/></Transform>
    <Transform translation='2.5 0.05 -3.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='3.5 0.05 -3.5'><USE node='BlackTile'/></Transform>

    <Transform translation='-3.5 0.05 -2.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-2.5 0.05 -2.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-1.5 0.05 -2.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-0.5 0.05 -2.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='0.5 0.05 -2.5'><USE node='BlackTile'/></Transform>
    <Transform translation='1.5 0.05 -2.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='2.5 0.05 -2.5'><USE node='BlackTile'/></Transform>
    <Transform translation='3.5 0.05 -2.5'><USE node='WhiteTile'/></Transform>

    <Transform translation='-3.5 0.05 -1.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-2.5 0.05 -1.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-1.5 0.05 -1.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-0.5 0.05 -1.5'><USE node='BlackTile'/></Transform>
    <Transform translation='0.5 0.05 -1.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='1.5 0.05 -1.5'><USE node='BlackTile'/></Transform>
    <Transform translation='2.5 0.05 -1.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='3.5 0.05 -1.5'><USE node='BlackTile'/></Transform>

    <Transform translation='-3.5 0.05 -0.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-2.5 0.05 -0.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-1.5 0.05 -0.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-0.5 0.05 -0.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='0.5 0.05 -0.5'><USE node='BlackTile'/></Transform>
    <Transform translation='1.5 0.05 -0.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='2.5 0.05 -0.5'><USE node='BlackTile'/></Transform>
    <Transform translation='3.5 0.05 -0.5'><USE node='WhiteTile'/></Transform>

    <Transform translation='-3.5 0.05 0.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-2.5 0.05 0.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-1.5 0.05 0.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-0.5 0.05 0.5'><USE node='BlackTile'/></Transform>
    <Transform translation='0.5 0.05 0.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='1.5 0.05 0.5'><USE node='BlackTile'/></Transform>
    <Transform translation='2.5 0.05 0.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='3.5 0.05 0.5'><USE node='BlackTile'/></Transform>

    <Transform translation='-3.5 0.05 1.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-2.5 0.05 1.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-1.5 0.05 1.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-0.5 0.05 1.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='0.5 0.05 1.5'><USE node='BlackTile'/></Transform>
    <Transform translation='1.5 0.05 1.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='2.5 0.05 1.5'><USE node='BlackTile'/></Transform>
    <Transform translation='3.5 0.05 1.5'><USE node='WhiteTile'/></Transform>

    <Transform translation='-3.5 0.05 2.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-2.5 0.05 2.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-1.5 0.05 2.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-0.5 0.05 2.5'><USE node='BlackTile'/></Transform>
    <Transform translation='0.5 0.05 2.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='1.5 0.05 2.5'><USE node='BlackTile'/></Transform>
    <Transform translation='2.5 0.05 2.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='3.5 0.05 2.5'><USE node='BlackTile'/></Transform>

    <Transform translation='-3.5 0.05 3.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-2.5 0.05 3.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='-1.5 0.05 3.5'><USE node='BlackTile'/></Transform>
    <Transform translation='-0.5 0.05 3.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='0.5 0.05 3.5'><USE node='BlackTile'/></Transform>
    <Transform translation='1.5 0.05 3.5'><USE node='WhiteTile'/></Transform>
    <Transform translation='2.5 0.05 3.5'><USE node='BlackTile'/></Transform>
    <Transform translation='3.5 0.05 3.5'><USE node='WhiteTile'/></Transform>

    <!-- Viewpoint -->
    <Viewpoint position='0 10 10' orientation='1 0 0 -0.7' description='Chess Board'/>
  </Scene>
</X3D>