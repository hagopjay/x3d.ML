<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Virginia Tech Drillfield Flagpole'/>
  </head>
  <Scene>
    <GeoViewpoint description='Virginia Tech Drillfield flagpole' geoSystem='"GD" "WE"' position='37.2278 -80.4234 641' orientation='1 0 0 -0.03' fieldOfView='0.8'/>
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2284 -80.4234 630'>
      <Viewpoint description='Flagpole close-up' position='10 5 10' orientation='0 1 0 0.7854'/>
      <Transform translation='0 -0.02 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.35 0.55 0.2' roughness='1.0'/>
          </Appearance>
          <Cylinder radius='2.5' height='0.04'/>
        </Shape>
      </Transform>
      <Transform translation='0 5 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.75 0.75 0.78' metalness='0.9' roughness='0.35'/>
          </Appearance>
          <Cylinder radius='0.07' height='10'/>
        </Shape>
      </Transform>
      <Transform translation='0 10.15 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.85 0.7 0.1' metalness='1.0' roughness='0.3'/>
          </Appearance>
          <Sphere radius='0.12'/>
        </Shape>
      </Transform>
      <Transform DEF='FlagHinge' translation='0.07 8.9 0'>
        <Transform translation='1.5 0 0'>
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor='0.8 0.05 0.05' roughness='0.9'/>
            </Appearance>
            <Box size='3 1.8 0.03'/>
          </Shape>
        </Transform>
      </Transform>
      <TimeSensor DEF='WaveClock' cycleInterval='4' loop='true'/>
      <OrientationInterpolator DEF='FlagWave' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 0.3 0 1 0 0 0 1 0 -0.3 0 1 0 0'/>
    </GeoLocation>
    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='FlagWave' toField='set_fraction'/>
    <ROUTE fromNode='FlagWave' fromField='value_changed' toNode='FlagHinge' toField='set_rotation'/>
  </Scene>
</X3D>