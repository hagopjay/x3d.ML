<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="HAnim" level="1"/>
  </head>
  <Scene>
    <Viewpoint description="HAnim waving figure" position="0 1.5 5"/>
    <HAnimHumanoid DEF="Humanoid" version="2.0">
      <HAnimJoint DEF="Root" name="HumanoidRoot" center="0 0 0" containerField="skeleton">
        <HAnimSegment DEF="TorsoSeg" name="Torso">
          <Shape>
            <Box size="0.4 1.2 0.2"/>
            <Appearance>
              <Material diffuseColor="0.8 0.8 0.8"/>
            </Appearance>
          </Shape>
        </HAnimSegment>
        <HAnimJoint DEF="LeftShoulder" name="LeftShoulder" center="0.2 1.1 0" ulimit="-1.57 1.57 -1.57 1.57 -1.57 1.57" llimit="-1.57 1.57 -1.57 1.57 -1.57 1.57">
          <HAnimSegment DEF="LeftUpperArmSeg" name="LeftUpperArm">
            <Shape>
              <Cylinder radius="0.05" height="0.5"/>
              <Appearance>
                <Material diffuseColor="0.8 0.6 0.4"/>
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint DEF="LeftElbow" name="LeftElbow" center="0.2 0.6 0" ulimit="0 0 -1.57 0 0 0" llimit="0 0 -1.57 0 0 0">
            <HAnimSegment DEF="LeftLowerArmSeg" name="LeftLowerArm">
              <Shape>
                <Cylinder radius="0.04" height="0.4"/>
                <Appearance>
                  <Material diffuseColor="0.8 0.6 0.4"/>
                </Appearance>
              </Shape>
            </HAnimSegment>
            <HAnimJoint DEF="LeftWrist" name="LeftWrist" center="0.2 0.2 0">
              <HAnimSegment DEF="LeftHandSeg" name="LeftHand">
                <Shape>
                  <Sphere radius="0.06"/>
                  <Appearance>
                    <Material diffuseColor="0.8 0.6 0.4"/>
                  </Appearance>
                </Shape>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>
        <HAnimJoint DEF="RightShoulder" name="RightShoulder" center="-0.2 1.1 0">
          <HAnimSegment DEF="RightUpperArmSeg" name="RightUpperArm">
            <Shape>
              <Cylinder radius="0.05" height="0.5"/>
              <Appearance>
                <Material diffuseColor="0.8 0.6 0.4"/>
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint DEF="RightElbow" name="RightElbow" center="-0.2 0.6 0">
            <HAnimSegment DEF="RightLowerArmSeg" name="RightLowerArm">
              <Shape>
                <Cylinder radius="0.04" height="0.4"/>
                <Appearance>
                  <Material diffuseColor="0.8 0.6 0.4"/>
                </Appearance>
              </Shape>
            </HAnimSegment>
            <HAnimJoint DEF="RightWrist" name="RightWrist" center="-0.2 0.2 0">
              <HAnimSegment DEF="RightHandSeg" name="RightHand">
                <Shape>
                  <Sphere radius="0.06"/>
                  <Appearance>
                    <Material diffuseColor="0.8 0.6 0.4"/>
                  </Appearance>
                </Shape>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>
        <HAnimJoint DEF="Neck" name="Neck" center="0 1.3 0">
          <HAnimSegment DEF="HeadSeg" name="Head">
            <Shape>
              <Sphere radius="0.15"/>
              <Appearance>
                <Material diffuseColor="0.8 0.6 0.4"/>
              </Appearance>
            </Shape>
          </HAnimSegment>
        </HAnimJoint>
        <HAnimJoint DEF="LeftHip" name="LeftHip" center="0.1 0 0">
          <HAnimSegment DEF="LeftThighSeg" name="LeftThigh">
            <Shape>
              <Cylinder radius="0.06" height="0.6"/>
              <Appearance>
                <Material diffuseColor="0.4 0.4 0.8"/>
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint DEF="LeftKnee" name="LeftKnee" center="0.1 -0.6 0">
            <HAnimSegment DEF="LeftShinSeg" name="LeftShin">
              <Shape>
                <Cylinder radius="0.05" height="0.5"/>
                <Appearance>
                  <Material diffuseColor="0.4 0.4 0.8"/>
                </Appearance>
              </Shape>
            </HAnimSegment>
            <HAnimJoint DEF="LeftAnkle" name="LeftAnkle" center="0.1 -1.1 0">
              <HAnimSegment DEF="LeftFootSeg" name="LeftFoot">
                <Shape>
                  <Box size="0.1 0.05 0.2"/>
                  <Appearance>
                    <Material diffuseColor="0.2 0.2 0.2"/>
                  </Appearance>
                </Shape>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>
        <HAnimJoint DEF="RightHip" name="RightHip" center="-0.1 0 0">
          <HAnimSegment DEF="RightThighSeg" name="RightThigh">
            <Shape>
              <Cylinder radius="0.06" height="0.6"/>
              <Appearance>
                <Material diffuseColor="0.4 0.4 0.8"/>
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint DEF="RightKnee" name="RightKnee" center="-0.1 -0.6 0">
            <HAnimSegment DEF="RightShinSeg" name="RightShin">
              <Shape>
                <Cylinder radius="0.05" height="0.5"/>
                <Appearance>
                  <Material diffuseColor="0.4 0.4 0.8"/>
                </Appearance>
              </Shape>
            </HAnimSegment>
            <HAnimJoint DEF="RightAnkle" name="RightAnkle" center="-0.1 -1.1 0">
              <HAnimSegment DEF="RightFootSeg" name="RightFoot">
                <Shape>
                  <Box size="0.1 0.05 0.2"/>
                  <Appearance>
                    <Material diffuseColor="0.2 0.2 0.2"/>
                  </Appearance>
                </Shape>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>
      <TouchSensor DEF="TouchSensor"/>
    </HAnimHumanoid>
    <TimeSensor DEF="WaveTimer" enabled="false" loop="false" cycleInterval="2"/>
    <OrientationInterpolator DEF="WaveInterpolator" key="0 0.5 1" keyValue="0 0 1 0  0 0 1 1.57  0 0 1 0"/>
    <Script DEF="StartScript"><field name="touchTime" type="SFTime" accessType="inputOnly"/><field name="timerEnabled" type="SFBool" accessType="outputOnly"/>
  
    ecmascript:
    function touchTime(value) {
      timerEnabled = true;
    }
  
</Script>
    <ROUTE fromNode="TouchSensor" fromField="touchTime" toNode="StartScript" toField="touchTime"/>
    <ROUTE fromNode="StartScript" fromField="timerEnabled" toNode="WaveTimer" toField="enabled"/>
    <ROUTE fromNode="WaveTimer" fromField="fraction_changed" toNode="WaveInterpolator" toField="set_fraction"/>
    <ROUTE fromNode="WaveInterpolator" fromField="value_changed" toNode="LeftShoulder" toField="set_rotation"/>
  </Scene>
</X3D>
