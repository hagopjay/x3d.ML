<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='2'/>
  </head>
  <Scene>
    <GeoViewpoint DEF='TorgersenView' description='Torgersen Hall Drone View' geoSystem='"GD" "WE"' position='37.226 -80.4208 775' orientation='1 0 0 -0.5'/>
    
    <GeoLocation DEF='DroneLocation' geoSystem='"GD" "WE"' geoCoords='37.2283 -80.4208 675'>
      <Transform scale='3 3 3'>
        <Shape>
          <Box size='1 1 1'/>
          <Appearance>
            <Material diffuseColor='0.8 0.2 0.2' specularColor='0.5 0.5 0.5'/>
          </Appearance>
        </Shape>
      </Transform>
    </GeoLocation>
    
    <TimeSensor DEF='FlightTimer' cycleInterval='15' loop='true'/>
    
    <GeoPositionInterpolator DEF='DronePath' geoSystem='"GD" "WE"' key='0 0.25 0.5 0.75 1' keyValue='37.2283 -80.4208 675, 37.2293 -80.4208 675, 37.2293 -80.4198 675, 37.2283 -80.4198 675, 37.2283 -80.4208 675'/>
    
    <ROUTE fromNode='FlightTimer' fromField='fraction_changed' toNode='DronePath' toField='set_fraction'/>
    <ROUTE fromNode='DronePath' fromField='geovalue_changed' toNode='DroneLocation' toField='set_geoCoords'/>
  </Scene>
</X3D>