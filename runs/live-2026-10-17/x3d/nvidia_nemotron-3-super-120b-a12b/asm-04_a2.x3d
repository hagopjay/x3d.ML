<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<head>
<component name='Shape' level='2'/>
</head>
<Scene>
<!-- Lamp post -->
<Transform translation='0 0 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0.2 0.2 0.2'/>
</Appearance>
<Cylinder height='5' radius='0.1'/>
</Shape>
</Transform>

<!-- Lamp head -->
<Transform translation='0 5 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0.8 0.8 0.2'/>
</Appearance>
<Sphere radius='0.2'/>
</Shape>
</Transform>

<!-- Point light at top of lamp -->
<Transform translation='0 5.2 0'>
<PointLight intensity='1.0' color='1 1 0.8'/>
</Transform>

<!-- Viewpoint -->
<Viewpoint description='View of street lamp' position='0 3 10' orientation='0 1 0 -0.5'/>
</Scene>
</X3D>