<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Rocket Launch'/>
  </head>
  <Scene>
    <Viewpoint description='Rocket on launch pad with gantry tower' position='0 8 25' orientation='0 1 0 0'/>
    <Background skyColor='0.2 0.6 1.0' groundColor='0.35 0.35 0.35'/>
    <DirectionalLight direction='0 -1 0' intensity='0.9' color='1 1 1'/>

    <!-- Ground -->
    <Transform translation='0 -0.1 0'>
      <Shape>
        <Box size='100 0.2 100'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.3 0.3 0.3'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Launch pad -->
    <Transform translation='0 0 0'>
      <Shape>
        <Box size='6 0.5 6'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.55 0.55 0.55'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Gantry tower -->
    <Transform translation='-4 5 0'>
      <Shape>
        <Box size='1 10 1'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.7 0.7 0.7'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation='-4 8 0'>
      <Shape>
        <Box size='4 0.3 1'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.7 0.7 0.7'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Rocket with flame -->
    <Transform DEF='rocketTransform' translation='0 0.25 0'>
      <Shape>
        <Cylinder height='4' radius='0.6'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.9 0.9 0.9'/>
        </Appearance>
      </Shape>
      <Transform translation='0 2.2 0'>
        <Shape>
          <Cone height='1.5' bottomRadius='0.6'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.2 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 -2.3 0' rotation='0 0 1 3.14159'>
        <Shape>
          <Cone height='1' bottomRadius='0.8'/>
          <Appearance>
            <UnlitMaterial diffuseColor='1 0.4 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <!-- Animation: rocket rises and travels into the distance -->
    <TimeSensor DEF='launchTimer' cycleInterval='10' loop='false' enabled='true'/>
    <PositionInterpolator DEF='launchPath' key='0 0.3 0.7 1' keyValue='0 0.25 0 0 15 0 0 30 -10 0 50 -20'/>

    <ROUTE fromNode='launchTimer' fromField='fraction_changed' toNode='launchPath' toField='set_fraction'/>
    <ROUTE fromNode='launchPath' fromField='value_changed' toNode='rocketTransform' toField='set_translation'/>
  </Scene>
</X3D>