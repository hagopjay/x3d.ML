<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<head>
<meta content='Bouncing ball between y=0 and y=2' name='title'/>
</head>
<Scene>
<Viewpoint description='Ball bouncing up and down with ease at the top' position='0 3 5'/>
<DirectionalLight direction='0 -1 0' intensity='0.8'/>
<Transform DEF='ballTransform' translation='0 0 0'>
<Shape>
<Sphere radius='0.5'/>
<Appearance>
<Material diffuseColor='1 0.5 0'/>
</Appearance>
</Shape>
</Transform>
<TimeSensor DEF='timer' cycleInterval='2' loop='true'/>
<PositionInterpolator DEF='bounce'
key='0 0.1 0.2 0.3 0.4 0.45 0.5 0.55 0.6 0.7 0.8 0.9 1'
keyValue='0 0 0 0 0.5 0 0 1 0 0 1.5 0 0 1.8 0 0 1.95 0 0 2 0 0 1.95 0 0 1.8 0 0 1.5 0 0 1 0 0 0.5 0 0 0 0'/>
<ROUTE fromNode='timer' fromField='fraction_changed' toNode='bounce' toField='set_fraction'/>
<ROUTE fromNode='bounce' fromField='value_changed' toNode='ballTransform' toField='set_translation'/>
</Scene>
</X3D>