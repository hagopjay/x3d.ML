<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Lighthouse on a rocky island at night'/>
  </head>
  <Scene>
    <Background skyColor='0.0 0.0 0.1' groundColor='0.0 0.0 0.1'/>
    <Viewpoint description='Lighthouse on a rocky island at night' position='0 4 12' orientation='0 1 0 -0.2'/>

    <!-- Sea -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Box size='100 0.1 100'/>
        <Appearance>
          <Material diffuseColor='0.0 0.1 0.2'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Island -->
    <Transform translation='0 0.1 0'>
      <Shape>
        <Box size='1.2 0.2 1.2'/>
        <Appearance>
          <Material diffuseColor='0.35 0.25 0.15'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Lighthouse -->
    <Transform>
      <!-- Tapered white tower -->
      <Transform translation='0 2 0'>
        <Shape>
          <Cone bottomRadius='0.5' topRadius='0.25' height='4'/>
          <Appearance>
            <Material diffuseColor='0.95 0.95 1.0'/>
          </Appearance>
        </Shape>
      </Transform>

      <!-- Red bands -->
      <Transform translation='0 1.2 0'>
        <Shape>
          <Cylinder radius='0.45' height='0.1'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 2.8 0'>
        <Shape>
          <Cylinder radius='0.35' height='0.1'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>

      <!-- Lantern room base -->
      <Transform translation='0 4.1 0'>
        <Shape>
          <Cylinder radius='0.55' height='0.2'/>
          <Appearance>
            <Material diffuseColor='0.7 0.7 0.7'/>
          </Appearance>
        </Shape>
      </Transform>

      <!-- Glass lantern room -->
      <Transform translation='0 4.3 0'>
        <Shape>
          <Cylinder radius='0.5' height='0.6'/>
          <Appearance>
            <Material diffuseColor='0.9 0.9 1.0' transparency='0.6'/>
          </Appearance>
        </Shape>
      </Transform>

      <!-- Sweeping beam -->
      <Transform DEF='BeamTransform' translation='0 4.6 0' rotation='0 1 0 0'>
        <Shape>
          <Box size='0.02 0.02 20'/>
          <Appearance>
            <Material emissiveColor='1.0 1.0 0.5' diffuseColor='0 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <!-- Animation: beam sweeps once every 6 seconds -->
    <TimeSensor DEF='BeamClock' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='BeamRot'
      key='0 0.25 0.5 0.75 1'
      keyValue='0 1 0 0 0 1 0 1.57079632679 0 1 0 3.14159265359 0 1 0 4.71238898038 0 1 0 6.28318530718'/>
    <ROUTE fromNode='BeamClock' fromField='fraction_changed' toNode='BeamRot' toField='set_fraction'/>
    <ROUTE fromNode='BeamRot' fromField='value_changed' toNode='BeamTransform' toField='set_rotation'/>
  </Scene>
</X3D>