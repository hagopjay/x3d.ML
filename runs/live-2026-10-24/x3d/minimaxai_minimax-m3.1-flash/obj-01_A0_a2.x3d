                            metallic='0'
                            roughness='0.35'/>
        </Appearance>
        <Sphere radius='1' solid='true'/>
      </Shape>
    </Transform>
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.35 0.35 0.35'
                            metallic='0'
                            roughness='0.9'/>
        </Appearance>
