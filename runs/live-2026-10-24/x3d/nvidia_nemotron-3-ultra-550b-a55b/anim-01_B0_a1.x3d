<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Blue rotating cube' position='0 0 10'/>
    <Transform DEF='CubeTransform'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='TS' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='OI' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307179586'/>
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='OI' toField='set_fraction'/>
    <ROUTE fromNode='OI' fromField='value_changed' toNode='CubeTransform' toField='rotation'/>
  </Scene>
</X3D>