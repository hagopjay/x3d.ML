<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='1'/>
  </head>
  <Scene>
    <GeoViewpoint description='Virginia Tech Drillfield Flagpole' geoSystem='"GD" "WE"' position='37.22813 -80.4234 632'/>
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2284 -80.4234 630'>
      <Transform translation='0 5 0'>
        <Shape>
          <Cylinder height='10' radius='0.1'/>
          <Appearance>
            <Material diffuseColor='0.85 0.85 0.9'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 9.4 0'>
        <Transform DEF='FlagTransform'>
          <Transform translation='1.05 0 0'>
            <Shape>
              <Box size='2 1.2 0.02'/>
              <Appearance>
                <Material diffuseColor='0.6 0 0'/>
              </Appearance>
            </Shape>
          </Transform>
        </Transform>
      </Transform>
    </GeoLocation>
    <TimeSensor DEF='WindTimer' cycleInterval='2.5' loop='true'/>
    <OrientationInterpolator DEF='WindFlapper' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0.0, 0 1 0 0.15, 0 1 0 0.0, 0 1 0 -0.15, 0 1 0 0.0'/>
    <ROUTE fromNode='WindTimer' fromField='fraction_changed' toNode='WindFlapper' toField='set_fraction'/>
    <ROUTE fromNode='WindFlapper' fromField='value_changed' toNode='FlagTransform' toField='set_rotation'/>
  </Scene>
</X3D>