<X3D profile="Immersive" version="4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <Scene>
    <Viewpoint description="Newton's Cradle" position="0 1.5 3" orientation="0 1 0 3.1416"/>
    <Background skyColor="0.5 0.5 0.5"/>
    
    <!-- Materials -->
    <PhysicalMaterial DEF="WireMat" baseColor="0.05 0.05 0.05" roughness="0.9" metallic="0"/>
    <PhysicalMaterial DEF="BallMat" baseColor="0.8 0.8 0.9" roughness="0.1" metallic="1"/>
    
    <!-- Frame with TouchSensor -->
    <Transform translation="0 2 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial USE="WireMat"/>
        </Appearance>
        <Box size="1.02 0.02 0.02"/>
      </Shape>
      <TouchSensor DEF="FrameTouch"/>
    </Transform>
    
    <!-- Pendulum 0 (leftmost, animated) -->
    <Transform DEF="Pendulum0" center="-0.44 2 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial USE="WireMat"/>
        </Appearance>
        <Cylinder radius="0.005" height="1.5"/>
      </Shape>
      <Transform translation="0 -1.5 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial USE="BallMat"/>
          </Appearance>
          <Sphere radius="0.1"/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Pendulum 1 (static) -->
    <Transform center="-0.22 2 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial USE="WireMat"/>
        </Appearance>
        <Cylinder radius="0.005" height="1.5"/>
      </Shape>
      <Transform translation="0 -1.5 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial USE="BallMat"/>
          </Appearance>
          <Sphere radius="0.1"/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Pendulum 2 (static) -->
    <Transform center="0 2 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial USE="WireMat"/>
        </Appearance>
        <Cylinder radius="0.005" height="1.5"/>
      </Shape>
      <Transform translation="0 -1.5 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial USE="BallMat"/>
          </Appearance>
          <Sphere radius="0.1"/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Pendulum 3 (static) -->
    <Transform center="0.22 2 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial USE="WireMat"/>
        </Appearance>
        <Cylinder radius="0.005" height="1.5"/>
      </Shape>
      <Transform translation="0 -1.5 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial USE="BallMat"/>
          </Appearance>
          <Sphere radius="0.1"/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Pendulum 4 (rightmost, animated) -->
    <Transform DEF="Pendulum4" center="0.44 2 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial USE="WireMat"/>
        </Appearance>
        <Cylinder radius="0.005" height="1.5"/>
      </Shape>
      <Transform translation="0 -1.5 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial USE="BallMat"/>
          </Appearance>
          <Sphere radius="0.1"/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Animation -->
    <TimeSensor DEF="Clock" cycleInterval="4" loop="true"/>
    <OrientationInterpolator DEF="LeftSwing"
      key="0 0.25 0.5 0.75 1"
      keyValue="0 0 0 1  0.2474 0 0 0.9689  0 0 0 1  0 0 0 1  0 0 0 1"/>
    <OrientationInterpolator DEF="RightSwing"
      key="0 0.25 0.5 0.75 1"
      keyValue="0 0 0 1  0 0 0 1  0 0 0 1  -0.2474 0 0 0.9689  0 0 0 1"/>
    
    <!-- Routes -->
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="LeftSwing" toField="set_fraction"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="RightSwing" toField="set_fraction"/>
    <ROUTE fromNode="LeftSwing" fromField="value_changed" toNode="Pendulum0" toField="set_rotation"/>
    <ROUTE fromNode="RightSwing" fromField="value_changed" toNode="Pendulum4" toField="set_rotation"/>
    <ROUTE fromNode="FrameTouch" fromField="touchTime" toNode="Clock" toField="set_startTime"/>
  </Scene>
</X3D>