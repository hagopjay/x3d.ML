<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Interpolation' level='1'/>
    <component name='Time' level='1'/>
    <component name='Shape' level='1'/>
    <component name='Grouping' level='1'/>
    <component name='Geometry3D' level='1'/>
    <component name='Navigation' level='1'/>
    <component name='EnvironmentalEffects' level='1'/>
  </head>
  <Scene>
    <Viewpoint description='Launch Pad View' position='0 12 45' orientation='1 0 0 -0.05'/>
    <Background skyColor='0.4 0.6 0.9' groundColor='0.2 0.5 0.2'/>

    <Transform translation='0 0 0'>
      <Shape>
        <Box size='100 0.1 100'/>
        <Appearance>
          <Material diffuseColor='0.2 0.5 0.2'/>
        </Appearance>
      </Shape>
    </Transform>

    <Transform translation='0 0.5 0'>
      <Shape>
        <Cylinder radius='12' height='1'/>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
      </Shape>
    </Transform>

    <Transform translation='7 15 0'>
      <Shape>
        <Box size='3 30 3'/>
        <Appearance>
          <Material diffuseColor='0.7 0.2 0.1'/>
        </Appearance>
      </Shape>
      <Transform translation='-4 10 0'>
        <Shape>
          <Box size='5 0.5 1'/>
          <Appearance>
            <Material diffuseColor='0.7 0.2 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='-4 0 0'>
        <Shape>
          <Box size='5 0.5 1'/>
          <Appearance>
            <Material diffuseColor='0.7 0.2 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <Transform DEF='Rocket' translation='0 2 0'>
      <Transform translation='0 6 0'>
        <Shape>
          <Cylinder radius='1.5' height='12'/>
          <Appearance>
            <Material diffuseColor='0.9 0.9 0.9'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 13.5 0'>
        <Shape>
          <Cone bottomRadius='1.5' height='3'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='1.5 2 0'>
        <Shape>
          <Box size='1.5 3 0.2'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='-1.5 2 0'>
        <Shape>
          <Box size='1.5 3 0.2'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 2 1.5'>
        <Shape>
          <Box size='0.2 3 1.5'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 2 -1.5'>
        <Shape>
          <Box size='0.2 3 1.5'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 -2 0' rotation='1 0 0 3.14159'>
        <Shape>
          <Cone bottomRadius='1.2' height='4'/>
          <Appearance>
            <Material diffuseColor='1 0.5 0' emissiveColor='0.8 0.4 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <TimeSensor DEF='FlightClock' cycleInterval='10' loop='true' autoStart='true'/>
    <PositionInterpolator DEF='RocketPath' key='0 0.1 0.3 0.6 1' keyValue='0 2 0, 0 8 0, 0 50 -20, 0 200 -100, 0 800 -400'/>
    <PositionInterpolator DEF='RocketScale' key='0 0.3 0.6 1' keyValue='1 1 1, 0.8 0.8 0.8, 0.4 0.4 0.4, 0.05 0.05 0.05'/>

    <ROUTE fromNode='FlightClock' fromField='fraction_changed' toNode='RocketPath' toField='set_fraction'/>
    <ROUTE fromNode='RocketPath' fromField='value_changed' toNode='Rocket' toField='translation'/>
    <ROUTE fromNode='FlightClock' fromField='fraction_changed' toNode='RocketScale' toField='set_fraction'/>
    <ROUTE fromNode='RocketScale' fromField='value_changed' toNode='Rocket' toField='scale'/>
  </Scene>
</X3D>