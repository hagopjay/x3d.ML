<Scene>
<Viewpoint description='HAnim Figure' position='0 2 5'/>
<TouchSensor DEF='TouchSensor' description='Touch to wave'/>
<TimeSensor DEF='TimeSensor' cycleInterval='1' loop='true'/>
<OrientationInterpolator DEF='WaveInterpolator' key='0 1' keyValue='0 0 1 0 0 1 0 0'/>
<ROUTE fromNode='TouchSensor' fromField='touchTime' toNode='TimeSensor' toField='startTime'/>
<ROUTE fromNode='TimeSensor' fromField='fraction_changed' toNode='WaveInterpolator' toField='set_fraction'/>
<HAnimHumanoid DEF='HAnimFigure' version='2.0'/>
<ROUTE fromNode='WaveInterpolator' fromField='value' toNode='HAnimFigure' toField='rotation'/>
</Scene>
</X3D>