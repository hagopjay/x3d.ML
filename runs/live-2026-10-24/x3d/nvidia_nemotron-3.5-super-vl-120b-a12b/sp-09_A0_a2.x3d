<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
 <head>
  <meta name='title' content='Medieval Castle'/>
 </head>
 <Scene>
  <Background skyColor='0.5 0.7 1.0' groundColor='0.1 0.5 0.1'/>
  <DirectionalLight intensity='0.9' direction='0.2 -1 0.3'/>
  <Viewpoint position='0 12 35' orientation='0 1 0 0' description='Medieval castle with four corner towers, crenellated walls, gatehouse, and red flag.'/>

  <!-- Green lawn -->
  <Transform translation='0 0 0'>
   <Shape>
    <Box size='100 0.2 100'/>
    <Appearance>
     <PhysicalMaterial baseColor='0.2 0.65 0.2' roughness='0.9'/>
    </Appearance>
   </Shape>
  </Transform>

  <!-- Back wall: defines reusable wall box and appearance -->
  <Transform translation='0 2.5 -10'>
   <Shape>
    <Box DEF='WallBox' size='4 5 0.5'/>
    <Appearance DEF='WallAppearance'>
     <PhysicalMaterial baseColor='0.65 0.6 0.55' roughness='0.95'/>
    </Appearance>
   </Shape>
  </Transform>
  <Transform translation='-2 5.5 -10'>
   <Shape>
    <Box DEF='CrenelBox' size='0.8 1 0.8'/>
    <Appearance USE='WallAppearance'/>
   </Shape>
  </Transform>
  <Transform translation