  <Scene>
    <Viewpoint description='HAnim Wave Demo' position='0 1.5 3' orientation='1 0 0 0'/>
    <HAnimHumanoid DEF='WaveFigure' version='2.0'>
      <HAnimJoint DEF='humanoid_root' name='humanoid_root' center='0 1.0 0'>
        <HAnimSegment DEF='torso' name='torso'>
          <Transform translation='0 0 0'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.8 0.6 0.4'/>
              </Appearance>
              <Box size='0.5 0.8 0.2'/>
            </Shape>
          </Transform>
          <HAnimJoint DEF='l_shoulder' name='l_shoulder' center='-0.2 0.8 0'>
            <HAnimSegment DEF='l_upper_arm' name='l_upper_arm'>
              <Transform translation='-0.2 0 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.8 0.6 0.4'/>
                  </Appearance>
                  <Box size='0.15 0.4 0.15'/>
                </Shape>
              </Transform>
              <HAnimJoint DEF='l_elbow' name='l_elbow' center='-0.2 0.4 0'>
                <HAnimSegment DEF='l_lower_arm' name='l_lower_arm'>
                  <Transform translation='-0.2 0 0'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.8 0.6 0.4'/>
                      </Appearance>
                      <Box size='0.15 0.4 0.15'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimSegment>
          </HAnimJoint>
        </HAnimSegment>
      </HAnimJoint>
    </HAnimHumanoid>
    <TouchSensor DEF='waveTouch' description='Touch to wave'/>
    <TimeSensor DEF='waveClock' cycleTime='2' loop='true'/>
    <OrientationInterpolator DEF='waveInterp' key='0 0.5 1' keyValue='0 1 0 0 0 1 0 0 0 1 0 0'/>
    <ROUTE fromNode='waveTouch' fromField='isOver' toNode='waveClock' toField='startTime'/>
    <ROUTE fromNode='waveClock' fromField='fraction_changed' toNode='waveInterp' toField='set_fraction'/>
    <ROUTE fromNode='waveInterp' fromField='value_changed' toNode='humanoid_root' toField='set_rotation'/>
  </Scene>
</X3D>