<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='A blue cube rotating continuously about its vertical axis' position='0 0 6' fieldOfView='0.785398'/>
    <Background color='0.08 0.12 0.2'/>
    <DirectionalLight direction='0 -1 -1' intensity='0.8'/>
    <Transform DEF='CubeTransform' rotation='0 1 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 0 1' specularColor='0.2 0.2 0.2'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='CubeRotation' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.5707963267948966 0 1 0 3.141592653589793 0 1 0 4.71238898038469 0 1 0 6.283185307179586'/>
    <ROUTE Clock.fraction_changed TO CubeRotation.set_fraction/>
    <ROUTE CubeRotation.value_changed TO CubeTransform.rotation/>
  </Scene>
</X3D>