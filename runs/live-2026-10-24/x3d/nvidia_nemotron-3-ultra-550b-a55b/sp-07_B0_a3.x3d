<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Rotating DNA Double Helix'/>
    <meta name='description' content='Two spiral strands with base-pair rungs rotating about long axis'/>
  </head>
  <Scene>
    <Viewpoint DEF='VP' position='0 0 10' description='DNA Double Helix'/>
    <TimeSensor DEF='TS' cycleInterval='10' loop='true'/>
    <OrientationInterpolator DEF='OI' key='0 1' keyValue='0 1 0 0  0 1 0 6.28318530718'/>
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='OI' toField='set_fraction'/>
    <ROUTE fromNode='OI' fromField='value_changed' toNode='Helix' toField='rotation'/>
    <!-- Library of reusable nodes (not rendered) -->
    <Switch whichChoice='-1'>
      <Shape DEF='BlueSphereShape' containerField='choice'>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
        <Sphere radius='0.05'/>
      </Shape>
      <Shape DEF='OrangeSphereShape' containerField='choice'>
        <Appearance>
          <Material diffuseColor='1 0.5 0'/>
        </Appearance>
        <Sphere radius='0.05'/>
      </Shape>
      <Shape DEF='CylinderShape' containerField='choice'>
        <Appearance>
          <Material diffuseColor='0.5 0.5 0.5'/>
        </Appearance>
        <Cylinder radius='0.02' height='1.0'/>
      </Shape>
      <Transform DEF='RungInner' rotation='0 0 1 -1.57079632679' containerField='choice'>
        <Shape USE='CylinderShape'/>
      </Transform>
    </Switch>
    <!-- Animated helix -->
    <Transform DEF='Helix'>
      <!-- Strand A (blue) spheres -->
      <Transform translation='0.5 -2.0 0.0'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 -1.8 0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 -1.6 0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 -1.4 0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 -1.2 0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.5 -1.0 0.0'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 -0.8 -0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 -0.6 -0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 -0.4 -0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 -0.2 -0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.5 0.0 0.0'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 0.2 0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 0.4 0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 0.6 0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 0.8 0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.5 1.0 0.0'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 1.2 -0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 1.4 -0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 1.6 -0.4755282581475768'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 1.8 -0.2938926261462366'>
        <Shape USE='BlueSphereShape'/>
      </Transform>
      <!-- Strand B (orange) spheres -->
      <Transform translation='-0.5 -2.0 0.0'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 -1.8 -0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 -1.6 -0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 -1.4 -0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 -1.2 -0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.5 -1.0 0.0'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 -0.8 0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 -0.6 0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 -0.4 0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 -0.2 0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.5 0.0 0.0'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 0.2 -0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 0.4 -0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 0.6 -0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 0.8 -0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.5 1.0 0.0'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.4045084971874737 1.2 0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='0.1545084971874737 1.4 0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.1545084971874737 1.6 0.4755282581475768'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <Transform translation='-0.4045084971874737 1.8 0.2938926261462366'>
        <Shape USE='OrangeSphereShape'/>
      </Transform>
      <!-- Base-pair rungs -->
      <Transform translation='0 -2.0 0' rotation='0 1 0 0'>
        <Transform USE='RungInner'/>
      </Transform>
      <Transform translation='0 -1.8 0' rotation='0 1 0 0.6283185307179586'>
        <Transform USE='RungInner'/>
      </Transform>
      <Transform translation='0 -1.6 0' rotation='0 1 0 1.2566370614359172'>
        <