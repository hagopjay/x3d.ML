<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
  </head>
  <Scene>
    <Viewpoint DEF="MainView" description="Red PBR sphere on grey ground" position="0 2 5"/>
    <DirectionalLight direction="0 -1 -1" intensity="0.8" color="1 1 1"/>
    <Transform translation="0 0 0">
      <Shape>
        <Sphere radius="1"/>
        <Appearance>
          <PhysicalMaterial DEF="RedPBR" baseColor="1 0 0" roughness="0.3" metallic="0.5"/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation="0 -0.5 0">
      <Shape>
        <Box size="20 0.1 20"/>
        <Appearance>
          <PhysicalMaterial DEF="GreyGround" baseColor="0.5 0.5 0.5" roughness="0.8" metallic="0.0"/>
        </Appearance>
      </Shape>
    </Transform>
  </Scene>
</X3D>