<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='1'/>
    <component name='Shape' level='1'/>
  </head>
  <Scene>
    <GeoOrigin geoSystem='"GD" "WE"' geoCoords='40.0 -88.0 0'/>
    <!-- Building A -->
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='40.0001 -88.0001 10'>
      <Transform>
        <Shape>
          <Sphere radius='0.5'/>
          <Appearance>
            <UnlitMaterial emissiveColor='1 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 5 0'>
        <Shape>
          <Text string='Building A'>
            <fontStyle>
              <FontStyle family='SANS' size='1.0'/>
            </fontStyle>
          </Text>
          <Appearance>
            <UnlitMaterial emissiveColor='0 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem='"GD" "WE"' position='40.0001 -88.0001 10' description='Building A'/>
    <!-- Building B -->
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='40.0002 -88.0002 15'>
      <Transform>
        <Shape>
          <Sphere radius='0.5'/>
          <Appearance>
            <UnlitMaterial emissiveColor='1 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 5 0'>
        <Shape>
          <Text string='Building B'>
            <fontStyle>
              <FontStyle family='SANS' size='1.0'/>
            </fontStyle>
          </Text>
          <Appearance>
            <UnlitMaterial emissiveColor='0 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem='"GD" "WE"' position='40.0002 -88.0002 15' description='Building B'/>
    <!-- Building C -->
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='40.0003 -88.0003 20'>
      <Transform>
        <Shape>
          <Sphere radius='0.5'/>
          <Appearance>
            <UnlitMaterial emissiveColor='1 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 5 0'>
        <Shape>
          <Text string='Building C'>
            <fontStyle>
              <FontStyle family='SANS' size='1.0'/>
            </fontStyle>
          </Text>
          <Appearance>
            <UnlitMaterial emissiveColor='0 0 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem='"GD" "WE"' position='40.0003 -88.0003 20' description='Building C'/>
    <!-- Overview viewpoint -->
    <Viewpoint description='Campus overview' position='0 0 100'/>
  </Scene>
</X3D>