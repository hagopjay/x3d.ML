<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="HAnim" level="2"/>
  </head>
  <Scene>
    <Viewpoint position="0 1.6 0" description="Eye level"/>
    <HAnimHumanoid version="2.0" name="Humanoid">
      <HAnimJoint name="Hips" center="0 0 0" ulimit="0 0 0" llimit="0 0 0" stiffness="0 0 0" containerField="skeleton">
        <HAnimSegment name="HipsSegment"/>
        <HAnimJoint name="RightShoulder" center="0.1 0.1 0" ulimit="0 0 0" llimit="0 0 0" stiffness="0 0 0">
          <HAnimSegment name="RightUpperArm"/>
          <HAnimJoint name="RightElbow" center="0 0 0" ulimit="0 0 0" llimit="0 0 0" stiffness="0 0 0">
            <HAnimSegment name="RightLowerArm"/>
            <HAnimJoint name="RightWrist" center="0 0 0" ulimit="0 0 0" llimit="0 0 0" stiffness="0 0 0">
              <HAnimSegment name="RightHand">
                <HAnimSite name="RightHandSite" translation="0 0 0" rotation="0 0 1 0">
                  <Shape DEF="RightHandSphere">
                    <Sphere radius="0.05"/>
                    <Appearance>
                      <Material diffuseColor="1 0 0"/>
                    </Appearance>
                  </Shape>
                </HAnimSite>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>
    </HAnimHumanoid>
  </Scene>
</X3D>