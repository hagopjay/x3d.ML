<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Minimal HAnim 2.0 Humanoid'/>
    <meta name='description' content='Humanoid with humanoid_root, sacroiliac, l_hip, r_hip joints and box segments'/>
  </head>
  <Scene>
    <Viewpoint position='0 1.5 3' description='Minimal HAnim 2.0 Humanoid'/>
    <Background skyColor='0.5 0.7 0.9'/>
    <HAnimHumanoid version='2.0' name='Humanoid'>
      <HAnimJoint DEF='humanoid_root' name='humanoid_root' center='0 1 0' ulimit='0 0 0' llimit='0 0 0'>
        <HAnimSegment DEF='humanoid_root_seg' name='humanoid_root'>
          <Transform translation='0 1 0'>
            <Shape>
              <Box size='0.2 0.2 0.2'/>
              <Appearance>
                <Material diffuseColor='0.8 0.2 0.2'/>
              </Appearance>
            </Shape>
          </Transform>
        </HAnimSegment>
        <HAnimJoint DEF='sacroiliac' name='sacroiliac' center='0 0.9 0' ulimit='0 0 0' llimit='0 0 0'>
          <HAnimSegment DEF='sacroiliac_seg' name='sacroiliac'>
            <Transform translation='0 0.9 0'>
              <Shape>
                <Box size='0.18 0.18 0.18'/>
                <Appearance>
                  <Material diffuseColor='0.2 0.8 0.2'/>
                </Appearance>
              </Shape>
            </Transform>
          </HAnimSegment>
          <HAnimJoint DEF='l_hip' name='l_hip' center='-0.1 0.85 0' ulimit='0 0 0' llimit='0 0 0'>
            <HAnimSegment DEF='l_hip_seg' name='l_hip'>
              <Transform translation='-0.1 0.85 0'>
                <Shape>
                  <Box size='0.15 0.15 0.15'/>
                  <Appearance>
                    <Material diffuseColor='0.2 0.2 0.8'/>
                  </Appearance>
                </Shape>
              </Transform>
            </HAnimSegment>
          </HAnimJoint>
          <HAnimJoint DEF='r_hip' name='r_hip' center='0.1 0.85 0' ulimit='0 0 0' llimit='0 0 0'>
            <HAnimSegment DEF='r_hip_seg' name='r_hip'>
              <Transform translation='0.1 0.85 0'>
                <Shape>
                  <Box size='0.15 0.15 0.15'/>
                  <Appearance>
                    <Material diffuseColor='0.8 0.8 0.2'/>
                  </Appearance>
                </Shape>
              </Transform>
            </HAnimSegment>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>
    </HAnimHumanoid>
  </Scene>
</X3D>