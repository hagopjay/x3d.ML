<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <meta name="title" content="Carousel"/>
    <meta name="description" content="Rotating carousel with eight horses moving up and down alternately"/>
  </head>
  <Scene>
    <Viewpoint position="0 5 15" orientation="0 1 0 -0.3" description="Carousel view"/>
    <!-- Rotation animation -->
    <TimeSensor DEF="rotTimer" cycleInterval="10" loop="true"/>
    <OrientationInterpolator DEF="rotInterp" key="0 1" keyValue="0 1 0 0  0 1 0 6.2831853"/>
    <ROUTE fromNode="rotTimer" fromField="fraction_changed" toNode="rotInterp" toField="set_fraction"/>
    <ROUTE fromNode="rotInterp" fromField="value_changed" toNode="carousel" toField="set_rotation"/>
    <!-- Vertical animation -->
    <TimeSensor DEF="vertTimer" cycleInterval="4" loop="true"/>
    <PositionInterpolator DEF="evenPos" key="0 0.5 1" keyValue="0 0.5 0  0 1 0  0 0.5 0"/>
    <PositionInterpolator DEF="oddPos" key="0 0.5 1" keyValue="0 1 0  0 0.5 0  0 1 0"/>
    <ROUTE fromNode="vertTimer" fromField="fraction_changed" toNode="evenPos" toField="set_fraction"/>
    <ROUTE fromNode="vertTimer" fromField="fraction_changed" toNode="oddPos" toField="set_fraction"/>
    <ROUTE fromNode="evenPos" fromField="value_changed" toNode="evenHorses" toField="set_translation"/>
    <ROUTE fromNode="oddPos" fromField="value_changed" toNode="oddHorses" toField="set_translation"/>
    <!-- Carousel root rotating -->
    <Transform DEF="carousel">
      <!-- Platform -->
      <Transform translation="0 0.1 0">
        <Shape>
          <Appearance>
            <Material diffuseColor="0.6 0.4 0.2"/>
          </Appearance>
          <Cylinder radius="3" height="0.2"/>
        </Shape>
      </Transform>
      <!-- Conical roof -->
      <Transform translation="0 1.2 0">
        <Shape>
          <Appearance>
            <Material diffuseColor="0.8 0.2 0.2"/>
          </Appearance>
          <Cone bottomRadius="3.5" height="2"/>
        </Shape>
      </Transform>
      <!-- Even horses (move up first) -->
      <Transform DEF="evenHorses">
        <Transform translation="2.5 0 0">
          <USE node="horseModel"/>
        </Transform>
        <Transform translation="0 0 2.5">
          <USE node="horseModel"/>
        </Transform>
        <Transform translation="-2.5 0 0">
          <USE node="horseModel"/>
        </Transform>
        <Transform translation="0 0 -2.5">
          <USE node="horseModel"/>
        </Transform>
      </Transform>
      <!-- Odd horses (move down first) -->
      <Transform DEF="oddHorses">
        <Transform translation="1.7678 0 1.7678">
          <USE node="horseModel"/>
        </Transform>
        <Transform translation="-1.7678 0 1.7678">
          <USE node="horseModel"/>
        </Transform>
        <Transform translation="-1.7678 0 -1.7678">
          <USE node="horseModel"/>
        </Transform>
        <Transform translation="1.7678 0 -1.7678">
          <USE node="horseModel"/>
        </Transform>
      </Transform>
      <!-- Horse model definition -->
      <Group DEF="horseModel">
        <!-- Pole -->
        <Transform translation="0 0.75 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.3 0.3 0.3"/>
            </Appearance>
            <Cylinder radius="0.05" height="1.5"/>
          </Shape>
        </Transform>
        <!-- Body -->
        <Transform translation="0 1.8 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.8 0.5 0.2"/>
            </Appearance>
            <Box size="0.4 0.6 0.8"/>
          </Shape>
        </Transform>
        <!-- Head -->
        <Transform translation="0 2.25 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.6 0.3 0.1"/>
            </Appearance>
            <Cylinder radius="0.15" height="0.3"/>
          </Shape>
        </Transform>
      </Group>
    </Transform>
  </Scene>
</X3D>
