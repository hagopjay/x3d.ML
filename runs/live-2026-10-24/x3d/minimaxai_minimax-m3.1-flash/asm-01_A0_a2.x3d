<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Simple House'/>
    <component name='Shape' level='1'/>
  </head>
  <Scene>
    <WorldInfo title='Simple House'/>
    <Background bgcolor='0.75 0.85 1'/>
    <Viewpoint description='Front view of a simple house with a box body, pyramid roof, door, and two windows'
                position='6 4.5 8'
                orientation='-0.8 0 0.6 1.835'
                centerOfRotation='0 1.8 0'
                fieldOfView='0.785'/>
    <DirectionalLight direction='0 -1 -0.4' intensity='0.8' color='1 1 1'/>
    <Group>
      <Transform translation='0 -0.05 0'>
        <Shape>
          <Appearance>
            <UnlitMaterial emissiveColor='0.35 0.45 0.3'/>
          </Appearance>
          <Box size='20 0.1 20' solid='true'/>
        </Shape>
      </Transform>
      <Transform translation='0 1.25 0'>
        <Shape>
          <Appearance>
            <UnlitMaterial emissiveColor='0.88 0.76 0.58'/>
          </Appearance>
          <Box DEF='HouseBody' size='4 2.5 3' solid='true'/>
        </Shape>
      </Transform>
      <Shape>
        <Appearance>
          <UnlitMaterial emissiveColor='0.65 0.18 0.12'/>
        </Appearance>
        <IndexedFaceSet DEF='PyramidRoof'
                        coordIndex='0 1 2 3 -1 3 2 4 -1 1 0 4 -1 2 1 4 -1 0 3 4 -1'
                        solid='true'
                        creaseAngle='0.5'>
          <Coordinate point='-2.4 2.5 -1.9  2.4 2.5 -1.9  2.4 2.5 1.9  -2.4 2.5 1.9  0 4.3 0'/>
        </IndexedFaceSet>
      </Shape>
      <Transform translation='0 0.9 1.55'>
        <Shape>
          <Appearance>
            <UnlitMaterial emissiveColor='0.35 0.16 0.07'/>
          </Appearance>
          <Box DEF='FrontDoor' size='0.9 1.8 0.1' solid='true'/>
        </Shape>
      </Transform>
      <Transform translation='-1.25 1.45 1.54'>
        <Shape>
          <Appearance>
            <UnlitMaterial emissiveColor='0.25 0.55 0.85'/>
          </Appearance>
          <Box DEF='LeftWindow' size='0.9 0.8 0.08' solid='true'/>
        </Shape>
      </Transform>
      <Transform translation='1.25 1.45 1.54'>
        <Shape>
          <Appearance>
            <UnlitMaterial emissiveColor='0.25 0.55 0.85'/>
          </Appearance>
          <Box DEF='RightWindow' size='0.9 0.8 0.08' solid='true'/>
        </Shape>
      </Transform>
    </Group>
    <Switch whichChoice='-1'>
      <Shape>
        <Box USE='HouseBody'/>
      </Shape>
      <Shape>
        <IndexedFaceSet USE='PyramidRoof'/>
      </Shape>
      <Shape>
        <Box USE='FrontDoor'/>
      </Shape>
      <Shape>
        <Box USE='LeftWindow'/>
      </Shape>
      <Shape>
        <Box USE='RightWindow'/>
      </Shape>
    </Switch>
  </Scene>
</X3D>