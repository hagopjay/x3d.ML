<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component level='1' name='HAnim'/>
  </head>
  <Scene>
    <WorldInfo title='Two HAnim Humanoids Sharing Joint Hierarchy'/>
    <Viewpoint description='Two HAnim Humanoids' position='0 1.2 3.8'/>
    <DirectionalLight direction='0.4 -0.8 -0.5' intensity='0.9'/>
    <DirectionalLight direction='-0.4 -0.4 0.8' intensity='0.4'/>

    <!-- Ground Floor -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.25 0.28 0.32' shininess='0.1'/>
        </Appearance>
        <Box size='6 0.1 4'/>
      </Shape>
    </Transform>

    <!-- First Humanoid: Light Skin Tone (Defines Shared Skeleton) -->
    <HAnimHumanoid DEF='Humanoid_Light' name='Humanoid_Light' version='2.0' translation='-0.8 0 0'>
      <HAnimJoint DEF='Shared_humanoid_root' name='humanoid_root' center='0 0.9 0' containerField='skeleton'>
        <HAnimJoint DEF='Shared_sacrum' name='sacrum' center='0 0.9 0'>
          <HAnimJoint DEF='Shared_spine1' name='spine_1' center='0 1.05 0'>
            <HAnimJoint DEF='Shared_spine2' name='spine_2' center='0 1.2 0'>
              <HAnimJoint DEF='Shared_neck' name='neck' center='0 1.38 0'>
                <HAnimJoint DEF='Shared_skullbase' name='skullbase' center='0 1.48 0'/>
              </HAnimJoint>
              <HAnimJoint DEF='Shared_l_shoulder' name='l_shoulder' center='0.24 1.3 0'>
                <HAnimJoint DEF='Shared_l_elbow' name='l_elbow' center='0.44 1.3 0'/>
              </HAnimJoint>
              <HAnimJoint DEF='Shared_r_shoulder' name='r_shoulder' center='-0.24 1.3 0'>
                <HAnimJoint DEF='Shared_r_elbow' name='r_elbow' center='-0.44 1.3 0'/>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>
          <HAnimJoint DEF='Shared_l_hip' name='l_hip' center='0.12 0.85 0'>
            <HAnimJoint DEF='Shared_l_knee' name='l_knee' center='0.12 0.45 0'/>
          </HAnimJoint>
          <HAnimJoint DEF='Shared_r_hip' name='r_hip' center='-0.12 0.85 0'>
            <HAnimJoint DEF='Shared_r_knee' name='r_knee' center='-0.12 0.45 0'/>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>

      <!-- Light Skin Geometry -->
      <Transform containerField='skin'>
        <!-- Head -->
        <Transform translation='0 1.5 0'>
          <Shape>
            <Appearance>
              <Material DEF='SkinLight' diffuseColor='0.88 0.70 0.56' shininess='0.2'/>
            </Appearance>
            <Sphere radius='0.13'/>
          </Shape>
        </Transform>
        <!-- Torso -->
        <Transform translation='0 1.05 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinLight'/>
            </Appearance>
            <Box size='0.36 0.5 0.2'/>
          </Shape>
        </Transform>
        <!-- Left Arm -->
        <Transform translation='0.24 1.05 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinLight'/>
            </Appearance>
            <Cylinder height='0.44' radius='0.05'/>
          </Shape>
        </Transform>
        <!-- Right Arm -->
        <Transform translation='-0.24 1.05 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinLight'/>
            </Appearance>
            <Cylinder height='0.44' radius='0.05'/>
          </Shape>
        </Transform>
        <!-- Left Leg -->
        <Transform translation='0.12 0.45 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinLight'/>
            </Appearance>
            <Cylinder height='0.75' radius='0.065'/>
          </Shape>
        </Transform>
        <!-- Right Leg -->
        <Transform translation='-0.12 0.45 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinLight'/>
            </Appearance>
            <Cylinder height='0.75' radius='0.065'/>
          </Shape>
        </Transform>
      </Transform>
    </HAnimHumanoid>

    <!-- Second Humanoid: Dark Skin Tone (Shares Skeleton Hierarchy via USE) -->
    <HAnimHumanoid DEF='Humanoid_Dark' name='Humanoid_Dark' version='2.0' translation='0.8 0 0'>
      <HAnimJoint USE='Shared_humanoid_root' containerField='skeleton'/>

      <!-- Dark Skin Geometry -->
      <Transform containerField='skin'>
        <!-- Head -->
        <Transform translation='0 1.5 0'>
          <Shape>
            <Appearance>
              <Material DEF='SkinDark' diffuseColor='0.38 0.24 0.16' shininess='0.2'/>
            </Appearance>
            <Sphere radius='0.13'/>
          </Shape>
        </Transform>
        <!-- Torso -->
        <Transform translation='0 1.05 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinDark'/>
            </Appearance>
            <Box size='0.36 0.5 0.2'/>
          </Shape>
        </Transform>
        <!-- Left Arm -->
        <Transform translation='0.24 1.05 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinDark'/>
            </Appearance>
            <Cylinder height='0.44' radius='0.05'/>
          </Shape>
        </Transform>
        <!-- Right Arm -->
        <Transform translation='-0.24 1.05 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinDark'/>
            </Appearance>
            <Cylinder height='0.44' radius='0.05'/>
          </Shape>
        </Transform>
        <!-- Left Leg -->
        <Transform translation='0.12 0.45 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinDark'/>
            </Appearance>
            <Cylinder height='0.75' radius='0.065'/>
          </Shape>
        </Transform>
        <!-- Right Leg -->
        <Transform translation='-0.12 0.45 0'>
          <Shape>
            <Appearance>
              <Material USE='SkinDark'/>
            </Appearance>
            <Cylinder height='0.75' radius='0.065'/>
          </Shape>
        </Transform>
      </Transform>
    </HAnimHumanoid>

    <!-- Animation for Joint Motion on Shared Hierarchy -->
    <TimeSensor DEF='WaveClock' cycleInterval='3.0' loop='true'/>
    <OrientationInterpolator DEF='WaveAnim' key='0 0.5 1.0' keyValue='0 0 1 0, 0 0 1 0.45, 0 0 1 0'/>

    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='WaveAnim' toField='set_fraction'/>
    <ROUTE fromNode='WaveAnim' fromField='value_changed' toNode='Shared_l_shoulder' toField='rotation'/>
  </Scene>
</X3D>