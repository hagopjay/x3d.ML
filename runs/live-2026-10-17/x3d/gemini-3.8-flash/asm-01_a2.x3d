<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='simple_house.x3d' name='title'/>
    <meta content='A simple house with box body, pyramid roof, door, and windows.' name='description'/>
  </head>
  <Scene>
    <WorldInfo title='Simple House'/>
    <Viewpoint description='House View' orientation='1 0 0 -0.1' position='0 3 10'/>

    <!-- Ground plane -->
    <Transform translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.6 0.3'/>
        </Appearance>
        <Box size='20 0.05 20'/>
      </Shape>
    </Transform>

    <!-- House Body -->
    <Transform DEF='HouseBody' translation='0 1.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.85 0.75'/>
        </Appearance>
        <Box size='4 3 4'/>
      </Shape>
    </Transform>

    <!-- Pyramid Roof -->
    <Transform DEF='HouseRoof' translation='0 3 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.75 0.22 0.15'/>
        </Appearance>
        <IndexedFaceSet coordIndex='0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1 3 2 1 0 -1' solid='false'>
          <Coordinate point='-2.3 0 2.3, 2.3 0 2.3, 2.3 0 -2.3, -2.3 0 -2.3, 0 2 0'/>
        </IndexedFaceSet>
      </Shape>
    </Transform>

    <!-- Front Door -->
    <Transform DEF='HouseDoor' translation='0 1 2.02'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.4 0.25 0.12'/>
        </Appearance>
        <Box size='0.9 2 0.05'/>
      </Shape>
    </Transform>

    <!-- Left Window -->
    <Transform DEF='LeftWindow' translation='-1.2 1.6 2.02'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.6 0.8 0.9' shininess='0.9' transparency='0.3'/>
        </Appearance>
        <Box size='0.8 0.8 0.05'/>
      </Shape>
    </Transform>

    <!-- Right Window -->
    <Transform DEF='RightWindow' translation='1.2 1.6 2.02'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.6 0.8 0.9' shininess='0.9' transparency='0.3'/>
        </Appearance>
        <Box size='0.8 0.8 0.05'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>