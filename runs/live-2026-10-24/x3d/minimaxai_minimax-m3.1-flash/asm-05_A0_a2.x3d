<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Bookshelf with colourful books'/>
    <meta name='description' content='A wooden bookshelf with three shelves, each holding five differently coloured books.'/>
  </head>
  <Scene>
    <Viewpoint description='Front view of a three-shelf bookshelf holding fifteen colourful books' position='0 2.1 6.2' orientation='1 0 0 0' fieldOfView='0.75'/>
    <Color color='0.88 0.93 1 1'/>
    <DirectionalLight direction='-0.4 -1 -0.6' intensity='0.85' color='1 0.96 0.9'/>
    <DirectionalLight direction='0.6 -0.5 0.4' intensity='0.35' color='0.8 0.88 1'/>

    <Group>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.72 0.68 0.6' specularColor='0.08 0.08 0.08' shininess='0.15'/>
        </Appearance>
        <Box size='12 0.12 12'/>
      </Shape>

      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.45 0.27 0.14' specularColor='0.18 0.12 0.06' shininess='0.3'/>
        </Appearance>
        <Box size='0.16 4.2 0.9' translation='-1.62 2.1 0'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.45 0.27 0.14' specularColor='0.18 0.12 0.06' shininess='0.3'/>
        </Appearance>
        <Box size='0.16 4.2 0.9' translation='1.62 2.1 0'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.34 0.19 0.09' specularColor='0.1 0.06 0.03' shininess='0.2'/>
        </Appearance>
        <Box size='3.08 4.2 0.08' translation='0 2.1 -0.41'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.45 0.27 0.14' specularColor='0.18 0.12 0.06' shininess='0.3'/>
        </Appearance>
        <Box size='3.08 0.12 0.9' translation='0 0.06 0'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.45 0.27 0.14' specularColor='0.18 0.12 0.06' shininess='0.3'/>
        </Appearance>
        <Box size='3.08 0.12 0.9' translation='0 1.36 0'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.45 0.27 0.14' specularColor='0.18 0.12 0.06' shininess='0.3'/>
        </Appearance>
        <Box size='3.08 0.12 0.9' translation='0 2.66 0'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.45 0.27 0.14' specularColor='0.18 0.12 0.06' shininess='0.3'/>
        </Appearance>
        <Box size='3.4 0.16 0.9' translation='0 4.02 0'/>
      </Shape>

      <Transform translation='-1.1 0.58 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.78 0.12 0.12' specularColor='0.2 0.1 0.1' shininess='0.35'/>
          </Appearance>
          <Box size='0.24 0.92 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='-0.55 0.64 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.95 0.45 0.08' specularColor='0.2 0.15 0.08' shininess='0.35'/>
          </Appearance>
          <Box size='0.22 1.04 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='0 0.55 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.95 0.82 0.12' specularColor='0.2 0.2 0.1' shininess='0.35'/>
          </Appearance>
          <Box size='0.26 0.86 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='0.55 0.61 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.18 0.65 0.25' specularColor='0.1 0.2 0.1' shininess='0.35'/>
          </Appearance>
          <Box size='0.21 0.98 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='1.1 0.57 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.05 0.55 0.52' specularColor='0.1 0.2 0.2' shininess='0.35'/>
          </Appearance>
          <Box size='0.25 0.9 0.48'/>
        </Shape>
      </Transform>

      <Transform translation='-1.12 1.92 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.12 0.35 0.85' specularColor='0.1 0.15 0.25' shininess='0.35'/>
          </Appearance>
          <Box size='0.22 1 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='-0.56 1.86 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.24 0.16 0.72' specularColor='0.12 0.1 0.22' shininess='0.35'/>
          </Appearance>
          <Box size='0.25 0.88 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='0 1.95 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.58 0.18 0.78' specularColor='0.2 0.1 0.25' shininess='0.35'/>
          </Appearance>
          <Box size='0.21 1.06 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='0.56 1.89 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.92 0.35 0.62' specularColor='0.25 0.15 0.2' shininess='0.35'/>
          </Appearance>
          <Box size='0.26 0.94 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='1.12 1.88 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.48 0.26 0.12' specularColor='0.15 0.1 0.06' shininess='0.35'/>
          </Appearance>
          <Box size='0.23 0.92 0.48'/>
        </Shape>
      </Transform>

      <Transform DEF='bookSway' translation='-1.1 3.17 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.12 0.78 0.9' specularColor='0.1 0.25 0.3' shininess='0.35'/>
          </Appearance>
          <Box size='0.25 0.9 0.48'/>
        </Shape>
        <TouchSensor DEF='bookTouch' description='Touch the cyan book on the top shelf to make it sway'/>
      </Transform>
      <Transform translation='-0.55 3.23 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.58 0.82 0.16' specularColor='0.2 0.25 0.1' shininess='0.35'/>
          </Appearance>
          <Box size='0.21 1.02 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='0 3.195 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.82 0.12 0.62' specularColor='0.25 0.1 0.2' shininess='0.35'/>
          </Appearance>
          <Box size='0.24 0.95 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='0.55 3.26 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.96 0.36 0.28' specularColor='0.25 0.15 0.12' shininess='0.35'/>
          </Appearance>
          <Box size='0.23 1 0.48'/>
        </Shape>
      </Transform>
      <Transform translation='1.1 3.2 -0.02'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.2 0.2 0.85' specularColor='0.1 0.1 0.25' shininess='0.35'/>
          </Appearance>
          <Box size='0.26 0.96 0.48'/>
        </Shape>
      </Transform>
    </Group>

    <TimeSensor DEF='clock' loop='true' cycleInterval='8'/>
    <OrientationInterpolator DEF='swayInterpolator' keyTimes='0 0.5 1' keyValues='0 0 0 0  0 0.25 0 0  0 0 0 0'/>
    <ROUTE bookTouch.touchTime TO clock.startTime/>
    <ROUTE clock.fraction_changed TO swayInterpolator.set_fraction/>
    <ROUTE swayInterpolator.value_changed TO bookSway.rotation/>
  </Scene>
</X3D>