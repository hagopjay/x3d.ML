<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Traffic Cone' position='0 0.5 2'/>
    <!-- Base -->
    <Transform translation='0 0.025 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 0 0'/>
        </Appearance>
        <Box size='0.3 0.05 0.3'/>
      </Shape>
    </Transform>
    <!-- Cone -->
    <Transform translation='0 0.375 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='1 0.5 0'/>
        </Appearance>
        <Cone bottomRadius='0.15' height='0.65'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>