<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Background skyColor='0.6 0.8 1'/>
    <Viewpoint description='Simple house' position='8 4 10' orientation='-0.24 0.97 0 0.69'/>
    <Transform DEF='Ground' translation='0 -0.01 0'>
      <Shape>
        <Appearance DEF='GroundAppearance'>
          <Material diffuseColor='0.3 0.55 0.25'/>
        </Appearance>
        <Box size='20 0.02 20'/>
      </Shape>
    </Transform>
    <Transform DEF='HouseBody' translation='0 1.25 0'>
      <Shape>
        <Appearance DEF='BodyAppearance'>
          <Material diffuseColor='0.85 0.75 0.6'/>
        </Appearance>
        <Box size='4 2.5 3'/>
      </Shape>
    </Transform>
    <Transform DEF='Roof'>
      <Shape>
        <Appearance DEF='RoofAppearance'>
          <Material diffuseColor='0.55 0.15 0.1'/>
        </Appearance>
        <IndexedFaceSet solid='true' coordIndex='3 2 4 -1 2 1 4 -1 1 0 4 -1 0 3 4 -1 0 1 2 3 -1'>
          <Coordinate point='-2.3 2.5 -1.6 2.3 2.5 -1.6 2.3 2.5 1.6 -2.3 2.5 1.6 0 4.2 0'/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <Transform DEF='Door' translation='0 0.8 1.53'>
      <Shape>
        <Appearance DEF='DoorAppearance'>
          <Material diffuseColor='0.3 0.2 0.1'/>
        </Appearance>
        <Box size='0.8 1.6 0.06'/>
      </Shape>
    </Transform>
    <Transform DEF='WindowLeft' translation='-1.2 1.5 1.53'>
      <Shape>
        <Appearance DEF='WindowAppearance'>
          <Material diffuseColor='0.4 0.7 0.9' transparency='0.3'/>
        </Appearance>
        <Box DEF='WindowGeometry' size='0.6 0.6 0.06'/>
      </Shape>
    </Transform>
    <Transform DEF='WindowRight' translation='1.2 1.5 1.53'>
      <Shape>
        <Appearance USE='WindowAppearance'/>
        <Box USE='WindowGeometry'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>