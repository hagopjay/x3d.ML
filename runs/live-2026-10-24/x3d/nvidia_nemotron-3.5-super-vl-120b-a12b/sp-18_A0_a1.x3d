<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Aquarium'/>
  </head>
  <Scene>
    <Viewpoint description='Aquarium view' position='0 3 8' orientation='0 1 0 0'/>
    <Background skyColor='0.1 0.4 0.8' groundColor='0.8 0.7 0.6'/>
    <NavigationInfo type='"EXAMINE" "ANY"' avatarSize='0.25' headlight='TRUE'/>
    <DirectionalLight direction='0 -1 -0.3' intensity='0.8' color='1 1 1'/>

    <Transform translation='0 2.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.95 1.0' transparency='0.7'/>
        </Appearance>
        <Box size='12 5 12'/>
      </Shape>
    </Transform>

    <Transform translation='0 0.1 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.8 0.6'/>
        </Appearance>
        <Box size='12 0.2 12'/>
      </Shape>
    </Transform>

    <Transform translation='-3 0.25 3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='3 0.25 3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='-3 0.25 -3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='3 0.25 -3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.25 -4'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.25 4'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>

    <TimeSensor DEF='FishTS1' cycleInterval='4' loop='TRUE'/>
    <OrientationInterpolator DEF='FishOI1' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot1' translation='0 0.5 0'>
      <Transform translation='1 0 0' rotation='0 0 1 1.5707963'>
        <Shape>
          <Appearance><Material diffuseColor='1 0.5 0'/></Appearance>
          <Cone bottomRadius='0.08' height='0.2'/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE FROM='FishTS1.cycleTime' TO='FishOI1.set_fraction'/>
    <ROUTE FROM='FishOI1.value_changed' TO='FishPivot1.rotation'/>

    <TimeSensor DEF='FishTS2' cycleInterval='5' loop='TRUE'/>
    <OrientationInterpolator DEF='FishOI2' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot2' translation='0 1 0'>
      <Transform translation='1.5 0 0' rotation='0 0 1 1.5707963'>
        <Shape>
          <Appearance><Material diffuseColor='1 0.5 0'/></Appearance>
          <Cone bottomRadius='0.08' height='0.2'/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE FROM='FishTS2.cycleTime' TO='FishOI2.set_fraction'/>
    <ROUTE FROM='FishOI2.value_changed' TO='FishPivot2.rotation'/>

    <TimeSensor DEF='FishTS3' cycleInterval='6' loop='TRUE'/>
    <OrientationInterpolator DEF='FishOI3' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot3' translation='0 1.5 0'>
      <Transform translation='2 0 0' rotation='0 0 1 1.5707963'>
        <Shape>
          <Appearance><Material diffuseColor='1 0.5 0'/></Appearance>
          <Cone bottomRadius='0.08' height='0.2'/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE FROM='FishTS3.cycleTime' TO='FishOI3.set_fraction'/>
    <ROUTE FROM='FishOI3.value_changed' TO='FishPivot3.rotation'/>

    <TimeSensor DEF='FishTS4' cycleInterval='7' loop='TRUE'/>
    <OrientationInterpolator DEF='FishOI4' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot4' translation='0 2 0'>
      <Transform translation='2.5 0 0' rotation='0 0 1 1.5707963'>
        <Shape>
          <Appearance><Material diffuseColor='1 0.5 0'/></Appearance>
          <Cone bottomRadius='0.08' height='0.2'/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE FROM='FishTS4.cycleTime' TO='FishOI4.set_fraction'/>
    <ROUTE FROM='FishOI4.value_changed' TO='FishPivot4.rotation'/>

    <TimeSensor DEF='FishTS5' cycleInterval='8' loop='TRUE'/>
    <OrientationInterpolator DEF='FishOI5' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot5' translation='0 2.5 0'>
      <Transform translation='3 0 0' rotation='0 0 1 1.5707963'>
        <Shape>
          <Appearance><Material diffuseColor='1 0.5 0'/></Appearance>
          <Cone bottomRadius='0.08' height='0.2'/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE FROM='FishTS5.cycleTime' TO='FishOI5.set_fraction'/>
    <ROUTE FROM='FishOI5.value_changed' TO='FishPivot5.rotation'/>
  </Scene>
</X3D>