e="x3dprov.step.3" content="{&quot;input_sha256&quot;:&quot;fc7f406d70de862839a619f5f79414b60807e8e5fc0864aa791a2e2e9d6e5c57&quot;,&quot;ms&quot;:0,&quot;op&quot;:&quot;validate&quot;,&quot;output_sha256&quot;:&quot;fc7f406d70de862839a619f5f79414b60807e8e5fc0864aa791a2e2e9d6e5c57&quot;,&quot;prev&quot;:&quot;9257165f19737ac04022f0bd11e1e575eab5cd3b442ae2a5a7f3d38d67bbf40f&quot;,&quot;semantic_error_codes&quot;:[],&quot;validator&quot;:&quot;x3d_mcp fork&quot;,&quot;validator_ref&quot;:&quot;eb4b4b4&quot;,&quot;verdict&quot;:&quot;valid&quot;,&quot;xsd&quot;:&quot;4.0&quot;,&quot;xsd_valid&quot;:true}"/></head>
  <Scene>
    <Transform DEF='DoorTransform'>
      <Shape>
        <Box size='2 2 0.1'/>
        <Appearance>
          <Material diffuseColor='0.5 0.5 0.5'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <TimeSensor DEF='DoorTimer' cycleInterval='2' loop='false'/>
    <OrientationInterpolator DEF='DoorRotator' key='0 1' keyValue='0 1 0 0 0 1 0 1.5708'/>
    
    <ROUTE fromNode='DoorTimer' fromField='fraction_changed' toNode='DoorRotator' toField='set_fraction'/>
    <ROUTE fromNode='DoorRotator' fromField='value_changed' toNode='DoorTransform' toField='rotation'/>
    
    <Viewpoint description='Door Viewpoint' position='0 0 5'/>
  </Scene>
</X3D>