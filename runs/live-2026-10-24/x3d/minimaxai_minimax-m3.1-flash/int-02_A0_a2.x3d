<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Clickable color-toggling sphere'/>
  </head>
  <Scene>
    <WorldInfo title='BooleanToggle color sphere'/>
    <Viewpoint description='Click the sphere to toggle between red and green.' position='0 0 5' orientation='0 0 1 0'/>
    <Background color='0.08 0.08 0.12'/>
    <DirectionalLight direction='0 0 -1' intensity='0.8'/>
    <BooleanToggle id='ColorToggle' value='false'/>
    <BooleanFilter id='GreenInverter' negate='true'/>
    <Group>
      <TouchSensor id='SphereTouch'/>
      <Shape id='RedSphere' visibility='false'>
        <Appearance>
          <PhysicalMaterial diffuseColor='1 0 0'/>
        </Appearance>
        <Sphere radius='1'/>
      </Shape>
      <Shape id='GreenSphere' visibility='true'>
        <Appearance>
          <PhysicalMaterial diffuseColor='0 1 0'/>
        </Appearance>
        <Sphere radius='1'/>
      </Shape>
    </Group>
    <ROUTE SphereTouch.touched TO ColorToggle.toggleTime/>
    <ROUTE ColorToggle.value TO RedSphere.visibility/>
    <ROUTE ColorToggle.value TO GreenInverter.input/>
    <ROUTE GreenInverter.output TO GreenSphere.visibility/>
  </Scene>
</X3D>