<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<Viewpoint DEF='View' position='0 1.6 10' description='Statue with proximity light'/>
<Transform DEF='StatueTransform' translation='0 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.8 0.8 0.8'/>
</Appearance>
<Cylinder height='3' radius='0.5'/>
</Shape>
<ProximitySensor DEF='ProxSensor' center='0 1.5 0' size='10 10 10' enabled='true'/>
</Transform>
<SpotLight DEF='Spot' location='0 5 0' direction='0 -1 0' radius='10' cutOffAngle='0.785' beamWidth='0.5' intensity='1' on='FALSE'/>
<ROUTE fromNode='ProxSensor' fromField='isActive' toNode='Spot' toField='set_on'/>
</Scene>
</X3D>