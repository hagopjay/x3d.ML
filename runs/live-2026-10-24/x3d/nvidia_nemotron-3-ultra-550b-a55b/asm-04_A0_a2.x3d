<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint position='0 2 10' description='Street lamp with point light'/>
    <!-- Lamp pole -->
    <Transform translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
        <Cylinder radius='0.1' height='5' bottom='true' top='true' side='true'/>
      </Shape>
    </Transform>
    <!-- Lamp head with point light -->
    <Transform translation='0 5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.9 0.7' emissiveColor='0.9 0.9 0.7'/>
        </Appearance>
        <Sphere radius='0.3'/>
      </Shape>
      <PointLight location='0 0 0' intensity='1' color='1 1 0.9' on='true' radius='10' attenuation='1 0 0'/>
    </Transform>
  </Scene>
</X3D>