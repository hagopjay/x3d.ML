<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
 <head>
  <meta name='title' content='Vermilion Torii Gate in Shallow Water'/>
  <meta name='description' content='A Japanese torii gate in vermilion standing in shallow water with stone lanterns and a low sun.'/>
  <component name='Shape' level='2'/>
 </head>
 <Scene>
  <Viewpoint description='Japanese torii gate in vermilion over shallow water' position='0 2 6' orientation='0 1 0 0'/>
  <DirectionalLight intensity='0.9' color='1 0.8 0.6' direction='0.3 -1 0.5'/>
  <Background skyColor='0.7 0.85 1.0' groundColor='0.1 0.2 0.3'/>

  <!-- Shallow water: translucent blue plane -->
  <Transform translation='0 0 0'>
   <Shape>
    <Appearance>
     <PhysicalMaterial baseColor='0.0 0.35 0.75' transparency='0.65'/>
    </Appearance>
    <Box size='30 0.05 30'/>
   </Shape>
  </Transform>

  <!-- Torii gate pillars -->
  <Transform translation='-1 1.5 0'>
   <Shape>
    <Appearance><PhysicalMaterial baseColor='0.78 0.12 0.15'/></Appearance>
    <Box size='0.25 3 0.25'/>
   </Shape>
  </Transform>
  <Transform translation='1 1.5 0'>
   <Shape>
    <Appearance><PhysicalMaterial baseColor='0.78 0.12 0.15'/></Appearance>
    <Box size='0.25 3 0.25'/>
   </Shape>
  </Transform>

  <!-- Top crossbeam -->
  <Transform translation='0 3.1 0'>
   <Shape>
    <Appearance><PhysicalMaterial baseColor='0.78 0.12 0.15'/></Appearance>
    <Box size='2.6 0.2 0.35'/>
   </Shape>
  </Transform>

  <!-- Lower crossbeam -->
  <Transform translation='0 2.3 0'>
   <Shape>
    <Appearance><PhysicalMaterial baseColor='0.78 0.12 0.15'/></Appearance>
    <Box size='2.4 0.15 0.3'/>
   </Shape>
  </Transform>

  <!-- Stone lantern geometry defined once at origin -->
  <Transform DEF='StoneLantern'>
   <Group>
    <Transform translation='0 0.1 0'>
     <Shape>
      <Appearance><PhysicalMaterial baseColor='0.55 0.55 0.55'/></Appearance>
      <Box size='0.6 0.2 0.6'/>
     </Shape>
    </Transform>
    <Transform translation='0 0.6 0'>
     <Shape>
      <Appearance><PhysicalMaterial baseColor='0.55 0.55 0.55'/></Appearance>
      <Box size='0.2 0.8 0.2'/>
     </Shape>
    </Transform>
    <Transform translation='0 1.1 0'>
     <Shape>
      <Appearance><PhysicalMaterial baseColor='0.55 0.55 0.55'/></Appearance>
      <Box size='0.5 0.4 0.5'/>
     </Shape>
    </Transform>
    <Transform translation='0 1.3 0'>
     <Shape>
      <Appearance><PhysicalMaterial baseColor='0.55 0.55 0.55'/></Appearance>
      <Box size='0.8 0.1 0.8'/>
     </Shape>
    </Transform>
   </Group>
  </Transform>

  <!-- First stone lantern -->
  <Transform translation='-2.2 0 0.5'>
   <Transform USE='StoneLantern'/>
  </Transform>

  <!-- Second stone lantern -->
  <Transform translation='2.2 0 0.5' scale='-1 1 1'>
   <Transform USE='StoneLantern'/>
  </Transform>

 </Scene>
</X3D>