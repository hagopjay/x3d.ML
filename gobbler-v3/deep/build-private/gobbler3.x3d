        <!-- Motes: bright sprites that run along graph edges into the head. -->
        <Transform DEF='MoteA' scale='0 0 0'>
          <Shape DEF='MoteSprite'>
            <Appearance alphaMode='BLEND'>
              <Material diffuseColor='0 0 0' emissiveColor='1 0.88 0.62'/>
