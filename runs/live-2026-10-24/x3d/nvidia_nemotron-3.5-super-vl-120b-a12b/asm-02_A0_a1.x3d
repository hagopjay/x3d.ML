<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head></head>
  <Scene>
    <Viewpoint description='Solar System with Sun and Three Planets' position='0 0 25'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Transform>
      <Transform translation='0 0 0'>
        <Shape>
          <Sphere radius='2'/>
          <Appearance>
            <Material emissiveColor='1 1 0' diffuseColor='1 1 0'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform DEF='Planet1Transform' translation='5 0 0'>
        <Shape>
          <Sphere radius='0.5'/>
          <Appearance>
            <Material diffuseColor='1 0.5 0'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform DEF='Planet2Transform' translation='10 0 0'>
        <Shape>
          <Sphere radius='0.7'/>
          <Appearance>
            <Material diffuseColor='0 0.5 1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform DEF='Planet3Transform' translation='15 0 0'>
        <Shape>
          <Sphere radius='0.6'/>
          <Appearance>
            <Material diffuseColor='0 1 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <TimeSensor DEF='OrbitTimer' cycleInterval='10' loop='TRUE'/>
    <OrientationInterpolator DEF='OrbitRot' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 1.57079632679 0 0 1 3.14159265359 0 0 1 4.71238898038 0 0 1 6.28318530718'/>
    <ROUTE fromNode='OrbitTimer' fromField='fraction_changed' toNode='OrbitRot' toField='set_fraction'/>
    <ROUTE fromNode='OrbitRot' fromField='value_changed' toNode='Planet1Transform' toField='rotation'/>
    <ROUTE fromNode='OrbitRot' fromField='value_changed' toNode='Planet2Transform' toField='rotation'/>
    <ROUTE fromNode='OrbitRot' fromField='value_changed' toNode='Planet3Transform' toField='rotation'/>
  </Scene>
</X3D>