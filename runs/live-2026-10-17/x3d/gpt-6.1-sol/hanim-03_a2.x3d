                  <Transform translation='-0.105 0.065 0.065'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.12 0.2 0.29'/>
                      </Appearance>
                      <Box size='0.15 0.12 0.3'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

          <HAnimJoint DEF='LeftHip' name='l_hip' center='0.105 0.93 0'>
            <HAnimSegment DEF='LeftThigh' name='l_thigh'>
              <Transform translation='0.105 0.73 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.25 0.48 0.65'/>
                  </Appearance>
                  <Cylinder radius='0.075' height='0.4'/>
