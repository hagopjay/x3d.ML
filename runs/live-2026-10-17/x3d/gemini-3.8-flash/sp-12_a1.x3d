<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='tree.x3d' name='title'/>
    <meta content='A tree with brown trunk, three overlapping foliage cones, grass plane, and ten bobbing apples.' name='description'/>
  </head>
  <Scene>
    <WorldInfo title='Apple Tree Scene'/>
    <Background groundColor='0.2 0.35 0.15' skyColor='0.5 0.75 0.95'/>
    <DirectionalLight ambientIntensity='0.3' direction='-0.5 -1.0 -0.4' intensity='0.9'/>

    <Viewpoint description='Front View of Apple Tree' position='0 3.5 11'/>

    <!-- Grass Plane -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.28 0.6 0.2' roughness='0.8'/>
        </Appearance>
        <Cylinder height='0.1' radius='12'/>
      </Shape>
    </Transform>

    <!-- Tree Trunk -->
    <Transform translation='0 1.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.45 0.26 0.12' roughness='0.9'/>
        </Appearance>
        <Cylinder height='3.0' radius='0.4'/>
      </Shape>
    </Transform>

    <!-- Foliage: Three Overlapping Cones -->
    <Transform translation='0 3.4 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.15 0.5 0.18' roughness='0.6'/>
        </Appearance>
        <Cone bottomRadius='2.4' height='2.6'/>
      </Shape>
    </Transform>

    <Transform translation='0 4.7 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.18 0.56 0.2' roughness='0.6'/>
        </Appearance>
        <Cone bottomRadius='1.9' height='2.3'/>
      </Shape>
    </Transform>

    <Transform translation='0 5.9 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.22 0.62 0.24' roughness='0.6'/>
        </Appearance>
        <Cone bottomRadius='1.4' height='2.0'/>
      </Shape>
    </Transform>

    <!-- Shared Apple Geometry Template -->
    <Transform translation='0 -100 0'>
      <Shape DEF='AppleShape'>
        <Appearance>
          <Material diffuseColor='0.85 0.08 0.08' roughness='0.3' specularColor='0.5 0.2 0.2'/>
        </Appearance>
        <Sphere radius='0.16'/>
      </Shape>
    </Transform>

    <!-- Apples Group A -->
    <Transform DEF='ApplesGroupA'>
      <Transform translation='1.3 3.0 0.8'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='-1.4 2.8 0.5'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='0.4 3.2 -1.4'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='-0.9 4.3 0.7'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='0.8 4.4 -0.9'>
        <Shape USE='AppleShape'/>
      </Transform>
    </Transform>

    <!-- Apples Group B -->
    <Transform DEF='ApplesGroupB'>
      <Transform translation='-0.5 2.9 1.5'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='1.5 2.7 -0.5'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='-1.2 3.1 -0.8'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='1.0 4.1 0.7'>
        <Shape USE='AppleShape'/>
      </Transform>
      <Transform translation='-0.6 5.2 0.4'>
        <Shape USE='AppleShape'/>
      </Transform>
    </Transform>

    <!-- Bobbing Animation Clock and Interpolators -->
    <TimeSensor DEF='BobTimer' cycleInterval='2.4' loop='true'/>

    <PositionInterpolator DEF='BobInterpA' key='0 0.5 1' keyValue='0 0 0, 0 0.08 0, 0 0 0'/>
    <PositionInterpolator DEF='BobInterpB' key='0 0.5 1' keyValue='0 0.08 0, 0 0 0, 0 0.08 0'/>

    <ROUTE fromField='fraction_changed' fromNode='BobTimer' toField='set_fraction' toNode='BobInterpA'/>
    <ROUTE fromField='fraction_changed' fromNode='BobTimer' toField='set_fraction' toNode='BobInterpB'/>
    <ROUTE fromField='value_changed' fromNode='BobInterpA' toField='translation' toNode='ApplesGroupA'/>
    <ROUTE fromField='value_changed' fromNode='BobInterpB' toField='translation' toNode='ApplesGroupB'/>
  </Scene>
</X3D>