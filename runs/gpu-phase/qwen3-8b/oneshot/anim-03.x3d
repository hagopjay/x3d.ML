<Scene>
<Viewpoint description='Door View' position='0 5 10' orientation='0 1 0 0'/>
<Transform translation='0 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.5 0.3 0.1'/>
</Appearance>
<Box size='2 2 0.1'/>
</Shape>
<OrientationInterpolator DEF='DoorRotation' key='0 1' keyValue='0 1 0 0 0 1 0 1.5708'/>
<TimeSensor DEF='DoorTimer' cycleInterval='2' loop='FALSE'/>
<ROUTE fromNode='DoorTimer' fromField='fraction_changed' toNode='DoorRotation' toField='set_fraction'/>
<ROUTE fromNode='DoorRotation' fromField='value_changed' toNode='Transform' toField='rotation'/>
</Transform>
</Scene>
