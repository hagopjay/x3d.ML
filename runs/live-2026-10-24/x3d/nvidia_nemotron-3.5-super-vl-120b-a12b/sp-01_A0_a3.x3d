<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Lighthouse on a rocky island at night'/>
  </head>
  <Scene>
    <Background skyColor='0.02 0.02 0.08'/>
    <Viewpoint description='Lighthouse on a rocky island at night' position='0 12 25'/>
    <DirectionalLight intensity='0.7' direction='0 -1 -1'/>

    <!-- Sea -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Box size='100 0.1 100'/>
        <Appearance>
          <Material diffuseColor='0.0 0.05 0.15'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Rocky island -->
    <Transform translation='0 0.25 0'>
      <Shape>
        <Box size='4 0.5 4'/>
        <Appearance>
          <Material diffuseColor='0.35 0.35 0.3'/>
        </Appearance>
      </Shape>
      <TouchSensor/>
    </Transform>

    <!-- Lighthouse -->
    <Transform translation='0 0.5 0'>
      <!-- Tapered white tower -->
      <Transform>
        <Shape>
          <Cone bottomRadius='0.8' height='6'/>
          <Appearance>
            <Material diffuseColor='0.95 0.95 0.95'/>
          </Appearance>
        </Shape>
      </Transform>

      <!-- Two red bands -->
      <Transform translation='0 2 0'>
        <Shape>
          <Cylinder radius='0.62' height='0.2'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 4 0'>
        <Shape>
          <Cylinder radius='0.42' height='0.2'/>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>

      <!-- Glass lantern room -->
      <Transform translation='0 6.2 0'>
        <Shape>
          <Box size='0.6 0.6 0.6'/>
          <Appearance>
            <Material diffuseColor='0.9 0.9 0.8' transparency='0.6'/>
          </Appearance>
        </Shape>
        <PointLight intensity='0.6' radius='15' color='1 1 0.8'/>
      </Transform>

      <!-- Pale yellow sweeping beam -->
      <Transform DEF='BEAM_TRANSFORM' translation='0 6.2 0' rotation='0 1 0 0'>
        <Transform translation='0 0 12.5'>
          <Shape>
            <Box size='0.04 0.04 25'/>
            <Appearance>
              <Material diffuseColor='1 1 0.6' emissiveColor='1 1 0.6'/>
            </Appearance>
          </Shape>
        </Transform>
      </Transform>
    </Transform>

    <!-- Animation: 6-second rotation -->
    <TimeSensor DEF='BEAM_TIME' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='BEAM_ROT' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.57079632679 0 1 0 3.14159265359 0 1 0 4.71238898038 0 1 0 6.28318530718'/>

    <ROUTE fromNode='BEAM_TIME' fromField='fraction_changed' toNode='BEAM_ROT' toField='set_fraction'/>
    <ROUTE fromNode='BEAM_ROT' fromField='value_changed' toNode='BEAM_TRANSFORM' toField='rotation'/>
  </Scene>
</X3D>