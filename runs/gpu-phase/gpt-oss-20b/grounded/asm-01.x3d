  <Scene>
    <Viewpoint description='House View' position='0 2 6' orientation='0 0 0 0' />
    <!-- House Body -->
    <Transform DEF='HouseBody' translation='0 0 0'>
      <Shape DEF='BodyShape'>
        <Box size='4 2 4' />
        <Appearance>
          <Material DEF='BodyMaterial' diffuseColor='0.8 0.7 0.6' />
        </Appearance>
      </Shape>
    </Transform>
    <!-- Roof -->
    <Transform DEF='Roof' translation='0 1.5 0'>
      <Shape DEF='RoofShape'>
        <IndexedFaceSet coordIndex='0 1 2 -1 0 2 3 -1 0 3 4 -1 1 4 2 -1' solid='true'>
