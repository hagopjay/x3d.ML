<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Three cubes rotating at different speeds'/>
  </head>
  <Scene>
    <Background color='0.08 0.10 0.16'/>
    <DirectionalLight direction='0 -1 0' intensity='0.9'/>
    <DirectionalLight direction='0.4 -1 -0.6' intensity='0.5'/>
    <Viewpoint description='Three cubes rotating at different speeds' position='0 1 14' orientation='0 0 1 0' fieldOfView='0.9'/>

    <TimeSensor DEF='fastClock' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='fastSpin' keyTimes='0 0.5 1' keyValue='0 1 0 0 0 1 0 3.14159265 0 1 0 6.2831853'/>
    <Transform DEF='fastCubeTransform' translation='-4 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.2 0.2'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <ROUTE from='fastClock' to='fastSpin' set_fraction/>
    <ROUTE from='fastSpin' to='fastCubeTransform' set_orientation/>

    <TimeSensor DEF='mediumClock' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='mediumSpin' keyTimes='0 0.5 1' keyValue='0 1 0 0 0 1 0 3.14159265 0 1 0 6.2831853'/>
    <Transform DEF='mediumCubeTransform' translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.8 0.3'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <ROUTE from='mediumClock' to='mediumSpin' set_fraction/>
    <ROUTE from='mediumSpin' to='mediumCubeTransform' set_orientation/>

    <TimeSensor DEF='slowClock' cycleInterval='9' loop='true'/>
    <OrientationInterpolator DEF='slowSpin' keyTimes='0 0.5 1' keyValue='0 1 0 0 0 1 0 3.14159265 0 1 0 6.2831853'/>
    <Transform DEF='slowCubeTransform' translation='4 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.4 0.95'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <ROUTE from='slowClock' to='slowSpin' set_fraction/>
    <ROUTE from='slowSpin' to='slowCubeTransform' set_orientation/>
  </Scene>
</X3D>