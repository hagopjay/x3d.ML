<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Drone over Torgersen Hall'/>
  </head>
  <Scene>
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2295 -80.4230 50'/>
    <GeoViewpoint geoSystem='"GD" "WE"' position='37.2295 -80.4230 50' description='View over Torgersen Hall'/>
    <TimeSensor DEF='FlyTimer' cycleInterval='20' loop='true'/>
    <GeoPositionInterpolator DEF='PathInterpolator'
      key='0 0.25 0.5 0.75 1'
      keyValue='37.229590 -80.423000 50 37.229500 -80.422887 50 37.229410 -80.423000 50 37.229500 -80.423113 50 37.229590 -80.423000 50'/>
    <GeoTransform DEF='DroneTransform' geoSystem='"GD" "WE"'>
      <Shape>
        <Box size='2 2 2'/>
        <Appearance>
          <Material diffuseColor='0.2 0.6 0.9'/>
        </Appearance>
      </Shape>
    </GeoTransform>
    <Viewpoint description='Drone flight over Torgersen Hall'/>
    <ROUTE fromNode='FlyTimer' fromField='fraction_changed' toNode='PathInterpolator' toField='set_fraction'/>
    <ROUTE fromNode='PathInterpolator' fromField='value_changed' toNode='DroneTransform' toField='set_geoCoords'/>
  </Scene>
</X3D>