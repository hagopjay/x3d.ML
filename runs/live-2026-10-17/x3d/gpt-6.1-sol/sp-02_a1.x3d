    <Transform DEF='GreenOrbit' rotation='0 1 0 5.1'>
      <Transform translation='10.7 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.12 0.74 0.43' specularColor='0.4 0.8 0.65' shininess='0.4'/>
          </Appearance>
          <Sphere radius='0.48'/>
        </Shape>
      </Transform>
    </Transform>

    <TimeSensor DEF='BlueClock' cycleInterval='14' loop='true'/>
    <OrientationInterpolator DEF='BlueMotion' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185'/>

    <TimeSensor DEF='RedClock' cycleInterval='23' loop='true'/>
    <OrientationInterpolator DEF='RedMotion' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 1.8, 0 1 0 3.370796, 0 1 0 4.941593, 0 1 0 6.512389, 0 1 0 8.083185'/>

    <TimeSensor DEF='RingedClock' cycleInterval='36' loop='true'/>
    <OrientationInterpolator DEF='RingedMotion' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 3.7, 0 1 0 5.270796, 0 1 0 6.841593, 0 1 0 8.412389, 0 1 0 9.983185'/>

    <TimeSensor DEF='GreenClock' cycleInterval='52' loop='true'/>
    <OrientationInterpolator DEF='GreenMotion' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 5.1, 0 1 0 6.670796, 0 1 0 8.241593, 0 1 0 9.812389, 0 1 0 11.383185'/>

    <ROUTE fromNode='BlueClock' fromField='fraction_changed' toNode='BlueMotion' toField='set_fraction'/>
    <ROUTE fromNode='BlueMotion' fromField='value_changed' toNode='BlueOrbit' toField='set_rotation'/>
    <ROUTE fromNode='RedClock' fromField='fraction_changed' toNode='RedMotion' toField='set_fraction'/>
    <ROUTE fromNode='RedMotion' fromField='value_changed' toNode='RedOrbit' toField='set_rotation'/>
    <ROUTE fromNode='RingedClock' fromField='fraction_changed' toNode='RingedMotion' toField='set_fraction'/>
    <ROUTE fromNode='RingedMotion' fromField='value_changed' toNode='RingedOrbit' toField='set_rotation'/>
    <ROUTE fromNode='GreenClock' fromField='fraction_changed' toNode='GreenMotion' toField='set_fraction'/>
    <ROUTE fromNode='GreenMotion' fromField='value_changed' toNode='GreenOrbit' toField='set_rotation'/>
