                <Box size='1 1.5 1'/>
              </Shape>
            </Transform>
            <HAnimJoint USE='HeadJoint'>
              <HAnimSegment>
                <Transform DEF='HeadTransform'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.4 0.6 0.8'/> <!-- Blue skin -->
                    </Appearance>
                    <Sphere radius='0.3'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimSegment>
