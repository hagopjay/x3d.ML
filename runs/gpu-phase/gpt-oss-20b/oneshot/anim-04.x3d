.step.3" content="{&quot;input_sha256&quot;:&quot;4d0a9810e43944a08caf0450586655c7678c7dceae0c1296a9af10287b1df896&quot;,&quot;ms&quot;:1,&quot;op&quot;:&quot;validate&quot;,&quot;output_sha256&quot;:&quot;4d0a9810e43944a08caf0450586655c7678c7dceae0c1296a9af10287b1df896&quot;,&quot;prev&quot;:&quot;7a47d01faf31785bd236188c6cc76de469f316fa5e0bf4cf127254c4ccc17ad5&quot;,&quot;semantic_error_codes&quot;:[],&quot;validator&quot;:&quot;x3d_mcp fork&quot;,&quot;validator_ref&quot;:&quot;eb4b4b4&quot;,&quot;verdict&quot;:&quot;valid&quot;,&quot;xsd&quot;:&quot;4.0&quot;,&quot;xsd_valid&quot;:true}"/></head>
  <Scene>
    <Viewpoint description='Color cycling sphere' position='0 0 5' />
    <TimeSensor DEF='Clock' cycleInterval='6' loop='true' />
    <ColorInterpolator DEF='ColorCycle' key='0 0.3333333333 0.6666666667 1' keyValue='1 0 0 0 1 0 0 0 1 1 0 0' />
    <Shape>
      <Appearance>
        <Material DEF='SphereMaterial' />
      </Appearance>
      <Sphere radius='1' />
    </Shape>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='ColorCycle' toField='set_fraction' />
    <ROUTE fromNode='ColorCycle' fromField='value_changed' toNode='SphereMaterial' toField='diffuseColor' />
  </Scene>
</X3D>