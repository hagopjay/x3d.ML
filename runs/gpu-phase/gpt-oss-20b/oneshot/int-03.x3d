  <Scene>
    <Viewpoint description='Drag the cone with the mouse' position='0 2 5' orientation='0 0 0 0' />
    <Transform DEF='ConeTransform' translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.5 0.8' />
        </Appearance>
        <Cone bottomRadius='1' height='2' />
      </Shape>
    </Transform>
    <PlaneSensor DEF='DragSensor' maxPosition='10 10' />
    <ROUTE fromNode='DragSensor' fromField='translation_changed' toNode='ConeTransform' toField='set_translation' />
  </Scene>
</X3D>