<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Pendulum Clock' position='0 0 3.5' centerOfRotation='0 0 0'/>
    <Background skyColor='0.8 0.85 0.9'/>
    <DirectionalLight direction='-0.5 -0.5 -0.5' intensity='0.8'/>

    <!-- Floor -->
    <Transform translation='0 -1.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
        <Box size='3 0.02 3'/>
      </Shape>
    </Transform>

    <!-- Clock Case -->
    <Transform>
      <!-- Base -->
      <Transform translation='0 -1.2 0'>
        <Shape>
          <Appearance DEF='WoodApp'>
            <Material diffuseColor='0.35 0.16 0.05'/>
          </Appearance>
          <Box size='0.8 0.6 0.4'/>
        </Shape>
      </Transform>
      <!-- Trunk -->
      <Transform translation='0 -0.1 0'>
        <Shape>
          <Appearance USE='WoodApp'/>
          <Box size='0.5 1.6 0.26'/>
        </Shape>
      </Transform>
      <!-- Hood -->
      <Transform translation='0 1.1 0'>
        <Shape>
          <Appearance USE='WoodApp'/>
          <Box size='0.7 0.8 0.4'/>
        </Shape>
      </Transform>
    </Transform>

    <!-- Clock Face and Hands -->
    <Transform translation='0 1.1