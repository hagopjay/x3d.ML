We'll create the scene:

<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Windmill on grassy hill' position='0 30 50'/>
    <Background skyColor='0.5 0.7 1.0'/>
    <Transform translation='0 0 0'>
      <Shape>
        <ElevationGrid xDimension='51' zDimension='51' xSpacing='1' zSpacing='1' height='...'/>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.2 0.6 0.2'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation='0 10 0'> <!-- position at hill top, adjust y -->
      <!-- Tower -->
      <Transform translation='0 5 0'>
        <Shape>
          <Cone bottomRadius='2' height='10' side='true' bottom='true'/>
          <Appearance>
            <PhysicalMaterial diffuseColor='1 1 1'/>
          </Appearance>
        </Shape>
      </Transform>
      <!-- Roof -->
      <Transform translation='0 10 0'>
        <Shape>
          <Cone bottomRadius='2.5' height='3' side='true' bottom='true'/>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.2 0.2 0.2'/>
          </Appearance>
        </Shape>
      </Transform>
      <!-- Blades rotor -->
      <Transform DEF='Rotor' translation='0 11.5 0'>
        <!-- Four blades -->
        <Transform rotation='0 0 1 0'>
          <Shape>
            <Box size='0.2 8 0.5'/>
            <Appearance>
              <PhysicalMaterial diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
          </Shape>
        </Transform>
        <Transform rotation='0 0 1 1.5708'>
          <Shape>
            <Box size='0.2 8 0.5'/>
            <Appearance>
              <PhysicalMaterial diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
          </Shape>
        </Transform>
        <Transform rotation='0 0 1 3.1416'>
          <Shape>
            <Box size='0.2 8 0.5'/>
            <Appearance>
              <PhysicalMaterial diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
          </Shape>
        </Transform>
        <Transform rotation='0 0 1 4.7124'>
          <Shape>
            <Box size='0.2 8 0.5'/>
            <Appearance>
              <PhysicalMaterial diffuseColor='0.8 0.8 0.8'/>
            </Appearance>
          </Shape>
        </Transform>
      </Transform>
    </Transform>
    <TimeSensor DEF='Timer' cycleInterval='8' loop='true'/>
    <OrientationInterpolator DEF='Spin' key='0 1' keyValue='0 1 0 0  0 1 0 6.2831853'/>
    <ROUTE fromNode='Timer' fromField='fraction_changed' toNode='Spin' toField='set_fraction'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='Rotor' toField='rotation'/>
  </Scene>
</X3D>