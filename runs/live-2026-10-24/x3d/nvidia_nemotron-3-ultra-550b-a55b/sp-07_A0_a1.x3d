<X3D profile='Immersive' version='4.0' ...>
  <head>
    <meta name='title' content='Rotating DNA Double Helix'/>
    <meta name='description' content='Two spiral strands with base-pair rungs rotating about long axis'/>
  </head>
  <Scene>
    <Viewpoint DEF='VP' description='DNA Double Helix' position='0 5 20' orientation='0 1 0 -0.2'/>
    <Transform DEF='Rotator'>
      <Group DEF='DNA'>
        <TouchSensor DEF='Touch'/>
        <!-- Strand 1 (blue) -->
        <Transform translation='1 0 0'>
          <Shape USE='SphereBlue'/>
        </Transform>
        ... 19 more for strand1
        <!-- Strand 2 (orange) -->
        <Transform translation='-1 0 0'>
          <Shape USE='SphereOrange'/>
        </Transform>
        ... 19 more for strand2
        <!-- Rungs -->
        <Transform translation='0 0 0' rotation='0 0 1 1.570796'>
          <Shape USE='CylinderRung'/>
        </Transform>
        ... 19 more rungs
      </Group>
    </Transform>
    <TimeSensor DEF='TS' cycleInterval='10' loop='true'/>
    <OrientationInterpolator DEF='OI' key='0 1' keyValue='0 1 0 0  0 1 0 6.283185'/>
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='OI' toField='set_fraction'/>
    <ROUTE fromNode='OI' fromField='value_changed' toNode='Rotator' toField='rotation'/>
  </Scene>
</X3D>