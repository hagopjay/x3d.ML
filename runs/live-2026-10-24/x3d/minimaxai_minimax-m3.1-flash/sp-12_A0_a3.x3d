<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Bobbing Apple Tree'/>
  </head>
  <Scene>
    <Viewpoint description='A brown-trunked tree with overlapping green foliage and ten gently bobbing red apples on a grassy field' position='0 3.2 8' orientation='0 0 1 0' fieldOfView='0.785'/>
    <Background color='0.68 0.82 0.95'/>
    <DirectionalLight direction='0 -1 0' diffuseColor='1 0.97 0.9' intensity='0.85'/>

    <Group>
      <TouchSensor DEF='TreeTouch' description='Touch the tree to restart the apple bobbing'/>

      <Transform translation='0 1.5 0'>
        <Shape>
          <Cylinder radius='0.34' height='3' bottom='true' top='true' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.42 0.23 0.09' specularColor='0.12 0.06 0.02' shininess='0.2'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform translation='0 3.4 0'>
        <Shape>
          <Cone radius='1.85' height='2.4' bottom='true' top='true' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.12 0.48 0.16' specularColor='0.04 0.1 0.04' shininess='0.15'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform translation='-0.58 2.85 0.12'>
        <Shape>
          <Cone radius='1.45' height='2.05' bottom='true' top='true' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.16 0.55 0.19' specularColor='0.04 0.12 0.05' shininess='0.15'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform translation='0.58 2.95 -0.12'>
        <Shape>
          <Cone radius='1.42' height='2.1' bottom='true' top='true' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.1 0.44 0.14' specularColor='0.03 0.09 0.03' shininess='0.15'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform rotation='1 0 0 -1.570796'>
        <Shape>
          <Plane size='20 20' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.28 0.62 0.22' specularColor='0.02 0.05 0.02' shininess='0.05'/>
          </Appearance>
        </Shape>
      </Transform>

      <Group DEF='Apple01' translation='-1.05 3.25 0.55'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple02' translation='0.95 3.45 0.45'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple03' translation='-0.55 2.85 0.95'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple04' translation='0.45 2.95 0.9'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple05' translation='-1.25 2.35 -0.15'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple06' translation='1.2 2.45 -0.2'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple07' translation='-0.15 3.85 0.75'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple08' translation='0.25 4 -0.65'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple09' translation='-0.85 3.65 -0.55'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <Group DEF='Apple10' translation='0.85 3.7 -0.45'>
        <Shape>
          <Sphere radius='0.16' solid='true'/>
          <Appearance>
            <Material diffuseColor='0.85 0.06 0.05' specularColor='0.35 0.08 0.06' shininess='0.6'/>
          </Appearance>
        </Shape>
      </Group>

      <TimeSensor DEF='BobClock' cycleInterval='4' loop='true' startTime='0'/>

      <PositionInterpolator DEF='AppleBob01' keyTimes='0 0.5 1' keyValues='-1.05 3.17 0.55 -1.05 3.33 0.55 -1.05 3.17 0.55'/>
      <PositionInterpolator DEF='AppleBob02' keyTimes='0 0.5 1' keyValues='0.95 3.37 0.45 0.95 3.53 0.45 0.95 3.37 0.45'/>
      <PositionInterpolator DEF='AppleBob03' keyTimes='0 0.5 1' keyValues='-0.55 2.77 0.95 -0.55 2.93 0.95 -0.55 2.77 0.95'/>
      <PositionInterpolator DEF='AppleBob04' keyTimes='0 0.5 1' keyValues='0.45 2.87 0.9 0.45 3.03 0.9 0.45 2.87 0.9'/>
      <PositionInterpolator DEF='AppleBob05' keyTimes='0 0.5 1' keyValues='-1.25 2.27 -0.15 -1.25 2.43 -0.15 -1.25 2.27 -0.15'/>
      <PositionInterpolator DEF='AppleBob06' keyTimes='0 0.5 1' keyValues='1.2 2.37 -0.2 1.2 2.53 -0.2 1.2 2.37 -0.2'/>
      <PositionInterpolator DEF='AppleBob07' keyTimes='0 0.5 1' keyValues='-0.15 3.77 0.75 -0.15 3.93 0.75 -0.15 3.77 0.75'/>
      <PositionInterpolator DEF='AppleBob08' keyTimes='0 0.5 1' keyValues='0.25 3.92 -0.65 0.25 4.08 -0.65 0.25 3.92 -0.65'/>
      <PositionInterpolator DEF='AppleBob09' keyTimes='0 0.5 1' keyValues='-0.85 3.57 -0.55 -0.85 3.73 -0.55 -0.85 3.57 -0.55'/>
      <PositionInterpolator DEF='AppleBob10' keyTimes='0 0.5 1' keyValues='0.85 3.62 -0.45 0.85 3.78 -0.45 0.85 3.62 -0.45'/>

      <ROUTE TreeTouch.touchTime TO BobClock.startTime/>
      <ROUTE BobClock.fraction TO AppleBob01.set_fraction/>
      <ROUTE AppleBob01.value_changed TO Apple01.translation/>
      <ROUTE BobClock.fraction TO AppleBob02.set_fraction/>
      <ROUTE AppleBob02.value_changed TO Apple02.translation/>
      <ROUTE BobClock.fraction TO AppleBob03.set_fraction/>
      <ROUTE AppleBob03.value_changed TO Apple03.translation/>
      <ROUTE BobClock.fraction TO AppleBob04.set_fraction/>
      <ROUTE AppleBob04.value_changed TO Apple04.translation/>
      <ROUTE BobClock.fraction TO AppleBob05.set_fraction/>
      <ROUTE AppleBob05.value_changed TO Apple05.translation/>
      <ROUTE BobClock.fraction TO AppleBob06.set_fraction/>
      <ROUTE AppleBob06.value_changed TO Apple06.translation/>
      <ROUTE BobClock.fraction TO AppleBob07.set_fraction/>
      <ROUTE AppleBob07.value_changed TO Apple07.translation/>
      <ROUTE BobClock.fraction TO AppleBob08.set_fraction/>
      <ROUTE AppleBob08.value_changed TO Apple08.translation/>
      <ROUTE BobClock.fraction TO AppleBob09.set_fraction/>
      <ROUTE AppleBob09.value_changed TO Apple09.translation/>
      <ROUTE BobClock.fraction TO AppleBob10.set_fraction/>
      <ROUTE AppleBob10.value_changed TO Apple10.translation/>
    </Group>
  </Scene>
</X3D>