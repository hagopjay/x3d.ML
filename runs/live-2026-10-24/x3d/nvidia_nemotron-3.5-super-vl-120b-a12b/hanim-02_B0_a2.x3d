<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="HAnim" level="1"/>
    <component name="Shape" level="2"/>
    <meta content="HAnim waving right arm" name="title"/>
    <meta content="X3D 4.0 HAnim 2.0 example" name="description"/>
  </head>
  <Scene>
    <Viewpoint description="HAnim figure waving right arm" position="0 1.5 3"/>
    <DirectionalLight intensity="0.8" color="1 1 1" direction="0 -1 0"/>
    <TimeSensor DEF="WaveTimer" cycleInterval="2" loop="true"/>
    <OrientationInterpolator DEF="ShoulderRot" key="0 0.25 0.5 0.75 1" keyValue="0 0 1 0 0 0 1 0.5 0 0 1 0 0 0 1 -0.5 0 0 1 0"/>
    <HAnimHumanoid version="2.0" name="Humanoid">
      <HAnimSegment name="HAnimSegment_root" containerField="segments">
        <HAnimJoint DEF="RightShoulderJoint" name="HAnimJoint_rightShoulder" rotation="0 0 1 0">
          <HAnimSegment name="HAnimSegment_rightUpperArm">
            <Shape>
              <Appearance>
                <PhysicalMaterial baseColor="0.8 0.6 0.5"/>
              </Appearance>
              <Box size="0.1 0.4 0.1"/>
            </Shape>
          </HAnimSegment>
        </HAnimJoint>
      </HAnimSegment>
    </HAnimHumanoid>
    <ROUTE fromNode="WaveTimer" fromField="fraction_changed" toNode="ShoulderRot" toField="set_fraction"/>
    <ROUTE fromNode="ShoulderRot" fromField="value_changed" toNode="RightShoulderJoint" toField="rotation"/>
  </Scene>
</X3D>