<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Solar System'/>
    <meta name='description' content='Sun with three planets at different distances'/>
  </head>
  <Scene>
    <Viewpoint description='Solar System View' position='0 0 20'/>
    <Background skyColor='0 0 0'/>
    <TimeSensor DEF='Clock' loop='true' cycleInterval='10'/>
    <OrientationInterpolator DEF='Spin' key='0 0.5 1' keyValue='0 1 0 0  0 1 0 3.14159  0 1 0 6.28318'/>
    <Transform translation='0 0 0'>
      <TouchSensor DEF='StartTouch'/>
      <Shape>
        <Appearance>
          <Material emissiveColor='1 1 0' diffuseColor='1 1 0'/>
        </Appearance>
        <Sphere radius='1'/>
      </Shape>
    </Transform>
    <Transform DEF='Planet1' translation='3 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
        <Sphere radius='0.3'/>
      </Shape>
    </Transform>
    <Transform DEF='Planet2' translation='5 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 1 0'/>
        </Appearance>
        <Sphere radius='0.4'/>
      </Shape>
    </Transform>
    <Transform DEF='Planet3' translation='7 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='1 0 0'/>
        </Appearance>
        <Sphere radius='0.5'/>
      </Shape>
    </Transform>
    <ROUTE fromNode='StartTouch' fromField='touchTime' toNode='Clock' toField='startTime'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Spin' toField='set_fraction'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='Planet1' toField='rotation'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='Planet2' toField='rotation'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='Planet3' toField='rotation'/>
  </Scene>
</X3D>