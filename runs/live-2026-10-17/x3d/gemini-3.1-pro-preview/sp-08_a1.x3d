<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='City Block' position='0 6 15' orientation='1 0 0 -0.2'/>
    
    <DirectionalLight direction='-0.5 -1 -0.5' intensity='0.8'/>
    <DirectionalLight direction='0.5 -0.5 0.5' intensity='0.4'/>

    <!-- Grey Streets Base -->
    <Transform translation='0 0 0'>
      <Shape>
        <Box size='10 0.1 10'/>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 1 (-3, -3) -->
    <Transform translation='-3 1.5 -3'>
      <Shape>
        <Box size='2 3 2'/>
        <Appearance>
          <Material diffuseColor='0.2 0.3 0.8'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 2 (0, -3) -->
    <Transform translation='0 1.0 -3'>
      <Shape>
        <Box size='2 2 2'/>
        <Appearance>
          <Material diffuseColor='0.2 0.8 0.3'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 3 (3, -3) -->
    <Transform translation='3 2.0 -3'>
      <Shape>
        <Box size='2 4 2'/>
        <Appearance>
          <Material diffuseColor='0.8 0.8 0.2'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 4 (-3, 0) -->
    <Transform translation='-3 1.25 0'>
      <Shape>
        <Box size='2 2.5 2'/>
        <Appearance>
          <Material diffuseColor='0.9 0.5 0.1'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 5 - Central Tower (0, 0) -->
    <Transform translation='0 4.0 0'>
      <Shape>
        <Box size='2 8 2'/>
        <Appearance>
          <Material diffuseColor='0.15 0.15 0.2'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Central Tower Blinking Light -->
    <Transform translation='0 8.2 0'>
      <Shape>
        <Sphere radius='0.3'/>
        <Appearance>
          <Material DEF='LightMaterial' diffuseColor='0 0 0' emissiveColor='1 0 0'/>
        </Appearance>
      </Shape>
      <PointLight DEF='TowerLight' color='1 0 0' radius='10' intensity='1' location='0 0 0'/>
    </Transform>

    <!-- Building 6 (3, 0) -->
    <Transform translation='3 1.75 0'>
      <Shape>
        <Box size='2 3.5 2'/>
        <Appearance>
          <Material diffuseColor='0.2 0.8 0.8'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 7 (-3, 3) -->
    <Transform translation='-3 2.5 3'>
      <Shape>
        <Box size='2 5 2'/>
        <Appearance>
          <Material diffuseColor='0.8 0.2 0.8'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 8 (0, 3) -->
    <Transform translation='0 0.75 3'>
      <Shape>
        <Box size='2 1.5 2'/>
        <Appearance>
          <Material diffuseColor='0.4 0.6 0.9'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Building 9 (3, 3) -->
    <Transform translation='3 1.4 3'>
      <Shape>
        <Box size='2 2.8 2'/>
        <Appearance>
          <Material diffuseColor='0.9 0.9 0.9'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Animation for the Blinking Light -->
    <TimeSensor DEF='Timer' cycleInterval='1.5' loop='true'/>
    <ColorInterpolator DEF='Blinker' key='0 0.5 1' keyValue='1 0 0, 0 0 0, 1 0 0'/>
    
    <ROUTE fromNode='Timer' fromField='fraction_changed' toNode='Blinker' toField='set_fraction'/>
    <ROUTE fromNode='Blinker' fromField='value_changed' toNode='LightMaterial' toField='set_emissiveColor'/>
    <ROUTE fromNode='Blinker' fromField='value_changed' toNode='TowerLight' toField='set_color'/>
  </Scene>
</X3D>