<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component level='2' name='HAnim'/>
  </head>
  <Scene>
    <WorldInfo title='HAnim Humanoid with Hand Site and Sphere'/>

    <Viewpoint description='Eye Level View' position='0 1.65 2.5' centerOfRotation='0 1.65 0'/>
    <Viewpoint description='Full Body View' position='0 1.1 3.5' centerOfRotation='0 1.0 0'/>

    <DirectionalLight direction='0.5 -1 -0.8' intensity='0.9' shadowIntensity='0.5'/>
    <DirectionalLight direction='-0.5 -0.5 0.8' intensity='0.4'/>

    <!-- Floor -->
    <Transform translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.22 0.25' roughness='0.8' specularColor='0.1 0.1 0.1'/>
        </Appearance>
        <Cylinder height='0.02' radius='2'/>
      </Shape>
    </Transform>

    <!-- HAnim Humanoid -->
    <HAnimHumanoid DEF='Humanoid' name='Humanoid' version='2.0'>
      <!-- SKELETON -->
      <HAnimJoint DEF='hanim_humanoid_root' name='humanoid_root' containerField='skeleton' center='0 0.95 0'>
        <HAnimSegment DEF='hanim_sacrum' name='sacrum'>
          <Transform translation='0 0.95 0'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.75 0.77 0.8' roughness='0.4' specularColor='0.4 0.4 0.4'/>
              </Appearance>
              <Box size='0.26 0.14 0.18'/>
            </Shape>
          </Transform>
        </HAnimSegment>

        <!-- Spine -->
        <HAnimJoint DEF='hanim_spine1' name='spine1' center='0 1.05 0'>
          <HAnimSegment DEF='hanim_segment_spine1' name='spine1'>
            <Transform translation='0 1.08 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.3 0.32 0.35' roughness='0.5'/>
                </Appearance>
                <Cylinder height='0.12' radius='0.1'/>
              </Shape>
            </Transform>
          </HAnimSegment>

          <HAnimJoint DEF='hanim_spine2' name='spine2' center='0 1.18 0'>
            <HAnimSegment DEF='hanim_segment_spine2' name='spine2'>
              <Transform translation='0 1.28 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.75 0.77 0.8' roughness='0.4' specularColor='0.4 0.4 0.4'/>
                  </Appearance>
                  <Box size='0.32 0.22 0.2'/>
                </Shape>
              </Transform>
            </HAnimSegment>

            <!-- Neck & Head -->
            <HAnimJoint DEF='hanim_neck' name='neck' center='0 1.45 0'>
              <HAnimSegment DEF='hanim_segment_neck' name='neck'>
                <Transform translation='0 1.47 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.3 0.32 0.35' roughness='0.5'/>
                    </Appearance>
                    <Cylinder height='0.08' radius='0.055'/>
                  </Shape>
                </Transform>
              </HAnimSegment>

              <HAnimJoint DEF='hanim_skullbase' name='skullbase' center='0 1.55 0'>
                <HAnimSegment DEF='hanim_head' name='head'>
                  <Transform translation='0 1.65 0'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.85 0.86 0.88' roughness='0.3' specularColor='0.5 0.5 0.5'/>
                      </Appearance>
                      <Sphere radius='0.12'/>
                    </Shape>
                  </Transform>
                  <!-- Stylized Visor at eye level (y ~ 1.65) -->
                  <Transform translation='0 1.65 0.1'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.05 0.6 0.8' emissiveColor='0.02 0.3 0.4' roughness='0.1'/>
                      </Appearance>
                      <Box size='0.16 0.04 0.06'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>

            <!-- Left Arm -->
            <HAnimJoint DEF='hanim_l_shoulder' name='l_shoulder' center='0.2 1.38 0'>
              <HAnimSegment DEF='hanim_l_upperarm' name='l_upperarm'>
                <Transform translation='0.22 1.24 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.75 0.77 0.8' roughness='0.4'/>
                    </Appearance>
                    <Cylinder height='0.24' radius='0.045'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='hanim_l_elbow' name='l_elbow' center='0.22 1.1 0'>
                <HAnimSegment DEF='hanim_l_forearm' name='l_forearm'>
                  <Transform translation='0.22 0.97 0'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.7 0.72 0.75' roughness='0.4'/>
                      </Appearance>
                      <Cylinder height='0.22' radius='0.04'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='hanim_l_wrist' name='l_wrist' center='0.22 0.84 0'>
                  <HAnimSegment DEF='hanim_l_hand' name='l_hand'>
                    <Transform translation='0.22 0.78 0'>
                      <Shape>
                        <Appearance>
                          <Material diffuseColor='0.3 0.32 0.35' roughness='0.5'/>
                        </Appearance>
                        <Sphere radius='0.045'/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>

            <!-- Right Arm raised forward holding object -->
            <HAnimJoint DEF='hanim_r_shoulder' name='r_shoulder' center='-0.2 1.38 0' rotation='1 0 0 -0.5'>
              <HAnimSegment DEF='hanim_r_upperarm' name='r_upperarm'>
                <Transform translation='-0.22 1.25 0.05' rotation='1 0 0 -0.3'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.75 0.77 0.8' roughness='0.4'/>
                    </Appearance>
                    <Cylinder height='0.24' radius='0.045'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='hanim_r_elbow' name='r_elbow' center='-0.22 1.15 0.12' rotation='1 0 0 -0.6'>
                <HAnimSegment DEF='hanim_r_forearm' name='r_forearm'>
                  <Transform translation='-0.22 1.12 0.26' rotation='1 0 0 1.2'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.7 0.72 0.75' roughness='0.4'/>
                      </Appearance>
                      <Cylinder height='0.22' radius='0.04'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='hanim_r_wrist' name='r_wrist' center='-0.22 1.1 0.4'>
                  <HAnimSegment DEF='hanim_r_hand' name='r_hand'>
                    <Transform translation='-0.22 1.1 0.42'>
                      <Shape>
                        <Appearance>
                          <Material diffuseColor='0.3 0.32 0.35' roughness='0.5'/>
                        </Appearance>
                        <Sphere radius='0.045'/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                  <!-- Site for holding item on the right hand -->
                  <HAnimSite DEF='RightHandSite' name='r_hand_site' translation='-0.22 1.18 0.48'>
                    <Shape DEF='HeldSphere'>
                      <Appearance>
                        <Material diffuseColor='0.9 0.3 0.15' emissiveColor='0.4 0.1 0.05' roughness='0.2' specularColor='1 0.8 0.7'/>
                      </Appearance>
                      <Sphere radius='0.085'/>
                    </Shape>
                  </HAnimSite>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

        <!-- Left Leg -->
        <HAnimJoint DEF='hanim_l_hip' name='l_hip' center='0.1 0.88 0'>
          <HAnimSegment DEF='hanim_l_thigh' name='l_thigh'>
            <Transform translation='0.1 0.68 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.7 0.72 0.75' roughness='0.4'/>
                </Appearance>
                <Cylinder height='0.36' radius='0.06'/>
              </Shape>
            </Transform>
          </HAnimSegment>
          <HAnimJoint DEF='hanim_l_knee' name='l_knee' center='0.1 0.48 0'>
            <HAnimSegment DEF='hanim_l_calf' name='l_calf'>
              <Transform translation='0.1 0.28 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.65 0.67 0.7' roughness='0.4'/>
                  </Appearance>
                  <Cylinder height='0.34' radius='0.05'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='hanim_l_ankle' name='l_ankle' center='0.1 0.08 0'>
              <HAnimSegment DEF='hanim_l_foot' name='l_foot'>
                <Transform translation='0.1 0.04 0.05'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.25 0.27 0.3' roughness='0.6'/>
                    </Appearance>
                    <Box size='0.1 0.06 0.2'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

        <!-- Right Leg -->
        <HAnimJoint DEF='hanim_r_hip' name='r_hip' center='-0.1 0.88 0'>
          <HAnimSegment DEF='hanim_r_thigh' name='r_thigh'>
            <Transform translation='-0.1 0.68 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.7 0.72 0.75' roughness='0.4'/>
                </Appearance>
                <Cylinder height='0.36' radius='0.06'/>
              </Shape>
            </Transform>
          </HAnimSegment>
          <HAnimJoint DEF='hanim_r_knee' name='r_knee' center='-0.1 0.48 0'>
            <HAnimSegment DEF='hanim_r_calf' name='r_calf'>
              <Transform translation='-0.1 0.28 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.65 0.67 0.7' roughness='0.4'/>
                  </Appearance>
                  <Cylinder height='0.34' radius='0.05'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='hanim_r_ankle' name='r_ankle' center='-0.1 0.08 0'>
              <HAnimSegment DEF='hanim_r_foot' name='r_foot'>
                <Transform translation='-0.1 0.04 0.05'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.25 0.27 0.3' roughness='0.6'/>
                    </Appearance>
                    <Box size='0.1 0.06 0.2'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

      </HAnimJoint>
    </HAnimHumanoid>
  </Scene>
</X3D>