<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Four-Planet Planetarium'/>
    <meta name='description' content='A luminous yellow Sun and four independently animated planets, including a large ringed planet.'/>
  </head>
  <Scene>
    <WorldInfo title='Four-Planet Planetarium'/>
    <Background skyColor='0.003 0.005 0.018'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
    <Viewpoint description='Planetarium overview' position='0 18 28' orientation='1 0 0 -0.5713' fieldOfView='0.85' centerOfRotation='0 0 0'/>

    <PointLight location='0 0 0' color='1 0.88 0.61' intensity='2' ambientIntensity='0.15' radius='45' global='true'/>
    <DirectionalLight direction='-0.3 -1 -0.5' color='0.38 0.48 0.8' intensity='0.22'/>

    <Shape>
      <Appearance>
        <Material diffuseColor='1 0.78 0.02' emissiveColor='1 0.67 0.025'/>
      </Appearance>
      <Sphere radius='1.35'/>
    </Shape>

    <Transform scale='3.2 1 3.2'>
      <Shape DEF='OrbitGuide'>
        <Appearance>
          <Material emissiveColor='0.09 0.14 0.24'/>
