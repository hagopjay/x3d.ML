<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
    <meta name='title' content='Nested Gyroscope'/>
    <meta name='description' content='Three nested gimbal rings rotate about different axes at different speeds around a spinning central disc. Touch the disc to restart its spin cycle.'/>
  </head>
  <Scene>
    <WorldInfo title='Nested Gyroscope'/>
    <Background skyColor='0.018 0.027 0.05'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
    <Viewpoint description='Gyroscope — three rotating gimbals' position='9 6.5 13' orientation='-0.585 0.811 0 0.61' fieldOfView='0.65'/>
    <DirectionalLight direction='-0.4 -0.7 -1' intensity='1' color='0.85 0.92 1'/>
    <DirectionalLight direction='0.7 -0.2 0.6' intensity='0.75' color='1 0.72 0.4'/>
    <PointLight location='0 6 2' intensity='0.7' radius='20' color='0.6 0.8 1'/>

    <Transform translation='0 -3.45 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.045 0.06 0.085' specularColor='0.2 0.25 0.3' shininess='0.5'/>
        </Appearance>
        <Cylinder radius='3.4' height='0.3'/>
      </Shape>
    </Transform>
    <Transform translation='0 -3.7 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.025 0.035 0.055'/>
        </Appearance>
        <Box size='200 0.15 200'/>
      </Shape>
    </Transform>

    <Transform rotation='1 0 0 0.28'>
      <Transform DEF='OuterGimbal'>
        <Transform scale='3 3 3'>
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor='0.94 0.48 0.10' metallic='0.8' roughness='0.25'/>
            </Appearance>
            <Extrusion DEF='RingGeometry'
              creaseAngle='1.4'
              solid='false'
              crossSection='0.022 0.022, 0.022 -0.022, -0.022 -0.022, -0.022 0.022, 0.022 0.022'
              spine='
                1 0 0,
                0.980785 0 0.195090,
                0.923880 0 0.382683,
                0.831470 0 0.555570,
                0.707107 0 0.707107,
                0.555570 0 0.831470,
                0.382683 0 0.923880,
                0.195090 0 0.980785,
                0 0 1,
                -0.195090 0 0.980785,
                -0.382683 0 0.923880,
                -0.555570 0 0.831470,
                -0.707107 0 0.707107,
                -0.831470 0 0.555570,
                -0.923880 0 0.382683,
                -0.980785 0 0.195090,
                -1 0 0,
                -0.980785 0 -0.195090,
                -0.923880 0 -0.382683,
                -0.831470 0 -0.555570,
                -0.707107 0 -0.707107,
                -0.555570 0 -0.831470,
                -0.382683 0 -0.923880,
                -0.195090 0 -0.980785,
                0 0 -1,
                0.195090 0 -0.980785,
                0.382683 0 -0.923880,
                0.555570 0 -0.831470,
                0.707107 0 -0.707107,
                0.831470 0 -0.555570,
                0.923880 0 -0.382683,
                0.980785 0 -0.195090,
                1 0 0'/>
          </Shape>
        </Transform>

        <Transform DEF='MiddleGimbal'>
          <Transform scale='2.4 2.4 2.4'>
            <Shape>
              <Appearance>
                <PhysicalMaterial baseColor='0.08 0.62 0.85' metallic='0.75' roughness='0.23'/>
              </Appearance>
              <Extrusion USE='RingGeometry'/>
            </Shape>
          </Transform>

          <Transform DEF='InnerGimbal'>
            <Transform scale='1.8 1.8 1.8'>
              <Shape>
                <Appearance>
                  <PhysicalMaterial baseColor='0.83 0.88 0.95' metallic='0.9' roughness='0.2'/>
                </Appearance>
                <Extrusion USE='RingGeometry'/>
              </Shape>
            </Transform>

            <Shape>
              <Appearance>
                <PhysicalMaterial baseColor='0.22 0.26 0.32' metallic='0.85' roughness='0.25'/>
              </Appearance>
              <Cylinder radius='0.09' height='1.25'/>
            </Shape>

            <Transform DEF='Rotor'>
              <TouchSensor DEF='DiscTouch' description='Restart the central rotor spin'/>
              <Shape>
                <Appearance>
                  <PhysicalMaterial baseColor='0.32 0.38 0.47' metallic='0.9' roughness='0.23'/>
                </Appearance>
                <Cylinder radius='1.27' height='0.19'/>
              </Shape>

              <Transform translation='0 0.115 0'>
                <Shape>
                  <Appearance>
                    <PhysicalMaterial baseColor='0.82 0.44 0.09' metallic='0.8' roughness='0.25'/>
                  </Appearance>
                  <Cylinder radius='0.28' height='0.09'/>
                </Shape>
              </Transform>
              <Transform translation='0 -0.115 0'>
                <Shape>
                  <Appearance>
                    <PhysicalMaterial baseColor='0.82 0.44 0.09' metallic='0.8' roughness='0.25'/>
                  </Appearance>
                  <Cylinder radius='0.28' height='0.09'/>
                </Shape>
              </Transform>

              <Transform translation='0.72 0 0'>
                <Shape>
                  <Appearance DEF='RotorMark'>
                    <Material diffuseColor='1 0.65 0.12' emissiveColor='0.15 0.065 0'/>
                  </Appearance>
                  <Box size='0.82 0.208 0.12'/>
                </Shape>
              </Transform>
              <Transform translation='-0.72 0 0'>
                <Shape>
                  <Appearance USE='RotorMark'/>
                  <Box size='0.82 0.208 0.12'/>
                </Shape>
              </Transform>
              <Transform translation='0 0 0.72'>
                <Shape>
                  <Appearance USE='RotorMark'/>
                  <Box size='0.12 0.208 0.82'/>
                </Shape>
              </Transform>
              <Transform translation='0 0 -0.72'>
                <Shape>
                  <Appearance USE='RotorMark'/>
                  <Box size='0.12 0.208 0.82'/>
                </Shape>
              </Transform>
            </Transform>
          </Transform>
        </Transform>
      </Transform>
    </Transform>

    <TimeSensor DEF='OuterClock' cycleInterval='23' loop='true'/>
    <OrientationInterpolator DEF='OuterRotation'
      key='0 0.25 0.5 0.75 1'
      keyValue='0 0 1 0, 0 0 1 1.570796, 0 0 1 3.141593, 0 0 1 4.712389, 0 0 1 6.283185'/>
    <TimeSensor DEF='MiddleClock' cycleInterval='13' loop='true'/>
    <OrientationInterpolator DEF='MiddleRotation'
      key='0 0.25 0.5 0.75 1'
      keyValue='1 0 0 0, 1 0 0 -1.570796, 1 0 0 -3.141593, 1 0 0 -4.712389, 1 0 0 -6.283185'/>
    <TimeSensor DEF='InnerClock' cycleInterval='8' loop='true'/>
    <OrientationInterpolator DEF='InnerRotation'
      key='0 0.25 0.5 0.75 1'
      keyValue='0.707107 0.707107 0 0, 0.707107 0.707107 0 1.570796, 0.707107 0.707107 0 3.141593, 0.707107 0.707107 0 4.712389, 0.707107 0.707107 0 6.283185'/>
    <TimeSensor DEF='RotorClock' cycleInterval='1.4' loop='true'/>
    <OrientationInterpolator DEF='RotorRotation'
      key='0 0.25 0.5 0.75 1'
      keyValue='0 1 0 0, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185'/>

    <ROUTE fromNode='OuterClock' fromField='fraction_changed' toNode='OuterRotation' toField='set_fraction'/>
    <ROUTE fromNode='OuterRotation' fromField='value_changed' toNode='OuterGimbal' toField='set_rotation'/>
    <ROUTE fromNode='MiddleClock' fromField='fraction_changed' toNode='MiddleRotation' toField='set_fraction'/>
    <ROUTE fromNode='MiddleRotation' fromField='value_changed' toNode='MiddleGimbal' toField='set_rotation'/>
    <ROUTE fromNode='InnerClock' fromField='fraction_changed' toNode='InnerRotation' toField='set_fraction'/>
    <ROUTE fromNode='InnerRotation' fromField='value_changed' toNode='InnerGimbal' toField='set_rotation'/>
    <ROUTE fromNode='RotorClock' fromField='fraction_changed' toNode='RotorRotation' toField='set_fraction'/>
    <ROUTE fromNode='RotorRotation' fromField='value_changed' toNode='Rotor' toField='set_rotation'/>
    <ROUTE fromNode='DiscTouch' fromField='touchTime' toNode='RotorClock' toField='set_startTime'/>
  </Scene>
</X3D>