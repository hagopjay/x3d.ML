  <Scene>
    <Viewpoint description='Bouncing Ball' position='0 5 10' orientation='1 0 0 0.785398'/>
    <Transform DEF='BallTransform'>
      <Shape>
        <Sphere radius='0.5'/>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
      </Shape>
    </Transform>
    <TimeSensor DEF='Bouncer' cycleInterval='4' loop='true'/>
    <PositionInterpolator DEF='Bounce' key='0 0.25 0.5 0.75 1' keyValue='0 0 0 0 2 0 0 0 2 0 0 0 0 0 0'/>
    <ROUTE fromNode='Bouncer' fromField='fraction_changed' toNode='Bounce' toField='set_fraction'/>
    <ROUTE fromNode='Bounce' fromField='value_changed' toNode='BallTransform' toField='set_translation'/>
  </Scene>
