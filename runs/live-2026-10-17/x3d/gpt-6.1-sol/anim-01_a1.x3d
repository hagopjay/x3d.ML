<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <WorldInfo title='Rotating Blue Cube'/>
    <Background skyColor='0.08 0.09 0.13'/>
    <Viewpoint description='View of the rotating blue cube' position='0 1.5 7' orientation='1 0 0 -0.21'/>
    <Transform DEF='Cube'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.03 0.2 0.95'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='Spin' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Spin' toField='set_fraction'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='Cube' toField='set_rotation'/>
  </Scene>
</X3D>