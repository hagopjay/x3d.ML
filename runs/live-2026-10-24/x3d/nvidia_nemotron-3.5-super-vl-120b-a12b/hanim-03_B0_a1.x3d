<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='component' content='HAnim' version='2.0'/>
    <meta name='component' content='Core'/>
    <meta name='component' content='Grouping'/>
    <meta name='component' content='Shape'/>
    <meta name='component' content='Geometry3D'/>
    <meta name='component' content='Appearance'/>
    <meta name='component' content='Lighting'/>
    <meta name='component' content='Navigation'/>
  </head>
  <Scene>
    <Viewpoint description='Eye level viewpoint' position='0 1.6 3' orientation='0 0 1 0'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='true'/>
    <Background skyColor='0.7 0.8 1.0'/>
    <DirectionalLight intensity='0.7' direction='0 -1 0'/>
    <Group>
      <HAnimHumanoid version='2.0'>
        <HAnimSegment name='HAnimSegment'>
          <HAnimJoint name='rightHand'>
            <HAnimSite name='rightHandSite'/>
            <Transform translation='0 0 0'>
              <Shape DEF='sphere'>
                <Sphere radius='0.05'/>
                <Appearance>
                  <PhysicalMaterial baseColor='1 1 1'/>
                </Appearance>
              </Shape>
            </Transform>
          </HAnimJoint>
        </HAnimSegment>
      </HAnimHumanoid>
      <Transform translation='0 2 0'>
        <USE DEF='sphere'/>
      </Transform>
    </Group>
  </Scene>
</X3D>