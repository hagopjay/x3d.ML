<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<Background skyColor='0 0 0.2'/>
<Viewpoint description='Lighthouse on rocky island' position='0 10 30' orientation='0 1 0 3.14'/>
<!-- Sea plane -->
<Transform translation='0 -5 0'>
<Shape>
<Box size='200 1 200'/>
<Appearance>
<Material diffuseColor='0 0 0.5' emissiveColor='0 0 0.2'/>
</Appearance>
</Shape>
</Transform>
<!-- Island -->
<Transform translation='0 -4.5 0'>
<Shape>
<Sphere radius='8'/>
<Appearance>
<Material diffuseColor='0.3 0.2 0.1'/>
</Appearance>
</Shape>
</Transform>
<!-- Lighthouse -->
<Transform translation='0 0 0'>
<Group>
<!-- Tower base white -->
<Transform translation='0 5 0'>
<Shape>
<Cylinder radius='2' height='10'/>
<Appearance>
<Material diffuseColor='1 1 1'/>
</Appearance>
</Shape>
</Transform>
<!-- First red band -->
<Transform translation='0 10.5 0'>
<Shape>
<Cylinder radius='2' height='1'/>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
</Shape>
</Transform>
<!-- White section -->
<Transform translation='0 16 0'>
<Shape>
<Cylinder radius='1.8' height='10'/>
<Appearance>
<Material diffuseColor='1 1 1'/>
</Appearance>
</Shape>
</Transform>
<!-- Second red band -->
<Transform translation='0 21.5 0'>
<Shape>
<Cylinder radius='1.8' height='1'/>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
</Shape>
</Transform>
<!-- Top white section -->
<Transform translation='0 24.5 0'>
<Shape>
<Cylinder radius='1.5' height='5'/>
<Appearance>
<Material diffuseColor='1 1 1'/>
</Appearance>
</Shape>
</Transform>
<!-- Lantern room: glass cylinder -->
<Transform translation='0 28.5 0'>
<Shape>
<Cylinder radius='1.5' height='3'/>
<Appearance>
<Material diffuseColor='0.8 0.8 1' transparency='0.5'/>
</Appearance>
</Shape>
</Transform>
<!-- Lantern roof: cone -->
<Transform translation='0 31 0'>
<Shape>
<Cone bottomRadius='1.5' height='2'/>
<Appearance>
<Material diffuseColor='0.5 0.5 0.5'/>
</Appearance>
</Shape>
</Transform>
<!-- Beam: thin long box, rotates around Y axis at lantern center -->
<Transform DEF='BeamTransform' translation='0 28.5 0'>
<Shape>
<Box size='20 0.1 0.1'/>
<Appearance>
<Material diffuseColor='1 1 0' emissiveColor='1 1 0'/>
</Appearance>
</Shape>
</Transform>
<!-- Touch sensor for interaction -->
<TouchSensor DEF='TouchLighthouse'/>
</Group>
</Transform>
<!-- Animation -->
<TimeSensor DEF='Clock' cycleInterval='6' loop='true'/>
<OrientationInterpolator DEF='Spin' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0  0 1 0 1.57  0 1 0 3.14  0 1 0 4.71  0 1 0 6.28'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Spin' toField='set_fraction'/>
<ROUTE fromNode='Spin' fromField='value_changed' toNode='BeamTransform' toField='rotation'/>
<ROUTE fromNode='TouchLighthouse' fromField='touchTime' toNode='Clock' toField='startTime'/>
</Scene>
</X3D>