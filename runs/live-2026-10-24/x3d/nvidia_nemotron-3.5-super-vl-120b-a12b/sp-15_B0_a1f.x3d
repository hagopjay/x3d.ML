<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Friendly Robot'/>
  </head>
  <Scene>
    <Viewpoint description='Friendly robot with swinging arms' position='0 2 6' orientation='0 1 0 0'/>
    <DirectionalLight intensity='0.9' color='1 1 1' direction='0 -1 -0.5'/>

    <Transform>
      <Transform translation='0 0.7 0'>
        <Shape>
          <Box size='1 1.4 0.8'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.8 0.9'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform translation='0 1.4 0'>
        <Shape>
          <Sphere radius='0.5'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.9 0.9 0.9'/>
          </Appearance>
        </Shape>
        <Transform translation='-0.2 0.1 0.48'>
          <Shape>
            <Sphere radius='0.09'/>
            <Appearance>
              <EmissiveMaterial emissiveColor='1 1 0'/>
            </Appearance>
          </Shape>
        </Transform>
        <Transform translation='0.2 0.1 0.48'>
          <Shape>
            <Sphere radius='0.09'/>
            <Appearance>
              <EmissiveMaterial emissiveColor='1 1 0'/>
            </Appearance>
          </Shape>
        </Transform>
      </Transform>

      <Transform DEF='LeftArm' translation='-0.6 0.5 0'>
        <Transform translation='0 -0.4 0'>
          <Shape>
            <Cylinder radius='0.14' height='0.8'/>
            <Appearance>
              <PhysicalMaterial baseColor='0.8 0.8 0.9'/>
            </Appearance>
          </Shape>
        </Transform>
      </Transform>

      <Transform DEF='RightArm' translation='0.6 0.5 0'>
        <Transform translation='0 -0.4 0'>
          <Shape>
            <Cylinder radius='0.14' height='0.8'/>
            <Appearance>
              <PhysicalMaterial baseColor='0.8 0.8 0.9'/>
            </Appearance>
          </Shape>
        </Transform>
      </Transform>

      <Transform translation='-0.25 -0.8 0'>
        <Shape>
          <Cylinder radius='0.14' height='0.8'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.8 0.9'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0.25 -0.8 0'>
        <Shape>
          <Cylinder radius='0.14' height='0.8'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.8 0.9'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <TimeSensor DEF='Swing' cycleInterval='3' loop='TRUE'/>

    <OrientationInterpolator DEF='SwingLeft'
      key='0 0.25 0.5 0.75