<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
  </head>
  <Scene>
    <Viewpoint description="Torii gate in shallow water" position="0 5 10" orientation="0 1 0 -0.5"/>
    <DirectionalLight direction="0 -1 -0.5" color="1 0.9 0.8" intensity="0.8"/>
    <Background skyColor="0.5 0.7 1"/>
    <!-- Water plane -->
    <Shape>
      <Appearance>
        <PhysicalMaterial diffuseColor="0 0.3 0.8" transparency="0.5"/>
      </Appearance>
      <Box size="100 0.1 100"/>
    </Shape>
    <!-- Torii gate with animation -->
    <Transform DEF="ToriiTransform" translation="0 0.05 0">
      <TouchSensor DEF="TouchTorii"/>
      <Group>
        <!-- Left post -->
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.8 0.2 0.2" specularColor="0.3 0.3 0.3" shininess="0.2"/>
          </Appearance>
          <Cylinder radius="0.2" height="3" bottom="true" top="true" side="true"/>
        </Shape>
        <!-- Right post -->
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.8 0.2 0.2" specularColor="0.3 0.3 0.3" shininess="0.2"/>
          </Appearance>
          <Cylinder radius="0.2" height="3" bottom="true" top="true" side="true" translation="3 0 0"/>
        </Shape>
        <!-- Lower lintel (nuki) -->
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.8 0.2 0.2" specularColor="0.3 0.3 0.3" shininess="0.2"/>
          </Appearance>
          <Box size="4 0.3 0.4" translation="1.5 3.15 0"/>
        </Shape>
        <!-- Upper lintel (kasagi) -->
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.8 0.2 0.2" specularColor="0.3 0.3 0.3" shininess="0.2"/>
          </Appearance>
          <Box size="4.5 0.2 0.5" translation="1.5 3.5 0"/>
        </Shape>
      </Group>
    </Transform>
    <!-- Left stone lantern -->
    <Transform translation="-3 0.05 0">
      <Group>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.4 0.4 0.4" specularColor="0.2 0.2 0.2" shininess="0.1"/>
          </Appearance>
          <Box size="0.8 0.3 0.8" translation="0 0.15 0"/>
        </Shape>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.4 0.4 0.4" specularColor="0.2 0.2 0.2" shininess="0.1"/>
          </Appearance>
          <Cylinder radius="0.15" height="1.5" bottom="true" top="true" side="true" translation="0 1.05 0"/>
        </Shape>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.4 0.4 0.4" specularColor="0.2 0.2 0.2" shininess="0.1"/>
          </Appearance>
          <Cone bottomRadius="0.4" height="0.5" bottom="true" side="true" translation="0 2.05 0"/>
        </Shape>
      </Group>
    </Transform>
    <!-- Right stone lantern -->
    <Transform translation="3 0.05 0">
      <Group>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.4 0.4 0.4" specularColor="0.2 0.2 0.2" shininess="0.1"/>
          </Appearance>
          <Box size="0.8 0.3 0.8" translation="0 0.15 0"/>
        </Shape>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.4 0.4 0.4" specularColor="0.2 0.2 0.2" shininess="0.1"/>
          </Appearance>
          <Cylinder radius="0.15" height="1.5" bottom="true" top="true" side="true" translation="0 1.05 0"/>
        </Shape>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.4 0.4 0.4" specularColor="0.2 0.2 0.2" shininess="0.1"/>
          </Appearance>
          <Cone bottomRadius="0.4" height="0.5" bottom="true" side="true" translation="0 2.05 0"/>
        </Shape>
      </Group>
    </Transform>
    <!-- Animation -->
    <TimeSensor DEF="TS" cycleInterval="20" loop="true"/>
    <OrientationInterpolator DEF="OI" key="0 1" keyValue="0 1 0 0 0 1 0 6.283"/>
    <ROUTE fromNode="TS" fromField="fraction_changed" toNode="OI" toField="set_fraction"/>
    <ROUTE fromNode="OI" fromField="value_changed" toNode="ToriiTransform" toField="set_rotation"/>
  </Scene>
</X3D>
