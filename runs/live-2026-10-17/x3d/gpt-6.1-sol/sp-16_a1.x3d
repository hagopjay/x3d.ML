      </Transform>
      <Transform translation='0 2.28 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.88 0.58' emissiveColor='1 0.68 0.28'/>
          </Appearance>
          <Sphere radius='0.11'/>
        </Shape>
      </Transform>
      <PointLight location='0 2.25 0' color='1 0.69 0.36' intensity='1.8' radius='9' attenuation='1 0.12 0.035'/>
    </Transform>

    <!-- A small ceramic bowl on the table. -->
    <Transform translation='0 1.69 0.15'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.78 0.66 0.45' specularColor='0.22 0.18 0.12' shininess='0.3'/>
        </Appearance>
        <Cylinder radius='0.25' height='0.16'/>
      </Shape>
    </Transform>
    <Transform translation='0 1.775 0.15'>
      <Shape>
        <Appearance USE='DarkWood'/>
        <Cylinder radius='0.205' height='0.008'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>