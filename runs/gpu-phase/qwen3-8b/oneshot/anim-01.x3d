<Scene>
<Viewpoint description='Top View' position='0 5 0' orientation='0 1 0 0'/>
<Shape>
<Appearance>
<Material diffuseColor='0 0 1'/>
</Appearance>
<Box size='2 2 2'/>
</Shape>
<TimeSensor DEF='RotationTimer' cycleInterval='4' loop='TRUE'/>
<OrientationInterpolator DEF='RotationInterpolator' key='0 1' keyValue='0 1 0 0 0 1 0 1.5707'/>
<ROUTE fromNode='RotationTimer' fromField='fractionComplete' toNode='RotationInterpolator' toField='set_fraction'/>
