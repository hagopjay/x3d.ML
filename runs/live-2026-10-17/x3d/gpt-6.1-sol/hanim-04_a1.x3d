            <HAnimJoint DEF='RightShoulder' name='r_shoulder' center='-0.48 2.06 0'
                        skinCoordIndex='24 25 26 27 28 29 30 31'
                        skinCoordWeight='1 1 1 1 1 1 1 1'>
