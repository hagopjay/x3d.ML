<X3D profile='Full' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Campus Buildings GeoLocation'/>
    <meta name='description' content='Three campus buildings with GeoLocation markers, GeoViewpoints, GeoOrigin, and Text labels'/>
  </head>
  <Scene>
    <Viewpoint description='Campus Overview' position='0 10 20'/>
    
    <!-- Building 1: Library -->
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='40.4435 -79.9432 300'>
      <Transform translation='0 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.8 0.2 0.2'/>
          </Appearance>
          <Box size='5 5 5'/>
        </Shape>
      </Transform>
      <Transform translation='0 8 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0 0 0'/>
          </Appearance>
          <Text string='"Library"'>
            <FontStyle size='3' horizontal='MIDDLE' vertical='TOP'/>
          </Text>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem='"GD" "WE"' position='40.4435 -79.9432 300'/>
    
    <!-- Building 2: Science Hall -->
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='40.4440 -79.9420 310'>
      <Transform translation='0 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.2 0.8 0.2'/>
          </Appearance>
          <Box size='5 5 5'/>
        </Shape>
      </Transform>
      <Transform translation='0 8 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0 0 0'/>
          </Appearance>
          <Text string='"Science Hall"'>
            <FontStyle size='3' horizontal='MIDDLE' vertical='TOP'/>
          </Text>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem='"GD" "WE"' position='40.4440 -79.9420 310'/>
    
    <!-- Building 3: Student Center -->
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='40.4450 -79.9410 305'>
      <Transform translation='0 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.2 0.2 0.8'/>
          </Appearance>
          <Box size='5 5 5'/>
        </Shape>
      </Transform>
      <Transform translation='0 8 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0 0 0'/>
          </Appearance>
          <Text string='"Student Center"'>
            <FontStyle size='3' horizontal='MIDDLE' vertical='TOP'/>
          </Text>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem='"GD" "WE"' position='40.4450 -79.9410 305'/>
  </Scene>
</X3D>