<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="1"/>
    <meta name="title" content="Simple House"/>
  </head>
  <Scene>
    <Viewpoint description="Simple house with box body, pyramid roof, door, and windows" position="0 2 6"/>
    <DirectionalLight intensity="0.8" direction="-1 -1 -1"/>
    <Transform>
      <Shape DEF="HouseBody">
        <Appearance>
          <UnlitMaterial diffuseColor="0.85 0.78 0.68"/>
        </Appearance>
        <Box size="2 3 2"/>
      </Shape>
      <Transform translation="0 1.5 0">
        <Shape DEF="PyramidRoof">
          <Appearance>
            <UnlitMaterial diffuseColor="0.75 0.25 0.25"/>
          </Appearance>
          <IndexedFaceSet coordIndex="0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1" solid="false">
            <Coordinate point="-1 3 -1 1 3 -1 1 3 1 -1 3 1 0 5 0"/>
          </IndexedFaceSet>
        </Shape>
      </Transform>
      <Transform translation="0 0.75 1.01">
        <Shape DEF="Door">
          <Appearance>
            <UnlitMaterial diffuseColor="0.45 0.30 0.20"/>
          </Appearance>
          <Box size="0.5 1.5 0.1"/>
        </Shape>
      </Transform>
      <Transform translation="-0.75 1.5 1.01">
        <Shape DEF="Window1">
          <Appearance>
            <UnlitMaterial diffuseColor="0.30 0.55 0.85"/>
          </Appearance>
          <Box size="0.5 0.5 0.1"/>
        </Shape>
      </Transform>
      <Transform translation="0.75 1.5 1.01">
        <Shape DEF="Window2">
          <Appearance>
            <UnlitMaterial diffuseColor="0.30 0.55 0.85"/>
          </Appearance>
          <Box size="0.5 0.5 0.1"/>
        </Shape>
      </Transform>
    </Transform>
  </Scene>
</X3D>
