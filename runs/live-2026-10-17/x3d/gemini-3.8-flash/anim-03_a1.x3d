<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='door_open.x3d' name='title'/>
    <meta content='A door that swings open 90 degrees over 2 seconds when scene loads and remains open.' name='description'/>
    <meta content='X3D-Edit 4.0, https://savage.nps.edu/X3D-Edit' name='generator'/>
  </head>
  <Scene>
    <WorldInfo title='Swinging Door'/>

    <Viewpoint description='Front View of Door' position='0 1.2 3.2'/>

    <NavigationInfo type='"WALK" "ANY"'/>

    <DirectionalLight ambientIntensity='0.35' direction='-0.4 -0.8 -0.5' intensity='0.85'/>
    <DirectionalLight direction='0.4 -0.5 0.6' intensity='0.3'/>

    <ProximitySensor DEF='LoadTrigger' size='1000 1000 1000'/>
    <TimeSensor DEF='DoorTimer' cycleInterval='2.0' loop='false'/>
    <OrientationInterpolator DEF='DoorRotator' key='0 1' keyValue='0 1 0 0, 0 1 0 -1.570796'/>

    <ROUTE fromNode='LoadTrigger' fromField='enterTime' toNode='DoorTimer' toField='set_startTime'/>
    <ROUTE fromNode='DoorTimer' fromField='fraction_changed' toNode='DoorRotator' toField='set_fraction'/>
    <ROUTE fromNode='DoorRotator' fromField='value_changed' toNode='DoorPivot' toField='set_rotation'/>

    <!-- Floor -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.45 0.32 0.22' roughness='0.4'/>
        </Appearance>
        <Box size='6 0.1 6'/>
      </Shape>
    </Transform>

    <!-- Wall Left -->
    <Transform translation='-1.55 1.3 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.88 0.84'/>
        </Appearance>
        <Box size='2.0 2.6 0.1'/>
      </Shape>
    </Transform>

    <!-- Wall Right -->
    <Transform translation='1.55 1.3 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.88 0.84'/>
        </Appearance>
        <Box size='2.0 2.6 0.1'/>
      </Shape>
    </Transform>

    <!-- Wall Top -->
    <Transform translation='0 2.375 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.88 0.84'/>
        </Appearance>
        <Box size='1.1 0.45 0.1'/>
      </Shape>
    </Transform>

    <!-- Door Frame Left Post -->
    <Transform translation='-0.5 1.05 0'>
      <Shape>
        <Appearance DEF='FrameApp'>
          <Material diffuseColor='0.28 0.16 0.08'/>
        </Appearance>
        <Box size='0.1 2.1 0.12'/>
      </Shape>
    </Transform>

    <!-- Door Frame Right Post -->
    <Transform translation='0.5 1.05 0'>
      <Shape>
        <Appearance USE='FrameApp'/>
        <Box size='0.1 2.1 0.12'/>
      </Shape>
    </Transform>

    <!-- Door Frame Header -->
    <Transform translation='0 2.125 0'>
      <Shape>
        <Appearance USE='FrameApp'/>
        <Box size='1.1 0.07 0.12'/>
      </Shape>
    </Transform>

    <!-- Rotating Door Assembly hinged at left edge (x = -0.45) -->
    <Transform DEF='DoorPivot' translation='-0.45 0 0'>
      <TouchSensor DEF='DoorClick' description='Click to open or close door'/>
      <ROUTE fromNode='DoorClick' fromField='touchTime' toNode='DoorTimer' toField='set_startTime'/>

      <!-- Door Leaf -->
      <Transform translation='0.45 1.02 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.58 0.35 0.18' roughness='0.3'/>
          </Appearance>
          <Box size='0.9 2.04 0.045'/>
        </Shape>

        <!-- Decorative Panels (Front) -->
        <Transform translation='0 0.45 0.024'>
          <Shape>
            <Appearance DEF='InlayApp'>
              <Material diffuseColor='0.5 0.3 0.15'/>
            </Appearance>
            <Box size='0.7 0.75 0.005'/>
          </Shape>
        </Transform>
        <Transform translation='0 -0.45 0.024'>
          <Shape>
            <Appearance USE='InlayApp'/>
            <Box size='0.7 0.75 0.005'/>
          </Shape>
        </Transform>

        <!-- Decorative Panels (Back) -->
        <Transform translation='0 0.45 -0.024'>
          <Shape>
            <Appearance USE='InlayApp'/>
            <Box size='0.7 0.75 0.005'/>
          </Shape>
        </Transform>
        <Transform translation='0 -0.45 -0.024'>
          <Shape>
            <Appearance USE='InlayApp'/>
            <Box size='0.7 0.75 0.005'/>
          </Shape>
        </Transform>
      </Transform>

      <!-- Door Hardware (Handle & Plate) -->
      <Transform translation='0.8 1.0 0'>
        <!-- Front Backplate -->
        <Transform translation='0 0 0.025'>
          <Shape>
            <Appearance DEF='BrassApp'>
              <Material diffuseColor='0.85 0.7 0.25' metalness='0.8' roughness='0.2' specularColor='0.9 0.8 0.4'/>
            </Appearance>
            <Box size='0.05 0.18 0.006'/>
          </Shape>
        </Transform>

        <!-- Front Lever Handle -->
        <Transform rotation='1 0 0 1.570796' translation='0 0.03 0.05'>
          <Shape>
            <Appearance USE='BrassApp'/>
            <Cylinder height='0.05' radius='0.008'/>
          </Shape>
        </Transform>
        <Transform rotation='0 0 1 1.570796' translation='-0.05 0.03 0.075'>
          <Shape>
            <Appearance USE='BrassApp'/>
            <Cylinder height='0.1' radius='0.009'/>
          </Shape>
        </Transform>

        <!-- Back Backplate -->
        <Transform translation='0 0 -0.025'>
          <Shape>
            <Appearance USE='BrassApp'/>
            <Box size='0.05 0.18 0.006'/>
          </Shape>
        </Transform>

        <!-- Back Lever Handle -->
        <Transform rotation='1 0 0 1.570796' translation='0 0.03 -0.05'>
          <Shape>
            <Appearance USE='BrassApp'/>
            <Cylinder height='0.05' radius='0.008'/>
          </Shape>
        </Transform>
        <Transform rotation='0 0 1 1.570796' translation='-0.05 0.03 -0.075'>
          <Shape>
            <Appearance USE='BrassApp'/>
            <Cylinder height='0.1' radius='0.009'/>
          </Shape>
        </Transform>
      </Transform>

      <!-- Hinges -->
      <Transform translation='0 1.7 0'>
        <Shape>
          <Appearance USE='BrassApp'/>
          <Cylinder height='0.08' radius='0.012'/>
        </Shape>
      </Transform>
      <Transform translation='0 0.35 0'>
        <Shape>
          <Appearance USE='BrassApp'/>
          <Cylinder height='0.08' radius='0.012'/>
        </Shape>
      </Transform>
    </Transform>
  </Scene>
</X3D>