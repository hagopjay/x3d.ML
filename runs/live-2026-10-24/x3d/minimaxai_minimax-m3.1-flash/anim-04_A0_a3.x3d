<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Color-cycling sphere'/>
    <meta name='description' content='A sphere whose colour cycles red, green, blue over 6 seconds using a ColorInterpolator. Touch the sphere to pause the animation.'/>
  </head>
  <Scene>
    <Viewpoint description='View of the sphere cycling red, green and blue every 6 seconds' position='0 0 5' orientation='0 0 1 0' fieldOfView='0.7854'/>
    <Background color='0.08 0.08 0.12'/>
    <PointLight position='0 0 6' intensity='0.9'/>
    <PointLight position='3 -3 2' intensity='0.4'/>

    <TimeSensor DEF='Clock' cycleInterval='6' loop='true'/>
    <ColorInterpolator DEF='ColourCycle'
                      keyTime='0 0.5 1'
                      keyColor='1 0 0  0 1 0  0 0 1'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='ColourCycle' toField='set_fraction'/>

    <Shape>
      <Appearance>
        <Material DEF='SphereMaterial' diffuseColor='1 0 0' specularColor='0.2 0.2 0.2' shininess='0.4'/>
      </Appearance>
      <Sphere radius='1'/>
      <TouchSensor DEF='SphereTouch'/>
    </Shape>
    <ROUTE fromNode='ColourCycle' fromField='value_changed' toNode='SphereMaterial' toField='diffuseColor'/>
    <ROUTE fromNode='SphereTouch' fromField='isActive' toNode='Clock' toField='pause'/>
  </Scene>
</X3D>