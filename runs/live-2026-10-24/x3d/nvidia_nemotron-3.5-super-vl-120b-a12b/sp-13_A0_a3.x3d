<X3D profile='Full' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Rocket Launch'/>
  </head>
  <Scene>
    <Viewpoint description='Rocket on launch pad with gantry tower' position='0 10 -30'/>
    <DirectionalLight intensity='0.8' color='1 1 1' direction='0 -1 -1'/>
    
    <Transform translation='0 0 0'>
      <Shape>
        <Box size='20 1 20'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.4 0.4 0.4'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <Transform translation='8 5 0'>
      <Shape>
        <Box size='2 20 2'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.6 0.6 0.6'/>
        </Appearance>
      </Shape>
      <Transform translation='0 10 0'>
        <Shape>
          <Box size='6 1 2'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.6 0.6 0.6'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    
    <Transform DEF='Rocket' translation='0 0.5 0'>
      <Shape>
        <Cylinder radius='1' height='10'/>
        <Appearance>
          <PhysicalMaterial baseColor='1 0.1 0.1'/>
        </Appearance>
      </Shape>
      <Transform translation='0 5.5 0'>
        <Shape>
          <Cone bottomRadius='1.5' height='3'/>
          <Appearance>
            <PhysicalMaterial baseColor='1 0.1 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 -0.5 0' rotation='1 0 0 3.14159'>
        <Shape>
          <Cone bottomRadius='1' height='4'/>
          <Appearance>
            <UnlitMaterial emissiveColor='1 0.4 0'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    
    <TimeSensor DEF='LaunchTimer' cycleInterval='12' loop='false' startTime='0'/>
    <PositionInterpolator DEF='RocketPath' key='0 0.5 1' keyValue='0 0.5 0 0 25 -40 0 50 -80'/>
    
    <ROUTE fromNode='LaunchTimer' fromField='fraction_changed' toNode='RocketPath' toField='set_fraction'/>
    <ROUTE fromNode='RocketPath' fromField='value_changed' toNode='Rocket' toField='set_translation'/>
  </Scene>
</X3D>