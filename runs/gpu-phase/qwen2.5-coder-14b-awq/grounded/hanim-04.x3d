  <Scene>
    <Background skyColor='0.5 0.5 1'/>
    <Viewpoint description='HAnim Humanoids' position='0 0 10'/>
    
    <!-- First HAnim Humanoid -->
    <Transform translation='-2 0 0'>
      <HAnimHumanoid name='Humanoid1' version='2.0'>
        <HAnimJoint name='Root'>
          <HAnimSegment DEF='RootSegment'>
            <Shape>
              <Box size='0.5 0.5 0.5'/>
              <Appearance>
                <Material diffuseColor='1 0 0'/> <!-- Red skin -->
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint name='Head'>
            <HAnimSegment DEF='HeadSegment'>
              <Shape>
                <Sphere radius='0.2'/>
                <Appearance>
                  <Material diffuseColor='1 0.8 0.6'/> <!-- Light brown skin -->
                </Appearance>
              </Shape>
            </HAnimSegment>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimHumanoid>
    </Transform>
    
    <!-- Second HAnim Humanoid using shared joint hierarchy -->
    <Transform translation='2 0 0'>
      <HAnimHumanoid name='Humanoid2' version='2.0'>
        <HAnimJoint name='Root'>
          <HAnimSegment USE='RootSegment'>
            <Shape>
              <Box size='0.5 0.5 0.5'/>
              <Appearance>
                <Material diffuseColor='0 1 0'/> <!-- Green skin -->
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint name='Head'>
            <HAnimSegment USE='HeadSegment'>
              <Shape>
                <Sphere radius='0.2'/>
                <Appearance>
                  <Material diffuseColor='0.8 0.6 0.4'/> <!-- Dark brown skin -->
                </Appearance>
              </Shape>
            </HAnimSegment>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimHumanoid>
    </Transform>
  </Scene>
