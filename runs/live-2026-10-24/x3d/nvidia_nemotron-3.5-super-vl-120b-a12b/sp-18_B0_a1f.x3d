<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <meta name="title" content="Aquarium"/>
  </head>
  <Scene>
    <Viewpoint description="Aquarium with transparent tank, sand floor, orange fish, and green plants" position="0 4 12"/>
    <Background skyColor="0.1 0.3 0.6" groundColor="0.9 0.8 0.7"/>
    <DirectionalLight direction="0 -1 -0.3" intensity="0.7"/>
    <AmbientLight intensity="0.3"/>
    <Material DEF="sandMat" diffuseColor="0.9 0.8 0.6"/>
    <Material DEF="glassMat" diffuseColor="0.8 0.9 1.0" transparency="0.6" specularColor="0.2 0.2 0.3"/>
    <Material DEF="fishMat" diffuseColor="1 0.5 0"/>
    <Material DEF="plantMat" diffuseColor="0 0.6 0"/>
    <Transform translation="0 -4.5 0" scale="14 0.2 14">
      <Shape>
        <Box/>
        <Appearance>
          <Material USE="sandMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation="0 0 0">
      <Shape>
        <Box size="12 10 12"/>
        <Appearance>
          <Material USE="glassMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <TimeSensor DEF="ts1" cycleInterval="4" loop="TRUE"/>
    <PositionInterpolator DEF="pi1" key="0 0.25 0.5 0.75 1" keyValue="3 -1 0 0 -1 3 -3 -1 0 0 -1 -3 3 -1 0"/>
    <Transform DEF="fish1" translation="3 -1 0" rotation="0 0 1 -1.57079632679">
      <Shape>
        <Cone bottomRadius="0.15" height="0.5"/>
        <Appearance>
          <Material USE="fishMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <ROUTE fromNode="ts1" fromField="fraction_changed" toNode="pi1" toField="set_fraction"/>
    <ROUTE fromNode="pi1" fromField="value_changed" toNode="fish1" toField="set_translation"/>
    <TimeSensor DEF="ts2" cycleInterval="5" loop="TRUE"/>
    <PositionInterpolator DEF="pi2" key="0 0.25 0.5 0.75 1" keyValue="2.5 0 0 0 0 2.5 -2.5 0 0 0 0 -2.5 2.5 0 0"/>
    <Transform DEF="fish2" translation="2.5 0 0" rotation="0 0 1 -1.57079632679">
      <Shape>
        <Cone bottomRadius="0.15" height="0.5"/>
        <Appearance>
          <Material USE="fishMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <ROUTE fromNode="ts2" fromField="fraction_changed" toNode="pi2" toField="set_fraction"/>
    <ROUTE fromNode="pi2" fromField="value_changed" toNode="fish2" toField="set_translation"/>
    <TimeSensor DEF="ts3" cycleInterval="6" loop="TRUE"/>
    <PositionInterpolator DEF="pi3" key="0 0.25 0.5 0.75 1" keyValue="2 1 0 0 1 2 -2 1 0 0 1 -2 2 1 0"/>
    <Transform DEF="fish3" translation="2 1 0" rotation="0 0 1 -1.57079632679">
      <Shape>
        <Cone bottomRadius="0.15" height="0.5"/>
        <Appearance>
          <Material USE="fishMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <ROUTE fromNode="ts3" fromField="fraction_changed" toNode="pi3" toField="set_fraction"/>
    <ROUTE fromNode="pi3" fromField="value_changed" toNode="fish3" toField="set_translation"/>
    <TimeSensor DEF="ts4" cycleInterval="7" loop="TRUE"/>
    <PositionInterpolator DEF="pi4" key="0 0.25 0.5 0.75 1" keyValue="1.5 2 0 0 2 1.5 -1.5 2 0 0 2 -1.5 1.5 2 0"/>
    <Transform DEF="fish4" translation="1.5 2 0" rotation="0 0 1 -1.57079632679">
      <Shape>
        <Cone bottomRadius="0.15" height="0.5"/>
        <Appearance>
          <Material USE="fishMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <ROUTE fromNode="ts4" fromField="fraction_changed" toNode="pi4" toField="set_fraction"/>
    <ROUTE fromNode="pi4" fromField="value_changed" toNode="fish4" toField="set_translation"/>
    <TimeSensor DEF="ts5" cycleInterval="8" loop="TRUE"/>
    <PositionInterpolator DEF="pi5" key="0 0.25 0.5 0.75 1" keyValue="1 3 0 0 3 1 -1 3 0 0 3 -1 1 3 0"/>
    <Transform DEF="fish5" translation="1 3 0" rotation="0 0 1 -1.57079632679">
      <Shape>
        <Cone bottomRadius="0.15" height="0.5"/>
        <Appearance>
          <Material USE="fishMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <ROUTE fromNode="ts5" fromField="fraction_changed" toNode="pi5" toField="set_fraction"/>
    <ROUTE fromNode="pi5" fromField="value_changed" toNode="fish5" toField="set_translation"/>
    <Transform translation="-4 -4.4 4">
      <Shape>
        <Cylinder radius="0.12" height="0.8"/>
        <Appearance>
          <Material USE="plantMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation="4 -4.4 4">
      <Shape>
        <Cylinder radius="0.12" height="0.8"/>
        <Appearance>
          <Material USE="plantMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation="-4 -4.4 -4">
      <Shape>
        <Cylinder radius="0.12" height="0.8"/>
        <Appearance>
          <Material USE="plantMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation="4 -4.4 -4">
      <Shape>
        <Cylinder radius="0.12" height="0.8"/>
        <Appearance>
          <Material USE="plantMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation="0 -4.4 5">
      <Shape>
        <Cylinder radius="0.12" height="0.8"/>
        <Appearance>
          <Material USE="plantMat"/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation="0 -4.4 -5">
      <Shape>
        <Cylinder radius="0.12" height="0.8"/>
        <Appearance>
          <Material USE="plantMat"/>
        </Appearance>
      </Shape>
    </Transform>
  </Scene>
</X3D>
