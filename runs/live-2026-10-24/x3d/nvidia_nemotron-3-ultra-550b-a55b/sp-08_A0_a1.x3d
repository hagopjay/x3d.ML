<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint position='0 30 40' description='City block with central tower'/>
    <!-- Ground plane with grey streets -->
    <Shape>
      <Appearance>
        <Material diffuseColor='0.4 0.4 0.4'/>
      </Appearance>
      <Box size='40 0.2 40'/>
    </Shape>
    <!-- Building 1 (front-left) -->
    <Transform translation='-12 2.5 -12'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.3 0.3'/>
        </Appearance>
        <Box size='8 5 8'/>
      </Shape>
    </Transform>
    <!-- Building 2 (front-center) -->
    <Transform translation='0 5 -12'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.7 0.3'/>
        </Appearance>
        <Box size='8 10 8'/>
      </Shape>
    </Transform>
    <!-- Building 3 (front-right) -->
    <Transform translation='12 3.5 -12'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.8'/>
        </Appearance>
        <Box size='8 7 8'/>
      </Shape>
    </Transform>
    <!-- Building 4 (middle-left) -->
    <Transform translation='-12 4 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.8 0.2'/>
        </Appearance>
        <Box size='8 8 8'/>
      </Shape>
    </Transform>
    <!-- Building 5 (central tower) -->
    <Transform translation='0 15 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.2'/>
        </Appearance>
        <Box size='8 30 8'/>
      </Shape>
    </Transform>
    <!-- Blinking red light on top of central tower -->
    <Transform translation='0 30.5 0' DEF='LightTransform'>
      <Shape>
        <Appearance>
          <Material DEF='LightMaterial' diffuseColor='1 0 0' emissiveColor='1 0 0'/>
        </Appearance>
        <Box size='1 1 1'/>
      </Shape>
    </Transform>
    <!-- Building 6 (middle-right) -->
    <Transform translation='12 6 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.4 0.8'/>
        </Appearance>
        <Box size='8 12 8'/>
      </Shape>
    </Transform>
    <!-- Building 7 (back-left) -->
    <Transform translation='-12 3 12'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.4 0.8 0.8'/>
        </Appearance>
        <Box size='8 6 8'/>
      </Shape>
    </Transform>
    <!-- Building 8 (back-center) -->
    <Transform translation='0 4.5 12'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.6 0.3 0.6'/>
        </Appearance>
        <Box size='8 9 8'/>
      </Shape>
    </Transform>
    <!-- Building 9 (back-right) -->
    <Transform translation='12 2.5 12'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.5 0.2'/>
        </Appearance>
        <Box size='8 5 8'/>
      </Shape>
    </Transform>
    <!-- Animation for blinking light -->
    <TimeSensor DEF='BlinkTimer' cycleInterval='1' loop='true'/>
    <ColorInterpolator DEF='BlinkColor' key='0 0.5 1' keyValue='1 0 0  0 0 0  1 0 0'/>
    <ROUTE fromNode='BlinkTimer' fromField='fraction_changed' toNode='BlinkColor' toField='set_fraction'/>
    <ROUTE fromNode='BlinkColor' fromField='value_changed' toNode='LightMaterial' toField='diffuseColor'/>
  </Scene>
</X3D>