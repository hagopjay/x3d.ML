            <Appearance>
              <UnlitMaterial emissiveColor='1 0 0'/>
            </Appearance>
          </Shape>
        </HAnimSegment>
        <HAnimJoint name='sacroiliac' jointIndex='1'>
          <HAnimSegment name='sacrum_segment' segmentIndex='1' jointName='sacroiliac'>
            <Shape>
              <Box size='0.08 0.08 0.08'/>
              <Appearance>
                <UnlitMaterial emissiveColor='0 1 0'/>
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint name='l_hip' jointIndex='2'>
            <HAnimSegment name='l_thigh_segment' segmentIndex='2' jointName='l_hip'>
              <Shape>
                <Box size='0.06 0.06 0.06'/>
                <Appearance>
                  <UnlitMaterial emissiveColor='0 0 1'/>
                </Appearance>
              </Shape>
            </HAnimSegment>
          </HAnimJoint>
          <HAnimJoint name='r_hip' jointIndex='3'>
            <HAnimSegment name='r_thigh_segment' segmentIndex='3' jointName='r_hip'>
              <Shape>
                <Box size='0.06 0.06 0.06'/>
                <Appearance>
                  <UnlitMaterial emissiveColor='0 0 1'/>
                </Appearance>
              </Shape>
            </HAnimSegment>
          </HAnimJoint>
        </HAnimJoint>
