    </Transform>
    <Transform translation='9 16.7 -9'>
      <Shape>
        <Appearance USE='RoofApp'/>
        <Cone bottomRadius='3.2' height='4.2'/>
      </Shape>
    </Transform>

    <!-- Flagpole and Red Flag on Tallest Tower -->
    <Transform translation='9 20 -9'>
      <Shape>
