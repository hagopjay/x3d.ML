<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Street Lamp'/>
    <component name='Shape' level='1'/>
  </head>
  <Scene>
    <Viewpoint description='A street lamp with a PointLight at the top that is on by default.' position='0 3 6'/>
    <Transform translation='0 0 0'>
      <Shape>
        <Appearance>
          <UnlitMaterial emissiveColor='0.6 0.6 0.6'/>
        </Appearance>
        <Cylinder height='6' radius='0.08'/>
      </Shape>
    </Transform>
    <Transform translation='0 6 0'>
      <Shape>
        <Appearance>
          <UnlitMaterial emissiveColor='0.9 0.9 0.7'/>
        </Appearance>
        <Box size='0.5 0.3 0.5'/>
      </Shape>
      <PointLight location='0 0 0' radius='25' intensity='1.2' on='true'/>
    </Transform>
  </Scene>
</X3D>