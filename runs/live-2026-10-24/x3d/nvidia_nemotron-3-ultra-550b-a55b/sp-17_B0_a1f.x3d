<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <Scene>
    <Viewpoint description="Pendulum Clock" position="0 1.5 5"/>
    <!-- Wooden case -->
    <Transform translation="0 1 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.55 0.27 0.07"/>
        </Appearance>
        <Box size="0.5 2.5 0.3"/>
      </Shape>
    </Transform>
    <!-- Clock face -->
    <Transform translation="0 2.3 0.16">
      <Shape>
        <Appearance>
          <Material diffuseColor="1 1 1"/>
        </Appearance>
        <Cylinder radius="0.2" height="0.02"/>
      </Shape>
      <!-- Tick marks -->
      <Transform DEF="TickMark" translation="0 0.18 0.01">
        <Shape>
          <Appearance>
            <Material diffuseColor="0 0 0"/>
          </Appearance>
          <Box size="0.01 0.04 0.005"/>
        </Shape>
      </Transform>
      <Transform rotation="0 0 1 0.523599">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 1.0472">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 1.5708">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 2.0944">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 2.618">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 3.14159">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 3.66519">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 4.18879">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 4.71239">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 5.23599">
        <USE node="TickMark"/>
      </Transform>
      <Transform rotation="0 0 1 5.75959">
        <USE node="TickMark"/>
      </Transform>
    </Transform>
    <!-- Pendulum -->
    <Transform DEF="PendulumPivot" translation="0 2.0 0">
      <Transform DEF="Pendulum">
        <Transform translation="0 -0.5 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.8 0.6 0.2"/>
            </Appearance>
            <Cylinder radius="0.01" height="1"/>
          </Shape>
        </Transform>
        <Transform translation="0 -1 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.8 0.6 0.2"/>
            </Appearance>
            <Sphere radius="0.05"/>
          </Shape>
        </Transform>
      </Transform>
    </Transform>
    <!-- Animation -->
    <TimeSensor DEF="ClockTimer" cycleInterval="2" loop="true"/>
    <OrientationInterpolator DEF="Swing" key="0 0.5 1" keyValue="1 0 0 -0.3  1 0 0 0  1 0 0 0.3"/>
    <ROUTE fromNode="ClockTimer" fromField="fraction_changed" toNode="Swing" toField="set_fraction"/>
    <ROUTE fromNode="Swing" fromField="value_changed" toNode="Pendulum" toField="rotation"/>
  </Scene>
</X3D>
