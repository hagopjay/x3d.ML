<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Friendly Robot' position='0 1.5 5'/>
    <Transform>
      <!-- Body -->
      <Transform translation='0 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.6 0.6 0.6'/>
          </Appearance>
          <Box size='1 1.5 0.5'/>
        </Shape>
      </Transform>
      <!-- Head -->
      <Transform translation='0 1.2 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.6 0.6 0.6'/>
          </Appearance>
          <Sphere radius='0.4'/>
        </Shape>
      </Transform>
      <!-- Left Eye -->
      <Transform translation='-0.12 1.25 0.35'>
        <Shape>
          <Appearance>
            <Material emissiveColor='1 1 0' diffuseColor='0 0 0'/>
          </Appearance>
          <Sphere radius='0.07'/>
        </Shape>
      </Transform>
      <!-- Right Eye -->
      <Transform translation='0.12 1.25 0.35'>
        <Shape>
          <Appearance>
            <Material emissiveColor='1 1 0' diffuseColor='0 0 0'/>
          </Appearance>
          <Sphere radius='0.07'/>
        </Shape>
      </Transform>
      <!-- Left Arm (animated) -->
      <Transform DEF='LeftArmTransform' translation='-0.55 0.5 0'>
        <Transform translation='0 -0.5 0'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.6 0.6 0.6'/>
            </Appearance>
            <Cylinder radius='0.1' height='1.0'/>
          </Shape>
        </Transform>
      </Transform>
      <!-- Right Arm (animated) -->
      <Transform DEF='RightArmTransform' translation='0.55 0.5 0'>
        <Transform translation='0 -0.5 0'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.6 0.6 0.6'/>
            </Appearance>
            <Cylinder radius='0.1' height='1.0'/>
          </Shape>
        </Transform>
      </Transform>
      <!-- Left Leg -->
      <Transform translation='-0.25 -0.75 0'>
        <Transform translation='0 -0.5 0'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.6 0.6 0.6'/>
            </Appearance>
            <Cylinder radius='0.1' height='1.0'/>
          </Shape>
        </Transform>
      </Transform>
      <!-- Right Leg -->
      <Transform translation='0.25 -0.75 0'>
        <Transform translation='0 -0.5 0'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.6 0.6 0.6'/>
            </Appearance>
            <Cylinder radius='0.1' height='1.0'/>
          </Shape>
        </Transform>
      </Transform>
    </Transform>
    <!-- Animation -->
    <TimeSensor DEF='RobotTimeSensor' cycleInterval='2' loop='true'/>
    <OrientationInterpolator DEF='LeftArmInterpolator' key='0 0.5 1' keyValue='0 1 0 0  1 0 0 -0.5  0 1 0 0'/>
    <OrientationInterpolator DEF='RightArmInterpolator' key='0 0.5 1' keyValue='0 1 0 0  1 0 0 0.5  0 1 0 0'/>
    <ROUTE fromNode='RobotTimeSensor' fromField='fraction_changed' toNode='LeftArmInterpolator' toField='set_fraction'/>
    <ROUTE fromNode='RobotTimeSensor' fromField='fraction_changed' toNode='RightArmInterpolator' toField='set_fraction'/>
    <ROUTE fromNode='LeftArmInterpolator' fromField='value_changed' toNode='LeftArmTransform' toField='rotation'/>
    <ROUTE fromNode='RightArmInterpolator' fromField='value_changed' toNode='RightArmTransform' toField='rotation'/>
  </Scene>
</X3D>