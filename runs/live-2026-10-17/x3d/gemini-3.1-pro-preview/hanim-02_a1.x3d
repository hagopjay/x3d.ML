<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='1'/>
  </head>
  <Scene>
    <Viewpoint description='View HAnim Waving' position='0 1.2 4'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    
    <TimeSensor DEF='WaveClock' cycleInterval='0.6' loop='true'/>
    <OrientationInterpolator DEF='WaveRotator' key='0 0.5 1' keyValue='0 0 1 -2.2, 0 0 1 -2.8, 0 0 1 -2.2'/>
    
    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='WaveRotator' toField='set_fraction'/>
    <ROUTE fromNode='WaveRotator' fromField='value_changed' toNode='r_shoulder' toField='set_rotation'/>

    <HAnimHumanoid name='WavingFigure' version='2.0'>
      <HAnimJoint name='humanoid_root' center='0 1 0' containerField='skeleton'>
        
        <HAnimSegment name='sacrum'>
          <Transform translation='0 1.25 0'>
            <Shape>
              <Box size='0.3 0.5 0.2'/>
              <Appearance>
                <PhysicalMaterial baseColor='0.2 0.6 1.0' roughness='0.8' metalness='0.1'/>
              </Appearance>
            </Shape>
          </Transform>
        </HAnimSegment>

        <HAnimJoint name='vl5' center='0 1.5 0'>
          <HAnimSegment name='c5'>
            <Transform translation='0 1.6 0'>