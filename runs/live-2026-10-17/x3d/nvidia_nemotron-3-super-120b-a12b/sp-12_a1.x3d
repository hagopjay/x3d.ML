<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Head>
 <meta name='title' content='Tree with apples'/>
</Head>
<Scene>
 <!-- Grass plane -->
 <Shape>
  <Appearance>
   <PhysicalMaterial baseColor='0.2 0.8 0.2'/>
  </Appearance>
  <Box size='20 0.1 20'/>
 </Shape>
 <!-- Trunk -->
 <Transform translation='0 1 0'>
  <Shape>
   <Appearance>
    <PhysicalMaterial baseColor='0.4 0.2 0.1'/>
   </Appearance>
   <Cylinder radius='0.5' height='2'/>
  </Shape>
 </Transform>
 <!-- Foliage: three cones -->
 <Transform translation='0 3 0'>
  <Shape>
   <Appearance>
    <PhysicalMaterial baseColor='0 0.6 0'/>
   </Appearance>
   <Cone bottomRadius='1' height='2'/>
  </Shape>
 </Transform>
 <Transform translation='0 3 0' rotation='0 1 0 0.2'>
  <Shape>
   <Appearance>
    <PhysicalMaterial baseColor='0 0.6 0'/>
   </Appearance>
   <Cone bottomRadius='1' height='2'/>
  </Shape>
 </Transform>
 <Transform translation='0 3 0' rotation='0 1 0 -0.2'>
  <Shape>
   <Appearance>
    <PhysicalMaterial baseColor='0 0.6 0'/>
   </Appearance>
   <Cone bottomRadius='1' height='2'/>
  </Shape>
 </Transform>
 <!-- Apple geometry -->
 <Shape DEF='Apple'>
  <Appearance>
   <PhysicalMaterial baseColor='0.8 0 0'/>
  </Appearance>
  <Sphere radius='0.15'/>
 </Shape>
 <!-- Animation -->
 <TimeSensor DEF='BobTimer' cycleInterval='2' loop='true'/>
 <PositionInterpolator DEF='BobInterpolator'
        key='0 0.5 1'
        keyValue='0 0 0  0 0.2 0  0 0 0'/>
 <!-- Routes for animation -->
 <ROUTE fromNode='BobTimer' fromField='fraction_changed' toNode='BobInterpolator' toField='set_fraction'/>
 <!-- Apples -->
 <!-- Apple 0 -->
 <Transform translation='1 3.5 0'>
  <Transform DEF='AppleBob0' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 1 -->
 <Transform translation='0.809 3.5 0.588'>
  <Transform DEF='AppleBob1' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 2 -->
 <Transform translation='0.309 3.5 0.951'>
  <Transform DEF='AppleBob2' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 3 -->
 <Transform translation='-0.309 3.5 0.951'>
  <Transform DEF='AppleBob3' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 4 -->
 <Transform translation='-0.809 3.5 0.588'>
  <Transform DEF='AppleBob4' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 5 -->
 <Transform translation='-1 3.5 0'>
  <Transform DEF='AppleBob5' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 6 -->
 <Transform translation='-0.809 3.5 -0.588'>
  <Transform DEF='AppleBob6' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 7 -->
 <Transform translation='-0.309 3.5 -0.951'>
  <Transform DEF='AppleBob7' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 8 -->
 <Transform translation='0.309 3.5 -0.951'>
  <Transform DEF='AppleBob8' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Apple 9 -->
 <Transform translation='0.809 3.5 -0.588'>
  <Transform DEF='AppleBob9' translation='0 0 0'>
   <Shape USE='Apple'/>
  </Transform>
 </Transform>
 <!-- Routes for bobbing -->
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob0' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob1' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob2' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob3' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob4' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob5' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob6' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob7' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob8' toField='translation'/>
 <ROUTE fromNode='BobInterpolator' fromField='value_changed' toNode='AppleBob9' toField='translation'/>
 <!-- Viewpoint -->
 <Viewpoint description='Tree with apples' position='0 5 -10'/>
</Scene>
</X3D>