<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='1'/>
  </head>
  <Scene>
    <Viewpoint description='Two humanoids side by side' position='0 0 5'/>
    <!-- First humanoid (red) -->
    <Transform translation='-1 0 0'>
      <HAnimHumanoid DEF='Humanoid1' version='2.0' name='Humanoid1'>
        <HAnimJoint DEF='Root1' containerField='joints' name='HumanoidRoot' center='0 0 0'>
          <HAnimJoint containerField='children' name='spine' center='0 0.1 0'>
            <HAnimJoint containerField='children' name='neck' center='0 0.2 0'>
              <HAnimJoint containerField='children' name='head' center='0 0.3 0'/>
            </HAnimJoint>
            <HAnimJoint containerField='children' name='l_shoulder' center='-0.15 0.15 0'>
              <HAnimJoint containerField='children' name='l_elbow' center='-0.3 0.15 0'>
                <HAnimJoint containerField='children' name='l_wrist' center='-0.45 0.15 0'/>
              </HAnimJoint>
            </HAnimJoint>
            <HAnimJoint containerField='children' name='r_shoulder' center='0.15 0.15 0'>
              <HAnimJoint containerField='children' name='r_elbow' center='0.3 0.15 0'>
                <HAnimJoint containerField='children' name='r_wrist' center='0.45 0.15 0'/>
              </HAnimJoint>
            </HAnimJoint>
            <HAnimJoint containerField='children' name='l_hip' center='-0.1 -0.1 0'>
              <HAnimJoint containerField='children' name='l_knee' center='-0.1 -0.3 0'>
                <HAnimJoint containerField='children' name='l_ankle' center='-0.1 -0.5 0'/>
              </HAnimJoint>
            </HAnimJoint>
            <HAnimJoint containerField='children' name='r_hip' center='0.1 -0.1 0'>
              <HAnimJoint containerField='children' name='r_knee' center='0.1 -0.3 0'>
                <HAnimJoint containerField='children' name='r_ankle' center='0.1 -0.5 0'/>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>
        <HAnimSegment containerField='segments' name='Body'>
          <HAnimJoint USE='Root1' containerField='joint' name='spine'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='1 0 0'/>
            </Appearance>
            <Box size='0.3 0.4 0.2'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='Head'>
          <HAnimJoint USE='Root1' containerField='joint' name='head'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='1 0 0'/>
            </Appearance>
            <Box size='0.2 0.2 0.2'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='LeftArm'>
          <HAnimJoint USE='Root1' containerField='joint' name='l_shoulder'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='1 0 0'/>
            </Appearance>
            <Box size='0.1 0.4 0.1'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='RightArm'>
          <HAnimJoint USE='Root1' containerField='joint' name='r_shoulder'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='1 0 0'/>
            </Appearance>
            <Box size='0.1 0.4 0.1'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='LeftLeg'>
          <HAnimJoint USE='Root1' containerField='joint' name='l_hip'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='1 0 0'/>
            </Appearance>
            <Box size='0.1 0.5 0.1'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='RightLeg'>
          <HAnimJoint USE='Root1' containerField='joint' name='r_hip'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='1 0 0'/>
            </Appearance>
            <Box size='0.1 0.5 0.1'/>
          </Shape>
        </HAnimSegment>
      </HAnimHumanoid>
    </Transform>
    <!-- Second humanoid (blue) sharing joint hierarchy via USE -->
    <Transform translation='1 0 0'>
      <HAnimHumanoid DEF='Humanoid2' version='2.0' name='Humanoid2'>
        <HAnimJoint USE='Root1' containerField='joints'/>
        <HAnimSegment containerField='segments' name='Body'>
          <HAnimJoint USE='Root1' containerField='joint' name='spine'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='0 0 1'/>
            </Appearance>
            <Box size='0.3 0.4 0.2'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='Head'>
          <HAnimJoint USE='Root1' containerField='joint' name='head'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='0 0 1'/>
            </Appearance>
            <Box size='0.2 0.2 0.2'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='LeftArm'>
          <HAnimJoint USE='Root1' containerField='joint' name='l_shoulder'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='0 0 1'/>
            </Appearance>
            <Box size='0.1 0.4 0.1'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='RightArm'>
          <HAnimJoint USE='Root1' containerField='joint' name='r_shoulder'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='0 0 1'/>
            </Appearance>
            <Box size='0.1 0.4 0.1'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='LeftLeg'>
          <HAnimJoint USE='Root1' containerField='joint' name='l_hip'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='0 0 1'/>
            </Appearance>
            <Box size='0.1 0.5 0.1'/>
          </Shape>
        </HAnimSegment>
        <HAnimSegment containerField='segments' name='RightLeg'>
          <HAnimJoint USE='Root1' containerField='joint' name='r_hip'/>
          <Shape containerField='geometry'>
            <Appearance>
              <Material diffuseColor='0 0 1'/>
            </Appearance>
            <Box size='0.1 0.5 0.1'/>
          </Shape>
        </HAnimSegment>
      </HAnimHumanoid>
    </Transform>
  </Scene>
</X3D>