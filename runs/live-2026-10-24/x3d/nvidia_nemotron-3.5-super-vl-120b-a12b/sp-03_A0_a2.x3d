<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<head>
<meta name='title' content="Newton's Cradle"/>
<meta name='description' content='Five polished steel balls hung by wires; outer left and outer right balls swing out and back in turn.'/>
</head>
<Scene>
<Viewpoint description='Newton's Cradle' position='0 2 6' orientation='0 1 0 0'/>
<NavigationInfo type='"EXAMINE" "ANY"'/>
<Background skyColor='0.7 0.8 1.0'/>

<PhysicalMaterial DEF='FRAME_MAT' baseColor='0.05 0.05 0.05' metalness='0.1' roughness='0.8'/>
<PhysicalMaterial DEF='BALL_MAT' baseColor='0.7 0.7 0.8' metalness='0.95' roughness='0.05'/>

<!-- Frame -->
<Transform translation='0 3 0'>
  <Shape>
    <Appearance><PhysicalMaterial USE='FRAME_MAT'/></Appearance>
    <Box size='3 0.1 0.2'/>
  </Shape>
</Transform>
<Transform translation='-1.4 1.5 0'>
  <Shape>
    <Appearance><PhysicalMaterial USE='FRAME_MAT'/></Appearance>
    <Box size='0.1 3 0.2'/>
  </Shape>
</Transform>
<Transform translation='1.4 1.5 0'>
  <Shape>
    <Appearance><PhysicalMaterial USE='FRAME_MAT'/></Appearance>
    <Box size='0.1 3 0.2'/>
  </Shape>
</Transform>

<!-- Static middle balls -->
<Transform translation='-0.4 1 0'>
  <Shape>
    <Appearance><PhysicalMaterial USE='BALL_MAT'/></Appearance>
    <Sphere radius='0.2'/>
  </Shape>
</Transform>
<Transform translation='0 1 0'>
  <Shape>
    <Appearance><PhysicalMaterial USE='BALL_MAT'/></Appearance>
    <Sphere radius='0.2'/>
  </Shape>
</Transform>
<Transform translation='0.4 1 0'>
  <Shape>
    <Appearance><PhysicalMaterial USE='BALL_MAT'/></Appearance>
    <Sphere radius='0.2'/>
  </Shape>
</Transform>

<!-- Animated outer left ball -->
<Transform DEF='PIVOT_LEFT' translation='-0.8 3 0'>
  <Transform translation='0 -1 0'>
    <Shape>
      <Appearance><PhysicalMaterial USE='FRAME_MAT'/></Appearance>
      <Cylinder radius='0.015' height='2'/>
    </Shape>
  </Transform>
  <Transform translation='0 -2 0'>
    <Shape>
      <Appearance><PhysicalMaterial USE='BALL_MAT'/></Appearance>
      <Sphere radius='0.2'/>
    </Shape>
  </Transform>
</Transform>

<!-- Animated outer right ball -->
<Transform DEF='PIVOT_RIGHT' translation='0.8 3 0'>
  <Transform translation='0 -1 0'>
    <Shape>
      <Appearance><PhysicalMaterial USE='FRAME_MAT'/></Appearance>
      <Cylinder radius='0.015' height='2'/>
    </Shape>
  </Transform>
  <Transform translation='0 -2 0'>
    <Shape>
      <Appearance><PhysicalMaterial USE='BALL_MAT'/></Appearance>
      <Sphere radius='0.2'/>
    </Shape>
  </Transform>
</Transform>

<!-- Animation -->
<TimeSensor DEF='TS' cycleInterval='6' loop='TRUE'/>
<OrientationInterpolator DEF='OI_LEFT' key='0 0.125 0.25 0.5 1' keyValue='0 0 1 0  0 0 1 0.4  0 0 1 0  0 0 1 0  0 0 1 0'/>
<OrientationInterpolator DEF='OI_RIGHT' key='0 0.5 0.75 0.875 1' keyValue='0 0 1 0  0 0 1 0  0 0 1 -0.4  0 0 1 0  0 0 1 0'/>

<ROUTE fromNode='TS' fromEvent='fraction_changed' toNode='OI_LEFT' toEvent='set_fraction'/>
<ROUTE fromNode='OI_LEFT' fromEvent='value_changed' toNode='PIVOT_LEFT' toEvent='rotation'/>
<ROUTE fromNode='TS' fromEvent='fraction_changed' toNode='OI_RIGHT' toEvent='set_fraction'/>
<ROUTE fromNode='OI_RIGHT' fromEvent='value_changed' toNode='PIVOT_RIGHT' toEvent='rotation'/>

</Scene>
</X3D>