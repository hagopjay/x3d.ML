<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Box highlight on hover' position='0 0 5'/>
    <NavigationInfo type='EXAMINE'/>
    <Transform>
      <Shape>
        <Appearance>
          <Material DEF='BoxMaterial' diffuseColor='0.8 0.8 0.8' emissiveColor='0 0 0'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
      <TouchSensor DEF='TouchSensor1'/>
    </Transform>
    <Script DEF='HighlightScript'>
      <field name='isOver' type='SFBool' accessType='inputOnly'/>
      <field name='emissiveColor' type='SFColor' accessType='outputOnly'/>
      <![CDATA[
        ecmascript:
        function initialize() {
          emissiveColor = new SFColor(0, 0, 0);
        }
        function set_isOver(value) {
          if (value) {
            emissiveColor = new SFColor(1, 1, 0); // yellow
          } else {
            emissiveColor = new SFColor(0, 0, 0);
          }
        }
      ]]>
    </Script>
    <ROUTE fromNode='TouchSensor1' fromField='isOver' toNode='HighlightScript' toField='isOver'/>
    <ROUTE fromNode='HighlightScript' fromField='emissiveColor' toNode='BoxMaterial' toField='set_emissiveColor'/>
  </Scene>
</X3D>