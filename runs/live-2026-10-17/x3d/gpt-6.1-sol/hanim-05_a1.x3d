<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='1'/>
    <meta name='title' content='Touch to Wave'/>
    <meta name='description' content='Touch the articulated HAnim figure to start a friendly wave.'/>
  </head>
  <Scene>
    <WorldInfo title='Touch to Wave'/>
    <Background skyColor='0.075 0.11 0.18'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='true'/>
    <Viewpoint description='Touch the figure to wave' position='0 2.1 8' centerOfRotation='0 1.8 0' fieldOfView='0.65'/>
    <DirectionalLight direction='-0.5 -1 -0.8' intensity='0.85'/>
    <DirectionalLight direction='0.6 -0.3 1' intensity='0.4' color='0.6 0.75 1'/>

    <Transform translation='0 -0.12 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.15 0.2 0.28'/>
        </Appearance>
        <Cylinder radius='2.1' height='0.18'/>
      </Shape>
    </Transform>

    <Group>
      <TouchSensor DEF='FigureTouch' description='Touch me to wave!'/>

      <HAnimHumanoid name='FriendlyFigure' version='2.0'>
        <HAnimJoint containerField='skeleton' DEF='Root' name='humanoid_root' center='0 1.55 0'>
          <HAnimJoint DEF='Pelvis' name='sacroiliac' center='0 1.55 0'>
            <HAnimSegment name='pelvis'>
              <Transform translation='0 1.53 0'>
                <Shape>
                  <Appearance DEF='Trousers'>
                    <Material diffuseColor='0.12 0.19 0.34'/>
                  </Appearance>
                  <Box size='0.68 0.36 0.4'/>
                </Shape>
              </Transform>
            </HAnimSegment>

            <HAnimJoint DEF='LeftHip' name='l_hip' center='0.23 1.48 0'>
              <HAnimSegment name='l_thigh'>
                <Transform translation='0.23 1.15 0'>
                  <Shape>
                    <Appearance USE='Trousers'/>
                    <Cylinder radius='0.16' height='0.65'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='LeftKnee' name='l_knee' center='0.23 0.82 0'>
                <HAnimSegment name='l_calf'>
                  <Transform translation='0.23 0.51 0'>
                    <Shape>
                      <Appearance USE='Trousers'/>
                      <Cylinder radius='0.135' height='0.62'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='LeftAnkle' name='l_ankle' center='0.23 0.2 0'>
                  <HAnimSegment name='l_hindfoot'>
                    <Transform translation='0.23 0.12 0.09'>
                      <Shape>
                        <Appearance DEF='Shoes'>
                          <Material diffuseColor='0.035 0.05 0.075' specularColor='0.2 0.2 0.2'/>
                        </Appearance>
                        <Box size='0.31 0.2 0.52'/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>

            <HAnimJoint DEF='RightHip' name='r_hip' center='-0.23 1.48 0'>
              <HAnimSegment name='r_thigh'>
                <Transform translation='-0.23 1.15 0'>
                  <Shape>
                    <Appearance USE='Trousers'/>
                    <Cylinder radius='0.16' height='0.65'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='RightKnee' name='r_knee' center='-0.23 0.82 0'>
                <HAnimSegment name='r_calf'>
                  <Transform translation='-0.23 0.51 0'>
                    <Shape>
                      <Appearance USE='Trousers'/>
                      <Cylinder radius='0.135' height='0.62'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='RightAnkle' name='r_ankle' center='-0.23 0.2 0'>
                  <HAnimSegment name='r_hindfoot'>
                    <Transform translation='-0.23 0.12 0.09'>
                      <Shape>
                        <Appearance USE='Shoes'/>
                        <Box size='0.31 0.2 0.52'/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

          <HAnimJoint DEF='Waist' name='vl5' center='0 1.7 0'>
            <HAnimSegment name='l5'>
              <Transform translation='0 2.08 0' scale='0.51 0.59 0.27'>
                <Shape>
                  <Appearance DEF='Shirt'>
                    <Material diffuseColor='0.025 0.58 0.62' specularColor='0.2 0.3 0.3'/>
                  </Appearance>
                  <Sphere/>
                </Shape>
              </Transform>
            </HAnimSegment>

            <HAnimJoint DEF='Neck' name='vc7' center='0 2.57 0'>
              <HAnimSegment name='c7'>
                <Transform translation='0 2.68 0'>
                  <Shape>
                    <Appearance DEF='Skin'>
                      <Material diffuseColor='0.78 0.49 0.3' specularColor='0.15 0.12 0.1'/>
                    </Appearance>
                    <Cylinder radius='0.125' height='0.27'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='Head' name='skullbase' center='0 2.8 0'>
                <HAnimSegment name='skull'>
                  <Transform translation='0 3.03 0' scale='0.32 0.38 0.29'>
                    <Shape>
                      <Appearance USE='Skin'/>
                      <Sphere/>
                    </Shape>
                  </Transform>
                  <Transform translation='0 3.25 -0.035' scale='0.325 0.19 0.285'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.075 0.04 0.025'/>
                      </Appearance>
                      <Sphere/>
                    </Shape>
                  </Transform>
                  <Transform translation='-0.105 3.07 0.265'>
                    <Shape>
                      <Appearance DEF='Eyes'>
                        <Material diffuseColor='0.025 0.025 0.035'/>
                      </Appearance>
                      <Sphere radius='0.035'/>
                    </Shape>
                  </Transform>
                  <Transform translation='0.105 3.07 0.265'>
                    <Shape>
                      <Appearance USE='Eyes'/>
                      <Sphere radius='0.035'/>
                    </Shape>
                  </Transform>
                  <Transform translation='0 2.94 0.277' scale='0.095 0.032 0.018'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.35 0.09 0.065'/>
                      </Appearance>
                      <Sphere/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>

            <HAnimJoint DEF='LeftShoulder' name='l_shoulder' center='0.48 2.45 0'>
              <HAnimSegment name='l_upperarm'>
                <Transform translation='0.59 2.19 0' rotation='0 0 1 0.4'>
                  <Shape>
                    <Appearance USE='Shirt'/>
                    <Cylinder radius='0.125' height='0.56'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='LeftElbow' name='l_elbow' center='0.7 1.93 0'>
                <HAnimSegment name='l_forearm'>
                  <Transform translation='0.7 1.69 0'>
                    <Shape>
                      <Appearance USE='Skin'/>
                      <Cylinder radius='0.095' height='0.48'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='LeftWrist' name='l_wrist' center='0.7 1.45 0'>
                  <HAnimSegment name='l_hand'>
                    <Transform translation='0.7 1.34 0' scale='0.115 0.16 0.075'>
                      <Shape>
                        <Appearance USE='Skin'/>
                        <Sphere/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>

            <HAnimJoint DEF='RightShoulder' name='r_shoulder' center='-0.48 2.45 0'>
              <HAnimSegment name='r_upperarm'>
                <Transform translation='-0.735 2.71 0' rotation='0 0 1 0.776'>
                  <Shape>
                    <Appearance USE='Shirt'/>
                    <Cylinder radius='0.125' height='0.73'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='RightElbow' name='r_elbow' center='-0.99 2.97 0'>
                <HAnimSegment name='r_forearm'>
                  <Transform translation='-0.99 3.22 0'>
                    <Shape>
                      <Appearance USE='Skin'/>
                      <Cylinder radius='0.095' height='0.5'/>
                    </Shape>
                  </Transform>
                  <Transform translation='-0.99 2.97 0'>
                    <Shape>
                      <Appearance USE='Skin'/>
                      <Sphere radius='0.105'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='RightWrist' name='r_wrist' center='-0.99 3.47 0'>
                  <HAnimSegment name='r_hand'>
                    <Transform translation='-0.99 3.61 0' scale='0.135 0.19 0.075'>
                      <Shape>
                        <Appearance USE='Skin'/>
                        <Sphere/>
                      </Shape>
                    </Transform>
                    <Transform translation='-0.85 3.55 0' rotation='0 0 1 -0.5' scale='0.055 0.1 0.055'>
                      <Shape>
                        <Appearance USE='Skin'/>
                        <Sphere/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

        <HAnimJoint containerField='joints' USE='Root'/>
        <HAnimJoint containerField='joints' USE='Pelvis'/>
        <HAnimJoint containerField='joints' USE='LeftHip'/>
        <HAnimJoint containerField='joints' USE='LeftKnee'/>
        <HAnimJoint containerField='joints' USE='LeftAnkle'/>
        <HAnimJoint containerField='joints' USE='RightHip'/>
        <HAnimJoint containerField='joints' USE='RightKnee'/>
        <HAnimJoint containerField='joints' USE='RightAnkle'/>
        <HAnimJoint containerField='joints' USE='Waist'/>
        <HAnimJoint containerField='joints' USE='Neck'/>
        <HAnimJoint containerField='joints' USE='Head'/>
        <HAnimJoint containerField='joints' USE='LeftShoulder'/>
        <HAnimJoint containerField='joints' USE='LeftElbow'/>
        <HAnimJoint containerField='joints' USE='LeftWrist'/>
        <HAnimJoint containerField='joints' USE='RightShoulder'/>
        <HAnimJoint containerField='joints' USE='RightElbow'/>
        <HAnimJoint containerField='joints' USE='RightWrist'/>
      </HAnimHumanoid>
    </Group>

    <Transform translation='0 -0.48 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.85 0.93 1'/>
        </Appearance>
        <Text string='"Touch me to wave!"'>
          <FontStyle justify='"MIDDLE" "MIDDLE"' size='0.2'/>
        </Text>
      </Shape>
    </Transform>

    <TimeSensor DEF='WaveClock' cycleInterval='3.2' loop='false'/>
    <OrientationInterpolator DEF='WaveMotion'
      key='0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1'
      keyValue='0 0 1 0,
                0 0 1 -0.4,
                0 0 1 0.4,
                0 0 1 -0.4,
                0 0 1 0.4,
                0 0 1 -0.4,
                0 0 1 0.4,
                0 0 1 -0.3,
                0 0 1 0'/>
    <ROUTE fromNode='FigureTouch' fromField='touchTime' toNode='WaveClock' toField='set_startTime'/>
    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='WaveMotion' toField='set_fraction'/>
    <ROUTE fromNode='WaveMotion' fromField='value_changed' toNode='RightElbow' toField='set_rotation'/>
  </Scene>
</X3D>