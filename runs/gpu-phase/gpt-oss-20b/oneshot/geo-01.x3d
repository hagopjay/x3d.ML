  <Scene>
    <!-- GeoLocation at Virginia Tech Drillfield -->
    <GeoLocation DEF='Drillfield' geoSystem='"GD" "WE"' geoCoords='37.2284 -80.4234 630' />
    <!-- GeoViewpoint at the same location -->
    <GeoViewpoint DEF='DrillfieldView' geoSystem='"GD" "WE"' position='37.2284 -80.4234 630' description='View of Drillfield flagpole' />
    <!-- Standard Viewpoint for initial view -->
    <Viewpoint DEF='InitialView' description='Initial view of flagpole' position='0 0 20' orientation='0 1 0 0' />
    <!-- Flagpole -->
    <Transform translation='0 0 0' rotation='0 0 0 0'>
      <!-- Flagpole base -->
      <Shape>
        <Appearance>
          <Material diffuseColor='0.6 0.6 0.6' specularColor='0.2 0.2 0.2' shininess='0.5' />
        </Appearance>
        <Cylinder radius='0.05' height='10' />
      </Shape>
      <!-- Flag -->
      <Transform translation='0 5 0.05'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0 0' specularColor='0.1 0.1 0.1' shininess='0.2' />
          </Appearance>
          <Box size='5 2 0.01' />
        </Shape>
      </Transform>
    </Transform>
  </Scene>
</X3D>