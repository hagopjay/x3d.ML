<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Simple House' position='0 5 10'/>
    <Group>
      <Transform DEF='Body' translation='0 1 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.8 0.6 0.4'/>
          </Appearance>
          <Box size='6 4 6'/>
        </Shape>
      </Transform>
      <Transform DEF='Roof' translation='0 3 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.6 0.2 0.2'/>
          </Appearance>
          <IndexedFaceSet coordIndex='0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1'>
            <Coordinate point='-3 0 -3 3 0 -3 3 0 3 -3 0 3 0 2 0'/>
          </IndexedFaceSet>
        </Shape>
      </Transform>
      <Transform DEF='Door' translation='0 0.5 3.01'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.4 0.2 0.1'/>
          </Appearance>
          <Box size='1.5 2.5 0.1'/>
        </Shape>
      </Transform>
      <Transform DEF='Window1' translation='-2 1.5 3.01'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.7 0.9 1.0' transparency='0.5'/>
          </Appearance>
          <Box size='1 1 0.1'/>
        </Shape>
      </Transform>
      <Transform DEF='Window2' translation='2 1.5 3.01'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.7 0.9 1.0' transparency='0.5'/>
          </Appearance>
          <Box size='1 1 0.1'/>
        </Shape>
      </Transform>
    </Group>
    <Switch whichChoice='-1'>
      <Transform USE='Body'/>
      <Transform USE='Roof'/>
      <Transform USE='Door'/>
      <Transform USE='Window1'/>
      <Transform USE='Window2'/>
    </Switch>
  </Scene>
</X3D>