<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
 <head>
  <meta name='title' content='Proximity-triggered spotlight'/>
 </head>
 <component name='Shape' level='1'/>
 <Scene>
  <Viewpoint description='Approach the statue within 5 metres to activate the spotlight.' position='0 2 8'/>
  <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
  <DirectionalLight intensity='0.3' direction='0 -1 0'/>
  <Group>
   <Transform translation='0 0 0'>
    <Shape>
     <Appearance><UnlitMaterial emissiveColor='0.55 0.4 0.3'/></Appearance>
     <Cylinder height='2' radius='0.2'/>
    </Shape>
   </Transform>
   <Transform translation='0 1.1 0'>
    <Shape>
     <Appearance><UnlitMaterial emissiveColor='0.55 0.4 0.3'/></Appearance>
     <Sphere radius='0.25'/>
    </Shape>
   </Transform>
  </Group>
  <SpotLight DEF='SPOT' on='false' location='0 4 0' direction='0 -1 0' cutOffAngle='0.5' beamWidth='0.3' intensity='3.0' radius='20'/>
  <ProximitySensor DEF='PROX' center='0 0 0' size='10 10 10'/>
  <ROUTE fromNode='PROX' fromField='isActive' toNode='SPOT' toField='on'/>
 </Scene>
</X3D>