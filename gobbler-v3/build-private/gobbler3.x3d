    <ROUTE fromNode='LightEmberPath' fromField='value_changed' toNode='LightEmberOrb' toField='set_translation'/>
    <ROUTE fromNode='LightEmberPath' fromField='value_changed' toNode='FacetShader' toField='light1'/>
    <ROUTE fromNode='LightEmberPath' fromField='value_changed' toNode='LineShader' toField='light1'/>
    <ROUTE fromNode='LightEmberPath' fromField='value_changed' toNode='PointShader' toField='light1'/>
    <TimeSensor DEF='LightCyanClock' cycleInterval='29' loop='true'/>
    <PositionInterpolator DEF='LightCyanPath' key='0 0.021 0.042 0.062 0.083 0.104 0.125 0.146 0.167 0.188 0.208 0.229 0.25 0.271 0.292 0.312 0.333 0.354 0.375 0.396 0.417 0.438 0.458 0.479 0.5 0.521 0.542 0.562 0.583 0.604 0.625 0.646 0.667 0.688 0.708 0.729 0.75 0.771 0.792 0.812 0.833 0.854 0.875 0.896 0.917 0.938 0.958 0.979 1'
      keyValue='12.88 1.5 4.3, 13.52 1.09 3.91, 14.08 0.65 3.56, 14.54 0.17 3.24, 14.89 -0.33 2.97, 15.14 -0.85 2.75, 15.28 -1.38 2.58, 15.29 -1.9 2.47, 15.19 -2.4 2.41, 14.98 -2.89 2.41, 14.66 -3.35 2.47, 14.23 -3.77 2.58, 13.7 -4.15 2.75, 13.08 -4.48 2.97, 12.39 -4.75 3.24, 11.63 -4.96 3.56, 10.81 -5.11 3.91, 9.96 -5.18 4.3, 9.08 -5.2 4.71, 8.19 -5.14 5.14, 7.31 -5.01 5.58, 6.44 -4.82 6.02, 5.61 -4.57 6.46, 4.84 -4.26 6.89, 4.12 -3.9 7.3, 3.48 -3.49 7.69, 2.92 -3.05 8.04, 2.46 -2.57 8.36, 2.11 -2.07 8.63, 1.86 -1.55 8.85, 1.72 -1.02 9.02, 1.71 -0.5 9.13, 1.81 0 9.19, 2.02 0.49 9.19, 2.34 0.95 9.13, 2.77 1.37 9.02, 3.3 1.75 8.85, 3.92 2.08 8.63, 4.61 2.35 8.36, 5.37 2.56 8.04, 6.19 2.71 7.69, 7.04 2.78 7.3, 7.92 2.8 6.89, 8.81 2.74 6.46, 9.69 2.61 6.02, 10.56 2.42 5.58, 11.39 2.17 5.14, 12.16 1.86 4.71, 12.88 1.5 4.3'/>
    <ROUTE fromNode='LightCyanClock' fromField='fraction_changed' toNode='LightCyanPath' toField='set_fraction'/>
    <ROUTE fromNode='LightCyanPath' fromField='value_changed' toNode='LightCyan' toField='set_location'/>
    <ROUTE fromNode='LightCyanPath' fromField='value_changed' toNode='LightCyanOrb' toField='set_translation'/>
