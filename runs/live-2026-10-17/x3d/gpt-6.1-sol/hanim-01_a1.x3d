<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='1'/>
  </head>
  <Scene>
    <WorldInfo title='Minimal HAnim 2.0 Humanoid'/>
    <Background skyColor='0.08 0.09 0.12'/>
    <Viewpoint description='Front view of minimal humanoid' position='0 0.85 3' centerOfRotation='0 0.85 0'/>

    <HAnimHumanoid name='minimalHumanoid' version='2.0'>
      <HAnimJoint DEF='humanoid_root' containerField='skeleton' name='humanoid_root' center='0 1 0'>
        <HAnimJoint DEF='sacroiliac' name='sacroiliac' center='0 1 0'>
          <HAnimSegment DEF='pelvis' name='pelvis'>
            <Transform translation='0 1 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.3 0.65 0.85'/>
                </Appearance>
                <Box size='0.36 0.16 0.18'/>
              </Shape>
            </Transform>
          </HAnimSegment>

          <HAnimJoint DEF='l_hip' name='l_hip' center='0.12 0.95 0'>
            <HAnimSegment DEF='l_thigh' name='l_thigh'>
              <Transform translation='0.12 0.74 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.4 0.8 0.5'/>
                  </Appearance>
                  <Box size='0.12 0.32 0.12'/>
                </Shape>
              </Transform>
            </HAnimSegment>
          </HAnimJoint>

          <HAnimJoint DEF='r_hip' name='r_hip' center='-0.12 0.95 0'>
            <HAnimSegment DEF='r_thigh' name='r_thigh'>
              <Transform translation='-0.12 0.74 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.9 0.55 0.3'/>
                  </Appearance>
                  <Box size='0.12 0.32 0.12'/>
                </Shape>
              </Transform>
            </HAnimSegment>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>

      <HAnimJoint USE='humanoid_root' containerField='joints'/>
      <HAnimJoint USE='sacroiliac' containerField='joints'/>
      <HAnimJoint USE='l_hip' containerField='joints'/>
      <HAnimJoint USE='r_hip' containerField='joints'/>
      <HAnimSegment USE='pelvis' containerField='segments'/>
      <HAnimSegment USE='l_thigh' containerField='segments'/>
      <HAnimSegment USE='r_thigh' containerField='segments'/>
    </HAnimHumanoid>
  </Scene>
</X3D>