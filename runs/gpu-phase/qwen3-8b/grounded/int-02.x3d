<Scene>
<Viewpoint description='Default View' position='0 0 10'/>
<Shape>
<Appearance>
<Material DEF='RedMaterial' emissiveColor='1 0 0'/>
</Appearance>
<Sphere/>
</Shape>
<Shape>
<Appearance>
<Material DEF='GreenMaterial' emissiveColor='0 1 0'/>
</Appearance>
<Sphere/>
</Shape>
<BooleanToggle DEF='ToggleSwitch'/>
<TouchSensor DEF='TouchSensor' description='Toggle Sphere Color'/>
<ROUTE fromNode='TouchSensor' fromField='touchTime' toNode='ToggleSwitch' toField='value'/>
<ROUTE fromNode='ToggleSwitch' fromField='value' toNode='RedMaterial' toField='emissiveColor'/>
<ROUTE fromNode='ToggleSwitch' fromField='value' toNode='GreenMaterial' toField='emissiveColor'/>
</Scene>
</X3D>