69"},"px:predicate":"motivates","px:object":{"@id":"px:n788"},"prov":"doc","grade":"Confirmed","px:evidence":"libxml2 refuses a start tag over 10 MB, so a splat scene stored as one huge attribute cannot be parsed, and the XSD check gives an \"Internal error\" on very large scenes. The blob store only gets the bytes to the tool; [splats.md](splats.md) covers what the server does about it (a \"not checkable at this size\" verdict, and `splat_chunk`"},{"@id":"px:s639","@type":"px:Statement","px:subject":{"@id":"px:n1911"},"px:predicate":"discovered_in","px:object":{"@id":"px:n2164"},"prov":"doc","grade":"Confirmed","px:evidence":"Untuned writes TRUE/FALSE booleans (11 XSD failures), tuned 0."},{"@id":"px:s640","@type":"px:Statement","px:subject":{"@id":"px:n1775"},"px:predicate":"discovered_in","px:object":{"@id":"px:n2164"},"prov":"doc","grade":"Confirmed","px:evidence":"Tuned failures now XML parse errors (19 of 38)."},{"@id":"px:s641","@type":"px:Statement","px:subject":{"@id":"px:n2189"},"px:predicate":"maintained_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"pushed to the fork https://github.com/hagopjay/x3d_mcp"},{"@id":"px:s642","@type":"px:Statement","px:subject":{"@id":"px:n2225"},"px:predicate":"discovered_in","px:object":{"@id":"px:n2021"},"prov":"doc","grade":"Confirmed","px:evidence":"Blender Shroud grid (Blenderization thread, fork eb4b4b4): schema warnings 0, semantic warnings twin 10, journey 12; behaviour and metadata do not survive."},{"@id":"px:s643","@type":"px:Statement","px:subject":{"@id":"px:n2154"},"px:predicate":"discovered_in","px:object":{"@id":"px:n2021"},"prov":"doc","grade":"Confirmed","px:evidence":"Try a console log of the load error before changing the exporter; tell the Blenderization thread."},{"@id":"px:s644","@type":"px:Statement","px:subject":{"@id":"px:n1685"},"px:predicate":"depends_on_decision","px:object":{"@id":"px:n665"},"prov":"doc","grade":"Confirmed","px:evidence":"If he picks a width o