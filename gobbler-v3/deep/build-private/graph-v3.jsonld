,"grade":"Suspected"},{"@id":"px:s1235","@type":"px:Statement","px:subject":{"@id":"px:n870"},"px:predicate":"renders","px:object":{"@id":"px:n1745"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s1236","@type":"px:Statement","px:subject":{"@id":"px:n501"},"px:predicate":"reads","px:object":{"@id":"px:n1600"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s1237","@type":"px:Statement","px:subject":{"@id":"px:n501"},"px:predicate":"writes","px:object":{"@id":"px:n1600"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s1238","@type":"px:Statement","px:subject":{"@id":"px:n501"},"px:predicate":"reads","px:object":{"@id":"px:n1695"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s1239","@type":"px:Statement","px:subject":{"@id":"px:n501"},"px:predicate":"writes","px:object":{"@id":"px:n1695"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s1240","@type":"px:Statement","px:subject":{"@id":"px:n1887"},"px:predicate":"member_of","px:object":{"@id":"px:n914"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s1241","@type":"px:Statement","px:subject":{"@id":"px:n353"},"px:predicate":"part_of","px:object":{"@id":"px:n168"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s1242","@type":"px:Statement","px:subject":{"@id":"px:n134"},"px:predicate":"improves","px:object":{"@id":"px:n1293"},"prov":"simulated","grade":"Suspected","px:evidence":"DSPy could be used to optimize the LLM prompts and tool-calling chains within the x3d_mcp server for better X3D generation."},{"@id":"px:s1243","@type":"px:Statement","px:subject":{"@id":"px:n2342"},"px:predicate":"feeds","px:object":{"@id":"px:n2337"},"prov":"simulated","grade":"Suspected","px:evidence":"The structured JSON state file directly powers the ecosystem watch workstream's dashboards and tracking mechanisms."},{"@id":"px:s1244","@type":"px:Statement","px:subject":{"@id":"px:n215"},"px:predicate":"presented_at","px:object":{"@id":"px:n1780"},"prov":"simulated","grade":"Suspected","px:evidence":"Associating the research paper with its target conference establishes the timeline and dissemination venue for the project's findings."},{"@id":"px:s1245","@type":"px:Statement","px:subject":{"@id":"px:n248"},"px:predicate":"reads","px:object":{"@id":"px:n2080"},"prov":"simulated","grade":"Suspected","px:evidence":"Advanced LLMs can leverage the X3D ontology to generate highly accurate and semantically correct X3D 4.1 scene graphs."},{"@id":"px:s1246","@type":"px:Statement","px:subject":{"@id":"px:n1293"},"px:predicate":"uses","px:object":{"@id":"px:n1305"},"prov":"simulated","grade":"Suspected","px:evidence":"The Model Context Protocol server could use x3d-tidy to automatically clean and format AI-generated X3D code before returning it."},{"@id":"px:s1247","@type":"px:Statement","px:subject":{"@id":"px:n2043"},"px:predicate":"produces","px:object":{"@id":"px:n1956"},"prov":"simulated","grade":"Suspected","px:evidence":"The Blender IO addon for X3D might be updated to cross-compile or co-export GLB alongside X3D for wider WebXR compatibility."},{"@id":"px:s1248","@type":"px:Statement","px:subject":{"@id":"px:n1771"},"px:predicate":"implements","px:object":{"@id":"px:n1435"},"prov":"simulated","grade":"Suspected","px:evidence":"Integrating the Khronos Gaussian splatting standard into the latest X_ITE release would enable native 3D splat rendering in X3D scenes."},{"@id":"px:s1249","@type":"px:Statement","px:subject":{"@id":"px:n683"},"px:predicate":"writes","px:object":{"@id":"px:n237"},"prov":"simulated","grade":"Suspected","px:evidence":"Updating the Python X3D package to fully support writing the upcoming X3D 4.1 standard would enable AI pipelines to generate modern nodes natively."},{"@id":"px:s1250","@type":"px:Statement","px:subject":{"@id":"px:n2295"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1033"},"prov":"simulated","grade":"Suspected","px:evidence":"This specific finding likely occurred while testing cutting-edge GaussianSplat nodes inside the X_ITE web viewer."},{"@id":"px:s1251","@type":"px:Statement","px:subject":{"@id":"px:n1025"},"px:predicate":"part_of","px:object":{"@id":"px:n814"},"prov":"simulated","grade":"Suspected","px:evidence":"The forensic analysis thread of the Shroud project naturally fits into the overarching traceability workstream."},{"@id":"px:s1252","@type":"px:Statement","px:subject":{"@id":"px:n2156"},"px:predicate":"hosts","px:object":{"@id":"px:n474"},"prov":"simulated","grade":"Suspected","px:evidence":"The future version of Blender could natively host an MCP server, allowing external AI tools direct access to its scene graph."},{"@id":"px:s1253","@type":"px:Statement","px:subject":{"@id":"px:n1745"},"px:predicate":"depends_on","px:object":{"@id":"px:n1600"},"prov":"simulated","grade":"Suspected","px:evidence":"Gaussian splatting nodes in X3D typically rely on external PLY files to supply the point and spherical harmonics data."},{"@id":"px:s1254","@type":"px:Statement","px:subject":{"@id":"px:n2140"},"px:predicate":"co_used_with","px:object":{"@id":"px:n2058"},"prov":"simulated","grade":"Suspected","px:evidence":"Combining the Digital Surface Model of the Drillfield with the Blacksburg tile creates a comprehensive geospatial scene of Virginia Tech."},{"@id":"px:s1255","@type":"px:Statement","px:subject":{"@id":"px:n1787"},"px:predicate":"part_of","px:object":{"@id":"px:n542"},"prov":"simulated","grade":"Suspected","px:evidence":"The HAnimHumanoid node is a foundational structural element defined within the HAnim 2.0 standard specification."},{"@id":"px:s1256","@type":"px:Statement","px:subject":{"@id":"px:n2180"},"px:predicate":"works_with","px:object":{"@id":"px:n1891"},"prov":"simulated","grade":"Suspected","px:evidence":"Playwright could be used to automate visual regression testing and interaction checks for scenes hosted in the x3d-playground."},{"@id":"px:s1257","@type":"px:Statement","px:subject":{"@id":"px:n620"},"px:predicate":"presented_at","px:object":{"@id":"px:n2112"},"prov":"simulated","grade":"Suspected","px:evidence":"This forward-looking agenda document is perfectly suited for presentation at the main Web3D Conference to align the community."},{"@id":"px:s1258","@type":"px:Statement","px:subject":{"@id":"px:n571"},"px:predicate":"measured_by","px:object":{"@id":"px:n1939"},"prov":"simulated","grade":"Suspected","px:evidence":"The first experimental run's performance and accuracy metrics are evaluated using the X3D-Bench framework."},{"@id":"px:s1259","@type":"px:Statement","px:subject":{"@id":"px:n1973"},"px:predicate":"converts_to","px:object":{"@id":"px:n1589"},"prov":"simulated","grade":"Suspected","px:evidence":"Adding a post-processing step to convert Hunyuan's generated 3D models directly into X3D 4.0 would streamline AI-to-Web workflows."},{"@id":"px:s1260","@type":"px:Statement","px:subject":{"@id":"px:n870"},"px:predicate":"maintained_by","px:object":{"@id":"px:n1676"},"prov":"simulated","grade":"Suspected","px:evidence":"As one of the original creators, Johannes Behr's continued maintenance of X3DOM ensures its alignment with modern web standards."},{"@id":"px:s1261","@type":"px:Statement","px:subject":{"@id":"px:n989"},"px:predicate":"evidences","px:object":{"@id":"px:n1685"},"prov":"simulated","grade":"Suspected","px:evidence":"The physical measurements of the 1532 burn folds provide the empirical evidence needed to animate the kinematic fold scene accurately."},{"@id":"px:s1262","@type":"px:Statement","px:subject":{"@id":"px:n183"},"px:predicate":"blocks","px:object":{"@id":"px:n1804"},"prov":"simulated","grade":"Suspected","px:evidence":"The strict rule against overwriting existing demos prevents automated experimental reruns from accidentally destroying validated outputs."},{"@id":"px:s1263","@type":"px:Statement","px:subject":{"@id":"px:n1958"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"simulated","grade":"Suspected","px:evidence":"HagopJay, being a known contributor to the x3d_mcp tool, is the logical author of its accompanying technical paper or documentation."},{"@id":"px:s1264","@type":"px:Statement","px:subject":{"@id":"px:n1664"},"px:predicate":"depends_on","px:object":{"@id":"px:n1393"},"prov":"simulated","grade":"Suspected","px:evidence":"The Semantic Web ontology for X3D is systematically derived from and fundamentally depends on the Unified Object Model definitions."},{"@id":"px:s1265","@type":"px:Statement","px:subject":{"@id":"px:n1985"},"px:predicate":"regresses","px:object":{"@id":"px:n835"},"prov":"simulated","grade":"Suspected","px:evidence":"Identifying a bug where a specific minor version of X_ITE accidentally broke ProtoInstance rendering would trigger a critical validator repair loop."},{"@id":"px:s1266","@type":"px:Statement","px:subject":{"@id":"px:n690"},"px:predicate":"motivates","px:object":{"@id":"px:n94"},"prov":"simulated","grade":"Suspected","px:evidence":"The best practices outlined in the AI authoring guide provide the theoretical justification for the five-step iterative generation loop."},{"@id":"px:s1267","@type":"px:Statement","px:subject":{"@id":"px:n1293"},"px:predicate":"maintained_by","px:object":{"@id":"px:n674"},"prov":"simulated","grade":"Suspected","px:evidence":"Identifying the maintainer of the MCP server ensures accountability and directs community contributions appropriately."},{"@id":"px:s1268","@type":"px:Statement","px:subject":{"@id":"px:n1771"},"px:predicate":"supersedes","px:object":{"@id":"px:n1985"},"prov":"simulated","grade":"Suspected","px:evidence":"Tracking tool versions clarifies the upgrade path for developers encountering bugs in previous releases."},{"@id":"px:s1269","@type":"px:Statement","px:subject":{"@id":"px:n2295"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1985"},"prov":"simulated","grade":"Suspected","px:evidence":"Pinpointing the exact tool version where a bug occurs is critical for targeted debugging and regression testing."},{"@id":"px:s1270","@type":"px:Statement","px:subject":{"@id":"px:n2295"},"px:predicate":"motivates","px:object":{"@id":"px:n183"},"prov":"simulated","grade":"Suspected","px:evidence":"Experiencing a bug that was difficult to reproduce justifies the strict rule to preserve historical demo states."},{"@id":"px:s1271","@type":"px:Statement","px:subject":{"@id":"px:n744"},"px:predicate":"maintained_by","px:object":{"@id":"px:n1202"},"prov":"simulated","grade":"Suspected","px:evidence":"Connecting the primary author to the engine fosters collaboration for engine-specific X3D extensions."},{"@id":"px:s1272","@type":"px:Statement","px:subject":{"@id":"px:n1035"},"px:predicate":"feeds","px:object":{"@id":"px:n714"},"prov":"simulated","grade":"Suspected","px:evidence":"Using the curated spine dataset as input for the flywheel loop ensures high-quality training data for AI models."},{"@id":"px:s1273","@type":"px:Statement","px:subject":{"@id":"px:n237"},"px:predicate":"works_with","px:object":{"@id":"px:n1435"},"prov":"simulated","grade":"Suspected","px:evidence":"Formally linking the new X3D standard with Khronos splatting extensions enables interoperable 3D scanning workflows."},{"@id":"px:s1274","@type":"px:Statement","px:subject":{"@id":"px:n683"},"px:predicate":"depends_on","px:object":{"@id":"px:n418"},"prov":"simulated","grade":"Suspected","px:evidence":"Recognizing that the Python API is generated from the Unified Object Model ensures that updates to the standard automatically cascade to the tooling."},{"@id":"px:s1275","@type":"px:Statement","px:subject":{"@id":"px:n1918"},"px:predicate":"works_with","px:object":{"@id":"px:n501"},"prov":"simulated","grade":"Suspected","px:evidence":"Pairing the specific X3D node with a dedicated splat editing tool creates a seamless asset creation pipeline."},{"@id":"px:s1276","@type":"px:Statement","px:subject":{"@id":"px:n1973"},"px:predicate":"feeds","px:object":{"@id":"px:n2180"},"prov":"simulated","grade":"Suspected","px:evidence":"Piping outputs from cutting-edge generative 3D models into the playground allows rapid validation of AI-generated X3D scenes."},{"@id":"px:s1277","@type":"px:Statement","px:subject":{"@id":"px:n248"},"px:predicate":"co_used_with","px:object":{"@id":"px:n1293"},"prov":"simulated","grade":"Suspected","px:evidence":"Combining a fast LLM with the specialized MCP server enables real-time, interactive X3D scene generation."},{"@id":"px:s1278","@type":"px:Statement","px:subject":{"@id":"px:n1867"},"px:predicate":"reads","px:object":{"@id":"px:n1035"},"prov":"simulated","grade":"Suspected","px:evidence":"Grounding the DSPy prompt optimization experiment in the official spine dataset guarantees that the AI learns from valid, standards-compliant examples."},{"@id":"px:s1279","@type":"px:Statement","px:subject":{"@id":"px:n532"},"px:predicate":"motivates","px:object":{"@id":"px:n2164"},"prov":"simulated","grade":"Suspected","px:evidence":"The theoretical framework laid out in the open models document provides the scientific justification for running the GPU performance experiment."},{"@id":"px:s1280","@type":"px:Statement","px:subject":{"@id":"px:n2156"},"px:predicate":"produces","px:object":{"@id":"px:n73"},"prov":"simulated","grade":"Suspected","px:evidence":"Highlighting Blender's native export capabilities emphasizes the potential for seamless conversion from glTF to X3D."},{"@id":"px:s1281","@type":"px:Statement","px:subject":{"@id":"px:n1570"},"px:predicate":"contains","px:object":{"@id":"px:n352"},"prov":"simulated","grade":"Suspected","px:evidence":"Linking the overarching project documentation to the specific 3D scene provides essential context for researchers studying the artifact."},{"@id":"px:s1282","@type":"px:Statement","px:subject":{"@id":"px:n1882"},"px:predicate":"step_of","px:object":{"@id":"px:n401"},"prov":"simulated","grade":"Suspected","px:evidence":"Defining a learning phase as an explicit step in the flywheel loop formalizes the process of extracting insights from generated scenes."},{"@id":"px:s1283","@type":"px:Statement","px:subject":{"@id":"px:n98"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1672"},"prov":"simulated","grade":"Suspected","px:evidence":"Documenting that this schema validation shortcut exists in the 4.1 XSD helps developers avoid unexpected validation failures."},{"@id":"px:s1284","@type":"px:Statement","px:subject":{"@id":"px:n1589"},"px:predicate":"maintained_by","px:object":{"@id":"px:n2072"},"prov":"simulated","grade":"Suspected","px:evidence":"Mapping the standard to its governing body is essential for users seeking official documentation or proposing amendments."},{"@id":"px:s1285","@type":"px:Statement","px:subject":{"@id":"px:n1655"},"px:predicate":"hosts","px:object":{"@id":"px:n1035"},"prov":"simulated","grade":"Suspected","px:evidence":"Specifying the repository location of the spine dataset makes it discoverable for machine learning practitioners targeting X3D."},{"@id":"px:s1286","@type":"px:Statement","px:subject":{"@id":"px:n690"},"px:predicate":"cites","px:object":{"@id":"px:n1305"},"prov":"simulated","grade":"Suspected","px:evidence":"Recommending a dedicated tidying tool in the authoring guide ensures that AI-generated code meets community formatting standards."},{"@id":"px:s1287","@type":"px:Statement","px:subject":{"@id":"px:n1858"},"px:predicate":"validates","px:object":{"@id":"px:n1664"},"prov":"simulated","grade":"Suspected","px:evidence":"Applying an automated validation script to the ontology ensures semantic consistency across the X3D ecosystem."},{"@id":"px:s1288","@type":"px:Statement","px:subject":{"@id":"px:n1945"},"px:predicate":"evidences","px:object":{"@id":"px:n354"},"prov":"doc","grade":"Confirmed","px:evidence":"The reference '1M in 20 nodes valid on 688174f/74da0ec' is Confirmed (CAPTURE-LOG.md line 57)."},{"@id":"px:s1289","@type":"px:Statement","px:subject":{"@id":"px:n1"},"px:predicate":"cites","px:object":{"@id":"px:n1985"},"prov":"doc","grade":"Confirmed","px:evidence":"The 19.06 dB vs 26.35 dB figure is documented in library-hall-build.md line 15 as 19.1 vs 26.3 dB. It is X_ITE 16.5.0 on Anamnesis views only."},{"@id":"px:s1290","@type":"px:Statement","px:subject":{"@id":"px:n127"},"px:predicate":"discovered_in","px:object":{"@id":"px:n761"},"prov":"doc","grade":"Confirmed","px:evidence":"a ZeroDivisionError in importMesh_Extrusion at import_x3d.py:2573 and expat errors"},{"@id":"px:s1291","@type":"px:Statement","px:subject":{"@id":"px:n761"},"px:predicate":"part_of","px:object":{"@id":"px:n2043"},"prov":"doc","grade":"Confirmed","px:evidence":"while the colour double decode is in source/import_x3d.py."},{"@id":"px:s1292","@type":"px:Statement","px:subject":{"@id":"px:n819"},"px:predicate":"part_of","px:object":{"@id":"px:n2043"},"prov":"doc","grade":"Confirmed","px:evidence":"PR #25 (open) is an exporter change to source/extract.py (_uv_values, _corner_normals, _color_values), while the colour double decode is in source/import_x3d.py."},{"@id":"px:s1293","@type":"px:Statement","px:subject":{"@id":"px:n2136"},"px:predicate":"cites","px:object":{"@id":"px:n2199"},"prov":"doc","grade":"Confirmed","px:evidence":"Memory note bridge-and-first-contact-15-oct.md says PR #15 added the 1.75 import factor."},{"@id":"px:s1294","@type":"px:Statement","px:subject":{"@id":"px:n2199"},"px:predicate":"part_of","px:object":{"@id":"px:n2043"},"prov":"doc","grade":"Confirmed","px:evidence":"Memory note bridge-and-first-contact-15-oct.md says PR #15 added the 1.75 import factor."},{"@id":"px:s1295","@type":"px:Statement","px:subject":{"@id":"px:n1739"},"px:predicate":"part_of","px:object":{"@id":"px:n2043"},"prov":"doc","grade":"Confirmed","px:evidence":"PR #25 (open, 'Export: read per-corner attributes in bulk') touches only release_notes.md, source/extract.py and tests/test_extract_bulk_reads_bpy.py."},{"@id":"px:s1296","@type":"px:Statement","px:subject":{"@id":"px:n1739"},"px:predicate":"authored_by","px:object":{"@id":"px:n1811"},"prov":"doc","grade":"Confirmed","px:evidence":"upstream PR #25 (Hoffman) conflicts with 6 of 9."},{"@id":"px:s1297","@type":"px:Statement","px:subject":{"@id":"px:n155"},"px:predicate":"uses","px:object":{"@id":"px:n1591"},"prov":"doc","grade":"Likely","px:evidence":"bl_phase.py reads view transform, units, colour-space, runs x3d-blender-io export; gate.py runs validate_xml + semantic + sci checks"},{"@id":"px:s1298","@type":"px:Statement","px:subject":{"@id":"px:n155"},"px:predicate":"uses","px:object":{"@id":"px:n1394"},"prov":"doc","grade":"Likely","px:evidence":"bl_phase.py reads view transform, units, colour-space, runs x3d-blender-io export; gate.py runs validate_xml + semantic + sci checks"},{"@id":"px:s1299","@type":"px:Statement","px:subject":{"@id":"px:n1170"},"px:predicate":"depends_on","px:object":{"@id":"px:n84"},"prov":"doc","grade":"Confirmed","px:evidence":"installing X libs for pip bpy (else libXrender.so.1 missing); package is libglib2.0-0t64."},{"@id":"px:s1300","@type":"px:Statement","px:subject":{"@id":"px:n1195"},"px:predicate":"cites","px:object":{"@id":"px:n1571"},"prov":"doc","grade":"Confirmed","px:evidence":"see [[library-of-polyxandria]], [[blender-x3d-milestone-1]]"},{"@id":"px:s1301","@type":"px:Statement","px:subject":{"@id":"px:n1195"},"px:predicate":"cites","px:object":{"@id":"px:n646"},"prov":"doc","grade":"Confirmed","px:evidence":"see [[library-of-polyxandria]], [[blender-x3d-milestone-1]]"},{"@id":"px:s1302","@type":"px:Statement","px:subject":{"@id":"px:n1627"},"px:predicate":"cites","px:object":{"@id":"px:n646"},"prov":"doc","grade":"Confirmed","px:evidence":"See [[blender-x3d-milestone-1]] for the code side."},{"@id":"px:s1303","@type":"px:Statement","px:subject":{"@id":"px:n2101"},"px:predicate":"renders","px:object":{"@id":"px:n1846"},"prov":"doc","grade":"Confirmed","px:evidence":"The full 500,000-splat Marble Pantheon as X3D 4.1 (65 MB XML, 14.6 MB .x3dz) loads in X_ITE in ~11 s on software WebGL"},{"@id":"px:s1304","@type":"px:Statement","px:subject":{"@id":"px:n683"},"px:predicate":"validates","px:object":{"@id":"px:n1846"},"prov":"doc","grade":"Confirmed","px:evidence":"x3d.py passes all sizes."},{"@id":"px:s1305","@type":"px:Statement","px:subject":{"@id":"px:n2084"},"px:predicate":"converts_to","px:object":{"@id":"px:n1600"},"prov":"doc","grade":"Likely","px:evidence":"SPZ import in x3d-blender-io (decoder at tools/spz_to_ply.py)"},{"@id":"px:s1306","@type":"px:Statement","px:subject":{"@id":"px:n1402"},"px:predicate":"motivates","px:object":{"@id":"px:n849"},"prov":"doc","grade":"Confirmed","px:evidence":"check that `node_type` is a plain name (letters, digits, underscore) before it goes into a query."},{"@id":"px:s1307","@type":"px:Statement","px:subject":{"@id":"px:n2071"},"px:predicate":"uses","px:object":{"@id":"px:n1393"},"prov":"doc","grade":"Confirmed","px:evidence":"Parents and fields that accept a node type, from the X3DUOM's `acceptableNodeTypes` (event-only fields left out), with `needsContainerField` and a versioned `table_sha256`."},{"@id":"px:s1308","@type":"px:Statement","px:subject":{"@id":"px:n2071"},"px:predicate":"uses","px:object":{"@id":"px:n418"},"prov":"doc","grade":"Confirmed","px:evidence":"Build where_can_place from X3DUOM (6,509 rows, 5.4 KB gzip)."},{"@id":"px:s1309","@type":"px:Statement","px:subject":{"@id":"px:n2071"},"px:predicate":"supersedes","px:object":{"@id":"px:n461"},"prov":"doc","grade":"Confirmed","px:evidence":"Unlike `node_parents` these are real placements."},{"@id":"px:s1310","@type":"px:Statement","px:subject":{"@id":"px:n1293"},"px:predicate":"uses","px:object":{"@id":"px:n436"},"prov":"doc","grade":"Confirmed","px:evidence":"validates LLM output through a standards-grounded pipeline: typed construction in X3DPSAIL, then the X3D 4.1 XSD, then the 4.0 JSON Schema"},{"@id":"px:s1311","@type":"px:Statement","px:subject":{"@id":"px:n707"},"px:predicate":"uses","px:object":{"@id":"px:n436"},"prov":"doc","grade":"Confirmed","px:evidence":"The paper credits the Lentz implementation with \"workflow-style tools (high-level operations that synthesize complete scenes from compact JSON descriptions) together with X3DPSAIL-backed construction"},{"@id":"px:s1312","@type":"px:Statement","px:subject":{"@id":"px:n1293"},"px:predicate":"uses","px:object":{"@id":"px:n294"},"prov":"doc","grade":"Confirmed","px:evidence":"validates LLM output through a standards-grounded pipeline: typed construction in X3DPSAIL, then the X3D 4.1 XSD, then the 4.0 JSON Schema"},{"@id":"px:s1313","@type":"px:Statement","px:subject":{"@id":"px:n1598"},"px:predicate":"contains","px:object":{"@id":"px:n1756"},"prov":"doc","grade":"Confirmed","px:evidence":"`x3d-4.0-JSONSchema.json` (1,023,286 B, Draft 2020-12, \"Experimental\", SHA-1 c6765a4c...) is in the SourceForge Web3D SVN mirror."},{"@id":"px:s1314","@type":"px:Statement","px:subject":{"@id":"px:n1756"},"px:predicate":"implements","px:object":{"@id":"px:n1589"},"prov":"doc","grade":"Confirmed","px:evidence":"No 4.1 JSON schema exists; its `@version` enum stops at 4.0"},{"@id":"px:s1315","@type":"px:Statement","px:subject":{"@id":"px:n1274"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"A bounded `huge_tree` in the fork is HagopJay's call (security trade-off)"},{"@id":"px:s1316","@type":"px:Statement","px:subject":{"@id":"px:n759"},"px:predicate":"writes","px:object":{"@id":"px:n318"},"prov":"doc","grade":"Confirmed","px:evidence":"tools/build_flight.py writes Viewpoint DroneCam + TimeSensor Flight + CamPos/CamRot/CamFov + FlightWipeAt/Back"},{"@id":"px:s1317","@type":"px:Statement","px:subject":{"@id":"px:n759"},"px:predicate":"writes","px:object":{"@id":"px:n397"},"prov":"doc","grade":"Confirmed","px:evidence":"tools/build_flight.py writes Viewpoint DroneCam + TimeSensor Flight + CamPos/CamRot/CamFov + FlightWipeAt/Back"},{"@id":"px:s1318","@type":"px:Statement","px:subject":{"@id":"px:n1538"},"px:predicate":"reads","px:obje