<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <WorldInfo title='Wooden Table'/>
    <Background skyColor='0.88 0.91 0.95'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Viewpoint description='Wooden table, dimensions in metres' position='0 1.8 3.4' orientation='1 0 0 -0.33' centerOfRotation='0 0.4 0'/>
    <DirectionalLight direction='-1 -2 -1' intensity='0.85'/>

    <!-- Tabletop: 2 m long, 1 m wide, 0.1 m thick. -->
    <Transform translation='0 0.75 0'>
      <Shape>
        <Appearance>
          <Material DEF='Wood' diffuseColor='0.55 0.30 0.12' specularColor='0.15 0.10 0.06' shininess='0.18'/>
        </Appearance>
        <Box size='2 0.1 1'/>
      </Shape>
    </Transform>

    <!-- Four cylindrical legs meet the underside of the tabletop. -->
    <Transform translation='-0.85 0.35 -0.35'>
      <Shape DEF='Leg'>
        <Appearance>
          <Material USE='Wood'/>
        </Appearance>
        <Cylinder radius='0.045' height='0.7'/>
      </Shape>
    </Transform>
    <Transform translation='0.85 0.35 -0.35'>
      <Shape USE='Leg'/>
    </Transform>
    <Transform translation='-0.85 0.35 0.35'>
      <Shape USE='Leg'/>
    </Transform>
    <Transform translation='0.85 0.35 0.35'>
      <Shape USE='Leg'/>
    </Transform>
  </Scene>
</X3D>