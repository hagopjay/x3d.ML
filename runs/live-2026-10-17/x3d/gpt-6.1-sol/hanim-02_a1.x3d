<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='1'/>
    <meta name='title' content='Waving HAnim Figure'/>
    <meta name='description' content='An HAnim 2.0 figure waves its right arm using an animated shoulder joint. Touch the torso to restart the wave.'/>
  </head>
  <Scene>
    <WorldInfo title='Waving HAnim Figure'/>
    <Background skyColor='0.055 0.075 0.12'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='true'/>
    <Viewpoint description='Front view of waving figure' position='0 1.5 5.2' centerOfRotation='0 1.2 0' fieldOfView='0.65'/>
    <DirectionalLight direction='-1 -2 -3' intensity='0.85'/>
    <DirectionalLight direction='1 -1 1' intensity='0.45' color='0.65 0.78 1'/>

    <Transform translation='0 -0.055 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.16 0.2 0.27'/>
        </Appearance>
        <Box size='4 0.1 3'/>
      </Shape>
    </Transform>

    <HAnimHumanoid name='WavingFigure' version='2.0'>
      <HAnimJoint DEF='HumanoidRoot' containerField='skeleton' name='humanoid_root' translation='0 1.02 0'>
        <HAnimJoint DEF='PelvisJoint' name='sacroiliac'>
          <HAnimSegment name='pelvis'>
            <Shape>
              <Appearance DEF='Clothing'>
                <Material diffuseColor='0.08 0.48 0.72' specularColor='0.25 0.3 0.35' shininess='0.35'/>
              </Appearance>
              <Box size='0.4 0.23 0.25'/>
            </Shape>
          </HAnimSegment>

          <HAnimJoint DEF='RightHip' name='r_hip' translation='-0.13 -0.1 0'>
            <HAnimSegment name='r_thigh'>
              <Transform translation='0 -0.21 0'>
                <Shape>
                  <Appearance DEF='Trousers'>
                    <Material diffuseColor='0.12 0.17 0.25'/>
                  </Appearance>
                  <Cylinder radius='0.085' height='0.42'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='RightKnee' name='r_knee' translation='0 -0.42 0'>
              <HAnimSegment name='r_calf'>
                <Transform translation='0 -0.2 0'>
                  <Shape>
                    <Appearance USE='Trousers'/>
                    <Cylinder radius='0.067' height='0.4'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='RightAnkle' name='r_ankle' translation='0 -0.4 0'>
                <HAnimSegment name='r_hindfoot'>
                  <Transform translation='0 -0.045 0.065'>
                    <Shape>
                      <Appearance DEF='Shoes'>
                        <Material diffuseColor='0.055 0.065 0.085'/>
                      </Appearance>
                      <Box size='0.17 0.1 0.31'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

          <HAnimJoint DEF='LeftHip' name='l_hip' translation='0.13 -0.1 0'>
            <HAnimSegment name='l_thigh'>
              <Transform translation='0 -0.21 0'>
                <Shape>
                  <Appearance USE='Trousers'/>
                  <Cylinder radius='0.085' height='0.42'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='LeftKnee' name='l_knee' translation='0 -0.42 0'>
              <HAnimSegment name='l_calf'>
                <Transform translation='0 -0.2 0'>
                  <Shape>
                    <Appearance USE='Trousers'/>
                    <Cylinder radius='0.067' height='0.4'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='LeftAnkle' name='l_ankle' translation='0 -0.4 0'>
                <HAnimSegment name='l_hindfoot'>
                  <Transform translation='0 -0.045 0.065'>
                    <Shape>
                      <Appearance USE='Shoes'/>
                      <Box size='0.17 0.1 0.31'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

        <HAnimJoint DEF='Spine' name='vl5' translation='0 0.12 0'>
          <HAnimSegment name='l5'>
            <TouchSensor DEF='WaveTouch' description='Touch to restart the right-arm wave'/>
            <Transform translation='0 0.23 0' scale='1 1.25 0.65'>
              <Shape>
                <Appearance USE='Clothing'/>
                <Sphere radius='0.3'/>
              </Shape>
            </Transform>
          </HAnimSegment>

          <HAnimJoint DEF='Neck' name='skullbase' translation='0 0.63 0'>
            <HAnimSegment name='skull'>
              <Transform translation='0 0.13 0' scale='0.85 1 0.85'>
                <Shape>
                  <Appearance DEF='Skin'>
                    <Material diffuseColor='0.82 0.56 0.37' specularColor='0.15 0.12 0.1'/>
                  </Appearance>
                  <Sphere radius='0.2'/>
                </Shape>
              </Transform>
              <Transform translation='-0.062 0.17 0.158'>
                <Shape>
                  <Appearance DEF='Eyes'>
                    <Material diffuseColor='0.025 0.035 0.05'/>
                  </Appearance>
                  <Sphere radius='0.022'/>
                </Shape>
              </Transform>
              <Transform translation='0.062 0.17 0.158'>
                <Shape>
                  <Appearance USE='Eyes'/>
                  <Sphere radius='0.022'/>
                </Shape>
              </Transform>
              <Transform translation='0 0.105 0.177'>
                <Shape>
                  <Appearance USE='Skin'/>
                  <Sphere radius='0.028'/>
                </Shape>
              </Transform>
            </HAnimSegment>
          </HAnimJoint>

          <HAnimJoint DEF='RightShoulder' name='r_shoulder' translation='-0.29 0.43 0' rotation='0 0 1 -2.25'>
            <HAnimSegment name='r_upperarm'>
              <Shape>
                <Appearance USE='Clothing'/>
                <Sphere radius='0.105'/>
              </Shape>
              <Transform translation='0 -0.24 0'>
                <Shape>
                  <Appearance USE='Clothing'/>
                  <Cylinder radius='0.075' height='0.48'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='RightElbow' name='r_elbow' translation='0 -0.48 0' rotation='0 0 1 -0.55'>
              <HAnimSegment name='r_forearm'>
                <Shape>
                  <Appearance USE='Skin'/>
                  <Sphere radius='0.07'/>
                </Shape>
                <Transform translation='0 -0.205 0'>
                  <Shape>
                    <Appearance USE='Skin'/>
                    <Cylinder radius='0.058' height='0.41'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='RightWrist' name='r_wrist' translation='0 -0.41 0'>
                <HAnimSegment name='r_hand'>
                  <Transform translation='0 -0.09 0' scale='0.8 1.3 0.45'>
                    <Shape>
                      <Appearance USE='Skin'/>
                      <Sphere radius='0.09'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

          <HAnimJoint DEF='LeftShoulder' name='l_shoulder' translation='0.29 0.43 0' rotation='0 0 1 0.12'>
            <HAnimSegment name='l_upperarm'>
              <Shape>
                <Appearance USE='Clothing'/>
                <Sphere radius='0.105'/>
              </Shape>
              <Transform translation='0 -0.24 0'>
                <Shape>
                  <Appearance USE='Clothing'/>
                  <Cylinder radius='0.075' height='0.48'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='LeftElbow' name='l_elbow' translation='0 -0.48 0'>
              <HAnimSegment name='l_forearm'>
                <Transform translation='0 -0.205 0'>
                  <Shape>
                    <Appearance USE='Skin'/>
                    <Cylinder radius='0.058' height='0.41'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='LeftWrist' name='l_wrist' translation='0 -0.41 0'>
                <HAnimSegment name='l_hand'>
                  <Transform translation='0 -0.09 0' scale='0.8 1.3 0.45'>
                    <Shape>
                      <Appearance USE='Skin'/>
                      <Sphere radius='0.09'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>

      <HAnimJoint USE='HumanoidRoot' containerField='joints'/>
      <HAnimJoint USE='PelvisJoint' containerField='joints'/>
      <HAnimJoint USE='RightHip' containerField='joints'/>
      <HAnimJoint USE='RightKnee' containerField='joints'/>
      <HAnimJoint USE='RightAnkle' containerField='joints'/>
      <HAnimJoint USE='LeftHip' containerField='joints'/>
      <HAnimJoint USE='LeftKnee' containerField='joints'/>
      <HAnimJoint USE='LeftAnkle' containerField='joints'/>
      <HAnimJoint USE='Spine' containerField='joints'/>
      <HAnimJoint USE='Neck' containerField='joints'/>
      <HAnimJoint USE='RightShoulder' containerField='joints'/>
      <HAnimJoint USE='RightElbow' containerField='joints'/>
      <HAnimJoint USE='RightWrist' containerField='joints'/>
      <HAnimJoint USE='LeftShoulder' containerField='joints'/>
      <HAnimJoint USE='LeftElbow' containerField='joints'/>
      <HAnimJoint USE='LeftWrist' containerField='joints'/>
    </HAnimHumanoid>

    <TimeSensor DEF='WaveClock' cycleInterval='2.4' loop='true'/>
    <OrientationInterpolator DEF='ShoulderWave'
      key='0 0.25 0.5 0.75 1'
      keyValue='0 0 1 -2.25, 0 0 1 -2.65, 0 0 1 -2.25, 0 0 1 -1.95, 0 0 1 -2.25'/>
    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='ShoulderWave' toField='set_fraction'/>
    <ROUTE fromNode='ShoulderWave' fromField='value_changed' toNode='RightShoulder' toField='set_rotation'/>
    <ROUTE fromNode='WaveTouch' fromField='touchTime' toNode='WaveClock' toField='set_startTime'/>
  </Scene>
</X3D>