  <Scene>
    <Transform DEF="CubeTransform">
      <Shape>
        <Box size='2 2 2'/>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
      </Shape>
    </Transform>
    <TimeSensor DEF="RotationTimer" cycleInterval="4" loop="true"/>
    <OrientationInterpolator DEF="RotateInterpolator">
      <key>[0, 0.25, 0.5, 0.75, 1]</key>
      < keyValue="[0 1 0 0, 0 1 0 1.57, 0 1 0 3.14, 0 1 0 4.71, 0 1 0 6.28]" />
    </OrientationInterpolator>
    <ROUTE fromNode="RotationTimer" fromField="fraction_changed" toNode="RotateInterpolator" toField="set_fraction"/>
    <ROUTE fromNode="RotateInterpolator" fromField="value_changed" toNode="CubeTransform" toField="rotation"/>
    <Viewpoint description="Rotating Blue Cube" position="0 0 5"/>
  </Scene>
</X3D>