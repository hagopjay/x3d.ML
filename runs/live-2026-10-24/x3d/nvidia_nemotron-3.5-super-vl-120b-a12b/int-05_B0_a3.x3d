<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <meta name="proximity-triggered-light" content="SpotLight activated when viewer approaches statue"/>
  </head>
  <Scene>
    <Viewpoint description="Approach the statue to switch on the spotlight" position="0 0 8" orientation="0 0 1 0"/>
    <Group>
      <Transform translation="0 0 0">
        <Shape>
          <Box size="1 2 1"/>
          <Appearance>
            <PhysicalMaterial baseColor="0.8 0.7 0.6"/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation="0 1.2 0">
        <Shape>
          <Sphere radius="0.4"/>
          <Appearance>
            <PhysicalMaterial baseColor="0.9 0.8 0.7"/>
          </Appearance>
        </Shape>
      </Transform>
    </Group>
    <ProximitySensor DEF="prox" center="0 0 0" size="10 10 10"/>
    <SpotLight DEF="spotLight" on="FALSE" location="0 5 0" direction="0 -1 0" intensity="1" cutOffAngle="0.785" beamWidth="0.5"/>
    <ROUTE fromNode="prox" fromField="isActive" toNode="spotLight" toField="on"/>
  </Scene>
</X3D>