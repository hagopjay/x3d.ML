<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='FerrisWheel.x3d' name='title'/>
    <meta content='A Ferris wheel with 12 upright gondolas, A-frame supports, and warm evening lighting' name='description'/>
    <meta content='X3D-Edit 4.0' name='generator'/>
  </head>
  <Scene>
    <WorldInfo title='Ferris Wheel at Sunset'/>
    <Background groundAngle='1.5708' groundColor='0.12 0.09 0.07 0.08 0.06 0.06' skyAngle='1.15 1.42 1.5708' skyColor='0.12 0.1 0.25 0.38 0.18 0.32 0.78 0.38 0.18 0.95 0.65 0.28'/>
    <Viewpoint description='Front View' position='0 10 24'/>
    <Viewpoint description='Side View' orientation='0 1 0 1.5708' position='24 10 0'/>
    <Viewpoint description='Distant Sunset View' position='0 8 38'/>
    <DirectionalLight ambientIntensity='0.3' color='1 0.75 0.45' direction='-0.6 -0.3 -0.7' intensity='1.2'/>
    <DirectionalLight color='0.3 0.2 0.4' direction='0.6 0.4 0.7' intensity='0.4'/>

    <!-- Ground Platform -->
    <Transform translation='0 -0.25 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.18 0.16 0.14' roughness='0.9'/>
        </Appearance>
        <Cylinder height='0.5' radius='14'/>
      </Shape>
    </Transform>

    <!-- Support Structure (A-Frames) -->
    <!-- Front A-Frame (Z = +1.1) -->
    <Transform translation='-3.2 5 1.1' rotation='0 0 1 -0.33'>
      <Shape DEF='Leg'>
        <Appearance DEF='SupportApp'>
          <Material diffuseColor='0.75 0.78 0.82' metalness='0.4' roughness='0.4'/>
        </Appearance>
        <Cylinder height='10.8' radius='0.18'/>
      </Shape>
    </Transform>
    <Transform translation='3.2 5 1.1' rotation='0 0 1 0.33'>
      <Shape USE='Leg'/>
    </Transform>
    <Transform translation='0 3.5 1.1'>
      <Shape DEF='Brace'>
        <Appearance USE='SupportApp'/>
        <Box size='4.8 0.15 0.15'/>
      </Shape>
    </Transform>

    <!-- Back A-Frame (Z = -1.1) -->
    <Transform translation='-3.2 5 -1.1' rotation='0 0 1 -0.33'>
      <Shape USE='Leg'/>
    </Transform>
    <Transform translation='3.2 5 -1.1' rotation='0 0 1 0.33'>
      <Shape USE='Leg'/>
    </Transform>
    <Transform translation='0 3.5 -1.1'>
      <Shape USE='Brace'/>
    </Transform>

    <!-- Central Axle -->
    <Transform translation='0 10 0' rotation='1 0 0 1.5708'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.25 0.25 0.28' metalness='0.7' roughness='0.3'/>
        </Appearance>
        <Cylinder height='2.8' radius='0.28'/>
      </Shape>
    </Transform>

    <!-- Boarding Platform -->
    <Transform translation='0 1.2 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.35 0.22 0.15' roughness='0.8'/>
        </Appearance>
        <Box size='6 0.3 3.4'/>
      </Shape>
    </Transform>
    <!-- Boarding Railing -->
    <Transform translation='0 1.9 1.6'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.6 0.2' metalness='0.5'/>
        </Appearance>
        <Box size='6 1 0.08'/>
      </Shape>
    </Transform>

    <!-- Rotating Wheel Assembly -->
    <Transform DEF='Wheel' translation='0 10 0'>
      <!-- Hub -->
      <Transform rotation='1 0 0 1.5708'>
        <Shape>
          <Appearance DEF='WheelWhite'>
            <Material diffuseColor='0.92 0.92 0.95' metalness='0.3' roughness='0.3'/>
          </Appearance>
          <Cylinder height='1.6' radius='0.7'/>
        </Shape>
      </Transform>

      <!-- Spokes (6 continuous diametrical cylinders each side = 12 radial spokes) -->
      <!-- Front Spokes (Z = +0.55) -->
      <Transform translation='0 0 0.55'>
        <Shape DEF='SpokeSpanned'>
          <Appearance USE='WheelWhite'/>
          <Cylinder height='14' radius='0.06'/>
        </Shape>
      </Transform>
      <Transform translation='0 0 0.55' rotation='0 0 1 0.5236'>
        <Shape USE='SpokeSpanned'/>
      </Transform>
      <Transform translation='0 0 0.55' rotation='0 0 1 1.0472'>
        <Shape USE='SpokeSpanned'/>
      </Transform>
      <Transform translation='0 0 0.55' rotation='0 0 1 1.5708'>
        <Shape USE='SpokeSpanned'/>
      </Transform>
      <Transform translation='0 0 0.55' rotation='0 0 1 2.0944'>
        <Shape USE='SpokeSpanned'/>
      </Transform>
      <Transform translation='0 0 0.55' rotation='0 0 1 2.6180'>
        <Shape USE='SpokeSpanned'/>
      </Transform>

      <!-- Back Spokes (Z = -0.55) -->
      <Transform translation='0 0 -0.55'>
        <Shape USE='SpokeSpanned'/>
