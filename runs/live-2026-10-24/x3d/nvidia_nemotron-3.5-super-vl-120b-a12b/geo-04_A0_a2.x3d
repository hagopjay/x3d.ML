<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
 <head>
  <meta name='title' content='Animated Drone over Torgersen Hall'/>
 </head>
 <Scene>
  <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2296 -80.4192 610'/>
  <GeoViewpoint geoSystem='"GD" "WE"' position='37.2296 -80.4192 660' description='Torgersen Hall'/>
  <Viewpoint description='Drone flying a square path 50 m above Torgersen Hall' position='0 0 100'/>
  <DirectionalLight intensity='0.8' color='1 1 1' direction='0 -1 -0.5'/>
  <Transform DEF='DroneTransform'>
   <Shape>
    <Box size='2 2 2'/>
    <Appearance>
     <PhysicalMaterial baseColor='0.2 0.6 1.0'/>
    </Appearance>
   </Shape>
  </Transform>
  <TimeSensor DEF='DroneTimer' cycleInterval='12' loop='TRUE'/>
  <GeoPositionInterpolator DEF='DronePath' key='0 0.25 0.5 0.75 1' keyValue='37.2296 -80.4192 660 37.2297 -80.4192 660 37.2297 -80.4191 660 37.2296 -80.4191 660 37.2296 -80.4192 660'/>
  <OrientationInterpolator DEF='DroneOrient' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 1.570796 0 0 1 3.141593 0 0 1 4.712389 0 0 1 0'/>
  <ROUTE fromNode='DroneTimer' fromField='fraction_changed' toNode='DronePath' toField='set_fraction'/>
  <ROUTE fromNode='DronePath' fromField='value_changed' toNode='DroneTransform' toField='set_translation'/>
  <ROUTE fromNode='DroneTimer' fromField='fraction_changed' toNode='DroneOrient' toField='set_fraction'/>
  <ROUTE fromNode='DroneOrient' fromField='value_changed' toNode='DroneTransform' toField='set_rotation'/>
 </Scene>
</X3D>