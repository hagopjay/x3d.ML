<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head></head>
  <Scene>
    <Viewpoint description='Minimal HAnim 2.0 humanoid with root, sacroiliac, l_hip and r_hip joints' position='0 0 1.2'/>
    <DirectionalLight intensity='0.8' color='1 1 1' direction='0 -1 -1'/>
    <HAnimHumanoid version='2.0' name='humanoid'>
      <HAnimJoint name='humanoid_root' jointIndex='0'>
        <HAnimSegment name='root_segment' segmentIndex='0' jointName='humanoid_root'>
          <Shape>
