<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <Scene>
    <Viewpoint description="Rocket launch view" position="0 5 30"/>
    <Background skyColor="0.5 0.7 1.0"/>
    <Transform DEF="RocketTransform" translation="0 0 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.8 0.8 0.8" specularColor="0.5 0.5 0.5" shininess="0.5"/>
        </Appearance>
        <Group>
          <Transform translation="0 5 0">
            <Shape>
              <Appearance>
                <Material diffuseColor="0.9 0.9 0.9"/>
              </Appearance>
              <Cylinder radius="1" height="10"/>
            </Shape>
          </Transform>
          <Transform translation="0 11 0">
            <Shape>
              <Appearance>
                <Material diffuseColor="0.9 0.9 0.9"/>
              </Appearance>
              <Cone bottomRadius="1" height="3"/>
            </Shape>
          </Transform>
          <Transform translation="0 1 0" rotation="0 0 1 0">
            <Shape>
              <Appearance>
                <Material diffuseColor="0.6 0.6 0.6"/>
              </Appearance>
              <Box size="0.2 4 2"/>
            </Shape>
          </Transform>
          <Transform translation="0 1 0" rotation="0 0 1 1.5708">
            <Shape>
              <Appearance>
                <Material diffuseColor="0.6 0.6 0.6"/>
              </Appearance>
              <Box size="0.2 4 2"/>
            </Shape>
          </Transform>
        </Group>
      </Shape>
      <Transform translation="0 -1 0">
        <Shape>
          <Appearance>
            <Material emissiveColor="1 0.5 0" diffuseColor="1 0.5 0" transparency="0.3"/>
          </Appearance>
          <Cone bottomRadius="0.5" height="2"/>
        </Shape>
      </Transform>
    </Transform>
    <Transform translation="5 10 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.4 0.4 0.4"/>
        </Appearance>
        <Box size="2 20 2"/>
      </Shape>
    </Transform>
    <Transform translation="-5 10 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.4 0.4 0.4"/>
        </Appearance>
        <Box size="2 20 2"/>
      </Shape>
    </Transform>
    <Transform translation="0 20 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.4 0.4 0.4"/>
        </Appearance>
        <Box size="12 2 2"/>
      </Shape>
    </Transform>
    <Transform translation="0 -1 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.3 0.3 0.3"/>
        </Appearance>
        <Box size="20 2 20"/>
      </Shape>
    </Transform>
    <TimeSensor DEF="LaunchTimer" cycleInterval="10" loop="true"/>
    <PositionInterpolator DEF="RocketPath" key="0 0.5 1" keyValue="0 0 0 0 50 50 0 100 100"/>
    <ROUTE fromNode="LaunchTimer" fromField="fraction_changed" toNode="RocketPath" toField="set_fraction"/>
    <ROUTE fromNode="RocketPath" fromField="value_changed" toNode="RocketTransform" toField="translation"/>
  </Scene>
</X3D>
