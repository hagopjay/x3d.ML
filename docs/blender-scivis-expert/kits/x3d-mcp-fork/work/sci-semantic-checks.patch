+def test_volume_without_voxels_is_error():
+    doc = _wrap('<VolumeData dimensions="0 0 0"/>').replace('level="1"/>', 'level="1"/>', 1)
+    report = validate_semantic(doc)
+    assert "volume-no-voxels" in report and "volume-dimensions" in report
