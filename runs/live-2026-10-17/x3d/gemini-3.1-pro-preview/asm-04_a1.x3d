<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='StreetLamp.x3d'/>
    <meta name='description' content='A street lamp with a PointLight at the top that is on by default.'/>
  </head>
  <Scene>
    <Viewpoint description='Street Lamp View' position='0 2 12'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Box size='15 0.1 15'/>
        <Appearance>
          <Material diffuseColor='0.15 0.2 0.25'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <Transform translation='0 0.25 0'>
      <Shape>
        <Cylinder radius='0.3' height='0.5'/>
        <Appearance>
          <Material diffuseColor='0.15 0.15 0.15' shininess='0.8'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <Transform translation='0 2.5 0'>
      <Shape>
        <Cylinder radius='0.08' height='4.5'/>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.2' shininess='0.5'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <Transform translation='0.6 4.8 0'>
      <Shape>
        <Box size='1.5 0.15 0.4'/>
        <Appearance>
          <Material diffuseColor='0.15 0.15 0.15'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <Transform translation='0.8 4.7 0'>
      <PointLight on='true' color='1 0.9 0.7' intensity='1.0' radius='20' ambientIntensity='0.2' location='0 0 0'/>
      <Shape>
        <Sphere radius='0.12'/>
        <Appearance>
          <Material emissiveColor='1 0.9 0.7' diffuseColor='0 0 0'/>
        </Appearance>
      </Shape>
    </Transform>
  </Scene>
</X3D>