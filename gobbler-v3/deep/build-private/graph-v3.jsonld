t_of","px:object":{"@id":"px:n2072"},"prov":"doc","grade":"Confirmed","px:evidence":"x3d_mcp (Narra, Lentz, Brutzman, Polys) is an official Web3D project"},{"@id":"px:s419","@type":"px:Statement","px:subject":{"@id":"px:n1958"},"px:predicate":"presented_at","px:object":{"@id":"px:n1780"},"prov":"doc","grade":"Confirmed","px:evidence":"x3d_mcp (Narra, Lentz, Brutzman, Polys) is an official Web3D project with a Web3D 2026 paper."},{"@id":"px:s420","@type":"px:Statement","px:subject":{"@id":"px:n1887"},"px:predicate":"member_of","px:object":{"@id":"px:n2072"},"prov":"doc","grade":"Confirmed","px:evidence":"Dr. Polys's CV phrases his presidency as \"2010 to 2025\", so confirm his current Consortium role with him."},{"@id":"px:s421","@type":"px:Statement","px:subject":{"@id":"px:n1887"},"px:predicate":"member_of","px:object":{"@id":"px:n914"},"prov":"doc","grade":"Confirmed","px:evidence":"his title, President of the Web3D Consortium and Director of Visualization at Virginia Tech"},{"@id":"px:s422","@type":"px:Statement","px:subject":{"@id":"px:n2188"},"px:predicate":"cites","px:object":{"@id":"px:n933"},"prov":"doc","grade":"Confirmed","px:evidence":"See [[landing-v2-gifts]], [[giza-x3d-showpiece]]."},{"@id":"px:s423","@type":"px:Statement","px:subject":{"@id":"px:n1625"},"px:predicate":"validates","px:object":{"@id":"px:n1091"},"prov":"doc","grade":"Confirmed","px:evidence":"Fork validator @c9c9788: 9/9 clean."},{"@id":"px:s424","@type":"px:Statement","px:subject":{"@id":"px:n1091"},"px:predicate":"uses","px:object":{"@id":"px:n457"},"prov":"doc","grade":"Confirmed","px:evidence":"One Transform ZOOM: scale 600/D (361 keys, linear in log D from 600 m to 10^17.9 m)"},{"@id":"px:s425","@type":"px:Statement","px:subject":{"@id":"px:n2229"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1091"},"prov":"doc","grade":"Confirmed","px:evidence":"R1 GeoElevationGrid at 1 m loses 0.16 m RMS / 0.28 m max to float32 geocentric rounding, with visible creases"},{"@id":"px:s426","@type":"px:Statement","px:subject":{"@id":"px:n1885"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1091"},"prov":"doc","grade":"Confirmed","px:evidence":"R3 spec defines 23 Earth ellipsoids only, but X_ITE ships SUN to PLUTO and its URANUS equatorial radius is 2555e3 (10x too small)"},{"@id":"px:s427","@type":"px:Statement","px:subject":{"@id":"px:n2178"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1091"},"prov":"doc","grade":"Confirmed","px:evidence":"R4 X_ITE measures LOD distance after scaling"},{"@id":"px:s428","@type":"px:Statement","px:subject":{"@id":"px:n2319"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1091"},"prov":"doc","grade":"Confirmed","px:evidence":"libxml2 2.14.6 XSD \"Internal error\" for one GaussianSplats node between 362k and 375k splats (halves validate)"},{"@id":"px:s429","@type":"px:Statement","px:subject":{"@id":"px:n800"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1091"},"prov":"doc","grade":"Confirmed","px:evidence":"X_ITE \"Sort worker error: memory access out of bounds\" with splats in the scaled zoom (no isolated repro)"},{"@id":"px:s430","@type":"px:Statement","px:subject":{"@id":"px:n902"},"px:predicate":"blocks","px:object":{"@id":"px:n1661"},"prov":"doc","grade":"Confirmed","px:evidence":"Loop experiment (30 prompts x 3 arms, cap $8) built but NOT run: GCP_PROJECT env var is unset"},{"@id":"px:s431","@type":"px:Statement","px:subject":{"@id":"px:n1929"},"px:predicate":"validates","px:object":{"@id":"px:n994"},"prov":"doc","grade":"Confirmed","px:evidence":"A hash-chained provenance record (`x3dprov`) rides inside the scene's own `<head><meta>` lines, survives the Blender round trip, and is checked by `verify()`."},{"@id":"px:s432","@type":"px:Statement","px:subject":{"@id":"px:n1443"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"HagopJay, 12 Oct 2026 23:42Z, after making demo-418 broadly admin (projectIamAdmin, compute.admin, aiplatform.admin and more): \"dont just go requesting more quota. dont let the admin go to your head i want to approve every upgrade!\""},{"@id":"px:s433","@type":"px:Statement","px:subject":{"@id":"px:n722"},"px:predicate":"authored_by","px:object":{"@id":"px:n289"},"prov":"doc","grade":"Confirmed","px:evidence":"Narra et al., X3Test (doi 10.1145/3746237.3746315)"},{"@id":"px:s434","@type":"px:Statement","px:subject":{"@id":"px:n814"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"Thread \"Traceability\" (HagopJay's insight: traceability and observability are a major win for X3D in real-time ML operation pipelines)"},{"@id":"px:s435","@type":"px:Statement","px:subject":{"@id":"px:n1801"},"px:predicate":"implements","px:object":{"@id":"px:n542"},"prov":"doc","grade":"Confirmed","px:evidence":"Armatures export as HAnim 2.0 humanoids: joint hierarchy, skinned meshes with weights, and joint rotation animation relative to rest."},{"@id":"px:s436","@type":"px:Statement","px:subject":{"@id":"px:n2111"},"px:predicate":"reads","px:object":{"@id":"px:n1600"},"prov":"doc","grade":"Confirmed","px:evidence":"splats Blender 5.3 imports from PLY, SPZ, glTF or USD can leave Blender as X3D."},{"@id":"px:s437","@type":"px:Statement","px:subject":{"@id":"px:n2111"},"px:predicate":"reads","px:object":{"@id":"px:n1695"},"prov":"doc","grade":"Confirmed","px:evidence":"splats Blender 5.3 imports from PLY, SPZ, glTF or USD can leave Blender as X3D."},{"@id":"px:s438","@type":"px:Statement","px:subject":{"@id":"px:n2111"},"px:predicate":"reads","px:object":{"@id":"px:n73"},"prov":"doc","grade":"Confirmed","px:evidence":"splats Blender 5.3 imports from PLY, SPZ, glTF or USD can leave Blender as X3D."},{"@id":"px:s439","@type":"px:Statement","px:subject":{"@id":"px:n1671"},"px:predicate":"uses","px:object":{"@id":"px:n683"},"prov":"doc","grade":"Confirmed","px:evidence":"the drop check does not cover an XML source, because x3d.py 