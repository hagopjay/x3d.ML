<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<Viewpoint description='Door swings open on load' position='0 1.6 5'/>
<Background skyColor='0.5 0.7 1'/>
<NavigationInfo type='["WALK","ANY"]'/>
<!-- Floor -->
<Transform translation='0 -0.05 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.3 0.3 0.3'/>
</Appearance>
<Box size='20 0.1 20'/>
</Shape>
</Transform>
<!-- Back wall -->
<Transform translation='0 1.25 -5'>
<Shape>
<Appearance>
<Material diffuseColor='0.8 0.8 0.8'/>
</Appearance>
<Box size='10 2.5 0.1'/>
</Shape>
</Transform>
<!-- Left wall -->
<Transform translation='-5 1.25 0' rotation='0 1 0 1.5708'>
<Shape>
<Appearance>
<Material diffuseColor='0.8 0.8 0.8'/>
</Appearance>
<Box size='10 2.5 0.1'/>
</Shape>
</Transform>
<!-- Right wall with doorway -->
<Transform translation='5 1.25 0' rotation='0 1 0 1.5708'>
<Shape>
<Appearance>
<Material diffuseColor='0.8 0.8 0.8'/>
</Appearance>
<Box size='10 2.5 0.1'/>
</Shape>
</Transform>
<!-- Door frame (static) -->
<Transform translation='-2 1 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.4 0.2 0.1'/>
</Appearance>
<Box size='0.1 2.1 0.2'/>
</Shape>
</Transform>
<!-- Door that swings open -->
<Transform DEF='DOOR_TRANSFORM' translation='-2 0 0' rotation='0 1 0 0'>
<Transform translation='0.5 1 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.6 0.3 0.1'/>
</Appearance>
<Box size='1 2 0.1'/>
</Shape>
</Transform>
</Transform>
<!-- Animation: TimeSensor triggers OrientationInterpolator -->
<TimeSensor DEF='TS' cycleInterval='2' loop='false'/>
<OrientationInterpolator DEF='OI' key='0 1' keyValue='0 1 0 0  0 1 0 1.5708'/>
<ROUTE fromNode='TS' fromField='fraction_changed' toNode='OI' toField='set_fraction'/>
<ROUTE fromNode='OI' fromField='value_changed' toNode='DOOR_TRANSFORM' toField='set_rotation'/>
</Scene>
</X3D>