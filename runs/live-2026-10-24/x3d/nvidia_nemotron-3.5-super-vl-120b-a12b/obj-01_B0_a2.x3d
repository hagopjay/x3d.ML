<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
    <meta name="title" content="Red PBR Sphere on Grey Ground"/>
  </head>
  <Scene>
    <Viewpoint DEF="MainViewpoint" description="A red PBR sphere on a grey ground plane" position="0 2 5" orientation="0 1 0 0"/>
    <DirectionalLight direction="0 -1 -1" intensity="1" color="1 1 1"/>
    <Transform translation="0 1 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="1 0 0" roughness="0.2" metallic="0"/>
        </Appearance>
        <Sphere radius="1"/>
      </Shape>
    </Transform>
    <Transform translation="0 -0.05 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.5 0.5 0.5" roughness="1" metallic="0"/>
        </Appearance>
        <Box size="20 0.1 20"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>