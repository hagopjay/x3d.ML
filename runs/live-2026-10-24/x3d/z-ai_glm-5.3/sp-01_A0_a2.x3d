<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Background skyColor='0.05 0.06 0.16 0.01 0.01 0.04' skyAngle='1.35 1.57' groundColor='0.01 0.02 0.05 0.00 0.00 0.02' groundAngle='1.35 1.57'/>
    <Viewpoint description='Lighthouse on a rocky island at night' position='18 7 24' orientation='0 1 0 0.64'/>
    <DirectionalLight direction='-0.4 -1 -0.3' color='0.45 0.55 0.8' intensity='0.6'/>
    <PointLight location='0 12.4 0' color='1 0.9 0.6' intensity='0.9' radius='22'/>

    <!-- Dark blue sea -->
    <Transform translation='0 -0.1 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.02 0.09 0.22' specularColor='0.1 0.2 0.35' shininess='0.5'/>
        </Appearance>
        <Box size='400 0.2 400'/>
      </Shape>
    </Transform>

    <!-- Rocky island -->
    <Transform translation='0 -0.25 0' scale='1 0.25 1'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.22 0.22 0.24'/>
        </Appearance>
        <Sphere radius='5'/>
      </Shape>
    </Transform>
    <Transform translation='3.5 0.2 2.0' scale='1 0.6 1'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.22'/>
        </Appearance>
        <Sphere radius='1.4'/>
      </Shape>
    </Transform>
    <Transform translation='-3.2 0.1 -2.5'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.19 0.19 0.21'/>
        </Appearance>
        <Sphere radius='1.0'/>
      </Shape>
    </Transform>
    <Transform translation='-1.5 0.05 3.8'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.21 0.21 0.23'/>
        </Appearance>
        <Sphere radius='0.8'/>
      </Shape>
    </Transform>

    <!-- Base platform -->
    <Transform translation='0 1.25 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.35 0.35 0.38'/>
        </Appearance>
        <Cylinder radius='2.6' height='0.5'/>
      </Shape>
    </Transform>

    <!-- Tapered white tower with two red bands -->
    <Transform translation='0 3.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.95 0.95 0.95'/>
        </Appearance>
        <Cylinder bottomRadius='2.0' topRadius='1.6' height='4'/>
      </Shape>
    </Transform>
    <Transform translation='0 6.0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.05 0.05'/>
        </Appearance>
        <Cylinder bottomRadius='1.6' topRadius='1.5' height='1'/>
      </Shape>
    </Transform>
    <Transform translation='0 8.0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.95 0.95 0.95'/>
        </Appearance>
        <Cylinder bottomRadius='1.5' topRadius='1.2' height='3'/>
      </Shape>
    </Transform>
    <Transform translation='0 10.0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.05 0.05'/>
        </Appearance>
        <Cylinder bottomRadius='1.2' topRadius='1.1' height='1'/>
      </Shape>
    </Transform>
    <Transform translation='0 11.0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.95 0.95 0.95'/>
        </Appearance>
        <Cylinder bottomRadius='1.1' topRadius='1.0' height='1'/>
      </Shape>
    </Transform>

    <!-- Door -->
    <Transform translation='0 2.3 1.95'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.1 0.1 0.12'/>
        </Appearance>
        <Box size='0.8 1.4 0.1'/>
      </Shape>
    </Transform>

    <!-- Gallery deck -->
    <Transform translation='0 11.6 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.15 0.15 0.18'/>
        </Appearance>
        <Cylinder radius='1.6' height='0.15'/>
      </Shape>
    </Transform>

    <!-- Glass lantern room -->
    <Transform translation='0 12.4 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.75 0.85 0.95' specularColor='0.5 0.5 0.5' shininess='0.4' transparency='0.55'/>
        </Appearance>
        <Cylinder radius='0.9' height='1.4'/>
      </Shape>
    </Transform>

    <!-- Lamp -->
    <Transform translation='0 12.4 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.4 0.3 0.1' emissiveColor='1 0.85 0.4'/>
        </Appearance>
        <Sphere radius='0.35'/>
      </Shape>
    </Transform>

    <!-- Lantern roof and finial -->
    <Transform translation='0 13.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.12 0.12 0.15'/>
        </Appearance>
        <Cone bottomRadius='1.1' height='0.8'/>
      </Shape>
    </Transform>
    <Transform translation='0 14.0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.12 0.12 0.15'/>
        </Appearance>
        <Sphere radius='0.15'/>
      </Shape>
    </Transform>

    <!-- Sweeping pale yellow beam -->
    <Transform DEF='BeamSpinner' translation='0 12.4 0'>
      <Transform translation='0 0 6'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 1 0.75' emissiveColor='1 0.95 0.6' transparency='0.45'/>
          </Appearance>
          <Box size='0.25 0.35 12'/>
        </Shape>
      </Transform>
    </Transform>

    <TimeSensor DEF='SweepClock' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='SweepSpin' key='0 1' keyValue='0 1 0 0 0 1 0 6.2832'/>
    <ROUTE fromNode='SweepClock' fromField='fraction_changed' toNode='SweepSpin' toField='set_fraction'/>
    <ROUTE fromNode='SweepSpin' fromField='value_changed' toNode='BeamSpinner' toField='set_rotation'/>
  </Scene>
</X3D>