<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Three Rotating Cubes'/>
    <meta name='description' content='Three cubes that rotate at different speeds driven by three separate TimeSensors.'/>
  </head>
  <Scene>
    <Viewpoint description='View Three Rotating Cubes' position='0 0 10'/>
    
    <!-- Fast Red Cube (Rotates on Y axis) -->
    <Transform DEF='Cube1' translation='-3 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='1 0 0'/>
        </Appearance>
        <Box size='1.5 1.5 1.5'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Timer1' cycleInterval='2.0' loop='true'/>
    <OrientationInterpolator DEF='Rotator1' key='0 0.5 1' keyValue='0 1 0 0, 0 1 0 3.14159, 0 1 0 6.28318'/>
    <ROUTE fromNode='Timer1' fromField='fraction_changed' toNode='Rotator1' toField='set_fraction'/>
    <ROUTE fromNode='Rotator1' fromField='value_changed' toNode='Cube1' toField='rotation'/>

    <!-- Medium Green Cube (Rotates on X axis) -->
    <Transform DEF='Cube2' translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 1 0'/>
        </Appearance>
        <Box size='1.5 1.5 1.5'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Timer2' cycleInterval='4.0' loop='true'/>
    <OrientationInterpolator DEF='Rotator2' key='0 0.5 1' keyValue='1 0 0 0, 1 0 0 3.14159, 1 0 0 6.28318'/>
    <ROUTE fromNode='Timer2' fromField='fraction_changed' toNode='Rotator2' toField='set_fraction'/>
    <ROUTE fromNode='Rotator2' fromField='value_changed' toNode='Cube2' toField='rotation'/>

    <!-- Slow Blue Cube (Rotates on Z axis) -->
    <Transform DEF='Cube3' translation='3 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
        <Box size='1.5 1.5 1.5'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Timer3' cycleInterval='8.0' loop='true'/>
    <OrientationInterpolator DEF='Rotator3' key='0 0.5 1' keyValue='0 0 1 0, 0 0 1 3.14159, 0 0 1 6.28318'/>
    <ROUTE fromNode='Timer3' fromField='fraction_changed' toNode='Rotator3' toField='set_fraction'/>
    <ROUTE fromNode='Rotator3' fromField='value_changed' toNode='Cube3' toField='rotation'/>
  </Scene>
</X3D>