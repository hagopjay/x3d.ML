<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Rotating DNA Double Helix'/>
    <meta name='description' content='Two spiral strands with base-pair rungs rotating about long axis'/>
  </head>
  <Scene>
    <Viewpoint DEF='VP' description='DNA Double Helix' position='0 5 20' orientation='0 1 0 -0.2'/>
    <Transform DEF='Rotator'>
      <TouchSensor DEF='Touch'/>
      <!-- Reusable shapes -->
      <Shape DEF='BlueSphere'>
        <Sphere radius='0.15'/>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
      </Shape>
      <Shape DEF='OrangeSphere'>
        <Sphere radius='0.15'/>
        <Appearance>
          <Material diffuseColor='1 0.5 0'/>
        </Appearance>
      </Shape>
      <Shape DEF='RungShape'>
        <Cylinder radius='0.05' height='2.0'/>
        <Appearance>
          <Material diffuseColor='0.5 0.5 0.5'/>
        </Appearance>
      </Shape>
      <!-- Base pair 0 -->
      <Transform translation='1 0 0'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-1 0 0'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 0 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 1 -->
      <Transform translation='0.809017 0.5 0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.809017 0.5 -0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 0.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 2 -->
      <Transform translation='0.309017 1 0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.309017 1 -0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 1 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 3 -->
      <Transform translation='-0.309017 1.5 0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.309017 1.5 -0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 1.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 4 -->
      <Transform translation='-0.809017 2 0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.809017 2 -0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 2 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 5 -->
      <Transform translation='-1 2.5 0'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='1 2.5 0'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 2.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 6 -->
      <Transform translation='-0.809017 3 -0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.809017 3 0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 3 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 7 -->
      <Transform translation='-0.309017 3.5 -0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.309017 3.5 0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 3.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 8 -->
      <Transform translation='0.309017 4 -0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.309017 4 0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 4 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 9 -->
      <Transform translation='0.809017 4.5 -0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.809017 4.5 0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 4.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 10 -->
      <Transform translation='1 5 0'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-1 5 0'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 11 -->
      <Transform translation='0.809017 5.5 0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.809017 5.5 -0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 5.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 12 -->
      <Transform translation='0.309017 6 0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.309017 6 -0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 6 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 13 -->
      <Transform translation='-0.309017 6.5 0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.309017 6.5 -0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 6.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 14 -->
      <Transform translation='-0.809017 7 0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.809017 7 -0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 7 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 15 -->
      <Transform translation='-1 7.5 0'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='1 7.5 0'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 7.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 16 -->
      <Transform translation='-0.809017 8 -0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.809017 8 0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 8 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 17 -->
      <Transform translation='-0.309017 8.5 -0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='0.309017 8.5 0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 8.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 18 -->
      <Transform translation='0.309017 9 -0.951057'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.309017 9 0.951057'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 9 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
      <!-- Base pair 19 -->
      <Transform translation='0.809017 9.5 -0.587785'>
        <Shape USE='BlueSphere'/>
      </Transform>
      <Transform translation='-0.809017 9.5 0.587785'>
        <Shape USE='OrangeSphere'/>
      </Transform>
      <Transform translation='0 9.5 0' rotation='0 0 1 1.570796'>
        <Shape USE='RungShape'/>
      </Transform>
    </Transform>
    <TimeSensor DEF='TS' cycleInterval='10' loop='true'/>
    <OrientationInterpolator DEF='OI' key='0 1' keyValue='0 0 1 0  0 0 1 6.283185'/>
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='OI' toField='set_fraction'/>
    <ROUTE fromNode='OI' fromField='value_changed' toNode='Rotator' toField='rotation'/>
  </Scene>
</X3D>