<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='button_spin_cylinder.x3d' name='title'/>
    <meta content='A button box that when clicked starts a cylinder spinning permanently.' name='description'/>
  </head>
  <Scene>
    <WorldInfo title='Button Spins Cylinder'/>
    <Viewpoint description='View Scene' position='0 1.2 3.5'/>

    <Background skyColor='0.12 0.14 0.18'/>
    <DirectionalLight direction='-0.5 -1 -0.8' intensity='0.9'/>
    <DirectionalLight direction='0.5 0.5 1' intensity='0.3'/>

    <Transform translation='0 -0.1 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.22 0.25' roughness='0.8'/>
        </Appearance>
        <Box size='3 0.1 1.6'/>
      </Shape>
    </Transform>

    <Transform translation='-0.7 0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.35 0.35 0.38'/>
        </Appearance>
        <Box size='0.6 0.2 0.6'/>
      </Shape>
      <Transform translation='0 0.15 0'>
        <TouchSensor DEF='ButtonTouch' description='Press to start spinning'/>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.85 0.15 0.15' roughness='0.3'/>
          </Appearance>
          <Box size='0.35 0.12 0.35'/>
        </Shape>
      </Transform>
    </Transform>

    <Transform translation='0.7 0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.35 0.35 0.38'/>
        </Appearance>
        <Cylinder height='0.2' radius='0.4'/>
      </Shape>
    </Transform>

    <Transform DEF='CylinderTransform' translation='0.7 0.65 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.1 0.5 0.85' roughness='0.3'/>
        </Appearance>
        <Cylinder height='0.9' radius='0.3'/>
      </Shape>
      <Shape>
        <Appearance>
          <Material diffuseColor='1 0.75 0.1' roughness='0.4'/>
        </Appearance>
        <Box size='0.65 0.85 0.08'/>
      </Shape>
    </Transform>

    <TimeSensor DEF='SpinClock' cycleInterval='2.0' loop='true' startTime='0' stopTime='1'/>
    <OrientationInterpolator DEF='SpinnerInterp' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0  0 1 0 1.570796  0 1 0 3.141593  0 1 0 4.712389  0 1 0 6.283185'/>

    <Script DEF='StartOnce'>
      <field accessType='inputOnly' name='touchTime' type='SFTime'/>
      <field accessType='outputOnly' name='startTime' type='SFTime'/>
      <field accessType='initializeOnly' name='started' type='SFBool' value='false'/>
<![CDATA[
ecmascript:
function touchTime(value) {
  if (!started) {
    started = true;
    startTime = value;
  }
}
]]>
    </Script>

    <ROUTE fromField='touchTime' fromNode='ButtonTouch' toField='touchTime' toNode='StartOnce'/>
    <ROUTE fromField='startTime' fromNode='StartOnce' toField='set_startTime' toNode='SpinClock'/>
    <ROUTE fromField='fraction_changed' fromNode='SpinClock' toField='set_fraction' toNode='SpinnerInterp'/>
    <ROUTE fromField='value_changed' fromNode='SpinnerInterp' toField='set_rotation' toNode='CylinderTransform'/>
  </Scene>
</X3D>