<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Core' level='1'/>
    <component name='Rendering' level='1'/>
    <component name='Shape' level='1'/>
    <component name='Geometry3D' level='1'/>
    <component name='Grouping' level='1'/>
    <component name='Navigation' level='1'/>
    <component name='HAnim' level='2'/>
  </head>
  <Scene>
    <Switch whichChoice='-1'>
      <Transform DEF='RightHandObject'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0 0'/>
          </Appearance>
          <Sphere radius='0.05'/>
        </Shape>
      </Transform>
    </Switch>

    <HAnimHumanoid version='2.0' name='SimpleHumanoid'>
      <HAnimJoint containerField='skeleton' name='HAnimRoot' center='0 0 0' ulimit='0 0 0' llimit='0 0 0' stiffness='0' damping='0'>
        <HAnimSegment containerField='segment' name='RootSegment' translation='0 0 0' rotation='0 0 1 0' scale='1 1 1' scaleOrientation='0 0 1 0'/>
        <HAnimJoint containerField='children' name='r_wrist' center='0.2 1.4 0' ulimit='0 0 0' llimit='0 0 0' stiffness='0' damping='0'>
          <HAnimSegment containerField='segment' name='RightHandSegment' translation='0 0 0' rotation='0 0 1 0' scale='1 1 1' scaleOrientation='0 0 1 0'/>
          <HAnimSite containerField='sites' name='RightHand' translation='0 0 0' rotation='0 0 1 0'>
            <USE node='RightHandObject'/>
          </HAnimSite>
        </HAnimJoint>
      </HAnimJoint>
    </HAnimHumanoid>

    <Viewpoint position='0 1.6 5' description='Eye level view'/>
  </Scene>
</X3D>