<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<!-- Water plane -->
<Transform>
<Shape>
<Appearance>
<Material diffuseColor='0.2 0.2 0.8' transparency='0.6'/>
</Appearance>
<Box size='10 0.1 10'/>
</Shape>
</Transform>

<!-- DirectionalLight (low sun) -->
<DirectionalLight direction='0 -1 -0.5' intensity='0.5' color='1 1 0.9'/>

<!-- Viewpoint -->
<Viewpoint description='View of torii gate' position='0 10 20'/>

<!-- Torii gate group with animation -->
<Transform DEF='ToriiTransform'>
<!-- Left post -->
<Transform translation='-2.5 2.5 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.8 0.2 0.2'/>
</Appearance>
<Box size='0.5 5 0.5'/>
</Shape>
</Transform>
<!-- Right post -->
<Transform translation='2.5 2.5 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.8 0.2 0.2'/>
</Appearance>
<Box size='0.5 5 0.5'/>
</Shape>
</Transform>
<!-- Top beam -->
<Transform translation='0 5 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.8 0.2 0.2'/>
</Appearance>
<Box size='6 0.5 0.5'/>
</Shape>
</Transform>
</Transform>

<!-- Stone lantern left -->
<Transform translation='-4 0.25 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.6 0.6 0.6'/>
</Appearance>
<Cylinder radius='0.3' height='0.5'/>
</Shape>
</Transform>
<Transform translation='-4 0.8 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.6 0.6 0.6'/>
</Appearance>
<Box size='0.6 0.6 0.6'/>
</Shape>
</Transform>

<!-- Stone lantern right -->
<Transform translation='4 0.25 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.6 0.6 0.6'/>
</Appearance>
<Cylinder radius='0.3' height='0.5'/>
</Shape>
</Transform>
<Transform translation='4 0.8 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.6 0.6 0.6'/>
</Appearance>
<Box size='0.6 0.6 0.6'/>
</Shape>
</Transform>

<!-- Animation -->
<TimeSensor DEF='Ts' loop='true' cycleInterval='10'/>
<OrientationInterpolator DEF='Oi' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307179586'/>
<ROUTE fromNode='Ts' fromField='fraction_changed' toNode='Oi' toField='set_fraction'/>
<ROUTE fromNode='Oi' fromField='value_changed' toNode='ToriiTransform' toField='rotation'/>
</Scene>
</X3D>