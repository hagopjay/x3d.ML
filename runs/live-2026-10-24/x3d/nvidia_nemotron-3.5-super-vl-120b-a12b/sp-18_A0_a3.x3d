<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Aquarium'/>
  </head>
  <Scene>
    <Viewpoint description='Aquarium view' position='0 3 8' orientation='0 1 0 0'/>
    <Background skyColor='0.1 0.4 0.8' groundColor='0.8 0.7 0.6'/>
    <NavigationInfo type='"EXAMINE" "ANY"' avatarSize='0.25' headlight='true'/>
    <DirectionalLight direction='0 -1 -0.3' intensity='0.8' color='1 1 1'/>

    <Transform translation='0 2.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.95 1.0' transparency='0.7'/>
        </Appearance>
        <Box size='12 5 12'/>
      </Shape>
    </Transform>

    <Transform translation='0 0.1 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.8 0.6'/>
        </Appearance>
        <Box size='12 0.2 12'/>
      </Shape>
    </Transform>

    <Transform translation='-3 0.25 3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='3 0.25 3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='-3 0.25 -3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
      </Shape>
    </Transform>
    <Transform translation='3 0.25 -3'>
      <Shape>
        <Appearance><Material diffuseColor='0 0.6 0'/></Appearance>
        <Cylinder radius='0.05' height='0.5'/>
