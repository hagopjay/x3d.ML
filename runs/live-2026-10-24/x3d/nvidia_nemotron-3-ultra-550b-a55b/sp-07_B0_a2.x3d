        </Shape>
      </Transform>
      <Transform translation='0.5 1.0 0.0'>
        <Shape>
          <Appearance USE='OrangeApp'/>
          <Sphere USE='SphereGeom'/>
        </Shape>
      </Transform>
      <Transform translation='0.4045084971874737 1.2 0.2938926261462366'>
        <Shape>
          <Appearance USE='OrangeApp'/>
          <Sphere USE='SphereGeom'/>
        </Shape>
      </Transform>
      <Transform translation='0.1545084971874737 1.4 0.4755282581475768'>
        <Shape>
          <Appearance USE='OrangeApp'/>
          <Sphere USE='SphereGeom'/>
        </Shape>
      </Transform>
      <Transform translation='-0.1545084971874737 1.6 0.4755282581475768'>
        <Shape>
          <Appearance USE='OrangeApp'/>
          <Sphere USE='SphereGeom'/>
        </Shape>
      </Transform>
      <Transform translation='-0.4045084971874737 1.8 0.2938926261462366'>
