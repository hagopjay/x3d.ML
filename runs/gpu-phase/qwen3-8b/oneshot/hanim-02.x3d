<Scene>
<Viewpoint description='HAnim Figure' position='0 3 5' orientation='0 1 0 0'/>
<NavigationInfo type='EXAMINE'/>
<TimeSensor DEF='WaveTimer' cycleTime='2' loop='TRUE'/>
<OrientationInterpolator DEF='ArmRotation' key='0 0.5 1' keyValue='0 1 0 0 0 1 0 1.5707 0 1 0 3.1415'/>
<ROUTE fromNode='WaveTimer' fromField='fractionChanged' toNode='ArmRotation' toField='set_fraction'/>
<HAnimHumanoid DEF='Figure' url='hAnimFigure.x3d'/>
<HAnimJoint DEF='ShoulderJoint' name='rightShoulder' containerField='joint' translation='0.5 0 0'/>
<HAnimSegment DEF='ArmSegment' name='rightUpperArm' containerField='segment' translation='0 0 0'/>
<ROUTE fromNode='ArmRotation' fromField='value' toNode='ShoulderJoint' toField='rotation'/>
</Scene>
</X3D>