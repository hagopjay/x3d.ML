<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Highlight Box on Hover'/>
  </head>
  <Scene>
    <Viewpoint description='Box that highlights emissive yellow while pointer is over it' position='0 0 5'/>
    <DirectionalLight intensity='0.6' color='1 1 1' direction='0 -1 0'/>
    <Transform>
      <TouchSensor DEF='BoxTouch'/>
      <Shape>
        <Appearance>
          <Material DEF='BoxMaterial' diffuseColor='0.8 0.8 0.8' emissiveColor='0 0 0'/>
        </Appearance>
        <Box/>
      </Shape>
    </Transform>
    <Script DEF='HighlightScript'>
      <field name='isOver' type='SFBool' accessType='inputOnly'/>
      <field name='emissiveColor' type='SFColor' accessType='outputOnly'/>
      <![CDATA[
        function isOver(value) {
          emissiveColor = value ? new SFColor(1,1,0) : new SFColor(0,0,0);
        }
      ]]>
    </Script>
    <ROUTE fromNode='BoxTouch' fromField='isOver' toNode='HighlightScript' toField='isOver'/>
    <ROUTE fromNode='HighlightScript' fromField='emissiveColor' toNode='BoxMaterial' toField='emissiveColor'/>
  </Scene>
</X3D>