  <Scene>
    <Viewpoint description='Door Opening' position='0 0 5' />
    <Transform DEF='DoorBase' translation='0 0 0'>
      <Transform DEF='Door' rotation='0 1 0 0'>
        <Shape>
          <Box size='2 4 0.1' />
          <Appearance>
            <Material diffuseColor='0.6 0.3 0.1' />
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <TimeSensor DEF='DoorTimer' cycleInterval='2' loop='false' />
    <OrientationInterpolator DEF='DoorAnim' key='0 1' keyValue='0 1 0 0 0 1 0 1.57079632679' />
    <ROUTE fromNode='DoorTimer' fromField='fraction_changed' toNode='DoorAnim' toField='set_fraction' />
    <ROUTE fromNode='DoorAnim' fromField='value_changed' toNode='Door' toField='set_rotation' />
  </Scene>
</X3D>