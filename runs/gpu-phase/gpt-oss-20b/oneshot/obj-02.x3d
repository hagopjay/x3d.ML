  <Scene>
    <Viewpoint description='Table view' position='0 2 5' orientation='0 0 0 0' />
    <!-- Table top -->
    <Transform translation='0 0.8 0'>
      <Shape>
        <Box size='2 0.05 1' />
        <Appearance>
          <Material diffuseColor='0.6 0.4 0.2' />
        </Appearance>
      </Shape>
    </Transform>
    <!-- Leg definition -->
    <Transform DEF='Leg' translation='0 0 0'>
