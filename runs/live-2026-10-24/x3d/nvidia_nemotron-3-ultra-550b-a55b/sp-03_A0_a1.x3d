<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Newton\'s Cradle'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 5' description="Newton's Cradle"/>
    <Background skyColor='0.8 0.8 0.8'/>
    
    <!-- Animation -->
    <TimeSensor DEF='TS' cycleInterval='4' loop='true'/>
    <TouchSensor DEF='TOUCH'/>
    <OrientationInterpolator DEF='LEFT_INTERP' key='0 0.125 0.25 1' keyValue='0 0 1 0  0 0 1 -0.5  0 0 1 0  0 0 1 0'/>
    <OrientationInterpolator DEF='RIGHT_INTERP' key='0 0.25 0.375 0.5 1' keyValue='0 0 1 0  0 0 1 0  0 0 1 0.5  0 0 1 0  0 0 1 0'/>
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='LEFT_INTERP' toField='set_fraction'/>
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='RIGHT_INTERP' toField='set_fraction'/>
    <ROUTE fromNode='LEFT_INTERP' fromField='value_changed' toNode='LEFT_PIVOT' toField='rotation'/>
    <ROUTE fromNode='RIGHT_INTERP' fromField='value_changed' toNode='RIGHT_PIVOT' toField='rotation'/>
    <ROUTE fromNode='TOUCH' fromField='touchTime' toNode='TS' toField='startTime'/>
    
    <!-- Frame -->
    <Transform rotation='0 0 1 -1.570796'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.1 0.1 0.1' metallic='0' roughness='0.9'/>
        </Appearance>
        <Cylinder radius='0.02' height='2.0'/>
      </Shape>
    </Transform>
    
    <!-- Five balls with wires -->
    <!-- Ball 0 (leftmost) -->
    <Transform DEF='LEFT_PIVOT' translation='-1 0 0'>
      <Transform translation='0 -0.5 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.1 0.1 0.1' metallic='0' roughness='0.9'/>
          </Appearance>
          <Cylinder radius='0.005' height='1.0'/>
        </Shape>
      </Transform>
      <Transform translation='0 -1 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.7 0.7 0.8' metallic='1' roughness='0.1'/>
          </Appearance>
          <Sphere radius='0.1'/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Ball 1 -->
    <Transform translation='-0.5 0 0'>
      <Transform translation='0 -0.5 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.1 0.1 0.1' metallic='0' roughness='0.9'/>
          </Appearance>
          <Cylinder radius='0.005' height='1.0'/>
        </Shape>
      </Transform>
      <Transform translation='0 -1 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.7 0.7 0.8' metallic='1' roughness='0.1'/>
          </Appearance>
          <Sphere radius='0.1'/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Ball 2 (center) -->
    <Transform translation='0 0 0'>
      <Transform translation='0 -0.5 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.1 0.1 0.1' metallic='0' roughness='0.9'/>
          </Appearance>
          <Cylinder radius='0.005' height='1.0'/>
        </Shape>
      </Transform>
      <Transform translation='0 -1 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.7 0.7 0.8' metallic='1' roughness='0.1'/>
          </Appearance>
          <Sphere radius='0.1'/>
        </Shape>
      </Transform>
    </Transform>
    
    <!-- Ball 3 -->
    <Transform translation='0.5 0 0'>
      <Transform translation='0 -0.5 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.1 0.1 0.1' metallic='0' roughness='0.9'/>
          </Appearance