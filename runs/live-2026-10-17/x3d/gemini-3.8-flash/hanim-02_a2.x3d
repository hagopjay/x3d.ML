<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='2'/>
  </head>
  <Scene>
    <WorldInfo title='Waving HAnim Figure'/>
    <Viewpoint description='Front View' position='0 1.25 3.0'/>
    <Background skyColor='0.12 0.14 0.18'/>
    <DirectionalLight direction='0.4 -0.8 -0.5' intensity='0.9'/>
    <DirectionalLight direction='-0.4 0.3 0.6' intensity='0.4'/>

    <!-- Floor Pedestal -->
    <Transform translation='0 -0.025 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.22 0.26'/>
        </Appearance>
        <Cylinder radius='0.8' height='0.05'/>
      </Shape>
    </Transform>

    <HAnimHumanoid name='WavingHumanoid' version='2.0'>
      <HAnimJoint name='humanoid_root' center='0 0.9 0' containerField='skeleton'>
        <HAnimSegment name='sacrum'>
          <Transform translation='0 0.9 0'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.25 0.5 0.75'/>
              </Appearance>
              <Box size='0.28 0.16 0.18'/>
            </Shape>
          </Transform>
        </HAnimSegment>

        <!-- Left Leg -->
        <HAnimJoint name='l_hip' center='0.1 0.82 0'>
          <HAnimSegment name='l_thigh'>
            <Transform translation='0.1 0.62 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.25 0.5 0.75'/>
                </Appearance>
                <Cylinder radius='0.055' height='0.36'/>
              </Shape>
            </Transform>
          </HAnimSegment>
          <HAnimJoint name='l_knee' center='0.1 0.44 0'>
            <HAnimSegment name='l_calf'>
              <Transform translation='0.1 0.24 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.25 0.5 0.75'/>
                  </Appearance>
                  <Cylinder radius='0.048' height='0.36'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint name='l_ankle' center='0.1 0.06 0'>
              <HAnimSegment name='l_hindfoot'>
                <Transform translation='0.1 0.03 0.04'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.15 0.18 0.24'/>
                    </Appearance>
                    <Box size='0.09 0.06 0.18'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

        <!-- Right Leg -->
        <HAnimJoint name='r_hip' center='-0.1 0.82 0'>
          <HAnimSegment name='r_thigh'>
            <Transform translation='-0.1 0.62 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.25 0.5 0.75'/>
                </Appearance>
                <Cylinder radius='0.055' height='0.36'/>
              </Shape>
            </Transform>
          </HAnimSegment>
          <HAnimJoint name='r_knee' center='-0.1 0.44 0'>
            <HAnimSegment name='r_calf'>
              <Transform translation='-0.1 0.24 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.25 0.5 0.75'/>
                  </Appearance>
                  <Cylinder radius='0.048' height='0.36'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint name='r_ankle' center='-0.1 0.06 0'>
              <HAnimSegment name='r_hindfoot'>
                <Transform translation='-0.1 0.03 0.04'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.15 0.18 0.24'/>
                    </Appearance>
                    <Box size='0.09 0.06 0.18'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

        <!-- Torso & Spine -->
        <HAnimJoint name='vl5' center='0 0.98 0'>
          <HAnimSegment name='torso'>
            <Transform translation='0 1.2 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.28 0.55 0.82'/>
                </Appearance>
                <Box size='0.34 0.44 0.2'/>
              </Shape>
            </Transform>
          </HAnimSegment>

          <!-- Head -->
          <HAnimJoint name='skullbase' center='0 1.46 0'>
            <HAnimSegment name='head'>
              <Transform translation='0 1.62 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.85 0.88 0.92'/>
                  </Appearance>
                  <Sphere radius='0.12'/>
                </Shape>
              </Transform>
            </HAnimSegment>
          </HAnimJoint>

          <!-- Left Arm (Resting) -->
          <HAnimJoint name='l_shoulder' center='0.24 1.38 0'>
            <HAnimSegment name='l_upperarm'>
              <Transform translation='0.24 1.21 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.25 0.5 0.75'/>
                  </Appearance>
                  <Cylinder radius='0.042' height='0.28'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint name='l_elbow' center='0.24 1.04 0'>
              <HAnimSegment name='l_forearm'>
                <Transform translation='0.24 0.89 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.25 0.5 0.75'/>
                    </Appearance>
                    <Cylinder radius='0.038' height='0.26'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint name='l_wrist' center='0.24 0.74 0'>
                <HAnimSegment name='l_hand'>
                  <Transform translation='0.24 0.68 0'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.85 0.88 0.92'/>
                      </Appearance>
                      <Box size='0.045 0.08 0.06'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

          <!-- Right Arm (Animated Wave) -->
          <HAnimJoint DEF='RightShoulder' name='r_shoulder' center='-0.24 1.38 0'>
            <HAnimSegment name='r_upperarm'>
              <Transform translation='-0.24 1.21 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.25 0.5 0.75'/>
                  </Appearance>
                  <Cylinder radius='0.042' height='0.28'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint name='r_elbow' center='-0.24 1.04 0'>
              <HAnimSegment name='r_forearm'>
                <Transform translation='-0.24 0.89 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.25 0.5 0.75'/>
                    </Appearance>
                    <Cylinder radius='0.038' height='0.26'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint name='r_wrist' center='-0.24 0.74 0'>
                <HAnimSegment name='r_hand'>
                  <Transform translation='-0.24 0.68 0'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.85 0.88 0.92'/>
                      </Appearance>
                      <Box size='0.045 0.08 0.06'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

        </HAnimJoint>
      </HAnimJoint>
    </HAnimHumanoid>

    <!-- Arm Wave Animation -->
    <TimeSensor DEF='WaveTimer' cycleInterval='2.0' loop='true'/>
    <OrientationInterpolator DEF='WaveInterpolator'
      key='0.0 0.15 0.35 0.55 0.75 0.9 1.0'
      keyValue='0 0 1 -2.5, 0 0 1 -2.8, 0 0 1 -2.3, 0 0 1 -2.8, 0 0 1 -2.3, 0 0 1 -2.8, 0 0 1 -2.5'/>

    <ROUTE fromNode='WaveTimer' fromField='fraction_changed' toNode='WaveInterpolator' toField='set_fraction'/>
    <ROUTE fromNode='WaveInterpolator' fromField='value_changed' toNode='RightShoulder' toField='set_rotation'/>
  </Scene>
</X3D>