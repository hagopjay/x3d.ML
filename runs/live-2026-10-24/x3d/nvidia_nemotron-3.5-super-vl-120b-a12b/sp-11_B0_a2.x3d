<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Gyroscope with three nested rings and central disc' position='0 0 7'/>

    <TimeSensor DEF='ClockDisc' cycleInterval='10' loop='TRUE'/>
    <TimeSensor DEF='ClockRing1' cycleInterval='15' loop='TRUE'/>
    <TimeSensor DEF='ClockRing2' cycleInterval='7' loop='TRUE'/>
    <TimeSensor DEF='ClockRing3' cycleInterval='20' loop='TRUE'/>

    <Transform DEF='Disc'>
      <Shape>
        <Cylinder height='0.2' radius='1.0'/>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.9 0.1 0.1'/>
        </Appearance>
      </Shape>
    </Transform>
    <OrientationInterpolator DEF='DiscInterpolator' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>

    <Transform DEF='Ring1'>
      <Shape>
        <Cylinder height='0.1' radius='1.5'/>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.1 0.9 0.1'/>
        </Appearance>
      </Shape>
    </Transform>
    <OrientationInterpolator DEF='Ring1Interpolator' key='0 1' keyValue='1 0 0 0 1 0 0 4.71238898'/>

    <Transform DEF='Ring2'>
      <Shape>
        <Cylinder height='0.1' radius='2.0'/>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.1 0.1 0.9'/>
        </Appearance>
      </Shape>
    </Transform>
    <OrientationInterpolator DEF='Ring2Interpolator' key='0 1' keyValue='0 1 0 0 0 1 0 9.42477796'/>

    <Transform DEF='Ring3'>
      <Shape>
        <Cylinder height='0.1' radius='2.5'/>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.9 0.9 0.1'/>
        </Appearance>
      </Shape>
    </Transform>
    <OrientationInterpolator DEF='Ring3Interpolator' key='0 1' keyValue='0 0 1 0 0 0 1 3.14159265'/>

    <ROUTE fromNode='ClockDisc' fromField='fraction_changed' toNode='DiscInterpolator' toField='set_fraction'/>
    <ROUTE fromNode='DiscInterpolator' fromField='value_changed' toNode='Disc' toField='rotation'/>
    <ROUTE fromNode='ClockRing1' fromField='fraction_changed' toNode='Ring1Interpolator' toField='set_fraction'/>
    <ROUTE fromNode='Ring1Interpolator' fromField='value_changed' toNode='Ring1' toField='rotation'/>
    <ROUTE fromNode='ClockRing2' fromField='fraction_changed' toNode='Ring2Interpolator' toField='set_fraction'/>
    <ROUTE fromNode='Ring2Interpolator' fromField='value_changed' toNode='Ring2' toField='rotation'/>
    <ROUTE fromNode='ClockRing3' fromField='fraction_changed' toNode='Ring3Interpolator' toField='set_fraction'/>
    <ROUTE fromNode='Ring3Interpolator' fromField='value_changed' toNode='Ring3' toField='rotation'/>
  </Scene>
</X3D>