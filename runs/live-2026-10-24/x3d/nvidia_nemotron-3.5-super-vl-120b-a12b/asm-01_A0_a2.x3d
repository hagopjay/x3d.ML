<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Simple House'/>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <Viewpoint description='A simple house with box body, pyramid roof, door, and windows' position='0 2 5'/>
    <Background skyColor='0.7 0.8 1.0'/>
    <DirectionalLight direction='-1 -1 -1' intensity='0.8'/>
    <Group>
      <Transform DEF='HouseBody'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.6 0.4'/>
          </Appearance>
          <Box size='2 2 2'/>
        </Shape>
      </Transform>
      <Transform DEF='Roof' translation='0 1.2 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.6 0.2 0.1'/>
          </Appearance>
          <IndexedFaceSet coordIndex='0 1 2 3 -1 0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1' solid='false'>
            <Coordinate point='-1 0 -1 1 0 -1 1 0 1 -1 0 1 0 1.5 0'/>
          </IndexedFaceSet>
        </Shape>
      </Transform>
      <Transform DEF='Door' translation='0 -0.4 1.01'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.3 0.2 0.1'/>
          </Appearance>
          <Box size='0.6 1.2 0.05'/>
        </Shape>
      </Transform>
      <Transform DEF='WindowLeft' translation='-0.8 0 1.01'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.6 0.8 1.0' transparency='0.3'/>
          </Appearance>
          <Box size='0.6 0.6 0.05'/>
        </Shape>
      </Transform>
      <Transform DEF='WindowRight' translation='0.8 0 1.01'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.6 0.8 1.0' transparency='0.3'/>
          </Appearance>
          <Box size='0.6 0.6 0.05'/>
        </Shape>
      </Transform>
    </Group>
  </Scene>
</X3D>