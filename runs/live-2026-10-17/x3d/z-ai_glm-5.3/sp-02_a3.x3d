    <TimeSensor DEF='MercuryClock' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='MercuryOrbitPath' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.5708 0 1 0 3.1416 0 1 0 4.7124 0 1 0 6.2832'/>
    <ROUTE fromNode='MercuryClock' fromField='fraction_changed' toNode='MercuryOrbitPath' toField='set_fraction'/>
