<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Greek Temple in Warm Marble'/>
  </head>
  <Scene>
    <WorldInfo title='Greek Temple in Warm Marble'/>
    <Background skyColor='0.65 0.77 0.87'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
    <Viewpoint description='Temple from the front corner' position='22 14 29' orientation='-0.414 0.895 0.168 0.720' centerOfRotation='0 3.5 0' fieldOfView='0.75'/>
    <DirectionalLight direction='-0.85 -0.25 -0.45' color='1 0.83 0.61' intensity='1' ambientIntensity='0.25'/>

    <!-- Green ground -->
    <Transform translation='0 -0.12 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.24 0.40 0.16' ambientIntensity='0.35'/>
        </Appearance>
        <Box size='100 0.2 100'/>
      </Shape>
    </Transform>

    <!-- Three ascending stone steps -->
    <Transform translation='0 0.15 0'>
      <Shape>
        <Appearance DEF='StepMarble'>
          <Material diffuseColor='0.69 0.61 0.48' specularColor='0.12 0.10 0.07' shininess='0.12'/>
        </Appearance>
        <Box size='11 0.3 20'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.45 0'>
      <Shape>
        <Appearance USE='StepMarble'/>
        <Box size='10 0.3 19'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.75 0'>
      <Shape>
        <Appearance USE='StepMarble'/>
        <Box size='9 0.3 18'/>
      </Shape>
    </Transform>

    <!-- Eight identical columns on the left long side -->
    <Transform translation='-3.5 0 -7'>
      <Group DEF='MarbleColumn'>
        <Transform translation='0 1.05 0'>
          <Shape>
            <Appearance DEF='WarmMarble'>
              <Material diffuseColor='0.88 0.79 0.63' specularColor='0.23 0.20 0.15' shininess='0.22'/>
            </Appearance>
            <Cylinder radius='0.56' height='0.3'/>
          </Shape>
        </Transform>
        <Transform translation='0 3.75 0'>
          <Shape>
            <Appearance USE='WarmMarble'/>
            <Cylinder radius='0.41' height='5.2'/>
          </Shape>
        </Transform>
        <Transform translation='0 6.36 0'>
          <Shape>
            <Appearance USE='WarmMarble'/>
            <Cylinder radius='0.54' height='0.22'/>
          </Shape>
        </Transform>
        <Transform translation='0 6.66 0'>
          <Shape>
            <Appearance USE='WarmMarble'/>
            <Box size='1.08 0.38 1.08'/>
          </Shape>
        </Transform>
      </Group>
    </Transform>
    <Transform translation='-3.5 0 -5'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='-3.5 0 -3'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='-3.5 0 -1'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='-3.5 0 1'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='-3.5 0 3'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='-3.5 0 5'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='-3.5 0 7'>
      <Group USE='MarbleColumn'/>
    </Transform>

    <!-- Eight identical columns on the right long side -->
    <Transform translation='3.5 0 -7'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='3.5 0 -5'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='3.5 0 -3'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='3.5 0 -1'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='3.5 0 1'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='3.5 0 3'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='3.5 0 5'>
      <Group USE='MarbleColumn'/>
    </Transform>
    <Transform translation='3.5 0 7'>
      <Group USE='MarbleColumn'/>
    </Transform>

    <!-- Flat roof slab and projecting cornice -->
    <Transform translation='0 7.08 0'>
      <Shape>
        <Appearance USE='WarmMarble'/>
        <Box size='9 0.46 17'/>
      </Shape>
    </Transform>
    <Transform translation='0 7.40 0'>
      <Shape>
        <Appearance DEF='CorniceMarble'>
          <Material diffuseColor='0.94 0.85 0.70' specularColor='0.20 0.17 0.12' shininess='0.2'/>
        </Appearance>
        <Box size='9.5 0.18 17.5'/>
      </Shape>
    </Transform>

    <!-- Solid triangular pediments at the two short ends -->
    <Transform translation='0 7.49 8.35'>
      <Shape DEF='TriangularPediment'>
        <Appearance USE='CorniceMarble'/>
        <IndexedFaceSet coordIndex='0 1 2 -1 5 4 3 -1 0 3 4 1 -1 1 4 5 2 -1 2 5 3 0 -1' creaseAngle='0'>
          <Coordinate point='-4.65 0 0.25, 4.65 0 0.25, 0 1.85 0.25, -4.65 0 -0.25, 4.65 0 -0.25, 0 1.85 -0.25'/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <Transform translation='0 7.49 -8.35'>
      <Shape USE='TriangularPediment'/>
    </Transform>
  </Scene>
</X3D>