        <Shape USE='SpokeSpanned'/>
      </Transform>
      <Transform translation='0 0 -0.55' rotation='0 0 1 2.0944'>
        <Shape USE='SpokeSpanned'/>
      </Transform>
      <Transform translation='0 0 -0.55' rotation='0 0 1 2.6180'>
        <Shape USE='SpokeSpanned'/>
      </Transform>

      <!-- Outer Rims (Front and Back) -->
      <Transform translation='0 0 0.55'>
        <Shape DEF='Rim'>
          <Appearance USE='WheelWhite'/>
          <Extrusion beginCap='true' endCap='true' circleRadius='0.08' crossSection='0.08 0 0.057 -0.057 0 -0.08 -0.057 -0.057 -0.08 0 -0.057 0.057 0 0.08 0.057 0.057 0.08 0' spine='7 0 0 6.062 3.5 0 3.5 6.062 0 0 7 0 -3.5 6.062 0 -6.062 3.5 0 -7 0 0 -6.062 -3.5 0 -3.5 -6.062 0 0 -7 0 3.5 -6.062 0 6.062 -3.5 0 7 0 0'/>
        </Shape>
      </Transform>
      <Transform translation='0 0 -0.55'>
        <Shape USE='Rim'/>
      </Transform>

      <!-- Inner Support Rims (Radius = 4.2) -->
      <Transform translation='0 0 0.55'>
        <Shape DEF='InnerRim'>
          <Appearance USE='WheelWhite'/>
          <Extrusion beginCap='true' endCap='true' circleRadius='0.05' crossSection='0.05 0 0.035 -0.035 0 -0.05 -0.035 -0.035 -0.05 0 -0.035 0.035 0 0.05 0.035 0.035 0.05 0' spine='4.2 0 0 3.637 2.1 0 2.1 3.637 0 0 4.2 0 -2.1 3.637 0 -3.637 2.1 0 -4.2 0 0 -3.637 -2.1 0 -2.1 -3.637 0 0 -4.2 0 2.1 -3.637 0 3.637 -2.1 0 4.2 0 0'/>
        </Shape>
      </Transform>
      <Transform translation='0 0 -0.55'>
        <Shape USE='InnerRim'/>
      </Transform>

      <!-- Gondolas at 12 positions around R=7 circle -->
      <!-- 0 deg -->
      <Transform translation='7 0 0'>
        <Transform DEF='G0'>
          <Group DEF='Gondola'>
            <!-- Hanger axle/bar -->
            <Transform rotation='1 0 0 1.5708'>
              <Shape>
                <Appearance DEF='MetalRodApp'>
                  <Material diffuseColor='0.6 0.6 0.65' metalness='0.8' roughness='0.2'/>
                </Appearance>
                <Cylinder height='1.3' radius='0.05'/>
              </Shape>
            </Transform>
            <!-- Hanger vertical struts -->
            <Transform translation='0 -0.55 0.5'>
              <Shape DEF='HangerStrut'>
                <Appearance USE='MetalRodApp'/>
                <Cylinder height='1.1' radius='0.03'/>
              </Shape>
            </Transform>
            <Transform translation='0 -0.55 -0.5'>
              <Shape USE='HangerStrut'/>
            </Transform>
            <!-- Gondola Roof -->
            <Transform translation='0 -1.1 0'>
              <Shape>
                <Appearance DEF='RoofApp'>
                  <Material diffuseColor='0.85 0.25 0.2' roughness='0.4'/>
                </Appearance>
                <Cylinder height='0.12' radius='0.75'/>
              </Shape>
            </Transform>
            <!-- Cabin Body -->
            <Transform translation='0 -1.6 0'>
              <Shape>
                <Appearance DEF='CabinApp'>
                  <Material diffuseColor='0.95 0.85 0.3' roughness='0.3'/>
                </Appearance>
                <Cylinder height='0.85' radius='0.65'/>
              </Shape>
            </Transform>
            <!-- Cabin Windows (dark cylinder inner) -->
            <Transform translation='0 -1.5 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.1 0.15 0.25' roughness='0.1' transparency='0.3'/>
                </Appearance>
                <Cylinder height='0.45' radius='0.67'/>
              </Shape>
            </Transform>
          </Group>
        </Transform>
      </Transform>

      <!-- 30 deg -->
      <Transform translation='6.062 3.5 0'>
        <Transform DEF='G1'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 60 deg -->
      <Transform translation='3.5 6.062 0'>
        <Transform DEF='G2'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 90 deg -->
      <Transform translation='0 7 0'>
        <Transform DEF='G3'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 120 deg -->
      <Transform translation='-3.5 6.062 0'>
        <Transform DEF='G4'>
          <Group USE='Gondola'/>
        </Transform>
