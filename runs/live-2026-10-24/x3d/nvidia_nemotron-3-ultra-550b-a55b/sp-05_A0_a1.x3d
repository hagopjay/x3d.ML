<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Desk lamp with articulated arm' position='0 1.5 3'/>
    <Transform translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.55 0.35 0.2'/>
        </Appearance>
        <Box size='1.2 0.05 0.8'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.025 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
        <Cylinder radius='0.1' height='0.05'/>
      </Shape>
      <Transform translation='0 0.05 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.4 0.4 0.4'/>
          </Appearance>
          <Cylinder radius='0.02' height='0.5'/>
        </Shape>
        <Transform DEF='UpperArm' translation='0 0.5 0'>
          <Shape>
            <Appearance>
              <Material diffuseColor='0.4 0.4 0.4'/>
            </Appearance>
            <Cylinder radius='0.02' height='0.4'/>
          </Shape>
          <Transform translation='0 0.4 0'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.8 0.8 0.8'/>
              </Appearance>
              <Cone bottomRadius='0.15' height='0.2'/>
            </Shape>
            <SpotLight location='0 0.1 0' direction='0 -1 0' cutOffAngle='0.5' beamWidth='0.3' radius='1.0' intensity='1' color='1 1 0.9'/>
          </Transform>
        </Transform>
      </Transform>
      <TouchSensor DEF='Touch'/>
    </Transform>
    <TimeSensor DEF='TS' cycleInterval='4' loop='true' enabled='true'/>
    <OrientationInterpolator DEF='OI' key='0 0.5 1' keyValue='0 0 1 0  0 0 1 0.5  0 0 1 0'/>
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='OI' toField='set_fraction'/>
    <ROUTE fromNode='OI' fromField='value_changed' toNode='UpperArm' toField='rotation'/>
    <ROUTE fromNode='Touch' fromField='isActive' toNode='TS' toField='enabled'/>
  </Scene>
</X3D>