<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='ThreeCubes.x3d'/>
    <meta name='description' content='Three cubes rotating at different speeds driven by three TimeSensors.'/>
  </head>
  <Scene>
    <WorldInfo title='Three Rotating Cubes'/>
    <Viewpoint description='View Three Cubes' position='0 1 9'/>

    <TimeSensor DEF='TimerFast' cycleInterval='2.0' loop='true'/>
    <TimeSensor DEF='TimerMedium' cycleInterval='4.5' loop='true'/>
    <TimeSensor DEF='TimerSlow' cycleInterval='8.0' loop='true'/>

    <OrientationInterpolator DEF='SpinFast'
      key='0 0.25 0.5 0.75 1'
      keyValue='0 1 0 0, 0 1 0 1.5707963, 0 1 0 3.1415927, 0 1 0 4.712389, 0 1 0 6.2831853'/>

    <OrientationInterpolator DEF='SpinMedium'
      key='0 0.25 0.5 0.75 1'
      keyValue='1 1 0 0, 1 1 0 1.5707963, 1 1 0 3.1415927, 1 1 0 4.712389, 1 1 0 6.2831853'/>

    <OrientationInterpolator DEF='SpinSlow'
      key='0 0.25 0.5 0.75 1'
      keyValue='0 1 1 0, 0 1 1 1.5707963, 0 1 1 3.1415927, 0 1 1 4.712389, 0 1 1 6.2831853'/>

    <Transform translation='-3 0 0'>
      <Transform DEF='CubeFastTransform'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.9 0.2 0.2' specularColor='0.9 0.6 0.6' shininess='0.8'/>
          </Appearance>
          <Box size='1.5 1.5 1.5'/>
        </Shape>
      </Transform>
    </Transform>

    <Transform translation='0 0 0'>
      <Transform DEF='CubeMediumTransform'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.2 0.8 0.3' specularColor='0.6 0.9 0.6' shininess='0.8'/>
          </Appearance>
          <Box size='1.5 1.5 1.5'/>
        </Shape>
      </Transform>
    </Transform>

    <Transform translation='3 0 0'>
      <Transform DEF='CubeSlowTransform'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.2 0.4 0.9' specularColor='0.6 0.7 1.0' shininess='0.8'/>
          </Appearance>
          <Box size='1.5 1.5 1.5'/>
        </Shape>
      </Transform>
    </Transform>

    <ROUTE fromNode='TimerFast' fromField='fraction_changed' toNode='SpinFast' toField='set_fraction'/>
    <ROUTE fromNode='SpinFast' fromField='value_changed' toNode='CubeFastTransform' toField='rotation'/>

    <ROUTE fromNode='TimerMedium' fromField='fraction_changed' toNode='SpinMedium' toField='set_fraction'/>
    <ROUTE fromNode='SpinMedium' fromField='value_changed' toNode='CubeMediumTransform' toField='rotation'/>

    <ROUTE fromNode='TimerSlow' fromField='fraction_changed' toNode='SpinSlow' toField='set_fraction'/>
    <ROUTE fromNode='SpinSlow' fromField='value_changed' toNode='CubeSlowTransform' toField='rotation'/>
  </Scene>
</X3D>