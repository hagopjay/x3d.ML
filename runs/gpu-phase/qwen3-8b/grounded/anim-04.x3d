<Scene>
<Viewpoint description='Looking at Sphere' position='0 0 5'/>
<Shape>
<Appearance>
<Material DEF='SphereMaterial' diffuseColor='1 0 0'/>
<ColorInterpolator DEF='ColorCycle' key='0 0.5 1' keyValue='1 0 0 0 1 0 0 0 1'/>
<TimeSensor DEF='ColorTimer' cycleInterval='6' loop='true'/>
<ROUTE fromNode='ColorTimer' fromField='fraction' toNode='ColorCycle' toField='set_fraction'/>
<ROUTE fromNode='ColorCycle' fromField='value' toNode='SphereMaterial' toField='diffuseColor'/>
</Appearance>
<Sphere radius='1'/>
</Shape>
</Scene>
