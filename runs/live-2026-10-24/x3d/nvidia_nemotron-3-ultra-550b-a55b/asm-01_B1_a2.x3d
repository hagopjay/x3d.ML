<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <meta name="title" content="Simple House"/>
  </head>
  <Scene>
    <Viewpoint description="Simple House" position="0 2 10"/>
    <Transform>
      <Group DEF="Body">
        <Shape>
          <Appearance>
            <Material diffuseColor="0.6 0.4 0.2"/>
          </Appearance>
          <Box size="5 3 5"/>
        </Shape>
      </Group>
      <Transform translation="0 1.5 0">
        <Group DEF="Roof">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.8 0.2 0.2"/>
            </Appearance>
            <IndexedFaceSet coordIndex="0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1">
              <Coordinate point="-2.5 0 -2.5, 2.5 0 -2.5, 2.5 0 2.5, -2.5 0 2.5, 0 2.5 0"/>
            </IndexedFaceSet>
          </Shape>
        </Group>
      </Transform>
      <Transform translation="0 -0.5 2.55">
        <Group DEF="Door">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.4 0.2 0.1"/>
            </Appearance>
            <Box size="1 2 0.1"/>
          </Shape>
        </Group>
      </Transform>
      <Transform translation="-1.5 0.5 2.55">
        <Group DEF="Window1">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.2 0.6 0.8" transparency="0.5"/>
            </Appearance>
            <Box size="1 1 0.1"/>
          </Shape>
        </Group>
      </Transform>
      <Transform translation="1.5 0.5 2.55">
        <Group DEF="Window2">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.2 0.6 0.8" transparency="0.5"/>
            </Appearance>
            <Box size="1 1 0.1"/>
          </Shape>
        </Group>
      </Transform>
    </Transform>
  </Scene>
</X3D>