<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Bouncing Ball'/>
    <meta name='description' content='A ball bounces between y=0 and y=2 forever, easing at the top of each bounce.'/>
  </head>
  <Scene>
    <Background skyColor='0.55 0.75 0.95'/>
    <Viewpoint description='Bouncing ball' position='0 1 8'/>
    <DirectionalLight direction='1 -2 -1' intensity='1'/>
    <Transform translation='0 -0.525 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.25 0.5 0.25'/>
        </Appearance>
        <Box size='12 0.05 12'/>
      </Shape>
    </Transform>
    <Transform DEF='Ball'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.2 0.1' specularColor='0.4 0.4 0.4' shininess='0.4'/>
        </Appearance>
        <Sphere radius='0.5'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Clock' cycleInterval='3' loop='true'/>
    <PositionInterpolator DEF='Bounce'
      key='0 0.1 0.2 0.3 0.4 0.45 0.5 0.55 0.6 0.7 0.8 0.9 1'
      keyValue='0 0 0 0 0.72 0 0 1.28 0 0 1.68 0 0 1.92 0 0 1.98 0 0 2 0 0 1.98 0 0 1.92 0 0 1.68 0 0 1.28 0 0 0.72 0 0 0 0'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Bounce' toField='set_fraction'/>
    <ROUTE fromNode='Bounce' fromField='value_changed' toNode='Ball' toField='set_translation'/>
  </Scene>
</X3D>