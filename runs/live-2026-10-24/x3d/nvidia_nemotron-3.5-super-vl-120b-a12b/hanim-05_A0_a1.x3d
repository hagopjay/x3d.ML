<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='HAnim Waving Figure'/>
  </head>
  <Scene>
    <Viewpoint description='A simple HAnim figure that waves when touched' position='0 1.5 3'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <DirectionalLight intensity='0.8'/>
    <HAnimHumanoid version='2.0'>
      <HAnimSegment name='Torso'>
        <Shape>
          <Box size='0.4 0.6 0.2'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.6 0.5'/>
          </Appearance>
        </Shape>
        <HAnimJoint DEF='shoulder' name='Shoulder' rotation='0 0 1 0' center='0.2 0.2 0'>
          <HAnimSegment name='UpperArm'>
            <Shape>
              <Cylinder radius='0.05' height='0.4'/>
              <Appearance>
                <PhysicalMaterial baseColor='0.8 0.6 0.5'/>
              </Appearance>
            </Shape>
          </HAnimSegment>
        </HAnimJoint>
      </HAnimSegment>
    </HAnimHumanoid>
    <TouchSensor DEF='touch'/>
    <TimeSensor DEF='timer' cycleInterval='2' loop='TRUE'/>
    <OrientationInterpolator DEF='wave' key='0 0.5 1' keyValue='0 0 1 0 0 0 1 0.7 0 0 1 0'/>
    <ROUTE fromNode='touch' fromField='touchedTime' toNode='timer' toField='startTime'/>
    <ROUTE fromNode='timer' fromField='fraction_changed' toNode='wave' toField='set_fraction'/>
    <ROUTE fromNode='wave' fromField='value_changed' toNode='shoulder' toField='rotation'/>
  </Scene>
</X3D>