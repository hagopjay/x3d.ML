                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.12 0.2 0.29'/>
                      </Appearance>
                      <Box size='0.15 0.12 0.3'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>
        </HAnimJoint>

        <HAnimJoint DEF='Spine' name='vl5' center='0 1.08 0'>
