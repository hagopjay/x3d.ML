<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
    <meta name="title" content="Swinging Door"/>
  </head>
  <Scene>
    <Viewpoint description="Door swings open 90 degrees over 2 seconds when the scene loads" position="0 1.5 3"/>
    <DirectionalLight intensity="0.8"/>
    <Transform DEF="DoorHinge">
      <Transform translation="0 0 0.5">
        <Shape>
          <Box size="0.05 2.0 1.0"/>
          <Appearance>
            <PhysicalMaterial baseColor="0.8 0.6 0.4"/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <TimeSensor DEF="DoorTimer" cycleInterval="2" loop="false" startTime="0" enabled="true"/>
    <OrientationInterpolator DEF="DoorRot" key="0 1" keyValue="0 1 0 0 0 1 0 1.5707963267948966"/>
    <ROUTE fromNode="DoorTimer" fromField="fraction_changed" toNode="DoorRot" toField="set_value"/>
    <ROUTE fromNode="DoorRot" fromField="value_changed" toNode="DoorHinge" toField="set_rotation"/>
  </Scene>
</X3D>
