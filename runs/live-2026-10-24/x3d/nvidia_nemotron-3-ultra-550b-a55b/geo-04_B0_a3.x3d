<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Geospatial" level="2"/>
  </head>
  <Scene>
    <GeoLocation geoSystem="&quot;GD&quot; &quot;WE&quot;" geoCoords="37.2296 -80.4139 650">
      <Transform DEF="DroneTrans">
        <Shape>
          <Appearance>
            <Material diffuseColor="0 0 1"/>
          </Appearance>
          <Box size="1 1 1"/>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem="&quot;GD&quot; &quot;WE&quot;" position="37.2296 -80.4139 650" description="Torgersen Hall overview"/>
    <Viewpoint description="Drone view" position="0 0 10"/>
    <TimeSensor DEF="Clock" cycleInterval="20" loop="true"/>
    <PositionInterpolator DEF="DronePath" key="0 0.25 0.5 0.75 1" keyValue="-5 0 -5 5 0 -5 5 0 5 -5 0 5 -5 0 -5"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="DronePath" toField="set_fraction"/>
    <ROUTE fromNode="DronePath" fromField="value_changed" toNode="DroneTrans" toField="set_translation"/>
  </Scene>
</X3D>