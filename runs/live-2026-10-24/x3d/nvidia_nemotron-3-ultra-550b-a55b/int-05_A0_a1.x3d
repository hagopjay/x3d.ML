<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint DEF='MainView' description='Proximity triggered spotlight demo' position='0 1.5 5'/>
    <ProximitySensor DEF='ProxSensor' center='0 0 0' size='10 10 10'/>
    <SpotLight DEF='SpotLight1' location='0 3 0' direction='0 -1 0' radius='6' cutOffAngle='0.785' beamWidth='0.523' on='FALSE'/>
    <Transform DEF='StatueTransform' translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.7 0.6'/>
        </Appearance>
        <Cylinder height='2' radius='0.5'/>
      </Shape>
    </Transform>
    <ROUTE fromNode='ProxSensor' fromField='isActive' toNode='SpotLight1' toField='set_on'/>
  </Scene>
</X3D>