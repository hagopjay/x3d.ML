<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="HAnim" level="1"/>
    <component name="Shape" level="1"/>
    <meta name="title" content="Waving HAnim Figure"/>
  </head>
  <Scene>
    <Viewpoint description="A simple HAnim figure that waves when touched" position="0 1.5 3"/>
    <DirectionalLight intensity="0.8" color="1 1 1" direction="0 -1 0"/>
    <Background skyColor="0.8 0.9 1.0"/>
    <NavigationInfo type="&quot;EXAMINE&quot; &quot;ANY&quot; &quot;FLY&quot;" headlight="true"/>
    <TouchSensor DEF="Touch"/>
    <TimeSensor DEF="WaveTimer" cycleInterval="2" loop="false" enabled="false"/>
    <OrientationInterpolator DEF="WaveInterpolator" key="0 0.25 0.5 0.75 1" keyValue="1 0 0 0 1 0 0 0.5 1 0 0 1 1 0 0 0.5 1 0 0 0"/>
    <HAnimHumanoid version="2.0" name="WavingFigure">
      <HAnimSegment name="Pelvis" containerField="segments">
        <Shape>
          <Box size="0.2 0.2 0.2"/>
          <Appearance>
            <PhysicalMaterial diffuseColor="0.8 0.6 0.4"/>
          </Appearance>
        </Shape>
        <HAnimJoint DEF="ShoulderRight" name="ShoulderRight" center="0.1 0.1 0" rotation="1 0 0 0">
          <HAnimSegment name="HumerusRight">
            <Shape>
              <Box size="0.1 0.3 0.1"/>
              <Appearance>
                <PhysicalMaterial diffuseColor="0.8 0.6 0.4"/>
              </Appearance>
            </Shape>
            <HAnimJoint name="ElbowRight" center="0 0.15 0" rotation="1 0 0 0">
              <HAnimSegment name="ForearmRight">
                <Shape>
                  <Box size="0.1 0.3 0.1"/>
                  <Appearance>
                    <PhysicalMaterial diffuseColor="0.8 0.6 0.4"/>
                  </Appearance>
                </Shape>
              </HAnimSegment>
            </HAnimJoint>
          </HAnimSegment>
        </HAnimJoint>
      </HAnimSegment>
    </HAnimHumanoid>
    <ROUTE fromNode="Touch" fromField="touchTime" toNode="WaveTimer" toField="startTime"/>
    <ROUTE fromNode="WaveTimer" fromField="fraction_changed" toNode="WaveInterpolator" toField="set_fraction"/>
    <ROUTE fromNode="WaveInterpolator" fromField="value_changed" toNode="ShoulderRight" toField="set_rotation"/>
  </Scene>
</X3D>