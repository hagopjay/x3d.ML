<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component level='2' name='HAnim'/>
  </head>
  <Scene>
    <WorldInfo title='HAnim Waving Figure'/>
    <Viewpoint description='Waving Figure View' position='0 1.25 3.0' centerOfRotation='0 1.0 0'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Background skyColor='0.18 0.22 0.28'/>
    <DirectionalLight direction='0.5 -1 -0.8' intensity='1.0'/>
    <DirectionalLight direction='-0.6 0.5 0.6' intensity='0.4'/>

    <!-- Ground Pedestal -->
    <Transform translation='0 -0.02 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.33 0.38'/>
        </Appearance>
        <Cylinder height='0.04' radius='1.2'/>
      </Shape>
    </Transform>

    <Group>
      <TouchSensor DEF='WaveTrigger' description='Click figure to wave'/>

      <HAnimHumanoid DEF='WaveHumanoid' name='WaveHumanoid' version='2.0'>
        <HAnimJoint containerField='skeleton' DEF='humanoid_root' name='humanoid_root' center='0 0.9 0'>
          <!-- Pelvis Segment -->
          <HAnimSegment DEF='sacrum' name='sacrum'>
            <Transform translation='0 0.88 0'>
              <Shape>
                <Appearance>
                  <Material diffuseColor='0.18 0.22 0.32'/>
                </Appearance>
                <Box size='0.28 0.16 0.18'/>
              </Shape>
            </Transform>
          </HAnimSegment>

          <!-- Left Leg -->
          <HAnimJoint DEF='l_hip' name='l_hip' center='0.1 0.82 0'>
            <HAnimSegment DEF='l_thigh' name='l_thigh'>
              <Transform translation='0.1 0.62 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.18 0.22 0.32'/>
                  </Appearance>
                  <Cylinder height='0.36' radius='0.055'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='l_knee' name='l_knee' center='0.1 0.44 0'>
              <HAnimSegment DEF='l_calf' name='l_calf'>
                <Transform translation='0.1 0.25 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.18 0.22 0.32'/>
                    </Appearance>
                    <Cylinder height='0.36' radius='0.045'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='l_ankle' name='l_ankle' center='0.1 0.07 0'>
                <HAnimSegment DEF='l_foot' name='l_foot'>
                  <Transform translation='0.1 0.035 0.04'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.1 0.1 0.12'/>
                      </Appearance>
                      <Box size='0.09 0.07 0.2'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

          <!-- Right Leg -->
          <HAnimJoint DEF='r_hip' name='r_hip' center='-0.1 0.82 0'>
            <HAnimSegment DEF='r_thigh' name='r_thigh'>
              <Transform translation='-0.1 0.62 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.18 0.22 0.32'/>
                  </Appearance>
                  <Cylinder height='0.36' radius='0.055'/>
                </Shape>
              </Transform>
            </HAnimSegment>
            <HAnimJoint DEF='r_knee' name='r_knee' center='-0.1 0.44 0'>
              <HAnimSegment DEF='r_calf' name='r_calf'>
                <Transform translation='-0.1 0.25 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.18 0.22 0.32'/>
                    </Appearance>
                    <Cylinder height='0.36' radius='0.045'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='r_ankle' name='r_ankle' center='-0.1 0.07 0'>
                <HAnimSegment DEF='r_foot' name='r_foot'>
                  <Transform translation='-0.1 0.035 0.04'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.1 0.1 0.12'/>
                      </Appearance>
                      <Box size='0.09 0.07 0.2'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
              </HAnimJoint>
            </HAnimJoint>
          </HAnimJoint>

          <!-- Spine and Upper Body -->
          <HAnimJoint DEF='vl5' name='vl5' center='0 0.96 0'>
            <!-- Torso Segment -->
            <HAnimSegment DEF='spine3' name='spine3'>
              <Transform translation='0 1.15 0'>
                <Shape>
                  <Appearance>
                    <Material diffuseColor='0.25 0.5 0.8'/>
                  </Appearance>
                  <Box size='0.32 0.38 0.2'/>
                </Shape>
              </Transform>
            </HAnimSegment>

            <!-- Neck / Head -->
            <HAnimJoint DEF='skullbase' name='skullbase' center='0 1.35 0'>
              <HAnimSegment DEF='skull' name='skull'>
                <Transform translation='0 1.48 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.92 0.74 0.62'/>
                    </Appearance>
                    <Sphere radius='0.13'/>
                  </Shape>
                </Transform>
                <!-- Eyes -->
                <Transform translation='0.045 1.5 0.115'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.1 0.1 0.1'/>
                    </Appearance>
                    <Sphere radius='0.02'/>
                  </Shape>
                </Transform>
                <Transform translation='-0.045 1.5 0.115'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.1 0.1 0.1'/>
                    </Appearance>
                    <Sphere radius='0.02'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
            </HAnimJoint>

            <!-- Left Arm (Resting) -->
            <HAnimJoint DEF='l_shoulder' name='l_shoulder' center='0.22 1.3 0'>
              <HAnimSegment DEF='l_upperarm' name='l_upperarm'>
                <Transform translation='0.23 1.15 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.25 0.5 0.8'/>
                    </Appearance>
                    <Cylinder height='0.28' radius='0.045'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='l_elbow' name='l_elbow' center='0.24 1.01 0'>
                <HAnimSegment DEF='l_forearm' name='l_forearm'>
                  <Transform translation='0.24 0.88 0'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.92 0.74 0.62'/>
                      </Appearance>
                      <Cylinder height='0.24' radius='0.04'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='l_wrist' name='l_wrist' center='0.24 0.76 0'>
                  <HAnimSegment DEF='l_hand' name='l_hand'>
                    <Transform translation='0.24 0.71 0'>
                      <Shape>
                        <Appearance>
                          <Material diffuseColor='0.92 0.74 0.62'/>
                        </Appearance>
                        <Box size='0.05 0.08 0.03'/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>

            <!-- Right Arm (Waving) -->
            <HAnimJoint DEF='Joint_r_shoulder' name='r_shoulder' center='-0.22 1.3 0'>
              <HAnimSegment DEF='r_upperarm' name='r_upperarm'>
                <Transform translation='-0.23 1.15 0'>
                  <Shape>
                    <Appearance>
                      <Material diffuseColor='0.25 0.5 0.8'/>
                    </Appearance>
                    <Cylinder height='0.28' radius='0.045'/>
                  </Shape>
                </Transform>
              </HAnimSegment>
              <HAnimJoint DEF='Joint_r_elbow' name='r_elbow' center='-0.24 1.01 0'>
                <HAnimSegment DEF='r_forearm' name='r_forearm'>
                  <Transform translation='-0.24 0.88 0'>
                    <Shape>
                      <Appearance>
                        <Material diffuseColor='0.92 0.74 0.62'/>
                      </Appearance>
                      <Cylinder height='0.24' radius='0.04'/>
                    </Shape>
                  </Transform>
                </HAnimSegment>
                <HAnimJoint DEF='r_wrist' name='r_wrist' center='-0.24 0.76 0'>
                  <HAnimSegment DEF='r_hand' name='r_hand'>
                    <Transform translation='-0.24 0.71 0'>
                      <Shape>
                        <Appearance>
                          <Material diffuseColor='0.92 0.74 0.62'/>
                        </Appearance>
                        <Box size='0.05 0.08 0.03'/>
                      </Shape>
                    </Transform>
                  </HAnimSegment>
                </HAnimJoint>
              </HAnimJoint>
            </HAnimJoint>

          </HAnimJoint>
        </HAnimJoint>
      </HAnimHumanoid>
    </Group>

    <!-- Wave Animation -->
    <TimeSensor DEF='WaveTimer' cycleInterval='2.2' loop='false' stopTime='1'/>

    <!-- Shoulder raises arm outward-upward and waves slightly -->
    <OrientationInterpolator DEF='ShoulderInterp'
      key='0.0 0.18 0.32 0.46 0.60 0.74 0.86 1.0'
      keyValue='
        0 0 1 0.0,
        0 0 1 -2.3,
        0 0 1 -2.15,
        0 0 1 -2.4,
        0 0 1 -2.15,
        0 0 1 -2.4,
        0 0 1 -2.25,
        0 0 1 0.0'/>

    <!-- Elbow bends forearm upward and oscillates for friendly wave -->
    <OrientationInterpolator DEF='ElbowInterp'
      key='0.0 0.18 0.32 0.46 0.60 0.74 0.86 1.0'
      keyValue='
        0 0 1 0.0,
        0 0 1 0.9,
        0 0 1 0.45,
        0 0 1 1.05,
        0 0 1 0.45,
        0 0 1 1.05,
        0 0 1 0.7,
        0 0 1 0.0'/>

    <ROUTE fromNode='WaveTrigger' fromField='touchTime' toNode='WaveTimer' toField='set_startTime'/>
    <ROUTE fromNode='WaveTimer' fromField='fraction_changed' toNode='ShoulderInterp' toField='set_fraction'/>
    <ROUTE fromNode='WaveTimer' fromField='fraction_changed' toNode='ElbowInterp' toField='set_fraction'/>
    <ROUTE fromNode='ShoulderInterp' fromField='value_changed' toNode='Joint_r_shoulder' toField='set_rotation'/>
    <ROUTE fromNode='ElbowInterp' fromField='value_changed' toNode='Joint_r_elbow' toField='set_rotation'/>
  </Scene>
</X3D>