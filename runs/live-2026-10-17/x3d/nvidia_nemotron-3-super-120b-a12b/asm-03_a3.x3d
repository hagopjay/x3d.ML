<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <Shape DEF='LightTile'>
      <Box size='1 0.1 1'/>
      <appearance>
        <Appearance>
          <material>
            <PhysicalMaterial baseColor='1 1 1'/>
          </material>
        </Appearance>
      </appearance>
    </Shape>
    <Shape DEF='DarkTile'>
      <Box size='1 0.1 1'/>
      <appearance>
        <Appearance>
          <material>
            <PhysicalMaterial baseColor='0.2 0.2 0.2'/>
          </material>
        </Appearance>
      </appearance>
    </Shape>
    <!-- Row 0 (z = -3.5) -->
    <Transform translation='-3.5 0.05 -3.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-2.5 0.05 -3.5'><USE name='LightTile'/></Transform>
    <Transform translation='-1.5 0.05 -3.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-0.5 0.05 -3.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 0.5 0.05 -3.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 1.5 0.05 -3.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 2.5 0.05 -3.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 3.5 0.05 -3.5'><USE name='LightTile'/></Transform>
    <!-- Row 1 (z = -2.5) -->
    <Transform translation='-3.5 0.05 -2.5'><USE name='LightTile'/></Transform>
    <Transform translation='-2.5 0.05 -2.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-1.5 0.05 -2.5'><USE name='LightTile'/></Transform>
    <Transform translation='-0.5 0.05 -2.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 0.5 0.05 -2.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 1.5 0.05 -2.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 2.5 0.05 -2.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 3.5 0.05 -2.5'><USE name='DarkTile'/></Transform>
    <!-- Row 2 (z = -1.5) -->
    <Transform translation='-3.5 0.05 -1.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-2.5 0.05 -1.5'><USE name='LightTile'/></Transform>
    <Transform translation='-1.5 0.05 -1.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-0.5 0.05 -1.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 0.5 0.05 -1.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 1.5 0.05 -1.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 2.5 0.05 -1.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 3.5 0.05 -1.5'><USE name='LightTile'/></Transform>
    <!-- Row 3 (z = -0.5) -->
    <Transform translation='-3.5 0.05 -0.5'><USE name='LightTile'/></Transform>
    <Transform translation='-2.5 0.05 -0.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-1.5 0.05 -0.5'><USE name='LightTile'/></Transform>
    <Transform translation='-0.5 0.05 -0.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 0.5 0.05 -0.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 1.5 0.05 -0.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 2.5 0.05 -0.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 3.5 0.05 -0.5'><USE name='DarkTile'/></Transform>
    <!-- Row 4 (z = 0.5) -->
    <Transform translation='-3.5 0.05 0.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-2.5 0.05 0.5'><USE name='LightTile'/></Transform>
    <Transform translation='-1.5 0.05 0.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-0.5 0.05 0.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 0.5 0.05 0.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 1.5 0.05 0.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 2.5 0.05 0.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 3.5 0.05 0.5'><USE name='LightTile'/></Transform>
    <!-- Row 5 (z = 1.5) -->
    <Transform translation='-3.5 0.05 1.5'><USE name='LightTile'/></Transform>
    <Transform translation='-2.5 0.05 1.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-1.5 0.05 1.5'><USE name='LightTile'/></Transform>
    <Transform translation='-0.5 0.05 1.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 0.5 0.05 1.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 1.5 0.05 1.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 2.5 0.05 1.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 3.5 0.05 1.5'><USE name='DarkTile'/></Transform>
    <!-- Row 6 (z = 2.5) -->
    <Transform translation='-3.5 0.05 2.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-2.5 0.05 2.5'><USE name='LightTile'/></Transform>
    <Transform translation='-1.5 0.05 2.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-0.5 0.05 2.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 0.5 0.05 2.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 1.5 0.05 2.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 2.5 0.05 2.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 3.5 0.05 2.5'><USE name='LightTile'/></Transform>
    <!-- Row 7 (z = 3.5) -->
    <Transform translation='-3.5 0.05 3.5'><USE name='LightTile'/></Transform>
    <Transform translation='-2.5 0.05 3.5'><USE name='DarkTile'/></Transform>
    <Transform translation='-1.5 0.05 3.5'><USE name='LightTile'/></Transform>
    <Transform translation='-0.5 0.05 3.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 0.5 0.05 3.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 1.5 0.05 3.5'><USE name='DarkTile'/></Transform>
    <Transform translation=' 2.5 0.05 3.5'><USE name='LightTile'/></Transform>
    <Transform translation=' 3.5 0.05 3.5'><USE name='DarkTile'/></Transform>
    <Viewpoint description='Chess board' position='0 5 0'/>
  </Scene>
</X3D>