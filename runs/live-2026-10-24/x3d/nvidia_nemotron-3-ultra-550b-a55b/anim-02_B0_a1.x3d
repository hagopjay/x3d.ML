<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<Viewpoint description='Bouncing ball' position='0 1 5'/>
<Transform DEF='BallTransform' translation='0 0 0'>
<Shape>
<Sphere radius='0.5'/>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
</Shape>
</Transform>
<TimeSensor DEF='Clock' cycleInterval='2' loop='true'/>
<PositionInterpolator DEF='Bounce' key='0 0.3 0.4 0.5 0.6 0.7 1' keyValue='0 0 0 0 1.5 0 0 1.8 0 0 2 0 0 1.8 0 0 1.5 0 0 0 0'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Bounce' toField='set_fraction'/>
<ROUTE fromNode='Bounce' fromField='value_changed' toNode='BallTransform' toField='translation'/>
</Scene>
</X3D>