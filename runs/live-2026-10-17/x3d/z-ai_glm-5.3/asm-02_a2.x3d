<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Solar System'/>
    <meta name='info' content='Sun with three orbiting planets at different distances'/>
  </head>
  <Scene>
    <Viewpoint description='Solar System overview' position='0 9 44' orientation='-1 0 0 0.2'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Background skyColor='0 0 0.12'/>
    <PointLight location='0 0 0' intensity='1.2' radius='100'/>

    <TimeSensor DEF='Clock1' cycleInterval='12' loop='true'/>
    <TimeSensor DEF='Clock2' cycleInterval='20' loop='true'/>
    <TimeSensor DEF='Clock3' cycleInterval='32' loop='true'/>
    <TimeSensor DEF='PulseClock' cycleInterval='3'/>
    <PositionInterpolator DEF='SunPulse' key='0 0.5 1' keyValue='1 1 1 1.35 1.35 1.35 1 1 1'/>

    <Transform DEF='SunTransform'>
      <Shape>
        <Sphere radius='2.5'/>
        <Appearance>
          <Material diffuseColor='1 0.5 0' emissiveColor='1 0.45 0'/>
        </Appearance>
      </Shape>
      <TouchSensor DEF='SunTouch' description='Touch the Sun to make it pulse'/>
    </Transform>

    <Transform DEF='Orbit1'>
      <Transform DEF='Planet1' translation='6 0 0'>
        <Shape>
          <Sphere radius='0.7'/>
          <Appearance>
            <Material diffuseColor='0.2 0.4 1'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <Transform DEF='Orbit2'>
      <Transform DEF='Planet2' translation='11 0 0'>
        <Shape>
          <Sphere radius='1.0'/>
          <Appearance>
            <Material diffuseColor='0.8 0.3 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <Transform DEF='Orbit3'>
      <Transform DEF='Planet3' translation='16 0 0'>
        <Shape>
          <Sphere radius='1.4'/>
          <Appearance>
            <Material diffuseColor='0.3 0.7 0.4'/>
          </Appearance>
        </Shape>
        <Transform DEF='MoonOrbit'>
          <Transform DEF='Moon' translation='2.4 0 0'>
            <Shape>
              <Sphere radius='0.35'/>
              <Appearance>
                <Material diffuseColor='0.8 0.8 0.8'/>
              </Appearance>
            </Shape>
          </Transform>
        </Transform>
      </Transform>
    </Transform>

    <OrientationInterpolator DEF='Revolve1' key='0 1' keyValue='0 1 0 0 0 1 0 6.283'/>
    <OrientationInterpolator DEF='Revolve2' key='0 1' keyValue='0 1 0 0 0 1 0 6.283'/>
    <OrientationInterpolator DEF='Revolve3' key='0 1' keyValue='0 1 0 0 0 1 0 6.283'/>
    <OrientationInterpolator DEF='Spin1' key='0 1' keyValue='0 1 0 0 0 1 0 6.283'/>
    <OrientationInterpolator DEF='Spin2' key='0 1' keyValue='0 1 0 0 0 1 0 6.283'/>
    <OrientationInterpolator DEF='Spin3' key='0 1' keyValue='0 1 0 0 0 1 0 6.283'/>
    <OrientationInterpolator DEF='MoonRevolve' key='0 1' keyValue='0 1 0 0 0 1 0 6.283'/>

    <ROUTE fromNode='Clock1' fromField='fraction_changed' toNode='Revolve1' toField='set_fraction'/>
    <ROUTE fromNode='Revolve1' fromField='value_changed' toNode='Orbit1' toField='set_rotation'/>
    <ROUTE fromNode='Clock2' fromField='fraction_changed' toNode='Revolve2' toField='set_fraction'/>
    <ROUTE fromNode='Revolve2' fromField='value_changed' toNode='Orbit2' toField='set_rotation'/>
    <ROUTE fromNode='Clock3' fromField='fraction_changed' toNode='Revolve3' toField='set_fraction'/>
    <ROUTE fromNode='Revolve3' fromField='value_changed' toNode='Orbit3' toField='set_rotation'/>

    <ROUTE fromNode='Clock1' fromField='fraction_changed' toNode='Spin1' toField='set_fraction'/>
    <ROUTE fromNode='Spin1' fromField='value_changed' toNode='Planet1' toField='set_rotation'/>
    <ROUTE fromNode='Clock2' fromField='fraction_changed' toNode='Spin2' toField='set_fraction'/>
    <ROUTE fromNode='Spin2' fromField='value_changed' toNode='Planet2' toField='set_rotation'/>
    <ROUTE fromNode='Clock3' fromField='fraction_changed' toNode='Spin3' toField='set_fraction'/>
    <ROUTE fromNode='Spin3' fromField='value_changed' toNode='Planet3' toField='set_rotation'/>

    <ROUTE fromNode='Clock2' fromField='fraction_changed' toNode='MoonRevolve' toField='set_fraction'/>
    <ROUTE fromNode='MoonRevolve' fromField='value_changed' toNode='MoonOrbit' toField='set_rotation'/>

    <ROUTE fromNode='SunTouch' fromField='touchTime' toNode='PulseClock' toField='set_startTime'/>
    <ROUTE fromNode='PulseClock' fromField='fraction_changed' toNode='SunPulse' toField='set_fraction'/>
    <ROUTE fromNode='SunPulse' fromField='value_changed' toNode='SunTransform' toField='set_scale'/>
  </Scene>
</X3D>