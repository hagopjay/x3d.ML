<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Drag the cone on the ground plane' position='0 5 10' orientation='0 1 0 0.7'/>
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.5 0.5 0.5'/>
        </Appearance>
        <Box size='10 0.1 10'/>
      </Shape>
    </Transform>
    <Transform DEF='ConeTransform' translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='1 0 0'/>
        </Appearance>
        <Cone bottomRadius='0.5' height='2'/>
      </Shape>
    </Transform>
    <PlaneSensor DEF='PlaneSensor' enabled='true' autoOffset='true' planeNormal='0 1 0' planeOffset='0'/>
    <ROUTE fromNode='PlaneSensor' fromField='translation_changed' toNode='ConeTransform' toField='set_translation'/>
  </Scene>
</X3D>