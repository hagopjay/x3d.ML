<Scene>
<Viewpoint description='HAnim Figure' position='0 2 5'/>
<HAnimHumanoid version='2.0'/>
<TouchSensor DEF='Touch'/>
<TimeSensor DEF='Time' cycleInterval='1' loop='TRUE'/>
<OrientationInterpolator DEF='Wave' key='0 1' keyValue='0 1 0 0 0 1 0 0'/>
<ROUTE fromNode='Touch' fromField='touchTime' toNode='Time' toField='startTime'/>
<ROUTE fromNode='Time' fromField='fraction_changed' toNode='Wave' toField='fraction'/>
<ROUTE fromNode='Wave' fromField='value' toNode='HAnimHumanoid' toField='rotation'/>
</Scene>
</X3D>