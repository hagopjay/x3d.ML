<Scene>
<Viewpoint description='Top View' position='0 5 0' orientation='0 1 0 0'/>
<Transform translation='0 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='0 0 1'/>
</Appearance>
<Box DEF='Box' size='2 2 2'/>
</Shape>
<TimeSensor DEF='TimeSensor' cycleInterval='4' loop='true'/>
<OrientationInterpolator DEF='OrientationInterpolator' key='0 1' keyValue='0 1 0 0 0 0 1 0'/>
<ROUTE fromNode='TimeSensor' fromField='fractionCurrent' toNode='OrientationInterpolator' toField='set_fraction'/>
<ROUTE fromNode='OrientationInterpolator' fromField='value' toNode='Box' toField='rotation'/>
</Transform>
</Scene>
</X3D>