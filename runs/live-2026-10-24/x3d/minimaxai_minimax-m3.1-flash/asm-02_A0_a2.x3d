<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Solar System'/>
    <meta name='description' content='The Sun with three planets orbiting at different distances.'/>
  </head>
  <Scene>
    <NavigationInfo type='EXAMINE'/>
    <Background skyColor='0.01 0.01 0.04' groundColor='0.01 0.01 0.04'/>
    <DirectionalLight direction='0 0 -1' intensity='0.7' color='1 1 1'/>
    <Viewpoint description='Solar System Overview' position='0 18 38' orientation='0.35 0 0 0.94' fieldOfView='0.9'/>

    <Transform id='SunTransform'>
      <Shape>
        <Appearance>
          <UnlitMaterial diffuseColor='1 0.65 0.05' emissiveColor='1 0.35 0'/>
        </Appearance>
        <Sphere radius='2.4'/>
      </Shape>
    </Transform>

    <Transform DEF='MercuryOrbit'>
      <OrientationInterpolator DEF='MercuryOrbitAnimation' keyTimes='0 1' keyValues='0 1 0 0, 0 1 0 6.283185'/>
      <TimeSensor DEF='MercuryClock' cycleInterval='8' loop='true'/>
      <Transform id='MercuryPlanet' translation='5 0 0'>
        <Shape>
          <Appearance>
            <UnlitMaterial diffuseColor='0.65 0.55 0.45'/>
          </Appearance>
          <Sphere radius='0.55'/>
        </Shape>
        <TouchSensor DEF='MercuryTouch' description='Touch Mercury to move it'/>
      </Transform>
    </Transform>

    <Transform DEF='VenusOrbit'>
      <OrientationInterpolator DEF='VenusOrbitAnimation' keyTimes='0 1' keyValues='0 1 0 0, 0 1 0 6.283185'/>
      <TimeSensor DEF='VenusClock' cycleInterval='14' loop='true'/>
      <Transform id='VenusPlanet' translation='8 0 0'>
        <Shape>
          <Appearance>
            <UnlitMaterial diffuseColor='0.9 0.65 0.2'/>
          </Appearance>
          <Sphere radius='0.9'/>
        </Shape>
        <TouchSensor DEF='VenusTouch' description='Touch Venus to move it'/>
      </Transform>
    </Transform>

    <Transform DEF='EarthOrbit'>
      <OrientationInterpolator DEF='EarthOrbitAnimation' keyTimes='0 1' keyValues='0 1 0 0, 0 1 0 6.283185'/>
      <TimeSensor DEF='EarthClock' cycleInterval='22' loop='true'/>
      <Transform id='EarthPlanet' translation='12 0 0'>
        <Shape>
          <Appearance>
            <UnlitMaterial diffuseColor='0.15 0.45 0.95'/>
          </Appearance>
          <Sphere radius='1.05'/>
        </Shape>
        <TouchSensor DEF='EarthTouch' description='Touch Earth to move it'/>
      </Transform>
    </Transform>

    <ROUTE MercuryClock.fraction_changed TO MercuryOrbitAnimation.set_fraction/>
    <ROUTE MercuryOrbitAnimation.value_changed TO MercuryOrbit.set_rotation/>
    <ROUTE MercuryTouch.touchTime TO MercuryClock.startTime/>
    <ROUTE MercuryTouch.overTime TO MercuryClock.stopTime/>

    <ROUTE VenusClock.fraction_changed TO VenusOrbitAnimation.set_fraction/>
    <ROUTE VenusOrbitAnimation.value_changed TO VenusOrbit.set_rotation/>
    <ROUTE VenusTouch.touchTime TO VenusClock.startTime/>
    <ROUTE VenusTouch.overTime TO VenusClock.stopTime/>

    <ROUTE EarthClock.fraction_changed TO EarthOrbitAnimation.set_fraction/>
    <ROUTE EarthOrbitAnimation.value_changed TO EarthOrbit.set_rotation/>
    <ROUTE EarthTouch.touchTime TO EarthClock.startTime/>
    <ROUTE EarthTouch.overTime TO EarthClock.stopTime/>
  </Scene>
</X3D>