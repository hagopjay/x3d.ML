<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Greek Temple'/>
    <meta name='description' content='A Greek temple with three-step base, columns, roof, and pediments.'/>
  </head>
  <Scene>
    <Viewpoint position='0 15 30' orientation='0 1 0 3.14159' description='Greek Temple'/>
    <DirectionalLight direction='-0.3 -0.5 -0.8' color='1 1 1' intensity='0.8'/>
    <PhysicalMaterial DEF='Marble' diffuseColor='0.9 0.85 0.8' specularColor='0.3 0.3 0.3' shininess='0.2'/>
    <PhysicalMaterial DEF='GreenGround' diffuseColor='0.2 0.6 0.2'/>
    <Appearance DEF='MarbleAppearance'>
      <PhysicalMaterial USE='Marble'/>
    </Appearance>
    <Appearance DEF='GroundAppearance'>
      <PhysicalMaterial USE='GreenGround'/>
    </Appearance>
    <Group DEF='Column'>
      <Shape>
        <Appearance USE='MarbleAppearance'/>
        <Cylinder radius='0.5' height='8'/>
      </Shape>
    </Group>
    <IndexedFaceSet DEF='PedimentGeometry' solid='false' coordIndex='0 1 2 -1'>
      <Coordinate point='0 -4 10 0 4 10 0 0 13'/>
    </IndexedFaceSet>
    <Transform translation='0 -0.1 0'>
      <Shape>
        <Appearance USE='GroundAppearance'/>
        <Box size='100 0.2 100'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.25 0'>
      <Shape>
        <Appearance USE='MarbleAppearance'/>
        <Box size='20 0.5 10'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.75 0'>
      <Shape>
        <Appearance USE='MarbleAppearance'/>
        <Box size='18 0.5 9'/>
      </Shape>
    </Transform>
    <Transform translation='0 1.25 0'>
      <Shape>
        <Appearance USE='MarbleAppearance'/>
        <Box size='16 0.5 8'/>
      </Shape>
    </Transform>
    <Transform translation='-7 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='-5 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='-3 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='-1 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='1 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='3 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='5 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='7 5.5 -3.5'><USE node='Column'/></Transform>
    <Transform translation='-7 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='-5 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='-3 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='-1 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='1 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='3 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='5 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='7 5.5 3.5'><USE node='Column'/></Transform>
    <Transform translation='0 9.75 0'>
      <Shape>
        <Appearance USE='MarbleAppearance'/>
        <Box size='16 0.5 8'/>
      </Shape>
    </Transform>
    <Transform translation='-8 0 0'>
      <Shape>
        <Appearance USE='MarbleAppearance'/>
        <IndexedFaceSet USE='PedimentGeometry'/>
      </Shape>
    </Transform>
    <Transform translation='8 0 0'>
      <Shape>
        <Appearance USE='MarbleAppearance'/>
        <IndexedFaceSet USE='PedimentGeometry'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>