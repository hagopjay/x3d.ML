<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
    <meta name='title' content='red_pbr_sphere.x3d'/>
    <meta name='description' content='A red PBR sphere of radius 1 on a grey ground plane with a directional light and a named viewpoint.'/>
  </head>
  <Scene>
    <WorldInfo title='Red PBR Sphere'/>
    <Viewpoint DEF='MainViewpoint' description='Overview' position='0 2.5 5' orientation='1 0 0 -0.35'/>
    <Background skyColor='0.2 0.3 0.4'/>
    <DirectionalLight direction='-0.5 -1.0 -0.8' intensity='1.0' color='1 1 1'/>
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.5 0.5 0.5' roughness='0.8' metallic='0.0'/>
        </Appearance>
        <Box size='10 0.1 10'/>
      </Shape>
    </Transform>
    <Transform translation='0 1 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.85 0.08 0.08' roughness='0.3' metallic='0.1'/>
        </Appearance>
        <Sphere radius='1'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>