<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <WorldInfo title='Proximity Triggered Light'/>
    <Background skyColor='0.02 0.02 0.02'/>
    <NavigationInfo type='"WALK" "ANY"' speed='2.0'/>
    <Viewpoint description='Approach the statue' position='0 1.5 12'/>

    <Group>
      <ProximitySensor DEF='StatueSensor' center='0 1 0' size='10 10 10'/>
      <SpotLight DEF='StatueLight' on='false' location='0 6 4' direction='0 -0.8 -0.6' radius='15' cutOffAngle='0.7' beamWidth='0.5' intensity='4.0' color='1 0.85 0.6'/>

      <Transform translation='0 -0.5 0'>
        <Shape>
          <Box size='20 0.1 20'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.15 0.15 0.2' roughness='0.9' metallic='0.1'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform>
        <Shape>
          <Box size='1.2 1 1.2'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.3 0.25 0.2' roughness='0.8' metallic='0.0'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform translation='0 1.5 0'>
        <Shape>
          <Cylinder radius='0.4' height='2'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.8 0.9' roughness='0.2' metallic='0.7'/>
          </Appearance>
        </Shape>
      </Transform>

      <Transform translation='0 2.8 0'>
        <Shape>
          <Sphere radius='0.35'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.8 0.9' roughness='0.2' metallic='0.7'/>
          </Appearance>
        </Shape>
      </Transform>
    </Group>

    <ROUTE fromNode='StatueSensor' fromField='isActive' toNode='StatueLight' toField='on'/>
  </Scene>
</X3D>