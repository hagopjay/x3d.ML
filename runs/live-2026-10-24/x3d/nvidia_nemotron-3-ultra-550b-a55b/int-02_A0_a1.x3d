<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Sphere Toggle Red Green'/>
    <meta name='description' content='A sphere that toggles between red and green on each click using BooleanToggle and ColorInterpolator.'/>
    <meta name='creator' content='X3D Example'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 5' description='Click the sphere to toggle color'/>
    <Transform>
      <Shape>
        <Appearance>
          <Material DEF='Mat' diffuseColor='1 0 0'/>
        </Appearance>
        <Sphere radius='1'/>
        <TouchSensor DEF='Touch'/>
      </Shape>
    </Transform>
    <BooleanToggle DEF='Toggle'/>
    <BooleanFilter DEF='Filter'/>
    <ColorInterpolator DEF='ColorInterp' key='0 1' keyValue='1 0 0 0 1 0'/>
    <ROUTE fromNode='Touch' fromField='touchTime' toNode='Toggle' toField='toggle'/>
    <ROUTE fromNode='Toggle' fromField='value_changed' toNode='Filter' toField='set_boolean'/>
    <ROUTE fromNode='Filter' fromField='value_changed' toNode='ColorInterp' toField='set_fraction'/>
    <ROUTE fromNode='ColorInterp' fromField='value_changed' toNode='Mat' toField='diffuseColor'/>
  </Scene>
</X3D>