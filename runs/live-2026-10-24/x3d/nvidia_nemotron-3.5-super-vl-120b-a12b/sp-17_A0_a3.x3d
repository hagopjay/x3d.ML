<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
 <head>
  <meta name='title' content='Pendulum Clock'/>
 </head>
 <Scene>
  <Viewpoint description='Pendulum Clock' position='0 2 5'/>
  <Background skyColor='0.8 0.9 1.0'/>
  <DirectionalLight direction='-1 -1 -1' intensity='0.8' color='1 1 1'/>

  <Transform translation='0 1.5 0'>
   <Shape>
    <Box size='0.8 3.0 0.4'/>
    <Appearance>
     <PhysicalMaterial baseColor='0.5 0.35 0.2' roughness='0.8' metalness='0.1'/>
    </Appearance>
   </Shape>
  </Transform>

  <Transform translation='0 1.5 0.21'>
   <Shape>
    <Cylinder radius='0.35' height='0.02' subdivision='32'/>
    <Appearance>
     <PhysicalMaterial baseColor='1 1 1' roughness='0.4' metalness='0.0'/>
    </Appearance>
   </Shape>
  </Transform>

  <Transform DEF='Tick' translation='0 0.34 0.22'>
   <Shape>
    <Box size='0.02 0.06 0.01'/>
    <Appearance>
     <PhysicalMaterial baseColor='0 0 0' roughness='0.9' metalness='0.0'/>
    </Appearance>
   </Shape>
  </Transform>

  <Transform rotation='0 0 1 0'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 0.523599'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 1.0472'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 1.5708'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 2.0944'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 2.618'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 3.14159'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 3.66519'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 4.18879'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 4.71239'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 5.23599'><USE DEF='Tick'/></Transform>
  <Transform rotation='0 0 1 5.75959'><USE DEF='Tick'/></Transform>

  <Transform DEF='Pendulum' translation='0 1.5 0.22'>
   <Transform translation='0 -0.7 0'>
    <Shape>
     <Box size='0.04 1.4 0.04'/>
     <Appearance>
      <PhysicalMaterial baseColor='0.8 0.6 0.2' roughness='0.3' metalness='0.7'/>
     </Appearance>
    </Shape>
   </Transform>
   <Transform translation='0 -1.5 0'>
    <Shape>
     <Cylinder radius='0.1' height='0.2' subdivision='16'/>
     <Appearance>
      <PhysicalMaterial baseColor='0.8 0.6 0.2' roughness='0.3' metalness='0.7'/>
     </Appearance>
    </Shape>
   </Transform>
  </Transform>

  <TimeSensor DEF='clock' cycleInterval='2' loop='true'/>
  <OrientationInterpolator DEF='swing' key='0 0.5 1' keyValue='0 0 1 -0.3 0 0 1 0.3 0 0 1 -0.3'/>
  <ROUTE fromNode='clock' fromField='fraction_changed' toNode='swing' toField='set_fraction'/>
  <ROUTE fromNode='swing' fromField='value_changed' toNode='Pendulum' toField='rotation'/>

 </Scene>
</X3D>