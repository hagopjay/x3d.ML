<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Button spins cylinder'/>
  </head>
  <Scene>
    <Viewpoint description='Touch the blue box to spin the yellow cylinder' position='0 0 6'/>
    <DirectionalLight intensity='0.8' color='1 1 1' direction='0 -1 0'/>
    <Transform>
      <TouchSensor DEF='ButtonTouch'/>
      <Shape>
        <Appearance><UnlitMaterial diffuseColor='0.2 0.4 1'/></Appearance>
        <Box size='0.5 0.2 0.5'/>
      </Shape>
    </Transform>
    <Transform DEF='CylinderTransform' translation='0 0 -2'>
      <Shape>
        <Appearance><UnlitMaterial diffuseColor='1 0.8 0'/></Appearance>
        <Cylinder height='1' radius='0.3'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='SpinTimer' cycleInterval='10' loop='TRUE' enabled='FALSE'/>
    <OrientationInterpolator DEF='SpinInterpolator' KEY='0 0.25 0.5 0.75 1' KEYVALUE='0 1 0 0 0 1 0 1.570796327