        <xs:group ref="MetadataObjectContentModel" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="X3DChildNodeContentModel" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      ...
    </xs:extension>
  </xs:complexContent>
</xs:complexType>

