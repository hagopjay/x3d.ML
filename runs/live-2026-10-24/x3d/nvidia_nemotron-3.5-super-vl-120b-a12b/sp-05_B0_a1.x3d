<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Desk lamp with articulated arm and swaying upper arm' position='0 1 2' orientation='0 1 0 0'/>
    <Background skyColor='0.7 0.8 0.9' groundColor='0.6 0.6 0.6'/>

    <!-- Wooden desk surface -->
    <Transform translation='0 0 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.55 0.35 0.2' roughness='0.9' metalness='0.0'/>
        </Appearance>
        <Box size='2 0.05 1.2'/>
      </Shape>
    </Transform>

    <!-- Lamp assembly -->
    <Transform translation='-0.6 0.05 0'>
      <!-- Round base -->
      <Transform translation='0 0.05 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.15 0.15 0.15' roughness='0.4' metalness='0.8'/>
          </Appearance>
          <Cylinder radius='0.25' height='0.1' subdivision='32'/>
        </Shape>
      </Transform>

      <!-- Lower arm -->
      <Transform translation='0 0.1 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor='0.2 0.2 0.2' roughness='0.4' metalness='0.8'/>
          </Appearance>
          <Cylinder radius='0.018' height='0.4' subdivision='16'/>
        </Shape>
      </Transform>

      <!-- Upper arm with sway animation -->
      <Transform DEF='UpperArm' translation='0 0.4 0' rotation='0 0 1 0'>
        <Transform translation='0 0.25 0'>
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor='0.2 0.2 0.2' roughness='0.4' metalness='0.8'/>
            </Appearance>
            <Cylinder radius='0.015' height='0.5' subdivision='16'/>
          </Shape>
        </Transform>

        <!-- Cone shade and spotlight -->
        <Transform translation='0 0.5 0'>
          <Transform rotation='1 0 0 3.141592653589793'>
            <Shape>
              <Appearance>
                <PhysicalMaterial baseColor='0.95 0.95 0.9' roughness='0.3' metalness='0.1'/>
              </Appearance>
              <Cone bottomRadius='0.1' height='0.16' subdivision='32'/>
            </Shape>
          </Transform>
          <SpotLight intensity='1.2' color='1 1 0.95' cutOffAngle='0.6' beamWidth='0.4' radius='4' on='true' location='0 0 0' direction='0 -1 0'/>
        </Transform>
      </Transform>
    </Transform>

    <!-- Animation: upper arm sways slowly back and forth -->
    <TimeSensor DEF='LampTimer' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='ArmOrient' key='0 0.5 1' keyValue='0 0 1 -0.15 0 0 1 0 0 0 1 0.15'/>

    <ROUTE fromNode='LampTimer' fromField='fraction_changed' toNode='ArmOrient' toField='set_fraction'/>
    <ROUTE fromNode='ArmOrient' fromField='value_changed' toNode='UpperArm' toField='set_rotation'/>
  </Scene>
</X3D>