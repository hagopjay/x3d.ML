    <OrientationInterpolator DEF='VenusOrbitPath' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.5708 0 1 0 3.1416 0 1 0 4.7124 0 1 0 6.2832'/>
    <ROUTE fromNode='VenusClock' fromField='fraction_changed' toNode='VenusOrbitPath' toField='set_fraction'/>
    <ROUTE fromNode='VenusOrbitPath' fromField='value_changed' toNode='VenusOrbit' toField='set_rotation'/>

    <!-- Earth: blue planet, third orbit -->
