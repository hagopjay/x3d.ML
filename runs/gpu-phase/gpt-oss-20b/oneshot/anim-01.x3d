.step.3" content="{&quot;input_sha256&quot;:&quot;df7e667d58b7c25a47734d526f6879952c0e0bc5d4f6e43061db4e608413fdd3&quot;,&quot;ms&quot;:1,&quot;op&quot;:&quot;validate&quot;,&quot;output_sha256&quot;:&quot;df7e667d58b7c25a47734d526f6879952c0e0bc5d4f6e43061db4e608413fdd3&quot;,&quot;prev&quot;:&quot;e394a5a20b12c6dc4d63a41283d509784f245e6379a7f0be72d5decdede996e7&quot;,&quot;semantic_error_codes&quot;:[],&quot;validator&quot;:&quot;x3d_mcp fork&quot;,&quot;validator_ref&quot;:&quot;eb4b4b4&quot;,&quot;verdict&quot;:&quot;valid&quot;,&quot;xsd&quot;:&quot;4.0&quot;,&quot;xsd_valid&quot;:true}"/></head>
  <Scene>
    <Viewpoint description='Blue Cube Rotating' position='0 0 5' />
    <Transform DEF='CubeTransform'>
      <Shape>
        <Box size='1 1 1' />
        <Appearance>
          <Material diffuseColor='0 0 1' specularColor='0.2 0.2 0.2' shininess='0.5' />
        </Appearance>
      </Shape>
    </Transform>
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true' />
    <OrientationInterpolator DEF='Rotator' key='0 1' keyValue='0 1 0 0 0 1 0 6.28319' />
    <ROUTE fromField='fraction_changed' fromNode='Clock' toField='set_fraction' toNode='Rotator' />
    <ROUTE fromField='value_changed' fromNode='Rotator' toField='set_rotation' toNode='CubeTransform' />
  </Scene>
</X3D>