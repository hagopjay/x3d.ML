<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Bouncing ball' position='0 2 5'/>
    <Background skyColor='0.7 0.8 1.0'/>
    <Transform DEF='ballTransform' translation='0 0 0'>
      <Shape>
        <Sphere radius='0.2'/>
        <Appearance>
          <Material diffuseColor='1 0.5 0'/>
        </Appearance>
      </Shape>
    </Transform>
    <TimeSensor DEF='timer' interval='4' loop='true'/>
    <PositionInterpolator DEF='posInterp'
        key='0 0.2 0.4 0.45 0.5 0.55 0.6 0.8 1.0'
        keyValue='0 0 0 0 0.8 0 0 1.6 0 0 1.8 0 0 2.0 0 0 1.8 0 0 1.6 0 0 0.8 0 0 0 0 0'/>
    <ROUTE fromNode='timer' fromField='fraction_changed' toNode='posInterp' toField='set_fraction'/>
    <ROUTE fromNode='posInterp' fromField='value_changed' toNode='ballTransform' toField='set_translation'/>
  </Scene>
</X3D>