            -0.7071 0 0.7071, -0.8315 0 0.5556, -0.9239 0 0.3827, -0.9808 0 0.1951,
            -1 0 0, -0.9808 0 -0.1951, -0.9239 0 -0.3827, -0.8315 0 -0.5556,
            -0.7071 0 -0.7071, -0.5556 0 -0.8315, -0.3827 0 -0.9239, -0.1951 0 -0.9808,
            0 0 -1, 0.1951 0 -0.9808, 0.3827 0 -0.9239, 0.5556 0 -0.8315,
            0.7071 0 -0.7071, 0.8315 0 -0.5556, 0.9239 0 -0.3827, 0.9808 0 -0.1951'/>
        </IndexedLineSet>
      </Shape>
    </Transform>
    <Transform scale='5 1 5'>
      <Shape USE='OrbitGuide'/>
    </Transform>
    <Transform scale='7.6 1 7.6'>
      <Shape USE='OrbitGuide'/>
    </Transform>
    <Transform scale='10.7 1 10.7'>
      <Shape USE='OrbitGuide'/>
    </Transform>

    <Transform DEF='BlueOrbit'>
      <Transform translation='3.2 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.06 0.43 0.95' specularColor='0.6 0.75 1' shininess='0.45'/>
          </Appearance>
          <Sphere radius='0.36'/>
        </Shape>
      </Transform>
    </Transform>

    <Transform DEF='RedOrbit' rotation='0 1 0 1.8'>
      <Transform translation='5 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.86 0.19 0.07' specularColor='0.4 0.22 0.15' shininess='0.2'/>
          </Appearance>
          <Sphere radius='0.6'/>
        </Shape>
      </Transform>
    </Transform>

    <Transform DEF='RingedOrbit' rotation='0 1 0 3.7'>
      <Transform translation='7.6 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.68 0.43 0.86' specularColor='0.75 0.65 0.85' shininess='0.3'/>
          </Appearance>
          <Sphere radius='1.05'/>
        </Shape>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.84 0.72 0.47' emissiveColor='0.08 0.055 0.025' specularColor='0.4 0.34 0.2' shininess='0.2'/>
          </Appearance>
          <IndexedFaceSet solid='false' coordIndex='
            0 16 17 1 -1, 1 17 18 2 -1, 2 18 19 3 -1, 3 19 20 4 -1,
            4 20 21 5 -1, 5 21 22 6 -1, 6 22 23 7 -1, 7 23 24 8 -1,
            8 24 25 9 -1, 9 25 26 10 -1, 10 26 27 11 -1, 11 27 28 12 -1,
