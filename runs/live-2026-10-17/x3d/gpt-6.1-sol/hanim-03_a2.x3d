<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='3'/>
    <component name='Shape' level='2'/>
    <meta name='title' content='Humanoid Holding a Sphere'/>
  </head>
  <Scene>
    <WorldInfo title='Humanoid Holding a Sphere'/>
    <Background skyColor='0.08 0.11 0.16'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Viewpoint description='Eye-level view of humanoid and right-hand sphere'
               position='0 1.68 4.8' fieldOfView='0.7'/>
    <DirectionalLight direction='-0.4 -1 -0.6' intensity='0.9'/>
    <DirectionalLight direction='0.7 -0.3 0.5' intensity='0.45'/>

    <Switch whichChoice='-1'>
      <Shape>
        <Sphere DEF='HeldSphere' radius='0.12'/>
      </Shape>
    </Switch>

    <HAnimHumanoid name='SphereHolder' version='2.0'>
      <HAnimJoint containerField='skeleton' DEF='Root' name='humanoid_root' center='0 0.98 0'>
