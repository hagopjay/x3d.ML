<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Solar System'/>
  </head>
  <Scene>
    <Viewpoint description='Solar System with Sun and Three Planets' position='0 0 25'/>
    <PointLight intensity='1' color='1 1 0.9' radius='100'/>
    <Transform>
      <Shape>
        <Sphere radius='2'/>
        <Appearance>
          <Material emissiveColor='1 1 0' diffuseColor='0 0 0' specularColor='0 0 0'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform DEF='MercuryPivot'>
      <Transform translation='6 0 0'>
        <Shape>
          <Sphere radius='0.4'/>
          <Appearance>
            <Material diffuseColor='0.9 0.7 0.5'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <Transform DEF='VenusPivot'>
      <Transform translation='10 0 0'>
        <Shape>
          <Sphere radius='0.7'/>
          <Appearance>
            <Material diffuseColor='1 0.8 0.4'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <Transform DEF='EarthPivot'>
      <Transform translation='15 0 0'>
        <Shape>
          <Sphere radius='0.8'/>
          <Appearance>
            <Material diffuseColor='0.3 0.5 1'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <TimeSensor DEF='OrbitClock' cycleInterval='12' loop='true'/>
    <OrientationInterpolator DEF='MercuryOrbit' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.5708 0 1 0 3.14159 0 1 0 4.71239 0 1 0 6.28319'/>
    <OrientationInterpolator DEF='VenusOrbit' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.0472 0 1 0 2.0944 0 1 0 3.1416 0 1 0 6.2832'/>
    <OrientationInterpolator DEF='EarthOrbit' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 0.7854 0 1 0 1.5708 0 1 0 2.3562 0 1 0 6.2832'/>
    <ROUTE fromNode='OrbitClock' fromField='fraction_changed' toNode='MercuryOrbit' toField='set_fraction'/>
    <ROUTE fromNode='MercuryOrbit' fromField='value_changed' toNode='MercuryPivot' toField='set_rotation'/>
    <ROUTE fromNode='OrbitClock' fromField='fraction_changed' toNode='VenusOrbit' toField='set_fraction'/>
    <ROUTE fromNode='VenusOrbit' fromField='value_changed' toNode='VenusPivot' toField='set_rotation'/>
    <ROUTE fromNode='OrbitClock' fromField='fraction_changed' toNode='EarthOrbit' toField='set_fraction'/>
    <ROUTE fromNode='EarthOrbit' fromField='value_changed' toNode='EarthPivot' toField='set_rotation'/>
  </Scene>
</X3D>