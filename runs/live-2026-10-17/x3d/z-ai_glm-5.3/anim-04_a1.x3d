<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Color cycling sphere' position='0 0 4'/>
    <TimeSensor DEF='ColorClock' cycleInterval='6' loop='true'/>
    <ColorInterpolator DEF='ColorCycle' key='0 0.333 0.667 1' keyValue='1 0 0 0 1 0 0 0 1 1 0 0'/>
    <Shape>
      <Appearance>
        <Material DEF='SphereMaterial' diffuseColor='1 0 0'/>
      </Appearance>
      <Sphere radius='1'/>
    </Shape>
    <ROUTE fromNode='ColorClock' fromField='fraction_changed' toNode='ColorCycle' toField='set_fraction'/>
    <ROUTE fromNode='ColorCycle' fromField='value_changed' toNode='SphereMaterial' toField='set_diffuseColor'/>
  </Scene>
</X3D>