    <Transform translation='-9 7.4 3'><Shape USE='MerlonZ'/></Transform>
    <Transform translation='-9 7.4 6'><Shape USE='MerlonZ'/></Transform>

    <!-- Front South Walls flanking Gatehouse -->
    <Transform translation='-5.5 3.5 9'>
