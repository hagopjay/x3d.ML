<Scene>
<Viewpoint description='Bouncing Ball' position='0 2 5' orientation='0 1 0 0'/>
<Shape DEF='BouncingBall'>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
<Sphere radius='0.5'/>
</Shape>
<TimeSensor DEF='BounceTimer' cycleInterval='2' loop='true'/>
<PositionInterpolator DEF='BouncePath' key='0 0.25 0.5 0.75 1' keyValue='0 0 0 0 2 0 0 2 0 0 0 2 0 0 0'/>
<ROUTE fromNode='BounceTimer' fromField='fractionCurrent' toNode='BouncePath' toField='set_fraction'/>
<ROUTE fromNode='BouncePath' fromField='value' toNode='BouncingBall' toField='translation'/>
</Scene>
</X3D>