<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="HAnim" level="1"/>
  </head>
  <Scene>
    <Viewpoint description="HAnim waving right arm"/>
    <TimeSensor DEF="WaveTimer" cycleInterval="4" loop="true"/>
    <OrientationInterpolator DEF="ShoulderInterpolator" key="0 0.25 0.5 0.75 1" keyValue="0 1 0 0  0 1 0 1.57  0 1 0 0  0 1 0 -1.57  0 1 0 0"/>
    <HAnimHumanoid DEF="Human" version="2.0" name="Human">
      <HAnimJoint DEF="r_shoulder" name="r_shoulder" center="0 0 0" rotation="0 1 0 0" ulimit="0 0 0 0" llimit="0 0 0 0" stiffness="0 0 0" damping="0 0 0" type="ball"/>
      <HAnimSegment DEF="r_upperarm" name="r_upperarm" translation="0 0 0" rotation="0 1 0 0" scale="1 1 1" scaleOrientation="0 1 0 0" centerOfMass="0 0 0" mass="1" momentsOfInertia="1 0 0 0 1 0 0 0 1"/>
    </HAnimHumanoid>
    <ROUTE fromNode="WaveTimer" fromField="fraction_changed" toNode="ShoulderInterpolator" toField="set_fraction"/>
    <ROUTE fromNode="ShoulderInterpolator" fromField="value_changed" toNode="r_shoulder" toField="set_rotation"/>
  </Scene>
</X3D>