<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='1'/>
  </head>
  <Scene>
    <WorldInfo title='Virginia Tech Drillfield Flagpole'/>
    <GeoViewpoint description='VT Drillfield Overview' geoSystem='"GD" "WE"' position='37.2284 -80.4234 645'/>
    <Viewpoint description='Close View of Flagpole' position='0 6 20'/>
    <GeoLocation geoCoords='37.2284 -80.4234 630' geoSystem='"GD" "WE"'>
      <Transform DEF='GroundBase' translation='0 0.2 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.3 0.35 0.3' roughness='0.9'/>
          </Appearance>
          <Cylinder height='0.4' radius='1.5'/>
        </Shape>
      </Transform>
      <Transform DEF='FlagpoleBase' translation='0 0.5 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.5 0.5 0.52' metalness='0.8' roughness='0.3'/>
          </Appearance>
          <Cylinder height='0.6' radius='0.25'/>
        </Shape>
      </Transform>
      <Transform DEF='FlagpolePole' translation='0 5.4 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.85 0.85 0.88' metalness='0.9' roughness='0.2'/>
          </Appearance>
          <Cylinder height='10.0' radius='0.08'/>
        </Shape>
      </Transform>
      <Transform DEF='FinialSphere' translation='0 10.45 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.9 0.75 0.2' metalness='0.9' roughness='0.15'/>
          </Appearance>
          <Sphere radius='0.16'/>
        </Shape>
      </Transform>
      <Transform DEF='FlagHinge' center='0 9.4 0' translation='0 0 0'>
        <Transform DEF='FlagTransform' translation='0 9.4 0'>
          <Transform translation='1.1 0 0'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.8 0.05 0.15' roughness='0.6'/>
              </Appearance>
              <Box size='2.2 1.3 0.02'/>
            </Shape>
          </Transform>
        </Transform>
      </Transform>
    </GeoLocation>
    <TimeSensor DEF='WindTimer' cycleInterval='3.0' loop='true'/>
    <OrientationInterpolator DEF='WindInterpolator' key='0 0.25 0.5 0.75 1.0' keyValue='0 1 0 0, 0 1 0 0.08, 0 1 0 0, 0 1 0 -0.08, 0 1 0 0'/>
    <ROUTE fromField='fraction_changed' fromNode='WindTimer' toField='set_fraction' toNode='WindInterpolator'/>
    <ROUTE fromField='value_changed' fromNode='WindInterpolator' toField='set_rotation' toNode='FlagHinge'/>
  </Scene>
</X3D>