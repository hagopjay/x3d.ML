<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Core" level="1"/>
    <component name="Grouping" level="1"/>
    <component name="Shape" level="2"/>
    <component name="Geometry3D" level="1"/>
    <component name="Appearance" level="1"/>
    <component name="Lighting" level="1"/>
    <component name="Navigation" level="1"/>
    <component name="HAnim" level="1"/>
    <meta name="component" content="Core"/>
    <meta name="component" content="Grouping"/>
    <meta name="component" content="Shape"/>
    <meta name="component" content="Geometry3D"/>
    <meta name="component" content="Appearance"/>
    <meta name="component" content="Lighting"/>
    <meta name="component" content="Navigation"/>
    <meta name="component" content="HAnim"/>
  </head>
  <Scene>
    <Viewpoint description="Eye level viewpoint" position="0 1.6 3" orientation="0 0 1 0"/>
    <NavigationInfo type="&quot;EXAMINE&quot; &quot;ANY&quot;" headlight="true"/>
    <Background skyColor="0.7 0.8 1.0"/>
    <DirectionalLight intensity="0.7" direction="0 -1 0"/>
    <Group>
      <HAnimHumanoid version="2.0">
        <HAnimSegment name="HAnimSegment" containerField="segments">
          <HAnimJoint name="rightHand"/>
          <HAnimSite name="rightHandSite"/>
        </HAnimSegment>
      </HAnimHumanoid>
      <Transform translation="0 1.5 0">
        <Shape DEF="sphere">
          <Sphere radius="0.05"/>
          <Appearance>
            <PhysicalMaterial baseColor="1 1 1"/>
          </Appearance>
        </Shape>
      </Transform>
    </Group>
  </Scene>
</X3D>