<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
    <meta name="title" content="Greek Temple"/>
  </head>
  <Scene>
    <Viewpoint description="Greek temple with marble columns, stepped base, roof slab, and triangular pediment" position="0 15 25"/>
    <Background skyColor="0.7 0.85 1.0" groundColor="0.1 0.3 0.1"/>
    <DirectionalLight direction="0.3 -1 0.4" intensity="0.9" color="1 0.95 0.85"/>
    <!-- Green ground -->
    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor="0.2 0.5 0.2" roughness="0.9"/>
      </Appearance>
      <Box size="200 1 200"/>
    </Shape>
    <!-- Three-step stone base -->
    <Transform translation="0 1 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.85 0.8 0.72" roughness="0.7"/>
        </Appearance>
        <Box size="22 2 14"/>
      </Shape>
    </Transform>
    <Transform translation="0 3 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.85 0.8 0.72" roughness="0.7"/>
        </Appearance>
        <Box size="20 2 12"/>
      </Shape>
    </Transform>
    <Transform translation="0 5 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.85 0.8 0.72" roughness="0.7"/>
        </Appearance>
        <Box size="18 2 10"/>
      </Shape>
    </Transform>
    <!-- Column definition reused with DEF/USE -->
    <Shape DEF="MarbleColumn">
      <Appearance>
        <PhysicalMaterial baseColor="0.92 0.88 0.8" roughness="0.4"/>
      </Appearance>
      <Cylinder radius="0.7" height="10" subdivision="32"/>
    </Shape>
    <!-- Eight columns along left long side -->
    <Transform translation="-7 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="-5 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="-3 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="-1 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="1 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="3 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="5 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="7 11 -6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <!-- Eight columns along right long side -->
    <Transform translation="-7 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="-5 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="-3 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="-1 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="1 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="3 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="5 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <Transform translation="7 11 6">
      <Shape USE="MarbleColumn"/>
    </Transform>
    <!-- Flat roof slab -->
    <Transform translation="0 16.5 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.9 0.85 0.78" roughness="0.5"/>
        </Appearance>
        <Box size="22 1 14"/>
      </Shape>
    </Transform>
    <!-- Triangular pediment at front -->
    <Transform translation="0 20 7">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.9 0.85 0.78" roughness="0.5"/>
        </Appearance>
        <IndexedFaceSet solid="false" coordIndex="0 1 2, 3 5 4, 0 3 5 2, 1 4 5 2, 0 3 4 1">
          <Coordinate point="-10 0 -0.5, 10 0 -0.5, 0 6 -0.5, -10 0 0.5, 10 0 0.5, 0 6 0.5"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
  </Scene>
</X3D>
