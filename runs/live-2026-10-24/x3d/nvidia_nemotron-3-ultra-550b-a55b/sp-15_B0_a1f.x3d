<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
  </head>
  <Scene>
    <Viewpoint description="Friendly Robot" position="0 2 5"/>
    <TimeSensor DEF="TS" cycleInterval="2" loop="true"/>
    <OrientationInterpolator DEF="OILeft" key="0 0.5 1" keyValue="1 0 0 0  1 0 0 0.5  1 0 0 0"/>
    <OrientationInterpolator DEF="OIRight" key="0 0.5 1" keyValue="1 0 0 0  1 0 0 -0.5  1 0 0 0"/>
    <Transform translation="0 0 0">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.2 0.6 0.8" roughness="0.5" metalness="0.2"/>
        </Appearance>
        <Box size="1 2 1"/>
      </Shape>
      <Transform translation="-0.7 1.5 0">
        <Transform DEF="LeftArmJoint">
          <Transform translation="0 -0.5 0">
            <Shape>
              <Appearance>
                <PhysicalMaterial baseColor="0.2 0.6 0.8" roughness="0.5" metalness="0.2"/>
              </Appearance>
              <Cylinder radius="0.1" height="1"/>
            </Shape>
          </Transform>
        </Transform>
      </Transform>
      <Transform translation="0.7 1.5 0">
        <Transform DEF="RightArmJoint">
          <Transform translation="0 -0.5 0">
            <Shape>
              <Appearance>
                <PhysicalMaterial baseColor="0.2 0.6 0.8" roughness="0.5" metalness="0.2"/>
              </Appearance>
              <Cylinder radius="0.1" height="1"/>
            </Shape>
          </Transform>
        </Transform>
      </Transform>
      <Transform translation="-0.3 0 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor="0.2 0.6 0.8" roughness="0.5" metalness="0.2"/>
          </Appearance>
          <Cylinder radius="0.1" height="1"/>
        </Shape>
      </Transform>
      <Transform translation="0.3 0 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor="0.2 0.6 0.8" roughness="0.5" metalness="0.2"/>
          </Appearance>
          <Cylinder radius="0.1" height="1"/>
        </Shape>
      </Transform>
      <Transform translation="0 3 0">
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor="0.8 0.8 0.8" roughness="0.3" metalness="0.1"/>
          </Appearance>
          <Sphere radius="0.5"/>
        </Shape>
        <Transform translation="-0.15 3.1 0.5">
          <Shape>
            <Appearance>
              <UnlitMaterial emissiveColor="1 1 0"/>
            </Appearance>
            <Sphere radius="0.1"/>
          </Shape>
        </Transform>
        <Transform translation="0.15 3.1 0.5">
          <Shape>
            <Appearance>
              <UnlitMaterial emissiveColor="1 1 0"/>
            </Appearance>
            <Sphere radius="0.1"/>
          </Shape>
        </Transform>
      </Transform>
    </Transform>
    <ROUTE fromNode="TS" fromField="fraction_changed" toNode="OILeft" toField="set_fraction"/>
    <ROUTE fromNode="TS" fromField="fraction_changed" toNode="OIRight" toField="set_fraction"/>
    <ROUTE fromNode="OILeft" fromField="value_changed" toNode="LeftArmJoint" toField="rotation"/>
    <ROUTE fromNode="OIRight" fromField="value_changed" toNode="RightArmJoint" toField="rotation"/>
  </Scene>
</X3D>
