      <HAnimJoint containerField='joints' USE='Root'/>
      <HAnimJoint containerField='joints' USE='Pelvis'/>
      <HAnimJoint containerField='joints' USE='RightHip'/>
      <HAnimJoint containerField='joints' USE='RightKnee'/>
      <HAnimJoint containerField='joints' USE='RightAnkle'/>
      <HAnimJoint containerField='joints' USE='LeftHip'/>
      <HAnimJoint containerField='joints' USE='LeftKnee'/>
      <HAnimJoint containerField='joints' USE='LeftAnkle'/>
      <HAnimJoint containerField='joints' USE='Spine'/>
      <HAnimJoint containerField='joints' USE='HeadJoint'/>
      <HAnimJoint containerField='joints' USE='RightShoulder'/>
      <HAnimJoint containerField='joints' USE='RightElbow'/>
      <HAnimJoint containerField='joints' USE='RightWrist'/>
      <HAnimJoint containerField='joints' USE='LeftShoulder'/>
