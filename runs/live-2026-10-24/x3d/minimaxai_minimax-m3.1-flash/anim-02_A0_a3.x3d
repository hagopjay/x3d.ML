<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Forever bouncing ball with eased apex'/>
    <meta name='description' content='A ball bounces repeatedly between y=0 and y=2, easing gently at the top with closely spaced interpolation keys.'/>
  </head>
  <Scene>
    <Viewpoint id='mainView' description='View of the bouncing ball between the floor and the apex marker' position='5 3 7' orientation='-0.371 0.929 0 0.655' center='0 1 0' fieldOfView='0.8'/>
    <Background color='0.05 0.07 0.12'/>
    <DirectionalLight direction='0 -1 -0.4' intensity='0.9' color='1 0.97 0.9'/>
    <TimeSensor DEF='bounceClock' loop='true' cycleInterval='4' startTime='0'/>
    <PositionInterpolator DEF='bouncePosition' keyTimes='0 0.30 0.40 0.46 0.50 0.54 0.60 0.70 1' keyValues='0 0 0  0 1.55 0  0 1.85 0  0 1.97 0  0 2 0  0 1.97 0  0 1.85 0  0 1.55 0  0 0 0'/>
    <ROUTE id='bounceRoute' fromNode='bounceClock' fromField='fraction_changed' toNode='bouncePosition' toField='set_fraction'/>
    <Transform DEF='ballTransform' translation='0 0 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial diffuseColor='0.92 0.22 0.16' roughness='0.3' metallic='0.05'/>
        </Appearance>
        <Sphere radius='0.25'/>
      </Shape>
      <TouchSensor DEF='ballTouch' description='Touch the ball to restart the bounce'/>
    </Transform>
    <ROUTE id='touchRoute' fromNode='ballTouch' fromField='touchTime' toNode='bounceClock' toField='startTime'/>
    <ROUTE id='ballRoute' fromNode='bouncePosition' fromField='value_changed' toNode='ballTransform' toField='translation'/>
    <Shape>
      <Appearance>
        <PhysicalMaterial diffuseColor='0.16 0.2 0.26' roughness='0.9' metallic='0'/>
      </Appearance>
      <Transform translation='0 -0.25 0' rotation='-1 0 0 0'>
        <Plane size='20 20'/>
      </Transform>
    </Shape>
    <Shape>
      <Appearance>
        <UnlitMaterial color='0.35 0.75 1' transparency='0.55'/>
      </Appearance>
      <Transform translation='0 2 0' rotation='-1 0 0 0'>
        <Circle radius='0.45'/>
      </Transform>
    </Shape>
  </Scene>
</X3D>