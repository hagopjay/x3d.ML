  <Scene>
    <Viewpoint description='Blue Cube Rotating' position='0 0 5' orientation='0 0 0 0'/>
    <Transform DEF='CubeTransform'>
      <Shape>
        <Appearance>
          <Material DEF='BlueMaterial' diffuseColor='0 0 1' specularColor='0.2 0.2 0.2'/>
        </Appearance>
        <Box size='1 1 1'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='Rotator' key='0 1' keyValue='0 1 0 0 0 1 0 6.28318'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Rotator' toField='set_fraction'/>
    <ROUTE fromNode='Rotator' fromField='value_changed' toNode='CubeTransform' toField='set_rotation'/>
  </Scene>
</X3D>