<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geometry2D' level='2'/>
    <meta name='title' content='proximity_statue_spotlight.x3d'/>
    <meta name='description' content='A SpotLight dynamically illuminates a museum statue when the viewer steps within a 5-meter proximity radius.'/>
  </head>
  <Scene>
    <WorldInfo title='Proximity-Triggered Spotlight Gallery'/>

    <NavigationInfo type='"WALK" "EXAMINE" "ANY"' headlight='false' speed='2.5'/>

    <Background skyColor='0.03 0.03 0.05' groundColor='0.02 0.02 0.03'/>

    <Viewpoint description='Gallery Entrance - Walk forward toward the statue' position='0 1.7 11' orientation='0 1 0 0'/>

    <DirectionalLight direction='0.5 -1 -0.3' intensity='0.08' color='0.6 0.7 1.0'/>

    <!-- 5m boundary detector centered on statue (10m x 6m x 10m box = +/- 5m on X and Z) -->
    <ProximitySensor DEF='ProximityTrigger' center='0 1.7 0' size='10 6 10'/>

    <!-- Overhead Spotlight targeting the statue -->
    <SpotLight DEF='StatueSpot' on='false' location='0 5.2 2.2' direction='0 -0.85 -0.52' color='1 0.95 0.82' intensity='4.0' beamWidth='0.45' cutOffAngle='0.75' radius='15'/>

    <!-- Floor and gallery environment -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.15 0.15 0.17' specularColor='0.25 0.25 0.28' shininess='0.4'/>
        </Appearance>
        <Box size='24 0.1 24'/>
      </Shape>
    </Transform>

    <!-- Inlaid floor boundary circle indicating proximity threshold (radius 5m) -->
    <Transform translation='0 0.005 0' rotation='1 0 0 -1.5708'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.28 0.22' emissiveColor='0.08 0.07 0.04'/>
        </Appearance>
        <Disk2D innerRadius='4.92' outerRadius='5.08'/>
      </Shape>
    </Transform>

    <!-- Overhead lighting fixture structure -->
    <Transform translation='0 5.4 2.2'>
      <!-- Fixture arm mount -->
      <Shape>
        <Appearance>
          <Material diffuseColor='0.1 0.1 0.1' specularColor='0.4 0.4 0.4' shininess='0.5'/>
        </Appearance>
        <Cylinder radius='0.04' height='0.8'/>
      </Shape>
      <!-- Fixture housing -->
      <Transform translation='0 -0.4 0' rotation='1 0 0 0.58'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.15 0.15 0.15' specularColor='0.3 0.3 0.3'/>
          </Appearance>
          <Cone bottomRadius='0.22' height='0.35'/>
        </Shape>
      </Transform>
    </Transform>

    <!-- Statue Assembly -->
    <Transform translation='0 0 0'>
      <!-- Plinth base steps -->
      <Transform translation='0 0.1 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.25 0.25 0.26' specularColor='0.15 0.15 0.15' shininess='0.2'/>
          </Appearance>
          <Box size='1.8 0.2 1.8'/>
        </Shape>
      </Transform>
      <Transform translation='0 0.3 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.28 0.28 0.29' specularColor='0.15 0.15 0.15' shininess='0.2'/>
          </Appearance>
          <Box size='1.5 0.2 1.5'/>
        </Shape>
      </Transform>

      <!-- Classical pedestal pillar -->
      <Transform translation='0 0.9 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.35 0.34 0.33' specularColor='0.2 0.2 0.2' shininess='0.3'/>
          </Appearance>
          <Box size='1.1 1.0 1.1'/>
        </Shape>
      </Transform>

      <!-- Pedestal cap -->
      <Transform translation='0 1.45 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.3 0.3 0.31' specularColor='0.15 0.15 0.15' shininess='0.2'/>
          </Appearance>
          <Box size='1.3 0.1 1.3'/>
        </Shape>
      </Transform>

      <!-- Bronze Classical Statue -->
      <!-- Lower draped gown / body base -->
      <Transform translation='0 1.95 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.65 0.55 0.42' specularColor='0.6 0.55 0.45' shininess='0.6'/>
          </Appearance>
          <Cylinder radius='0.36' height='0.9'/>
        </Shape>
      </Transform>

      <!-- Torso -->
      <Transform translation='0 2.65 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.68 0.58 0.44' specularColor='0.6 0.55 0.45' shininess='0.6'/>
          </Appearance>
          <Cylinder radius='0.28' height='0.65'/>
        </Shape>
      </Transform>

      <!-- Shoulders & Upper Chest -->
      <Transform translation='0 3.0 0' rotation='0 0 1 1.5708'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.68 0.58 0.44' specularColor='0.6 0.55 0.45' shininess='0.6'/>
          </Appearance>
          <Cylinder radius='0.18' height='0.75'/>
        </Shape>
      </Transform>

      <!-- Neck -->
      <Transform translation='0 3.15 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.65 0.55 0.42' specularColor='0.6 0.55 0.45' shininess='0.6'/>
          </Appearance>
          <Cylinder radius='0.11' height='0.2'/>
        </Shape>
      </Transform>

      <!-- Head -->
      <Transform translation='0 3.4 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.68 0.58 0.44' specularColor='0.6 0.55 0.45' shininess='0.6'/>
          </Appearance>
          <Sphere radius='0.22'/>
        </Shape>
      </Transform>

      <!-- Left arm resting downward -->
      <Transform translation='-0.4 2.6 0' rotation='0 0 1 0.15'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.65 0.55 0.42' specularColor='0.6 0.55 0.45' shininess='0.6'/>
          </Appearance>
          <Cylinder radius='0.09' height='0.75'/>
        </Shape>
      </Transform>

      <!-- Right arm raised gesturing -->
      <Transform translation='0.38 2.8 0.15' rotation='1 0.3 0.3 1.1'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.65 0.55 0.42' specularColor='0.6 0.55 0.45' shininess='0.6'/>
          </Appearance>
          <Cylinder radius='0.085' height='0.7'/>
        </Shape>
      </Transform>
    </Transform>

    <!-- Connect proximity sensor directly to the spotlight switch -->
    <ROUTE fromNode='ProximityTrigger' fromField='isActive' toNode='StatueSpot' toField='on'/>
  </Scene>
</X3D>