<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Geospatial" level="1"/>
    <component name="Shape" level="2"/>
    <component name="Grouping" level="1"/>
    <component name="Geometry3D" level="2"/>
    <component name="Rendering" level="2"/>
    <component name="Lighting" level="2"/>
    <component name="Navigation" level="1"/>
    <meta content="GeoLOD statue within 200 m, box beyond" name="description"/>
  </head>
  <Scene>
    <Viewpoint description="GeoLOD statue and box" position="0 10 50"/>
    <NavigationInfo type="EXAMINE ANY FLY"/>
    <Background skyColor="0.2 0.6 0.9"/>
    <DirectionalLight intensity="0.8" direction="0 -1 0" color="1 1 1"/>
    <GeoLOD center="0 0 0" range="200">
      <Group>
        <Transform translation="0 1 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.9 0.85 0.8"/>
            </Appearance>
            <Box size="1 2 1"/>
          </Shape>
        </Transform>
        <Transform translation="0 3 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.9 0.85 0.8"/>
            </Appearance>
            <Sphere radius="0.5"/>
          </Shape>
        </Transform>
        <Transform translation="0 -1 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.6 0.55 0.5"/>
            </Appearance>
            <Box size="2 0.5 2"/>
          </Shape>
        </Transform>
      </Group>
      <Group>
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor="0.5 0.5 0.5"/>
          </Appearance>
          <Box size="2 2 2"/>
        </Shape>
      </Group>
    </GeoLOD>
  </Scene>
</X3D>