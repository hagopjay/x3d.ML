<Scene>
<Viewpoint description='Default View' position='0 3 5'/>
<NavigationInfo type='EXAMINE' />
<Shape>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
<Box size='1 1 0.1'/>
</Shape>
<Shape>
<Appearance>
<Material diffuseColor='0 1 0'/>
</Appearance>
<Cylinder radius='0.5' height='2'/>
<RotationInterpolator DEF='SpinInterpolator' key='0 1' keyValue='0 0 0 0 1 0 0 1'/>
</Shape>
<TimeSensor DEF='SpinTimer' cycleInterval='5' loop='TRUE'/>
<ROUTE fromNode='SpinTimer' fromField='fraction' toNode='SpinInterpolator' toField='set_fraction'/>
<TouchSensor DEF='ButtonSensor' description='Spin Button'/>
<ROUTE fromNode='ButtonSensor' fromField='touchTime' toNode='SpinTimer' toField='startTime'/>
</Scene>
</X3D>