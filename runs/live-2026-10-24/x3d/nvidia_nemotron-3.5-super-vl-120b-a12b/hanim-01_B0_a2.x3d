<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="HAnim" level="1"/>
    <component name="Shape" level="1"/>
  </head>
  <Scene>
    <Viewpoint description="Minimal HAnim 2.0 humanoid with root, sacroiliac, l_hip and r_hip joints" position="0 0 1.2"/>
    <DirectionalLight intensity="0.8" color="1 1 1" direction="0 -1 -1"/>
    <HAnimHumanoid version="2.0" name="humanoid">
      <HAnimJoint name="humanoid_root" containerField="skeleton">
        <HAnimSegment name="root_segment">
          <Shape>
            <Box size="0.1 0.1 0.1"/>
            <Appearance>
              <UnlitMaterial emissiveColor="1 0 0"/>
            </Appearance>
          </Shape>
        </HAnimSegment>
        <HAnimJoint name="sacroiliac">
          <HAnimSegment name="sacrum_segment">
            <Shape>
              <Box size="0.08 0.08 0.08"/>
              <Appearance>
                <UnlitMaterial emissiveColor="0 1 0"/>
              </Appearance>
            </Shape>
          </HAnimSegment>
          <HAnimJoint name="l_hip">
            <HAnimSegment name="l_thigh_segment">
              <Shape>
                <Box size="0.06 0.06 0.06"/>
                <Appearance>
                  <UnlitMaterial emissiveColor="0 0 1"/>
                </Appearance>
              </Shape>
            </HAnimSegment>
          </HAnimJoint>
          <HAnimJoint name="r_hip">
            <HAnimSegment name="r_thigh_segment">
              <Shape>
                <Box size="0.06 0.06 0.06"/>
                <Appearance>
                  <UnlitMaterial emissiveColor="0 0 1"/>
                </Appearance>
              </Shape>
            </HAnimSegment>
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>
    </HAnimHumanoid>
  </Scene>
</X3D>