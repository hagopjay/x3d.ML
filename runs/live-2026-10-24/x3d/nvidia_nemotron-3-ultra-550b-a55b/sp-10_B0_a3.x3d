<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
  </head>
  <Scene>
    <Viewpoint description="Torii gate in shallow water" position="0 5 10" orientation="0 1 0 -0.5"/>
    <DirectionalLight direction="0 -1 -0.5" color="1 0.9 0.8" intensity="0.8"/>
    <Background skyColor="0.5 0.7 1"/>
    <!-- Water plane -->
    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor="0 0.3 0.8" roughness="0.1" transparency="0.5"/>
      </Appearance>
      <Box size="100 0.1 100"/>
    </Shape>
    <!-- Torii gate with animation -->
    <Transform DEF="ToriiTransform" translation="0 0.05 0">
      <TouchSensor DEF="TouchTorii"/>
      <Group>
        <!-- Left post -->
        <Transform translation="0 1.55 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.8 0.2 0.2" roughness="0.5"/>
            </Appearance>
            <Cylinder radius="0.2" height="3" bottom="true" top="true" side="true"/>
          </Shape>
        </Transform>
        <!-- Right post -->
        <Transform translation="3 1.55 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.8 0.2 0.2" roughness="0.5"/>
            </Appearance>
            <Cylinder radius="0.2" height="3" bottom="true" top="true" side="true"/>
          </Shape>
        </Transform>
        <!-- Lower lintel (nuki) -->
        <Transform translation="1.5 3.15 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.8 0.2 0.2" roughness="0.5"/>
            </Appearance>
            <Box size="4 0.3 0.4"/>
          </Shape>
        </Transform>
        <!-- Upper lintel (kasagi) -->
        <Transform translation="1.5 3.5 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.8 0.2 0.2" roughness="0.5"/>
            </Appearance>
            <Box size="4.5 0.2 0.5"/>
          </Shape>
        </Transform>
      </Group>
    </Transform>
    <!-- Left stone lantern -->
    <Transform translation="-3 0.05 0">
      <Group>
        <Transform translation="0 0.15 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.4 0.4 0.4" roughness="0.9"/>
            </Appearance>
            <Box size="0.8 0.3 0.8"/>
          </Shape>
        </Transform>
        <Transform translation="0 1.05 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.4 0.4 0.4" roughness="0.9"/>
            </Appearance>
            <Cylinder radius="0.15" height="1.5" bottom="true" top="true" side="true"/>
          </Shape>
        </Transform>
        <Transform translation="0 2.05 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.4 0.4 0.4" roughness="0.9"/>
            </Appearance>
            <Cone bottomRadius="0.4" height="0.5" bottom="true" side="true"/>
          </Shape>
        </Transform>
      </Group>
    </Transform>
    <!-- Right stone lantern -->
    <Transform translation="3 0.05 0">
      <Group>
        <Transform translation="0 0.15 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.4 0.4 0.4" roughness="0.9"/>
            </Appearance>
            <Box size="0.8 0.3 0.8"/>
          </Shape>
        </Transform>
        <Transform translation="0 1.05 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.4 0.4 0.4" roughness="0.9"/>
            </Appearance>
            <Cylinder radius="0.15" height="1.5" bottom="true" top="true" side="true"/>
          </Shape>
        </Transform>
        <Transform translation="0 2.05 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.4 0.4 0.4" roughness="0.9"/>
            </Appearance>
            <Cone bottomRadius="0.4" height="0.5" bottom="true" side="true"/>
          </Shape>
        </Transform>
      </Group>
    </Transform>
    <!-- Animation -->
    <TimeSensor DEF="TS" cycleInterval="20" loop="true"/>
    <OrientationInterpolator DEF="OI" key="0 1" keyValue="0 1 0 0 0 1 0 6.283"/>
    <ROUTE fromNode="TS" fromField="fraction_changed" toNode="OI" toField="set_fraction"/>
    <ROUTE fromNode="OI" fromField="value_changed" toNode="ToriiTransform" toField="set_rotation"/>
  </Scene>
</X3D>