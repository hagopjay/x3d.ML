<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Background skyColor='0.05 0.06 0.16 0.01 0.01 0.05' skyAngle='1.55' groundColor='0.01 0.02 0.05'/>
    <Viewpoint description='Lighthouse on rocky island at night' position='0 9 48' orientation='1 0 0 0.05'/>
    <Viewpoint description='Lantern gallery' position='7 14.5 12' orientation='0 1 0 -0.55 1 0 0 0.05'/>
    <DirectionalLight direction='0.2 -1 -0.4' color='0.55 0.65 0.9' intensity='0.7' ambientIntensity='0.15'/>
    <PointLight location='0 14.3 0' color='1 0.9 0.55' intensity='0.9' radius='30'/>

    <!-- Dark blue sea -->
    <Transform translation='0 -0.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.04 0.10 0.22' specularColor='0.10 0.15 0.30' shininess='0.3'/>
        </Appearance>
        <Box size='400 1 400'/>
      </Shape>
    </Transform>

    <!-- Rocky island -->
    <Transform translation='0 0.4 0' scale='1 0.35 1'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.22 0.20 0.18'/>
        </Appearance>
        <Sphere radius='7'/>
      </Shape>
    </Transform>
    <Transform translation='5.5 0.3 3' scale='1 0.6 1'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.20 0.19 0.17'/>
        </Appearance>
        <Sphere radius='1.4'/>
      </Shape>
    </Transform>
    <Transform translation='-6 0.25 -2.5' scale='1 0.5 1'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.20 0.19 0.17'/>
        </Appearance>
        <Sphere radius='1.1'/>
      </Shape>
    </Transform>

    <!-- Tapered white tower with two red bands -->
    <Group DEF='Tower'>
      <Transform translation='0 0.6 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.8 0.8 0.82'/>
          </Appearance>
          <Cylinder radius='2.4' height='1.2'/>
        </Shape>
      </Transform>
      <Transform translation='0 2.8 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.95 0.95 0.95'/>
          </Appearance>
          <Cylinder radius='1.8' height='3.2'/>
        </Shape>
      </Transform>
      <Transform translation='0 4.95 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
          <Cylinder radius='1.66' height='1.1'/>
        </Shape>
      </Transform>
      <Transform translation='0 7.1 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.95 0.95 0.95'/>
          </Appearance>
          <Cylinder radius='1.56' height='3.2'/>
        </Shape>
      </Transform>
      <Transform translation='0 9.25 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.8 0.1 0.1'/>
          </Appearance>
          <Cylinder radius='1.44' height='1.1'/>
        </Shape>
      </Transform>
      <Transform translation='0 11.4 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.95 0.95 0.95'/>
          </Appearance>
          <Cylinder radius='1.36' height='3.2'/>
        </Shape>
      </Transform>

      <!-- Door and glowing windows -->
      <Transform translation='0 2.0 1.72'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.15 0.12 0.10'/>
          </Appearance>
          <Box size='0.9 1.6 0.25'/>
        </Shape>
      </Transform>
      <Transform translation='0 6.3 1.5'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.8 0.4' emissiveColor='0.9 0.7 0.3'/>
          </Appearance>
          <Box size='0.45 0.7 0.2'/>
        </Shape>
      </Transform>
      <Transform translation='0 10.6 1.32'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.8 0.4' emissiveColor='0.9 0.7 0.3'/>
          </Appearance>
          <Box size='0.45 0.7 0.2'/>
        </Shape>
      </Transform>

      <!-- Gallery deck -->
      <Transform translation='0 13.175 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.25 0.25 0.27'/>
          </Appearance>
          <Cylinder radius='2.1' height='0.35'/>
        </Shape>
      </Transform>

      <!-- Glass lantern room -->
      <Transform translation='0 14.3 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.8 0.85 0.9' transparency='0.5' specularColor='0.6 0.7 0.8' shininess='0.4'/>
          </Appearance>
          <Cylinder radius='1.15' height='1.9'/>
        </Shape>
      </Transform>

      <!-- Lamp -->
      <Transform translation='0 14.3 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.9 0.45' emissiveColor='1 0.9 0.45'/>
          </Appearance>
          <Sphere radius='0.55'/>
        </Shape>
      </Transform>

      <!-- Roof and finial -->
      <Transform translation='0 15.9 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.75 0.1 0.1'/>
          </Appearance>
          <Cone bottomRadius='1.45' height='1.3'/>
        </Shape>
      </Transform>
      <Transform translation='0 16.7 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.25 0.25 0.27'/>
          </Appearance>
          <Sphere radius='0.18'/>
        </Shape>
      </Transform>
    </Group>

    <!-- Sweeping pale yellow beam -->
    <Transform DEF='BeamPivot' translation='0 14.3 0'>
      <Transform translation='20.5 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.95 0.65' emissiveColor='0.9 0.85 0.5' transparency='0.35'/>
          </Appearance>
          <Box size='40 0.25 0.9'/>
        </Shape>
      </Transform>
    </Transform>

    <TimeSensor DEF='Clock' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='Spin' key='0 0.5 1' keyValue='0 1 0 0 0 1 0 3.14159 0 1 0 6.28318'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Spin' toField='set_fraction'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='BeamPivot' toField='set_rotation'/>
  </Scene>
</X3D>