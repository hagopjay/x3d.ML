<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Drone square flight above Torgersen Hall'/>
    <meta name='description' content='Animated drone (small box) flying a square path 50 m above Torgersen Hall using GeoPositionInterpolator'/>
    <meta name='creator' content='X3D author'/>
    <meta name='created' content='2025-07-15'/>
    <meta name='modified' content='2025-07-15'/>
    <meta name='identifier' content='https://example.com/drone-square-flight'/>
    <meta name='generator' content='manual'/>
  </head>
  <Scene>
    <!-- Geographic reference for Torgersen Hall, Virginia Tech -->
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2296 -80.4139 600'/>
    <GeoViewpoint geoSystem='"GD" "WE"' position='37.2296 -80.4139 600' description='Torgersen Hall view'/>
    <Viewpoint description='Drone flight overview' position='0 10 30' orientation='1 0 0 -0.3'/>

    <!-- Time sensor driving the animation -->
    <TimeSensor DEF='TS' cycleInterval='20' loop='true'/>

    <!-- GeoPositionInterpolator defining square path 50 m above hall (altitude 650 m) -->
    <GeoPositionInterpolator DEF='GPI'
      key='0 0.25 0.5 0.75 1'
      keyValue='37.23005 -80.41334 650
                37.23005 -80.41446 650
                37.22915 -80.41446 650
                37.22915 -80.41334 650
                37.23005 -80.41334 650'/>
    <!-- Drone geometry (small box) -->
    <Transform DEF='DroneTransform' translation='0 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.6 0.9' emissiveColor='0.1 0.3 0.5' shininess='0.5'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>

    <!-- ROUTEs -->
    <ROUTE fromNode='TS' fromField='fraction_changed' toNode='GPI' toField='set_fraction'/>
    <ROUTE fromNode='GPI' fromField='value_changed' toNode='DroneTransform' toField='set_translation'/>
  </Scene>
</X3D>