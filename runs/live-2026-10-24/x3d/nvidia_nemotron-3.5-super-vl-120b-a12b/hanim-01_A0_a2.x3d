<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='HAnimVersion' content='2.0'/>
    <meta name='HAnimHAnim' content='2.0'/>
    <component name='HAnim' level='1'/>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <Viewpoint description='Minimal HAnim 2.0 humanoid with root, sacroiliac, and hip joints' position='0 1.5 3'/>
    <HAnimHumanoid version='2.0' name='humanoid'>
      <HAnimJoint name='humanoid_root' containerField='joints'/>
      <HAnimJoint name='sacroiliac' containerField='joints'/>
      <HAnimJoint name='l_hip' containerField='joints'/>
      <HAnimJoint name='r_hip' containerField='joints'/>
      <HAnimSegment name='humanoid_root_segment' containerField='segments'>
        <Transform translation='0 0.9 0'>
          <Shape>
            <Box size='0.2 0.2 0.2'/>
            <Appearance>
              <PhysicalMaterial baseColor='0.8 0.6 0.4'/>
            </Appearance>
          </Shape>
        </Transform>
      </HAnimSegment>
      <HAnimSegment name='sacroiliac_segment' containerField='segments'>
        <Transform translation='0 -0.25 0'>
          <Shape>
            <Box size='0.16 0.12 0.16'/>
            <Appearance>
              <PhysicalMaterial baseColor='0.7 0.5 0.3'/>
            </Appearance>
          </Shape>
        </Transform>
      </HAnimSegment>
      <HAnimSegment name='l_hip_segment' containerField='segments'>
        <Transform translation='-0.12 -0.25 0'>
          <Shape>
            <Box size='0.14 0.1 0.14'/>
            <Appearance>
              <PhysicalMaterial baseColor='0.6 0.4 0.2'/>
            </Appearance>
          </Shape>
        </Transform>
      </HAnimSegment>
      <HAnimSegment name='r_hip_segment' containerField='segments'>
        <Transform translation='0.12 -0.25 0'>
          <Shape>
            <Box size='0.14 0.1 0.14'/>
            <Appearance>
              <PhysicalMaterial baseColor='0.6 0.4 0.2'/>
            </Appearance>
          </Shape>
        </Transform>
      </HAnimSegment>
    </HAnimHumanoid>
  </Scene>
</X3D>