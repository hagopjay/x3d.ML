ov.step.3" content="{&quot;input_sha256&quot;:&quot;7fab0724431bf33dd9a7a4868f353be31afc7f1e89311ee0732bdf5add86a446&quot;,&quot;ms&quot;:0,&quot;op&quot;:&quot;validate&quot;,&quot;output_sha256&quot;:&quot;7fab0724431bf33dd9a7a4868f353be31afc7f1e89311ee0732bdf5add86a446&quot;,&quot;prev&quot;:&quot;cdced680ff669cf86df0c2a6d4949fee3e16e47ba898a8c47f0219bd0d1f728f&quot;,&quot;semantic_error_codes&quot;:[&quot;route-invalid-to-field&quot;],&quot;validator&quot;:&quot;x3d_mcp fork&quot;,&quot;validator_ref&quot;:&quot;eb4b4b4&quot;,&quot;verdict&quot;:&quot;invalid&quot;,&quot;xsd&quot;:&quot;4.0&quot;,&quot;xsd_valid&quot;:false}"/></head>
  <Scene>
    <Viewpoint description='Box Highlight Demo' position='0 0 5'/>
    <Shape>
      <Box size='1 1 1'/>
      <Appearance>
        <BooleanSwitch DEF='bs'>
          <Material DEF='defaultMat' diffuseColor='0.8 0.8 0.8'/>
          <Material DEF='highlightMat' emissiveColor='1 1 0'/>
        </BooleanSwitch>
      </Appearance>
    </Shape>
    <TouchSensor DEF='ts' isOver='true'/>
    <BooleanToggle DEF='bt'/>
    <ROUTE fromField='isOver' fromNode='ts' toField='toggle' toNode='bt'/>
    <ROUTE fromField='toggle' fromNode='bt' toField='whichChoice' toNode='bs'/>
  </Scene>
</X3D>