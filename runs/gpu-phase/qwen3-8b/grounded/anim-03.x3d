<Scene>
<Viewpoint description='Door View' position='0 5 10' orientation='0 1 0 0'/>
<Group DEF='Door'>
<Transform translation='0 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.5 0.3 0.1'/>
</Appearance>
<Box size='2 2 0.1'/>
</Shape>
<Shape>
<Appearance>
<Material diffuseColor='0.5 0.3 0.1'/>
</Appearance>
<Box size='2 0.1 0.1'/>
</Shape>
<Transform DEF='DoorHinge' translation='0 0 0'>
