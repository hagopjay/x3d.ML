<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <title>Traffic Cone</title>
  </head>
  <Scene>
    <Background skyColor='0.82 0.9 1'/>
    <DirectionalLight direction='0 -1 0' intensity='0.8' ambientIntensity='0.35'/>
    <Viewpoint description='Orange traffic cone on a black square base' position='0 0.45 1.4' orientation='0 0 1 0' fieldOfView='0.8'/>
    <Shape>
      <Appearance>
        <PhysicalMaterial diffuseColor='1 0.25 0.02' roughness='0.55'/>
      </Appearance>
      <Cone bottomRadius='0.15' topRadius='0.025' height='0.62' position='0 0.39 0' solid='true'/>
    </Shape>
    <Shape>
      <Appearance>
        <PhysicalMaterial diffuseColor='0.02 0.02 0.02' roughness='0.8'/>
      </Appearance>
      <Box size='0.36 0.08 0.36' position='0 0.04 0' solid='true'/>
    </Shape>
  </Scene>
</X3D>