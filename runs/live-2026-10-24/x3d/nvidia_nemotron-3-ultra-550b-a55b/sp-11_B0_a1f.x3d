Let's write the X3D.

We'll use the following structure:

<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Gyroscope view' position='0 0 5'/>
    <Background skyColor='0.1 0.1 0.2'/>
    <!-- Central disc -->
    <Transform DEF='DiscTransform'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.8 0.2'/>
        </Appearance>
        <Cylinder radius='0.3' height='0.02' top='true' bottom='true' side='true'/>
      </Shape>
      <TouchSensor description='Click to interact'/>  <!-- no DEF -->
    </Transform>
    <!-- Ring 1: XY plane -->
    <Transform DEF='Ring1Transform'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.2 0.2' transparency='0.2'/>
        </Appearance>
        <Extrusion crossSection='...' spine='...' solid='false'/>
      </Shape>
    </Transform>
    <!-- Ring 2: YZ plane -->
    <Transform DEF='Ring2Transform'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.8 0.2' transparency='0.2'/>
        </Appearance>
        <Extrusion crossSection='...' spine='...' solid='false'/>
      </Shape>
    </Transform>
    <!-- Ring 3: ZX plane -->
    <Transform DEF='Ring3Transform'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.8' transparency='0.2'/>
        </Appearance>
        <Extrusion crossSection='...' spine='...' solid='false'/>
      </Shape>
    </Transform>
    <!-- TimeSensors and OrientationInterpolators -->
    <TimeSensor DEF='DiscTimeSensor' cycleInterval='4' loop='true'/>
    <OrientationInterpolator DEF='DiscOI' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0  0 0 1 1.57  0 0 1 3.14  0 0 1 4.71  0 0 1 6.28'/>
    <TimeSensor DEF='Ring1TimeSensor' cycleInterval='10' loop='true'/>
    <OrientationInterpolator DEF='Ring1OI' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0  0 0 1 1.57  0 0 1 3.14  0 0 1 4.71  0 0 1 6.28'/>
