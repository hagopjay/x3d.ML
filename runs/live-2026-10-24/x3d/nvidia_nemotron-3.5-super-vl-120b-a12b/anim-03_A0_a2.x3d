<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <Viewpoint description='A door swings open 90 degrees over 2 seconds when the scene loads.' position='0 1.5 3'/>
    <DirectionalLight direction='0 -1 -1' intensity='0.8' color='1 1 1'/>
    <Transform translation='0 -1.05 0'>
      <Shape>
        <Box size='10 0.1 10'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.7 0.7 0.7'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform DEF='DoorPivot' translation='-1 0 0'>
      <Transform translation='0.05 0 0'>
        <Shape>
          <Box size='0.1 2 1'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.55 0.4 0.3'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>
    <TimeSensor DEF='DoorTimer' cycleInterval='2' loop='false' startTime='0' enabled='true'/>
    <OrientationInterpolator DEF='DoorRot' key='0 1' keyValue='0 1 0 0 0 1 0 1.5707963267948966'/>
    <ROUTE fromNode='DoorTimer' fromField='fraction_changed' toNode='DoorRot' toField='set_fraction'/>
    <ROUTE fromNode='DoorRot' fromField='value_changed' toNode='DoorPivot' toField='set_rotation'/>
  </Scene>
</X3D>