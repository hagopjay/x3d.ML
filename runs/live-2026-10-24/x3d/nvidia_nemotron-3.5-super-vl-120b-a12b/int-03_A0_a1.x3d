<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Drag the red cone across the gray ground plane' position='0 4 8'/>
    <DirectionalLight direction='0 -1 -1' intensity='0.9'/>
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Box size='20 0.1 20'/>
        <Appearance>
          <Material diffuseColor='0.5 0.5 0.5'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform DEF='coneTransform' translation='0 0.5 0'>
      <Shape>
        <Cone bottomRadius='0.4' height='1.0'/>
        <Appearance>
          <Material diffuseColor='1 0.2 0.2'/>
        </Appearance>
      </Shape>
    </Transform>
    <PlaneSensor DEF='planeSensor' enabled='true' minPosition='-10 0 -10' maxPosition='10 0 10'/>
    <ROUTE fromNode='planeSensor' fromField='translation_changed' toNode='coneTransform' toField='set_translation'/>
  </Scene>
</X3D>