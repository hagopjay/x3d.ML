<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<head>
<meta content='Three rotating cubes' name='title'/>
<component name='Shape' level='2'/>
</head>
<Scene>
<Viewpoint description='Three cubes rotating at different speeds' position='0 0 10'/>
<Group>
<Transform DEF='CUBE1_TRANSFORM' rotation='0 0 1 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='1 0 0'/>
</Appearance>
<Box size='2 2 2'/>
</Shape>
</Transform>
<Transform DEF='CUBE2_TRANSFORM' translation='3 0 0' rotation='0 0 1 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0 1 0'/>
</Appearance>
<Box size='2 2 2'/>
</Shape>
</Transform>
<Transform DEF='CUBE3_TRANSFORM' translation='-3 0 0' rotation='0 0 1 0'>
<Shape>
<Appearance>
<PhysicalMaterial baseColor='0 0 1'/>
</Appearance>
<Box size='2 2 2'/>
</Shape>
</Transform>
</Group>
<TimeSensor DEF='TS1' cycleInterval='4' loop='true'/>
<OrientationInterpolator DEF='OI1' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 1.570796327 0 0 1 3.141592654 0 0 1 4.712388980 0 0 1 6.283185307'/>
<TimeSensor DEF='TS2' cycleInterval='6' loop='true'/>
<OrientationInterpolator DEF='OI2' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 1.570796327 0 0 1 3.141592654 0 0 1 4.712388980 0 0 1 6.283185307'/>
<TimeSensor DEF='TS3' cycleInterval='8' loop='true'/>
<OrientationInterpolator DEF='OI3' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 1.570796327 0 0 1 3.141592654 0 0 1 4.712388980 0 0 1 6.283185307'/>
<ROUTE fromNode='TS1' fromField='fraction_changed' toNode='OI1' toField='set_fraction'/>
<ROUTE fromNode='OI1' fromField='value_changed' toNode='CUBE1_TRANSFORM' toField='rotation'/>
<ROUTE fromNode='TS2' fromField='fraction_changed' toNode='OI2' toField='set_fraction'/>
<ROUTE fromNode='OI2' fromField='value_changed' toNode='CUBE2_TRANSFORM' toField='rotation'/>
<ROUTE fromNode='TS3' fromField='fraction_changed' toNode='OI3' toField='set_fraction'/>
<ROUTE fromNode='OI3' fromField='value_changed' toNode='CUBE3_TRANSFORM' toField='rotation'/>
</Scene>
</X3D>