    </GeoLocation>

    <TimeSensor DEF='DroneTimer' cycleInterval='20' loop='true'/>

    <GeoPositionInterpolator DEF='DronePath' geoSystem='"GD" "WE"' key='0 0.25 0.5 0.75 1' keyValue='37.2295 -80.4199 685 37.2305 -80.4199 685 37.2305 -80.4189 685 37.2295 -80.4189 685 37.2295 -80.4199 685'/>

    <ROUTE fromNode='DroneTimer' fromField='fraction_changed' toNode='DronePath' toField='set_fraction'/>
    <ROUTE fromNode='DronePath' fromField='geovalue_changed' toNode='DroneLocation' toField='set_geoCoords'/>
  </Scene>
