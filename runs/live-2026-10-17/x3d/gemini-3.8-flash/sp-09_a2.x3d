    <Transform translation='4 7.4 9'><Shape USE='MerlonX'/></Transform>
    <Transform translation='6 7.4 9'><Shape USE='MerlonX'/></Transform>

    <!-- Corner Towers (Standard: NW, SW, SE) -->
