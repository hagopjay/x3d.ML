<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Windmill on a Grassy Hill'/>
    <meta name='description' content='A conical white windmill with a dark roof and four rotating blades on a grassy elevation hill.'/>
  </head>
  <Scene>
    <WorldInfo title='Windmill on Grassy Hill'/>

    <Background skyColor='0.35 0.6 0.88, 0.65 0.8 0.95, 0.85 0.9 0.98' skyAngle='1.2 1.57'
                groundColor='0.2 0.38 0.12, 0.28 0.48 0.16, 0.38 0.58 0.22' groundAngle='1.3 1.57'/>

    <Viewpoint description='Windmill View' position='0 8 26' orientation='1 0 0 -0.08'/>
    <Viewpoint description='Close-up View' position='0 9 12' orientation='1 0 0 0.05'/>
    <Viewpoint description='Side View' position='20 8 6' orientation='0 1 0 1.25'/>

    <DirectionalLight direction='-0.6 -0.75 -0.4' intensity='1.0' color='1 0.98 0.92'/>
    <DirectionalLight direction='0.5 0.4 0.6' intensity='0.3' color='0.6 0.75 0.9'/>

    <!-- Grassy Hill ElevationGrid -->
    <Transform translation='-20 0 -20'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.55 0.18' specularColor='0.08 0.15 0.05'/>
        </Appearance>
        <ElevationGrid xDimension='9' zDimension='9' xSpacing='5.0' zSpacing='5.0' solid='false'
          height='
            0.0 0.0 0.1 0.5 0.8 0.5 0.1 0.0 0.0
            0.0 0.2 0.8 1.4 1.7 1.4 0.8 0.2 0.0
            0.1 0.8 1.6 2.4 2.8 2.4 1.6 0.8 0.1
            0.5 1.4 2.4 3.2 3.5 3.2 2.4 1.4 0.5
            0.8 1.7 2.8 3.5 3.8 3.5 2.8 1.7 0.8
            0.5 1.4 2.4 3.2 3.5 3.2 2.4 1.4 0.5
            0.1 0.8 1.6 2.4 2.8 2.4 1.6 0.8 0.1
            0.0 0.2 0.8 1.4 1.7 1.4 0.8 0.2 0.0
            0.0 0.0 0.1 0.5 0.8 0.5 0.1 0.0 0.0
          '/>
      </Shape>
    </Transform>

    <!-- Windmill Structure on top of the hill -->
    <Transform translation='0 3.6 0'>
      <!-- Conical White Tower -->
      <Shape>
        <Appearance>
          <Material diffuseColor='0.92 0.91 0.88'/>
        </Appearance>
        <Extrusion solid='true' creaseAngle='1.57'
          spine='0 0 0, 0 7.5 0'
          scale='2.4 2.4, 1.5 1.5'
          crossSection='
            1.000  0.000,  0.924  0.383,  0.707  0.707,  0.383  0.924,
            0.000  1.000, -0.383  0.924, -0.707  0.707, -0.924  0.383,
           -1.000  0.000, -0.924 -0.383, -0.707 -0.707, -0.383 -0.924,
            0.000 -1.000,  0.383 -0.924,  0.707 -0.707,  0.924 -0.383,
            1.000  0.000
          '/>
      </Shape>

      <!-- Tower Stone Base Rim -->
      <Transform translation='0 0.2 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.45 0.42 0.38'/>
          </Appearance>
          <Cylinder radius='2.5' height='0.4'/>
        </Shape>
      </Transform>

      <!-- Dark Conical Roof -->
      <Transform translation='0 8.7 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.22 0.16 0.14' specularColor='0.08 0.06 0.05'/>
          </Appearance>
          <Cone height='2.6' bottomRadius='1.75'/>
        </Shape>
      </Transform>

      <!-- Roof Cap Finial -->
      <Transform translation='0 10.1 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.18 0.13 0.11'/>
          </Appearance>
          <Sphere radius='0.22'/>
        </Shape>
      </Transform>

      <!-- Wooden Door -->
      <Transform translation='0 1.0 2.22'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.35 0.22 0.12'/>
          </Appearance>
          <Box size='1.0 1.8 0.15'/>
        </Shape>
      </Transform>

      <!-- Upper Window -->
      <Transform translation='0 5.2 1.6'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.15 0.12 0.1'/>
          </Appearance>
          <Box size='0.6 0.8 0.15'/>
        </Shape>
      </Transform>

      <!-- Axle housing pointing forward -->
      <Transform translation='0 7.7 1.4' rotation='1 0 0 1.5708'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.3 0.2 0.15'/>
          </Appearance>
          <Cylinder radius='0.28' height='1.2'/>
        </Shape>
      </Transform>

      <!-- Rotating Blades Assembly (turns continuously once every 8 seconds) -->
      <Transform translation='0 7.7 2.0'>
        <Transform DEF='RotorTransform'>
          <!-- Center Hub -->
          <Transform rotation='1 0 0 1.5708'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.2 0.15 0.1'/>
              </Appearance>
              <Cylinder radius='0.42' height='0.4'/>
            </Shape>
          </Transform>
          <Transform translation='0 0 0.2'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.25 0.18 0.12'/>
              </Appearance>
              <Sphere radius='0.32'/>
            </Shape>
          </Transform>

          <!-- Blade 1 (Up) -->
          <Transform rotation='0 0 1 0'>
            <!-- Central Spar -->
            <Transform translation='0 2.6 0'>
              <Shape>
                <Appearance DEF='SparAppearance'>
                  <Material diffuseColor='0.4 0.25 0.14'/>
                </Appearance>
                <Box size='0.14 5.2 0.12'/>
              </Shape>
            </Transform>
            <!-- Sail Lattice / Canvas -->
            <Transform translation='0.36 2.8 0.02'>
              <Shape>
                <Appearance DEF='SailAppearance'>
                  <Material diffuseColor='0.88 0.85 0.78'/>
                </Appearance>
                <Box size='0.6 4.0 0.03'/>
              </Shape>
            </Transform>
          </Transform>

          <!-- Blade 2 (Right) -->
          <Transform rotation='0 0 1 1.5708'>
            <Transform translation='0 2.6 0'>
              <Shape>
                <Appearance USE='SparAppearance'/>
                <Box size='0.14 5.2 0.12'/>
              </Shape>
            </Transform>
            <Transform translation='0.36 2.8 0.02'>
              <Shape>
                <Appearance USE='SailAppearance'/>
                <Box size='0.6 4.0 0.03'/>
              </Shape>
            </Transform>
          </Transform>

          <!-- Blade 3 (Down) -->
          <Transform rotation='0 0 1 3.14159'>
            <Transform translation='0 2.6 0'>
              <Shape>
                <Appearance USE='SparAppearance'/>
                <Box size='0.14 5.2 0.12'/>
              </Shape>
            </Transform>
            <Transform translation='0.36 2.8 0.02'>
              <Shape>
                <Appearance USE='SailAppearance'/>
                <Box size='0.6 4.0 0.03'/>
              </Shape>
            </Transform>
          </Transform>

          <!-- Blade 4 (Left) -->
          <Transform rotation='0 0 1 4.71239'>
            <Transform translation='0 2.6 0'>
              <Shape>
                <Appearance USE='SparAppearance'/>
                <Box size='0.14 5.2 0.12'/>
              </Shape>
            </Transform>
            <Transform translation='0.36 2.8 0.02'>
              <Shape>
                <Appearance USE='SailAppearance'/>
                <Box size='0.6 4.0 0.03'/>
              </Shape>
            </Transform>
          </Transform>
        </Transform>
      </Transform>
    </Transform>

    <!-- Animation Clock and Interpolator: 8 second continuous rotation -->
    <TimeSensor DEF='BladeClock' cycleInterval='8.0' loop='true'/>
    <OrientationInterpolator DEF='BladeRotator'
      key='0.0 0.25 0.5 0.75 1.0'
      keyValue='
        0 0 1 0.0,
        0 0 1 1.5708,
        0 0 1 3.14159,
        0 0 1 4.71239,
        0 0 1 6.28319
      '/>

    <ROUTE fromNode='BladeClock' fromField='fraction_changed' toNode='BladeRotator' toField='set_fraction'/>
    <ROUTE fromNode='BladeRotator' fromField='value_changed' toNode='RotorTransform' toField='rotation'/>
  </Scene>
</X3D>