</Appearance>
<Cylinder radius='2' height='10'/>
</Shape>
<Transform translation='0 10 0'>
<Shape>
<Appearance>
<Material diffuseColor='0.4 0.2 0.2'/>
</Appearance>
<Cone bottomRadius='2' height='5'/>
</Shape>
</Transform>
</Transform>

<!-- Tower 3: front-right (10,0,-10) height 15 (tallest) with flag -->
<Transform translation='10 0 -10'>
<Shape>
<Appearance>
<Material diffuseColor='0.6 0.6 0.6'/>
</Appearance>
<Cylinder radius='2' height='15'/>
</Shape>
<Transform translation='0 15 0'>
<Shape>
