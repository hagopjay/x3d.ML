  <Scene>
    <Viewpoint description='Color Cycling Sphere' position='0 0 5' />
    <TimeSensor DEF='Clock' cycleInterval='6' loop='true' />
    <ColorInterpolator DEF='ColorCycle' key='0 0.333 0.666 1' keyValue='1 0 0 0 1 0 0 0 1 1 0 0' />
    <Shape>
      <Sphere radius='1' />
      <Appearance>
        <Material DEF='DynamicMaterial' />
      </Appearance>
    </Shape>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='ColorCycle' toField='set_fraction' />
    <ROUTE fromNode='ColorCycle' fromField='color_changed' toNode='DynamicMaterial' toField='diffuseColor' />
  </Scene>
</X3D>