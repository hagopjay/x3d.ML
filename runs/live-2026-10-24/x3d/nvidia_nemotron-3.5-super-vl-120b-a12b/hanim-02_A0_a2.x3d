<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<head>
<meta name='title' content='Waving HAnim Right Arm'/>
<component name='HAnim' level='1'/>
<component name='Shape' level='1'/>
</head>
<Scene>
<Viewpoint description='Waving HAnim figure with animated shoulder joint' position='0 1.5 4' orientation='0 1 0 0'/>
<DirectionalLight intensity='0.9' direction='0 -1 -1'/>
<HAnimHumanoid version='2.0' name='WavingFigure'>
  <HAnimSegment containerField='segments' name='Torso'>
    <HAnimJoint DEF='rightShoulderJoint' name='RightShoulder' center='0 0.8 0' rotation='0 0 1 0'>
      <HAnimSegment containerField='segments' name='UpperArm'>
        <Shape>
          <Appearance>
            <UnlitMaterial diffuseColor='0.85 0.7 0.6'/>
          </Appearance>
          <Box size='0.2 1.0 0.2'/>
        </Shape>
      </HAnimSegment>
    </HAnimJoint>
  </HAnimSegment>
</HAnimHumanoid>
<OrientationInterpolator DEF='shoulderOrientation' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 0.6 0 0 1 0 0 0 1 -0.6 0 0 1 0'/>
<TimeSensor DEF='waveClock' cycleInterval='4' loop='true'/>
<ROUTE fromNode='waveClock' fromField='fraction_changed' toNode='shoulderOrientation' toField='set_fraction'/>
<ROUTE fromNode='shoulderOrientation' fromField='value_changed' toNode='rightShoulderJoint' toField='rotation'/>
</Scene>
</X3D>