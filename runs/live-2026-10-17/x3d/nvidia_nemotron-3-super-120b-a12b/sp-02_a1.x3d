<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Planetarium view' position='0 0 15'/>
    <DirectionalLight intensity='0.8' color='1 1 1' direction='0 -1 0'/>
    <!-- Sun -->
    <Transform>
      <Shape>
        <Appearance>
          <PhysicalMaterial emissiveColor='1 1 0' roughness='0.2' metalness='0'/>
        </Appearance>
        <Sphere radius='1.5'/>
      </Shape>
    </Transform>
    <!-- Planet 1 -->
    <Transform DEF='Planet1Orbit'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.8 0.2 0.2' roughness='0.5' metalness='0'/>
        </Appearance>
        <Sphere radius='0.3'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Planet1Time' cycleInterval='12' loop='true'/>
    <OrientationInterpolator DEF='Planet1Ori' key='0 1' keyValue='0 0 1 0  0 0 1 6.283185307179586'/>
    <ROUTE fromNode='Planet1Time' fromField='fraction_changed' toNode='Planet1Ori' toField='set_fraction'/>
    <ROUTE fromNode='Planet1Ori' fromField='value_changed' toNode='Planet1Orbit' toField='set_rotation'/>
    <!-- Planet 2 -->
    <Transform DEF='Planet2Orbit'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.2 0.6 0.8' roughness='0.5' metalness='0'/>
        </Appearance>
        <Sphere radius='0.4'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Planet2Time' cycleInterval='20' loop='true'/>
    <OrientationInterpolator DEF='Planet2Ori' key='0 1' keyValue='0 0 1 0  0 0 1 6.283185307179586'/>
    <ROUTE fromNode='Planet2Time' fromField='fraction_changed' toNode='Planet2Ori' toField='set_fraction'/>
    <ROUTE fromNode='Planet2Ori' fromField='value_changed' toNode='Planet2Orbit' toField='set_rotation'/>
    <!-- Planet 3 -->
    <Transform DEF='Planet3Orbit'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.2 0.8 0.4' roughness='0.5' metalness='0'/>
        </Appearance>
        <Sphere radius='0.25'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Planet3Time' cycleInterval='28' loop='true'/>
    <OrientationInterpolator DEF='Planet3Ori' key='0 1' keyValue='0 0 1 0  0 0 1 6.283185307179586'/>
    <ROUTE fromNode='Planet3Time' fromField='fraction_changed' toNode='Planet3Ori' toField='set_fraction'/>
    <ROUTE fromNode='Planet3Ori' fromField='value_changed' toNode='Planet3Orbit' toField='set_rotation'/>
    <!-- Planet 4 (largest) with ring -->
    <Transform DEF='Planet4Orbit'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.8 0.8 0.2' roughness='0.5' metalness='0'/>
        </Appearance>
        <Sphere radius='0.5'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.5 0.5 0.5' roughness='0.5' metalness='0' transparency='0.8'/>
        </Appearance>
        <Torus innerRadius='0.1' outerRadius='0.8'/>
      </Shape>
    </Transform>
    <TimeSensor DEF='Planet4Time' cycleInterval='36' loop='true'/>
    <OrientationInterpolator DEF='Planet4Ori' key='0 1' keyValue='0 0 1 0  0 0 1 6.283185307179586'/>
    <ROUTE fromNode='Planet4Time' fromField='fraction_changed' toNode='Planet4Ori' toField='set_fraction'/>
    <ROUTE fromNode='Planet4Ori' fromField='value_changed' toNode='Planet4Orbit' toField='set_rotation'/>
  </Scene>
</X3D>