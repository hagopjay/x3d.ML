<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Solar System'/>
    <meta name='description' content='Sun with three orbiting planets'/>
    <meta name='creator' content='X3D Author'/>
    <meta name='created' content='2024-01-01'/>
    <meta name='modified' content='2024-01-01'/>
    <meta name='identifier' content='https://example.com/solar-system'/>
    <meta name='generator' content='manual'/>
  </head>
  <Scene>
    <Viewpoint description='Solar System View' position='0 0 50'/>
    <Transform DEF='SolarSystem'>
      <!-- Sun -->
      <Shape>
        <Appearance>
          <Material diffuseColor='1 1 0' emissiveColor='1 1 0' shininess='0.1'/>
        </Appearance>
        <Sphere radius='5'/>
      </Shape>
      <!-- Planet 1 -->
      <Transform DEF='Planet1' translation='15 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.5 0.5 0.8'/>
          </Appearance>
          <Sphere radius='1.5'/>
        </Shape>
      </Transform>
      <!-- Planet 2 -->
      <Transform DEF='Planet2' translation='25 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.8 0.4 0.2'/>
          </Appearance>
          <Sphere radius='2'/>
        </Shape>
      </Transform>
      <!-- Planet 3 -->
      <Transform DEF='Planet3' translation='35 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.3 0.7 0.3'/>
          </Appearance>
          <Sphere radius='1'/>
        </Shape>
      </Transform>
    </Transform>
    <!-- Animation for Planet 1 -->
    <TimeSensor DEF='Clock1' cycleInterval='10' loop='true'/>
    <OrientationInterpolator DEF='Orbit1' key='0 1' keyValue='0 1 0 0  0 1 0 6.283'/>
    <ROUTE fromNode='Clock1' fromField='fraction_changed' toNode='Orbit1' toField='set_fraction'/>
    <ROUTE fromNode='Orbit1' fromField='value_changed' toNode='Planet1' toField='rotation'/>
    <!-- Animation for Planet 2 -->
    <TimeSensor DEF='Clock2' cycleInterval='20' loop='true'/>
    <OrientationInterpolator DEF='Orbit2' key='0 1' keyValue='0 1 0 0  0 1 0 6.283'/>
    <ROUTE fromNode='Clock2' fromField='fraction_changed' toNode='Orbit2' toField='set_fraction'/>
    <ROUTE fromNode='Orbit2' fromField='value_changed' toNode='Planet2' toField='rotation'/>
    <!-- Animation for Planet 3 -->
    <TimeSensor DEF='Clock3' cycleInterval='30' loop='true'/>
    <OrientationInterpolator DEF='Orbit3' key='0 1' keyValue='0 1 0 0  0 1 0 6.283'/>
    <ROUTE fromNode='Clock3' fromField='fraction_changed' toNode='Orbit3' toField='set_fraction'/>
    <ROUTE fromNode='Orbit3' fromField='value_changed' toNode='Planet3' toField='rotation'/>
  </Scene>
</X3D>