<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Background color='0.08 0.1 0.14'/>
    <DirectionalLight direction='-0.4 -1 -0.6' intensity='0.9' color='1 0.96 0.9'/>
    <Viewpoint id='doorView' description='A hinged door that swings open 90 degrees over two seconds when the scene loads and remains open' position='2.4 1.7 3.4' orientation='-0.107 0 0.034 0.703'/>
    <NavigationInfo type='WALK' speed='1'/>

    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor='0.25 0.27 0.3' roughness='0.85' metallic='0'/>
      </Appearance>
      <Box size='8 0.08 8' position='0 -0.04 0'/>
    </Shape>

    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor='0.72 0.7 0.66' roughness='0.9' metallic='0'/>
      </Appearance>
      <Box size='1.8 3 0.12' position='-1.6 1.5 0'/>
    </Shape>
    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor='0.72 0.7 0.66' roughness='0.9' metallic='0'/>
      </Appearance>
      <Box size='1.2 3 0.12' position='1 1.5 0'/>
    </Shape>
    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor='0.72 0.7 0.66' roughness='0.9' metallic='0'/>
      </Appearance>
      <Box size='1.1 0.9 0.12' position='-0.15 2.55 0'/>
    </Shape>

    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor='0.18 0.12 0.08' roughness='0.7' metallic='0'/>
      </Appearance>
      <Box size='0.12 2.2 0.18' position='-0.65 1.1 0'/>
    </Shape>
    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor='0.18 0.12 0.08' roughness='0.7' metallic='0'/>
      </Appearance>
      <Box size='0.12 2.2 0.18' position='0.45 1.1 0'/>
    </Shape>
    <Shape>
      <Appearance>
        <PhysicalMaterial baseColor='0.18 0.12 0.08' roughness='0.7' metallic='0'/>
      </Appearance>
      <Box size='1.22 0.12 0.18' position='-0.1 2.16 0'/>
    </Shape>

    <Transform id='doorHinge' translation='-0.55 1.05 0.08' rotation='0 0 1 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.48 0.22 0.09' roughness='0.65' metallic='0'/>
        </Appearance>
        <Box size='0.9 2.1 0.07' position='0.45 0 0'/>
        <TouchSensor id='doorTouch' description='Touch the door to replay the opening animation'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.62 0.32 0.13' roughness='0.6' metallic='0'/>
        </Appearance>
        <Box size='0.72 1.82 0.015' position='0.45 0 0.043'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.65 0.65 0.7' roughness='0.25' metallic='0.85'/>
        </Appearance>
        <Cylinder radius='0.025' height='0.12' position='0.78 0 0.095' rotation='1.570796 0 0 0'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.65 0.65 0.7' roughness='0.25' metallic='0.85'/>
        </Appearance>
        <Sphere radius='0.055' position='0.78 0 0.16'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.55 0.55 0.6' roughness='0.3' metallic='0.8'/>
        </Appearance>
        <Cylinder radius='0.035' height='0.16' position='0 0.7 -0.045'/>
      </Shape>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.55 0.55 0.6' roughness='0.3' metallic='0.8'/>
        </Appearance>
        <Cylinder radius='0.035' height='0.16' position='0 -0.7 -0.045'/>
      </Shape>
    </Transform>

    <TimeSensor id='doorClock' cycleInterval='2' loop='false' startTime='0'/>
    <OrientationInterpolator id='doorSwing' key='0 2' keyTimes='0 1' keyValue='0 0 1 0 0 0 1 -1.570796' interpolation='LINEAR'/>

    <ROUTE sourceField='fraction' source='doorClock' targetField='set_fraction' target='doorSwing'/>
    <ROUTE sourceField='value' source='doorSwing' targetField='rotation' target='doorHinge'/>
    <ROUTE sourceField='touchTime' source='doorTouch' targetField='startTime' target='doorClock'/>
  </Scene>
</X3D>