(Cloud Run, deployed 11 Oct; XSD + DEF/USE/ROUTE endpoints only, per x3d-bench-next/open-models-fork/README.md)&quot;,&quot;validator_ref&quot;:&quot;service name recorded, build digest not&quot;,&quot;verdict&quot;:&quot;invalid&quot;,&quot;xsd_valid&quot;:false}"/><meta name="x3dprov.step.3" content="{&quot;input_sha256&quot;:&quot;0b70c6d686dd35238f0f900104e0d071699156ecd2f2d7ba3f0e889a7ecd09d0&quot;,&quot;ms&quot;:0,&quot;op&quot;:&quot;validate&quot;,&quot;output_sha256&quot;:&quot;0b70c6d686dd35238f0f900104e0d071699156ecd2f2d7ba3f0e889a7ecd09d0&quot;,&quot;prev&quot;:&quot;5a216418c2ba32e77c7874be73af8bd79f97c2e1d26abfdfa816ca4546702a0f&quot;,&quot;semantic_error_codes&quot;:[&quot;route-invalid-to-field&quot;],&quot;validator&quot;:&quot;x3d_mcp fork&quot;,&quot;validator_ref&quot;:&quot;eb4b4b4&quot;,&quot;verdict&quot;:&quot;invalid&quot;,&quot;xsd&quot;:&quot;4.0&quot;,&quot;xsd_valid&quot;:false}"/></head>
<Scene>
<Viewpoint description='Default View' position='0 3 5'/>
<Group>
<Shape>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
<Box size='1 0.2 1'/>
</Shape>
<TouchSensor description='Button' DEF='Button'/>
<ROUTE fromNode='Button' fromField='touchTime' toNode='TimeSensor' toField='set_startTime'/>
</Group>
<Group DEF='CylinderGroup'>
<Shape>
<Appearance>
<Material diffuseColor='0 1 0'/>
</Appearance>
<Cylinder radius='0.2' height='2'/>
</Shape>
<RotationInterpolator DEF='SpinInterpolator' 
    key='0 1' 
    keyValue='0 1 0 0 1 0 0 1'/>
<TimeSensor DEF='TimeSensor' cycleInterval='5' loop='TRUE'/>
<ROUTE fromNode='TimeSensor' fromField='fraction_changed' toNode='SpinInterpolator' toField='set_fraction'/>
</Group>
</Scene>
</X3D>