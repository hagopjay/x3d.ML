n process on fork eb4b4b4"},{"@id":"px:s461","@type":"px:Statement","px:subject":{"@id":"px:n2240"},"px:predicate":"uses","px:object":{"@id":"px:n1985"},"prov":"doc","grade":"Confirmed","px:evidence":"every attempt was rendered offline in X_ITE 16.5.0 (the section 8 watcher)"},{"@id":"px:s462","@type":"px:Statement","px:subject":{"@id":"px:n2179"},"px:predicate":"discovered_in","px:object":{"@id":"px:n2240"},"prov":"doc","grade":"Confirmed","px:evidence":"10 of the 23 scenes that never became valid still draw something | Confirmed | X_ITE is more lenient than the validator"},{"@id":"px:s463","@type":"px:Statement","px:subject":{"@id":"px:n1887"},"px:predicate":"member_of","px:object":{"@id":"px:n727"},"prov":"doc","grade":"Confirmed","px:evidence":"Chair of the Metaverse Standards Forum's 3D Web Interoperability domain group since 2022."},{"@id":"px:s464","@type":"px:Statement","px:subject":{"@id":"px:n1293"},"px:predicate":"validates","px:object":{"@id":"px:n1589"},"prov":"doc","grade":"Confirmed","px:evidence":"The server exposes 28 tools and four validation layers against the X3D 4.0 and 4.1 schemas"},{"@id":"px:s465","@type":"px:Statement","px:subject":{"@id":"px:n2180"},"px:predicate":"uses","px:object":{"@id":"px:n210"},"prov":"doc","grade":"Confirmed","px:evidence":"LIVE: Cloud Run service x3d-playground, us-central1, revision 00002 (validator 020221e), min 0 max 1."},{"@id":"px:s466","@type":"px:Statement","px:subject":{"@id":"px:n885"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"Oct 8, 2026 \u00b7 @Hagop Jay Tumayan"},{"@id":"px:s467","@type":"px:Statement","px:subject":{"@id":"px:n683"},"px:predicate":"validates","px:object":{"@id":"px:n1109"},"prov":"doc","grade":"Confirmed","px:evidence":"typed construction in x3d.py rejects bad fields with actionable messages (confirmed locally on Oct 8, 2026)"},{"@id":"px:s468","@type":"px:Statement","px:subject":{"@id":"px:n1325"},"px:predicate":"discovere