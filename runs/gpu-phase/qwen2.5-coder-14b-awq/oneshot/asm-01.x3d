  <Scene>
    <Viewpoint description='Simple House Viewpoint' position='0 5 10'/>
    
    <!-- House Body -->
    <Transform DEF='HouseBody' translation='0 0.5 0'>
      <Shape>
        <Box size='4 2 3'/>
        <Appearance>
          <Material diffuseColor='0.8 0.6 0.4'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Pyramid Roof -->
    <Transform DEF='PyramidRoof' translation='0 2.5 0'>
      <Shape>
        <IndexedFaceSet coordIndex='0 1 2 3 -1 0 1 4 -1 1 2 4 -1 2 3 4 -1'>
          <Coordinate point='-2 0 1.5 2 0 1.5 2 0 -1.5 -2 0 -1.5 0 3 1.5'/>
        </IndexedFaceSet>
        <Appearance>
          <Material diffuseColor='0.5 0.3 0.1'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Door -->
    <Transform DEF='Door' translation='-1.5 0 0'>
      <Shape>
        <Box size='1 2 0.1'/>
        <Appearance>
          <Material diffuseColor='0.9 0.7 0.5'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Window 1 -->
    <Transform DEF='Window1' translation='1.5 0 1.5'>
      <Shape>
        <Box size='1 1 0.1'/>
        <Appearance>
          <Material diffuseColor='0.2 0.4 0.6'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Window 2 -->
    <Transform DEF='Window2' translation='1.5 0 -1.5'>
      <Shape>
        <Box size='1 1 0.1'/>
        <Appearance>
          <Material diffuseColor='0.2 0.4 0.6'/>
        </Appearance>
