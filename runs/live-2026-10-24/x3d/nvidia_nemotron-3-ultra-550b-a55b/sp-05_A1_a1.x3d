<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<Viewpoint description='Desk lamp' position='0 1.5 3'/>
<Background skyColor='0.5 0.7 1'/>
<Transform DEF='LampBase' translation='0 0 0'>
<Shape>
<Appearance>
<PhysicalMaterial diffuseColor='0.3 0.3 0.3'/>
</Appearance>
<Cylinder radius='0.15' height='0.05'/>
</Shape>
</Transform>
<Transform DEF='LowerArm' translation='0 0.05 0'>
<Shape>
<Appearance>
<PhysicalMaterial diffuseColor='0.4 0.4 0.4'/>
</Appearance>
<Cylinder radius='0.03' height='0.5'/>
</Shape>
</Transform>
<Transform DEF='UpperArmPivot' translation='0 0.55 0'>
<Transform DEF='UpperArm' translation='0 0 0'>
<Shape>
<Appearance>
<PhysicalMaterial diffuseColor='0.4 0.4 0.4'/>
</Appearance>
<Cylinder radius='0.03' height='0.5'/>
</Shape>
<Transform DEF='Shade' translation='0 0.5 0'>
<Shape>
<Appearance>
<PhysicalMaterial diffuseColor='0.8 0.8 0.2'/>
</Appearance>
<Cone bottomRadius='0.15' height='0.3'/>
</Shape>
<SpotLight DEF='LampLight' location='0 0.15 0' direction='0 -1 0' cutOffAngle='0.5' beamWidth='0.3' radius='2' intensity='1' color='1 1 0.8'/>
</Transform>
</Transform>
</Transform>
<Transform DEF='Desk' translation='0 -0.05 0'>
<Shape>
<Appearance>
<PhysicalMaterial diffuseColor='0.5 0.35 0.2'/>
</Appearance>
<Box size='1 0.05 0.6'/>
</Shape>
</Transform>
<TimeSensor DEF='Clock' cycleInterval='4' loop='true'/>
<OrientationInterpolator DEF='Sway' key='0 0.5 1' keyValue='0 1 0 0 0 1 0 0.3 0 1 0 0'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Sway' toField='set_fraction'/>
<ROUTE fromNode='Sway' fromField='value_changed' toNode='UpperArm' toField='rotation'/>
</Scene>
</X3D>