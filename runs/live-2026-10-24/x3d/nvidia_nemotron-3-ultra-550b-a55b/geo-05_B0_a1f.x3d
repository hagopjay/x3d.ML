<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Geospatial" level="1"/>
  </head>
  <Scene>
    <GeoLocation geoSystem="&quot;GD&quot; &quot;WE&quot;" geoCoords="0 0 0"/>
    <GeoLOD center="0 0 0" range="200">
      <Group>
        <Shape>
          <Appearance>
            <Material diffuseColor="0.8 0.7 0.6"/>
          </Appearance>
          <Cylinder height="3" radius="0.5"/>
        </Shape>
        <Transform translation="0 2 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.9 0.8 0.7"/>
            </Appearance>
            <Sphere radius="0.6"/>
          </Shape>
        </Transform>
        <Transform translation="-0.7 1.2 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.8 0.7 0.6"/>
            </Appearance>
            <Cylinder height="1.5" radius="0.15"/>
          </Shape>
        </Transform>
        <Transform translation="0.7 1.2 0">
          <Shape>
            <Appearance>
              <Material diffuseColor="0.8 0.7 0.6"/>
            </Appearance>
            <Cylinder height="1.5" radius="0.15"/>
          </Shape>
        </Transform>
      </Group>
      <Shape>
        <Appearance>
          <Material diffuseColor="0.5 0.5 0.5" transparency="0.3"/>
        </Appearance>
        <Box size="2 4 2"/>
