<Scene>
<Viewpoint description='Looking at the Cone' position='0 5 10' orientation='0 1 0 0'/>
<NavigationInfo type='WALK' />
<Background skyColor='0.2 0.2 0.6'/>
<Shape>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
<Cone height='2' bottomRadius='1'/>
</Shape>
<TouchSensor DEF='TouchSensor' description='Drag the cone' />
