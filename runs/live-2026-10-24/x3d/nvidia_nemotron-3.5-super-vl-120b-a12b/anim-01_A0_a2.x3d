<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='1'/>
  </head>
  <Scene>
    <Viewpoint description='Blue cube rotating continuously about its vertical axis once every 4 seconds' position='0 0 6' />
    <TimeSensor DEF='ts' cycleInterval='4' loop='true' />
    <OrientationInterpolator DEF='oi' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.5707963267948966 0 1 0 3.141592653589793 0 1 0 4.71238898038469 0 1 0 6.283185307179586' />
    <Transform DEF='cubeTransform'>
      <Shape>
        <Appearance>
          <UnlitMaterial emissiveColor='0 0 1' />
        </Appearance>
        <Box size='2 2 2' />
      </Shape>
    </Transform>
    <ROUTE fromNode='ts' fromField='fraction_changed' toNode='oi' toField='set_fraction' />
    <ROUTE fromNode='oi' fromField='value_changed' toNode='cubeTransform' toField='rotation' />
  </Scene>
</X3D>