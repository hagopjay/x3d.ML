<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Draggable Cone'/>
  </head>
  <Scene>
    <DirectionalLight intensity='0.8' direction='0 -1 -0.5'/>
    <Viewpoint description='Drag the red cone across the green ground plane' position='0 2 6' orientation='0 1 0 0'/>

    <!-- Ground plane -->
    <Shape>
      <Box size='30 0.1 30'/>
      <PhysicalMaterial>
        <baseColor>0.15 0.55 0.15</baseColor>
        <roughness>0.8</roughness>
      </PhysicalMaterial>
    </Shape>

    <!-- Plane sensor aligned with ground -->
    <Transform translation='0 0 0'>
      <PlaneSensor DEF='groundDrag' enabled='true' autoOffset='true' offset='0 0 0'/>
    </Transform>

    <!-- Cone pivot stays on the drag plane; cone sits above it -->
    <Transform DEF='conePivot' translation='0 0 0'>
      <Transform translation='0 0.75 0'>
        <Shape>
          <Cone bottomRadius='0.4' height='1.5' subdivision='16'/>
          <PhysicalMaterial>
            <baseColor>0.8 0.2 0.2</baseColor>
            <roughness>0.4</roughness>
            <metallic>0.1</metallic>
          </PhysicalMaterial>
        </Shape>
      </Transform>
    </Transform>

    <ROUTE fromNode='groundDrag' fromField='translationChanged' toNode='conePivot' toField='set_translation'/>
  </Scene>
</X3D>