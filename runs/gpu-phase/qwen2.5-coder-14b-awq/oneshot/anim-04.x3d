  <Scene>
    <Background skyColor='0 0 0'/>
    <Viewpoint description='Cycling Sphere Color' position='0 0 5'/>
    
    <Shape>
      <Sphere radius='1'/>
      <Appearance>
        <Material DEF='ColorMaterial' diffuseColor='1 0 0'/>
      </Appearance>
    </Shape>
    
    <TimeSensor DEF='ColorTimer' cycleInterval='6' loop='true'/>
    
    <ColorInterpolator DEF='ColorChanger' key='0 0.33 0.67 1' keyValue='1 0 0 0 1 0 0 0 1 1 0 0'/>
    
    <ROUTE fromNode='ColorTimer' fromField='fraction_changed' toNode='ColorChanger' toField='set_fraction'/>
    <ROUTE fromNode='ColorChanger' fromField='value_changed' toNode='ColorMaterial' toField='diffuseColor'/>
  </Scene>
</X3D>