          <Material diffuseColor='0.45 0.43 0.4' shininess='0.1'/>
        </Appearance>
        <Box size='18 0.2 18'/>
      </Shape>
    </Transform>

    <!-- Shared Materials and Geometries Defined in Wall Segments -->
    <!-- East Wall (X = +9) -->
    <Transform translation='9 3.5 0'>
      <Shape DEF='WallSegmentZ'>
        <Appearance DEF='StoneWallApp'>
          <Material diffuseColor='0.62 0.6 0.56' shininess='0.15' specularColor='0.1 0.1 0.1'/>
        </Appearance>
        <Box size='1.6 7 14'/>
      </Shape>
    </Transform>

    <!-- West Wall (X = -9) -->
    <Transform translation='-9 3.5 0'>
      <Shape USE='WallSegmentZ'/>
    </Transform>

    <!-- North (Back) Wall (Z = -9) -->
    <Transform translation='0 3.5 -9'>
      <Shape DEF='WallSegmentX'>
        <Appearance USE='StoneWallApp'/>
        <Box size='14 7 1.6'/>
      </Shape>
    </Transform>

    <!-- Crenellation Merlon Definitions and Rows -->
    <!-- Single Merlon for X-axis walls -->
    <Transform translation='-6 7.4 -9'>
      <Shape DEF='MerlonX'>
        <Appearance USE='StoneWallApp'/>
        <Box size='1.2 0.8 1.8'/>
