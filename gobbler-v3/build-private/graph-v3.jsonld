 with Y up: Transform rotation \"1 0 0 -1.5708\" maps one onto the other."},{"@id":"px:s710","@type":"px:Statement","px:subject":{"@id":"px:n9"},"px:predicate":"motivates","px:object":{"@id":"px:n121"},"prov":"doc","grade":"Confirmed","px:evidence":"Confirmed: failure classes are generator-specific, so rungs must be rebuilt per generator family"},{"@id":"px:s711","@type":"px:Statement","px:subject":{"@id":"px:n145"},"px:predicate":"uses","px:object":{"@id":"px:n101"},"prov":"doc","grade":"Confirmed","px:evidence":"Validator: fork d5598c4."},{"@id":"px:s712","@type":"px:Statement","px:subject":{"@id":"px:n265"},"px:predicate":"uses","px:object":{"@id":"px:n101"},"prov":"doc","grade":"Confirmed","px:evidence":"Validator: fork d5598c4."},{"@id":"px:s713","@type":"px:Statement","px:subject":{"@id":"px:n250"},"px:predicate":"version_of","px:object":{"@id":"px:n199"},"prov":"doc","grade":"Confirmed","px:evidence":"v3 looked best (86.9% on all 1,370 scenes) and v4 looked no better (86.9% on the test half)"},{"@id":"px:s714","@type":"px:Statement","px:subject":{"@id":"px:n22"},"px:predicate":"renders","px:object":{"@id":"px:n5"},"prov":"doc","grade":"Confirmed","px:evidence":"ends on X3D GaussianSplats in X_ITE 16.5.0 (depth-slab nodes: X_ITE orders nodes by bbox centre), about 76 s"},{"@id":"px:s715","@type":"px:Statement","px:subject":{"@id":"px:n91"},"px:predicate":"writes","px:object":{"@id":"px:n382"},"prov":"doc","grade":"Confirmed","px:evidence":"Export dialog \"X3D Version\" option: 3.3 legacy default, 4.0 PBR. 4.0 path writes PhysicalMaterial/UnlitMaterial"},{"@id":"px:s716","@type":"px:Statement","px:subject":{"@id":"px:n360"},"px:predicate":"validates","px:object":{"@id":"px:n91"},"prov":"doc","grade":"Confirmed","px:evidence":"Validates with x3d.py (X3D_STRICT_VALIDATION=1 makes warnings fail)."},{"@id":"px:s717","@type":"px:Statement","px:subject":{"@id":"px:n91"},"px:predicate":"writes","px:object":{"@id":"px:n126"},"prov":"doc","grade":"Confirmed","px:evidenc