<?xml version='1.0' encoding='UTF-8'?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shaders' level='1'/>
    <component name='Shape' level='2'/>
    <component name='ParticleSystems' level='3'/>
    <component name='Texturing3D' level='1'/>
    <meta name='title' content='gobbler.x3d'/>
    <meta name='x3d-kg' content='nodes 2476, edges 2412, loops 19; graph.json built by kg/ (see GRAPH-v3.md in the release)'/>
    <meta name='description' content='The PolyXandria gobbler, version 3: the golden turkey head trails off into the PolyXandria knowledge graph. Every star is an entity, every ribbon a typed relation, every wheel a flywheel loop whose light pulses circle it. Four coloured lights move on sinusoidal paths. GLSL shaders (ComposedShader) draw the metal, the edges and the stars; TimeSensors, interpolators and ROUTEs drive their fields. No Script.'/>
    <meta name='x3d-build' content='Standard X3D 4.0 build. The X_ITE extras build, gobbler-xite.x3d, is the same scene plus X_ITE-only nodes and the standard switches, triggers and ROUTEs that drive them.'/>
    <meta name='creator' content='HagopJay'/>
    <meta name='created' content='26 October 2026 (v3; v1 and v2 of the gobbler stay as they were)'/>
  </head>
  <Scene>
    <WorldInfo title='PolyXandria gobbler 3' info='"The knowledge graph of PolyXandria and the global X3D community, with its flywheel loops." "Real entities carry provenance data or doc; model-recalled and simulated entities are dimmer and tagged in graph.json."'/>
    <Background skyColor='0.057 0.05 0.047'/>
    <NavigationInfo type='"EXAMINE" "FLY" "WALK" "ANY"' headlight='false' speed='3' avatarSize='0.25 1.6 0.75' transitionType='"ANIMATE"' transitionTime='1.8'/>
    <!-- Wide (the default, unchanged from v2) frames the head on the left third and the graph to the right edge. Colossus, Eye, Behind,
         Flywheel and Crown are the v3 views, in metres: in a headset the head stands about 7.5 m tall. Binding any plays the assembly (see Intro). -->
    <Viewpoint DEF='Wide' description='Wide' position='5.15 -1.31 15.59' orientation='0 0 1 0' centerOfRotation='0.72 -0.76 0' fieldOfView='0.7'/>
    <Viewpoint DEF='Colossus' description='Colossus' position='-3.4 -8.2 3.6' orientation='0.625 -0.696 0.354 1.366' centerOfRotation='2.6 1.4 0' fieldOfView='1.22'/>
    <Viewpoint DEF='EyeToEye' description='Eye' position='-2.48 0.38 4.4' orientation='0.357 -0.93 0.084 0.497' centerOfRotation='-0.28 1.28 0' fieldOfView='0.62'/>
    <Viewpoint DEF='Inside' description='Inside the graph' position='8.4 -2.6 4.4' orientation='0.212 0.969 -0.125 1.096' centerOfRotation='0.4 -0.2 0' fieldOfView='0.95'/>
    <Viewpoint DEF='Flywheel' description='Flywheel' position='6.41 -3.99 3.35' orientation='0.965 -0.259 0.036 0.287' centerOfRotation='6.73 -2.74 -1.02' fieldOfView='0.9'/>
    <Viewpoint DEF='Crown' description='Crown' position='4 12.5 7' orientation='-0.994 -0.089 -0.057 1.134' centerOfRotation='4.8 -2.4 0' fieldOfView='1'/>
    <Viewpoint DEF='Probe' description='Probe' position='4 -2 14' orientation='0 0 1 0' fieldOfView='0.9'/>
    <!-- The pick marker: the page moves it onto the selected node (translation), and flies the Probe viewpoint to it. Parked far below the scene until then. -->
    <Transform DEF='PickMarker' translation='0 -900 0'>
      <PointLight color='1 0.95 0.8' intensity='0.9' radius='6' attenuation='1 0 0.4'/>
      <Shape><Appearance><Material diffuseColor='0 0 0' emissiveColor='1 0.92 0.7'/></Appearance><Sphere radius='0.045'/></Shape>
      <Shape><Appearance><Material diffuseColor='0 0 0' emissiveColor='1 0.8 0.3' transparency='0.82'/></Appearance><Sphere radius='0.2' solid='false'/></Shape>
    </Transform>

    <!-- v3: four coloured point lights on sinusoidal paths. Each has its own TimeSensor and PositionInterpolator (48 keys per period,
         centre + amplitude * sin(2 pi t / T + phase) per axis); the same value is routed to the PointLight and into the shaders as light0..3,
         so the facets, ribbons and stars are lit by exactly the lights that move. -->
    <PointLight DEF='LightGold' location='0 2.5 8.2' color='1 0.8 0.42' intensity='1' radius='40' attenuation='1 0 0.02'/>
    <PointLight DEF='LightEmber' location='7.69 -5.04 6.56' color='1 0.36 0.09' intensity='0.95' radius='40' attenuation='1 0 0.02'/>
    <PointLight DEF='LightCyan' location='12.88 1.5 4.3' color='0.12 0.78 1' intensity='1' radius='40' attenuation='1 0 0.02'/>
    <PointLight DEF='LightViolet' location='-1.09 4.48 0.03' color='0.66 0.28 1' intensity='1.05' radius='40' attenuation='1 0 0.02'/>

    <!-- The sky: a sphere around the camera, coloured by direction in SkyShader (dithered, so no banding). -->
    <Transform translation='1.5 -0.8 12'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0 0 0' emissiveColor='0.057 0.05 0.047'/>
          <ComposedShader DEF='SkyShader' language='GLSL'>
            <ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
in vec4 x3d_Vertex;
out vec3 vDir;
void main() {
  vDir = x3d_Vertex.xyz;
  gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex;
}
]]></ShaderPart>
            <ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
in vec3 vDir;
out vec4 x3d_FragColor;
float h1(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x) {
  vec3 i = floor(x), f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(h1(i), h1(i + vec3(1, 0, 0)), f.x), mix(h1(i + vec3(0, 1, 0)), h1(i + vec3(1, 1, 0)), f.x), f.y),
             mix(mix(h1(i + vec3(0, 0, 1)), h1(i + vec3(1, 0, 1)), f.x), mix(h1(i + vec3(0, 1, 1)), h1(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
float h2(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
void main() {
  vec3 d = normalize(vDir);
  float f = smoothstep(0.0, 0.4, -d.z);
  vec2 q = d.xy / max(-d.z, 0.1);
  vec2 a = (q - vec2(-0.075, 0.03)) * vec2(1.0, 1.3), b = q - vec2(0.2, -0.05);
  float n = vnoise(d * 9.0) * 0.6 + vnoise(d * 21.0) * 0.4;
  vec3 col = vec3(0.057, 0.050, 0.047)
           + f * vec3(0.15, 0.095, 0.045) * exp(-dot(a, a) / 0.03) * (0.8 + 0.4 * n)
           + f * vec3(0.085, 0.022, 0.032) * exp(-dot(b, b) / 0.05) * (0.7 + 0.6 * n)
           + f * vec3(0.03, 0.02, 0.012) * smoothstep(0.55, 0.9, n) * exp(-dot(q, q) / 0.12);
  col += (h2(gl_FragCoord.xy) + h2(gl_FragCoord.yx + 17.0) - 1.0) / 255.0;
  x3d_FragColor = vec4(col, 1.0);
}
]]></ShaderPart>
          </ComposedShader>
        </Appearance>
        <Sphere radius='60' solid='false'/>
      </Shape>
    </Transform>
    <!-- Dust: 300 points that drift slowly on the GPU (PointShader, kind 2), out of focus near and far. -->
    <Shape>
      <Appearance alphaMode='BLEND'>
        <Material diffuseColor='0 0 0' emissiveColor='0.608 0.513 0.313'/>
        <ComposedShader DEF='PointShader' language='GLSL'>
          <field name='phase' type='SFFloat' accessType='inputOutput' value='1'/>
          <field name='time' type='SFTime' accessType='inputOutput' value='0'/>
          <field name='glow' type='SFFloat' accessType='inputOutput' value='1'/>
          <field name='bloom' type='SFFloat' accessType='inputOutput' value='0'/>
          <field name='light0' type='SFVec3f' accessType='inputOutput' value='0 2.5 8.2'/>
          <field name='light1' type='SFVec3f' accessType='inputOutput' value='7.69 -5.04 6.56'/>
          <field name='light2' type='SFVec3f' accessType='inputOutput' value='12.88 1.5 4.3'/>
          <field name='light3' type='SFVec3f' accessType='inputOutput' value='-1.09 4.48 0.03'/>
          <ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform ivec4 x3d_Viewport;
uniform float phase;
uniform float time;
uniform float glow;
uniform float bloom;
uniform vec3 light0;
uniform vec3 light1;
uniform vec3 light2;
uniform vec3 light3;
in vec4 x3d_Vertex;
in vec4 x3d_Color;
out vec4 vColor;
out float vB;
out float vBloom;
out float vSpike;
uvec3 pcg3(uvec3 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  v ^= v >> 16u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  return v;
}
vec3 rnd3i(ivec3 q) { return vec3(pcg3(uvec3(q + 4096))) * (1.0 / 4294967296.0); }
ivec3 qpos(vec3 p) { return ivec3(floor(p * 100.0 + 0.5)); }
vec4 scatter(vec3 p) {
  ivec3 q = qpos(p);
  vec3 r = rnd3i(q);
  vec3 g = (rnd3i(q + ivec3(37, 71, 13)) - 0.5) * 3.4;
  float u = clamp((p.x - -2.75) / (4.79 - -2.75), 0.0, 1.0);
  float jit = (r.x - 0.5) * 0.04;
  float l0 = 0.14 + 0.16 * (1.0 - u) + jit, l1 = l0 + 0.2;
  float b0 = 0.6 + 0.12 * u + jit, b1 = min(0.95, b0 + 0.2);
  if (phase <= l0 || phase >= b1) return vec4(p, 0.0);
  float e, hold;
  if (phase < l1) { e = smoothstep(l0, l1, phase); hold = 0.0; }
  else if (phase <= b0) { e = 1.0; hold = (phase - l1) / max(1e-4, b0 - l1); }
  else { e = 1.0 - smoothstep(b0, b1, phase); hold = 1.0; }
  float s = e < 1.0 ? sin(3.14159265 * e) : 0.0;
  const float c = 0.97030, sn = -0.24188;
  vec2 d = vec2((p.x - 0.45) * 1.6, (p.y + 0.75) * 1.5);
  vec3 tgt = vec3(2.5 + d.x * c - d.y * sn + g.x * 0.36, -0.9 + d.x * sn + d.y * c + g.y * 0.36, 1.2 * p.z + g.z * 0.9);
  vec3 curl = vec3(0.0, 0.6 * sin(2.1 * p.x + 0.5), 0.6 * cos(1.7 * p.y));
  vec3 drift = vec3(0.3 + 0.1 * sin(3.0 * p.y), 0.12 * sin(2.0 * p.x), 0.15 * cos(2.0 * p.y));
  vec3 live = 0.07 * e * vec3(sin(time * 0.9 + r.y * 6.283), cos(time * 0.7 + r.z * 6.283), sin(time * 0.5 + r.x * 6.283));
  return vec4(p + (tgt - p) * e + curl * s + drift * hold * e + live, e);
}
vec3 poolAt(vec3 p) {
  vec3 d0 = p - light0, d1 = p - light1, d2 = p - light2, d3 = p - light3;
  return (vec3(1, 0.8, 0.42) * exp(-dot(d0, d0) * 0.05) + vec3(1, 0.36, 0.09) * exp(-dot(d1, d1) * 0.05) + vec3(0.12, 0.78, 1) * exp(-dot(d2, d2) * 0.05) + vec3(0.66, 0.28, 1) * exp(-dot(d3, d3) * 0.05)) * 0.9;
}
void main() {
  vec3 p = x3d_Vertex.xyz;
  vec3 r = rnd3i(qpos(p) + ivec3(11, 5, 3));
  float kind = floor(x3d_Color.a * 4.0 + 0.001), size = (x3d_Color.a - kind * 0.25) * 16.0, e = 0.0;
  if (kind < 0.5) { vec4 s = scatter(p); p = s.xyz; e = s.w; }
  else if (kind < 2.5 && kind > 1.5) {
    p += vec3(sin(time * (0.05 + 0.06 * r.x) + r.y * 6.283) * 0.7, sin(time * (0.04 + 0.05 * r.y) + r.z * 6.283) * 0.5,
              sin(time * (0.03 + 0.04 * r.z) + r.x * 6.283) * 0.6);
  }
  vec4 mv = x3d_ModelViewMatrix * vec4(p, 1.0);
  float k = float(x3d_Viewport.w) / 640.0;
  float dist = max(0.2, -mv.z);
  if (kind > 2.5) size *= 1.0 - 0.45 * bloom;                  // motes: bloom draws them wider, so it draws them smaller
  float px = size * length(x3d_ModelViewMatrix[0].xyz) * 0.16 * x3d_ProjectionMatrix[1][1] * float(x3d_Viewport.w) * 0.5 / dist;
  float tw = 0.62 + 0.38 * sin(time * (0.7 + 1.9 * r.y) + r.x * 6.283);
  if (kind < 0.5) tw = 0.88 + 0.12 * tw;
  float coc = abs(dist - 14.0) * (kind > 0.5 ? 0.9 : 0.25) * k;
  float s = clamp(px * (0.85 + 0.3 * tw) * (1.0 + 0.9 * bloom) + coc, 1.0, 110.0 * k);
  gl_PointSize = s;
  vB = tw * (1.0 + 0.9 * e) * clamp(px * (1.0 + 0.9 * bloom) / s, 0.2, 1.0) * mix(1.0, glow, 0.5);
  vBloom = bloom;
  vSpike = size > 2.75 && kind > 0.5 && kind < 1.5 ? 1.0 : 0.0;   // only the few brightest hubs
  vec3 pool = (kind > 0.5 && kind < 2.5) ? poolAt(p) : vec3(0.0);
  vColor = vec4(clamp(x3d_Color.rgb + pool * 0.8, 0.0, 1.0), 1.0);
  vB *= 1.0 + 0.9 * min(1.0, length(pool));
  gl_Position = size <= 0.01 ? vec4(2.0, 2.0, 2.0, 1.0) : x3d_ProjectionMatrix * mv;
  gl_Position.z -= 0.003 * gl_Position.w;
}
]]></ShaderPart>
          <ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
in vec4 vColor;
in float vB;
in float vBloom;
in float vSpike;
out vec4 x3d_FragColor;
void main() {
  vec2 d = gl_PointCoord * 2.0 - 1.0;
  float r2 = dot(d, d);
  if (r2 > 1.0) discard;
  float bb = 1.0 + 0.9 * vBloom;
  float core = exp(-r2 * 16.0 * bb * bb);
  float halo = (exp(-r2 * 3.5 * bb) * (0.62 - 0.2 * vBloom) * (1.0 - r2) + exp(-r2 * 2.5) * 0.16 * vBloom * (1.0 - r2)) * 1.0;
  float sp = vSpike * (exp(-abs(d.x) * 28.0) + exp(-abs(d.y) * 28.0)) * max(0.0, 1.0 - sqrt(r2) / 0.7) * 0.7;
  vec3 hc = pow(vColor.rgb, vec3(1.0 + 0.0 * vBloom)) * (1.0 + 0.6 * vBloom);   // bloom: a deeper halo round a pale core
  vec3 em = (hc * (halo + sp) + mix(vColor.rgb, vec3(1.0), 0.6) * core * 1.3) * vB;
  float a = clamp(max(max(em.r, em.g), em.b), 0.0, 1.0);
  if (a < 0.004) discard;
  x3d_FragColor = vec4(min(em / max(a, 1e-3), vec3(1.0)), a);
}
]]></ShaderPart>
        </ComposedShader>
      </Appearance>
