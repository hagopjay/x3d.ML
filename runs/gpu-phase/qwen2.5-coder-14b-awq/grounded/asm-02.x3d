  <Scene>
    <Background skyColor='0 0 0'/>
    <DirectionalLight direction='0 -1 0' color='1 1 1'/>
    
    <!-- Sun -->
    <Transform translation='0 0 0'>
      <Shape>
        <Sphere radius='5'/>
        <Appearance>
          <Material diffuseColor='1 1 0'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Earth -->
    <Transform translation='10 0 0'>
      <Shape>
        <Sphere radius='1'/>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Mars -->
    <Transform translation='20 0 0'>
      <Shape>
        <Sphere radius='0.8'/>
        <Appearance>
          <Material diffuseColor='1 0 0'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Jupiter -->
    <Transform translation='30 0 0'>
      <Shape>
        <Sphere radius='2'/>
        <Appearance>
          <Material diffuseColor='1 0.5 0'/>
        </Appearance>
      </Shape>
    </Transform>
    
    <!-- Viewpoint -->
    <Viewpoint description='Solar System View' position='0 10 20'/>
  </Scene>
