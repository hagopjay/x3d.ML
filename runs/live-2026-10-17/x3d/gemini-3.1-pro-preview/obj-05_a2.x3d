<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='4'/>
  </head>
  <Scene>
    <WorldInfo title='Metallic Gold Ring'/>
    <Background skyColor='0.05 0.05 0.08'/>
    <Viewpoint description='Metallic Gold Ring' position='0 1 4' orientation='1 0 0 -0.2'/>
    
    <DirectionalLight direction='-0.8 -0.8 -0.2' intensity='1' color='1 0.98 0.95'/>
    <PointLight location='2 3 2' intensity='1.2' color='1 0.9 0.8'/>
    <PointLight location='-2 -1 3' intensity='0.5' color='0.8 0.9 1'/>

    <Transform DEF='RingTransform'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='1 0.843 0' metallic='1' roughness='0.15'/>
        </Appearance>
        <Extrusion beginCap='false' endCap='false' creaseAngle='1.57'
                   crossSection='0.2 0 0.1414 0.1414 0 0.2 -0.1414 0.1414 -0.2 0 -0.1414 -0.1414 0 -0.2 0.1414 -0.1414 0.2 0'
                   spine='1 0 0 0.9239 0 0.3827 0.7071 0 0.7071 0.3827 0 0.9239 0 0 1 -0.3827 0 0.9239 -0.7071 0 0.7071 -0.9239 0 0.3827 -1 0 0 -0.9239 0 -0.3827 -0.7071 0 -0.7071 -0.3827 0 -0.9239 0 0 -1 0.3827 0 -0.9239 0.7071 0 -0.7071 0.9239 0 -0.3827 1 0 0'/>
      </Shape>
    </Transform>

    <TimeSensor DEF='Clock' cycleInterval='8' loop='true'/>
    <OrientationInterpolator DEF='Rotator' key='0 0.5 1' keyValue='0.577 0.577 0.577 0, 0.577 0.577 0.577 3.14159, 0.577 0.577 0.577 6.28318'/>

    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Rotator' toField='set_fraction'/>
    <ROUTE fromNode='Rotator' fromField='value_changed' toNode='RingTransform' toField='rotation'/>
  </Scene>
</X3D>