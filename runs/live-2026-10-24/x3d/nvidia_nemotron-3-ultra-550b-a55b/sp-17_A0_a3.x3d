<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Pendulum Clock'/>
    <meta name='description' content='A tall wooden case clock with a white face, twelve tick marks, and a swinging brass pendulum.'/>
  </head>
  <Scene>
    <Viewpoint description='Pendulum Clock' position='0 1.5 5'/>
    <!-- Reusable tick mark geometry and appearance -->
    <Box DEF='TickMarkBox' size='0.02 0.05 0.01'/>
    <Appearance DEF='TickMarkAppearance'>
      <Material diffuseColor='0 0 0'/>
    </Appearance>
    <!-- Clock case and contents -->
    <Transform translation='0 0 0'>
      <!-- Wooden case: tall box -->
      <Shape>
        <Appearance>
          <Material diffuseColor='0.55 0.35 0.2' specularColor='0.1 0.1 0.1' shininess='0.2'/>
        </Appearance>
        <Box size='0.6 2.5 0.3'/>
      </Shape>
      <!-- Clock face: white circle on front -->
      <Transform translation='0 0 0.151'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 1 1' specularColor='0.2 0.2 0.2' shininess='0.5'/>
          </Appearance>
          <Circle radius='0.25'/>
        </Shape>
        <!-- 12 tick marks at 30 degree intervals -->
        <Transform rotation='0 0 1 0'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -0.523599'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -1.0472'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -1.5708'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -2.0944'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -2.618'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -3.14159'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -3.66519'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -4.18879'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -4.71239'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -5.23599'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
        <Transform rotation='0 0 1 -5.75959'>
          <Transform translation='0 0.22 0'>
            <Shape>
              <USE node='TickMarkAppearance'/>
              <USE node='TickMarkBox'/>
            </Shape>
          </Transform>
        </Transform>
      </Transform>
      <!-- Pendulum pivot at top center inside case (y=1.0) -->
      <Transform translation='0 1.0 0' DEF='PendulumPivot'>
        <Transform DEF='PendulumArm'>
          <!-- Pendulum rod: thin cylinder hanging down from pivot -->
          <Transform translation='0 -0.5 0'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.8 0.6 0.2' specularColor='0.5 0.5 0.5' shininess='0.8'/>
              </Appearance>
              <Cylinder radius='0.01' height='1.0'/>
            </Shape>
          </Transform>
          <!-- Pendulum bob at bottom of rod -->
          <Transform translation='0 -1.0 0'>
            <Shape>
              <Appearance>
                <Material diffuseColor='0.8 0.6 0.2' specularColor='0.5 0.5 0.5' shininess='0.8'/>
              </Appearance>
              <Sphere radius='0.08'/>
            </Shape>
          </Transform>
        </Transform>
      </Transform>
    </Transform>
    <!-- Animation: swing every 2 seconds -->
    <TimeSensor DEF='ClockTimer' cycleInterval='2' loop='true'/>
    <OrientationInterpolator DEF='PendulumSwing' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 -0.3  0 0 1 0  0 0 1 0.3  0 0 1 0  0 0 1 -0.3'/>
    <ROUTE fromNode='ClockTimer' fromField='fraction_changed' toNode='PendulumSwing' toField='set_fraction'/>
    <ROUTE fromNode='PendulumSwing' fromField='value_changed' toNode='PendulumArm' toField='set_rotation'/>
  </Scene>
</X3D>