<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<Viewpoint description='Three rotating cubes' position='0 0 10'/>
<!-- Cube 1 -->
<Transform DEF='Cube1Transform' translation='-4 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='1 0 0'/>
</Appearance>
<Box size='2 2 2'/>
</Shape>
</Transform>
<TimeSensor DEF='TimeSensor1' cycleInterval='5' loop='true'/>
<OrientationInterpolator DEF='OI1' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0 0 1 0 1.5708 0 1 0 3.1416 0 1 0 4.7124 0 1 0 6.2832'/>
<ROUTE fromNode='TimeSensor1' fromField='fraction_changed' toNode='OI1' toField='set_fraction'/>
<ROUTE fromNode='OI1' fromField='value_changed' toNode='Cube1Transform' toField='rotation'/>

<!-- Cube 2 -->
<Transform DEF='Cube2Transform' translation='0 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='0 1 0'/>
</Appearance>
<Box size='2 2 2'/>
</Shape>
</Transform>
<TimeSensor DEF='TimeSensor2' cycleInterval='3' loop='true'/>
<OrientationInterpolator DEF='OI2' key='0 0.25 0.5 0.75 1' keyValue='0 0 1 0 0 0 1 1.5708 0 0 1 3.1416 0 0 1 4.7124 0 0 1 6.2832'/>
<ROUTE fromNode='TimeSensor2' fromField='fraction_changed' toNode='OI2' toField='set_fraction'/>
<ROUTE fromNode='OI2' fromField='value_changed' toNode='Cube2Transform' toField='rotation'/>

<!-- Cube 3 -->
<Transform DEF='Cube3Transform' translation='4 0 0'>
<Shape>
<Appearance>
<Material diffuseColor='0 0 1'/>
</Appearance>
<Box size='2 2 2'/>
</Shape>
</Transform>
<TimeSensor DEF='TimeSensor3' cycleInterval='7' loop='true'/>
<OrientationInterpolator DEF='OI3' key='0 0.25 0.5 0.75 1' keyValue='1 0 0 0 1 0 0 1.5708 1 0 0 3.1416 1 0 0 4.7124 1 0 0 6.2832'/>
<ROUTE fromNode='TimeSensor3' fromField='fraction_changed' toNode='OI3' toField='set_fraction'/>
<ROUTE fromNode='OI3' fromField='value_changed' toNode='Cube3Transform' toField='rotation'/>
</Scene>
</X3D>