    </Transform>
    <ROUTE fromNode='FishTS2' fromField='fraction_changed' toNode='FishOI2' toField='set_fraction'/>
    <ROUTE fromNode='FishOI2' fromField='value_changed' toNode='FishPivot2' toField='rotation'/>

    <TimeSensor DEF='FishTS3' cycleInterval='6' loop='true'/>
