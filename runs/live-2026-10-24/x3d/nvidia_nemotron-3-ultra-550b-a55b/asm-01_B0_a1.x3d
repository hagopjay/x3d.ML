<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Viewpoint description='Simple House' position='0 5 10'/>
    <Transform DEF='House'>
      <Shape DEF='Body'>
        <Appearance>
          <Material diffuseColor='0.6 0.4 0.2'/>
        </Appearance>
        <Box size='4 3 4'/>
      </Shape>
      <Shape DEF='Roof'>
        <Appearance>
          <Material diffuseColor='0.8 0.2 0.2'/>
        </Appearance>
        <IndexedFaceSet coordIndex='0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1'>
          <Coordinate point='-2 1.5 -2  2 1.5 -2  2 1.5 2  -2 1.5 2  0 3.5 0'/>
        </IndexedFaceSet>
      </Shape>
      <Shape DEF='Door'>
        <Appearance>
          <Material diffuseColor='0.4 0.2 0.1'/>
        </Appearance>
        <Box size='1 2 0.1'/>
      </Shape>
      <Transform translation='0 -0.5 2.05'>
        <Shape USE='Door'/>
      </Transform>
      <Shape DEF='Window1'>
        <Appearance>
          <Material diffuseColor='0.2 0.6 0.9' transparency='0.5'/>
        </Appearance>
        <Box size='1 1 0.1'/>
      </Shape>
      <Transform translation='-1.5 0.5 2.05'>
        <Shape USE='Window1'/>
      </Transform>
      <Shape DEF='Window2'>
        <Appearance>
          <Material diffuseColor='0.2 0.6 0.9' transparency='0.5'/>
        </Appearance>
        <Box size='1 1 0.1'/>
      </Shape>
      <Transform translation='1.5 0.5 2.05'>
        <Shape USE='Window2'/>
      </Transform>
    </Transform>
  </Scene>
</X3D>