<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='3'/>
    <meta name='title' content='Shared HAnim skeleton, individual skins'/>
    <meta name='description' content='Two HAnim 2.0 humanoids share one joint hierarchy using DEF and USE, with independent skin coordinates and different skin colours. Click either humanoid to animate both.'/>
  </head>
  <Scene>
    <WorldInfo title='Shared skeleton, two skins'/>
    <Background skyColor='0.075 0.10 0.15'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='true'/>
    <Viewpoint description='Two humanoids — click either to wave' position='0 1.5 8' centerOfRotation='0 1.4 0' fieldOfView='0.65'/>
    <DirectionalLight direction='-0.4 -1 -0.7' intensity='0.85'/>
    <DirectionalLight direction='0.7 -0.3 1' intensity='0.45' color='0.65 0.78 1'/>

    <Transform translation='0 -0.06 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.17 0.21 0.28'/>
        </Appearance>
        <Box size='7 0.12 3'/>
      </Shape>
    </Transform>

    <Group>
      <TouchSensor DEF='WaveTouch' description='Click to animate the shared skeleton'/>

      <HAnimHumanoid name='warm_skin_humanoid' version='2.0' translation='-1.05 0 0'>
