<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='1'/>
  </head>
  <Scene>
    <Viewpoint description='View Waving HAnim' position='0 1.2 4'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    
    <TimeSensor DEF='WaveClock' cycleInterval='0.8' loop='true'/>
    <OrientationInterpolator DEF='WaveRotator' key='0 0.5 1' keyValue='0 0 1 2.0, 0 0 1 2.8, 0 0 1 2.0'/>
    
    <HAnimHumanoid DEF='WavingFigure' name='WavingFigure' version='2.0'>
      <HAnimJoint DEF='humanoid_root' name='humanoid_root' center='0 1 0' containerField='skeleton'>
        <HAnimSegment DEF='sacrum' name='sacrum'>
          <Transform translation='0 1 0'>
            <Shape>
              <Box size='0.3 0.2 0.2'/>
              <Appearance>
                <PhysicalMaterial baseColor='0.2 0.4 0.8' roughness='0.6' metalness='0.1'/>
              </Appearance>
            </Shape>
          </Transform>
        </HAnimSegment>
        
        <HAnimJoint DEF='vl5' name='vl5' center='0 1.1 0'>
          <HAnimSegment DEF='c5' name='c5'>
            <Transform translation='0 1.4 0'>
              <Shape>
                <Box size='0.4 0.6 0.25'/>
                <Appearance>
                  <PhysicalMaterial baseColor='0.8 0.3 0.2' roughness='0.6' metalness='0.1'/>
                </Appearance>
              </Shape>
            </Transform>
          </HAnimSegment>
          
          <HAnimJoint DEF='r_shoulder' name='r_shoulder' center='0.25 1.6 0'>
            <HAnimSegment DEF='r_upperarm' name='r_upperarm'>
              <Transform translation='0.25 1.4 0'>
                <Shape>
                  <Cylinder radius='0.05' height='0.4'/>
                  <Appearance>
                    <PhysicalMaterial baseColor='0.9 0.7 0.6' roughness='0.8' metalness='0.0'/>
                  </Appearance>
                </Shape>
              </Transform>
            </HAnimSegment>
            
            <HAnimJoint DEF='r_elbow' name='r_elbow' center='0.25 1.2 0'>
              <HAnimSegment DEF='r_lowerarm' name='r_lowerarm'>
                <Transform translation='0.25 1.0 0'>
                  <Shape>
                    <Cylinder radius='0.04' height='0.4'/>
                    <Appearance>
                      <PhysicalMaterial baseColor='0.9 0.7 0.6' roughness='0.8' metalness='0.0'/>
                    </Appearance>
                  </Shape>
                </Transform>
              </HAnimSegment>
            </HAnimJoint>
            
          </HAnimJoint>
        </HAnimJoint>
      </HAnimJoint>
    </HAnimHumanoid>
    
    <ROUTE fromNode='WaveClock' fromField='fraction_changed' toNode='WaveRotator' toField='set_fraction'/>
    <ROUTE fromNode='WaveRotator' fromField='value_changed' toNode='r_shoulder' toField='set_rotation'/>
  </Scene>
</X3D>