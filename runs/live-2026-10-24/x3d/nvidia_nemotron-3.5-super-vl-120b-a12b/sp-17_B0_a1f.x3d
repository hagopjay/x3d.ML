<?xml version="1.0" encoding="UTF-8"?>
<X3D xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" profile="Immersive" version="4.0" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Shape" level="2"/>
    <meta name="title" content="Pendulum Clock"/>
  </head>
  <Scene>
    <Viewpoint description="Tall wooden pendulum clock with white face, twelve tick marks, and swinging brass pendulum" position="0 1.5 5"/>
    <DirectionalLight intensity="0.9" color="1 1 1" direction="0 -1 -1"/>
    <Transform translation="0 0 0">
      <!-- Wooden case -->
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.55 0.35 0.2" roughness="0.8" metalness="0.05"/>
        </Appearance>
        <Box size="0.7 3.2 0.5"/>
      </Shape>
      <!-- Clock face and tick marks -->
      <Transform translation="0 1.5 0.26">
        <Shape>
          <Appearance>
            <PhysicalMaterial baseColor="1 1 1" roughness="0.5" metalness="0.0"/>
          </Appearance>
          <Cylinder radius="0.28" height="0.02" subdivision="32"/>
        </Shape>
        <Shape DEF="tickMarkShape">
          <Appearance>
            <PhysicalMaterial baseColor="0 0 0" roughness="0.9" metalness="0.0"/>
          </Appearance>
          <Box size="0.02 0.06 0.01"/>
        </Shape>
        <Transform rotation="0 0 1 0" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 0.523599" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 1.0472" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 1.5708" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 2.0944" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 2.618" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 3.14159" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 3.66519" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 4.18879" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 4.71239" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 5.23599" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
        <Transform rotation="0 0 1 5.75959" translation="0 0.28 0">
          <Shape USE="tickMarkShape"/>
        </Transform>
      </Transform>
      <!-- Brass pendulum -->
      <Transform DEF="pendulumTransform" translation="0 0.5 0.26" rotation="0 0 1 0">
        <Transform translation="0 -0.5 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.85 0.65 0.25" roughness="0.3" metalness="0.9"/>
            </Appearance>
            <Cylinder radius="0.012" height="1.0" subdivision="16"/>
          </Shape>
        </Transform>
        <Transform translation="0 -1.0 0">
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor="0.85 0.65 0.25" roughness="0.3" metalness="0.9"/>
            </Appearance>
            <Sphere radius="0.06" subdivision="16"/>
          </Shape>
        </Transform>
      </Transform>
      <TimeSensor DEF="pendulumTimer" cycleInterval="2" loop="TRUE"/>
      <OrientationInterpolator DEF="pendulumInterpolator" key="0 0.25 0.5 0.75 1" keyValue="0 0 1 -0.35 0 0 1 0 0 0 1 0.35 0 0 1 0 0 0 1 -0.35"/>
      <ROUTE fromNode="pendulumTimer" fromField="fraction_changed" toNode="pendulumInterpolator" toField="set_fraction"/>
      <ROUTE fromNode="pendulumInterpolator" fromField="value_changed" toNode="pendulumTransform" toField="rotation"/>
    </Transform>
  </Scene>
</X3D>
