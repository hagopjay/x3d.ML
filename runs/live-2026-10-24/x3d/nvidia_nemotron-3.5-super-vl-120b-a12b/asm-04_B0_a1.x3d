<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='Street lamp with PointLight at the top' name='description'/>
  </head>
  <Scene>
    <Viewpoint description='Street lamp' position='0 4 10'/>
    <Transform DEF='StreetLamp'>
      <Transform DEF='Pole' translation='0 2.5 0'>
        <Shape>
          <Cylinder height='5' radius='0.1'/>
          <Appearance>
            <Material diffuseColor='0.6 0.6 0.6'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform DEF='LampHead' translation='0 5 0'>
        <Shape>
          <Box size='0.5 0.2 0.5'/>
          <Appearance>
            <Material diffuseColor='0.2 0.2 0.2'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 5.1 0'>
        <PointLight DEF='StreetLight' on='true' intensity='1' radius='25' color='1 1 0.9'/>
      </Transform>
    </Transform>
  </Scene>
</X3D>