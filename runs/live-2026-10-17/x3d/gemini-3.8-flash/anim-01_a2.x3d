<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='rotating_cube.x3d' name='title'/>
    <meta content='A blue cube rotating continuously around its vertical Y-axis once every 4 seconds.' name='description'/>
    <meta content='X3D-Edit 4.0, https://savage.nps.edu/X3D-Edit' name='generator'/>
  </head>
  <Scene>
    <WorldInfo title='Rotating Blue Cube'/>
    <Viewpoint description='View Blue Cube' position='0 1.5 5'/>
    <TimeSensor DEF='CubeTimer' cycleInterval='4.0' loop='true'/>
    <OrientationInterpolator DEF='CubeRotator' key='0.0 0.25 0.5 0.75 1.0' keyValue='0 1 0 0.0  0 1 0 1.570796  0 1 0 3.141593  0 1 0 4.712389  0 1 0 6.283185'/>
    <Transform DEF='CubeTransform'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.1 0.3 0.9' shininess='0.7' specularColor='0.8 0.8 1.0'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <ROUTE fromField='fraction_changed' fromNode='CubeTimer' toField='set_fraction' toNode='CubeRotator'/>
    <ROUTE fromField='value_changed' fromNode='CubeRotator' toField='set_rotation' toNode='CubeTransform'/>
  </Scene>
</X3D>