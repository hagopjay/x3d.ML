<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Carousel'/>
    <meta name='description' content='A rotating carousel with eight horses moving up and down alternately.'/>
  </head>
  <Scene>
    <Viewpoint description='Carousel view' position='0 5 10' orientation='0 1 0 0'/>
    <Background skyColor='0.7 0.85 1.0' groundColor='0.2 0.4 0.2'/>
    <PointLight location='0 10 0' intensity='1.0' color='1 1 1' radius='50'/>

    <TimeSensor DEF='CarouselTimer' cycleInterval='10' loop='true'/>

    <OrientationInterpolator DEF='PlatformRot' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>

    <PositionInterpolator DEF='HorseMoveUpDown' key='0 0.5 1' keyValue='0 0 0 0 0.5 0 0 0 0'/>
    <PositionInterpolator DEF='HorseMoveDownUp' key='0 0.5 1' keyValue='0 0.5 0 0 0 0 0 0.5 0'/>

    <Transform DEF='CarouselRoot' translation='0 0 0' rotation='0 1 0 0'>
      <Transform translation='0 0.25 0'>
        <Shape>
          <Cylinder radius='3' height='0.5'/>
          <Appearance>
            <UnlitMaterial baseColor='0.8 0.6 0.4'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0 2.5 0'>
        <Shape>
          <