<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Virginia Tech Drillfield Flagpole'/>
    <meta name='description' content='GeoLocation with a 10 m flagpole and red flag at Virginia Tech Drillfield'/>
  </head>
  <Scene>
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2284 -80.4234 630'>
      <!-- Flagpole: 10 m tall cylinder -->
      <Transform translation='0 5 0'>
        <Shape>
          <Appearance>
            <PhysicalMaterial diffuseColor='0.5 0.5 0.5'/>
          </Appearance>
          <Cylinder height='10' radius='0.1' bottom='true' top='true' side='true'/>
        </Shape>
      </Transform>
      <!-- Red flag at top of pole -->
      <Transform translation='0 10 0'>
        <Shape>
          <Appearance>
            <UnlitMaterial diffuseColor='1 0 0'/>
          </Appearance>
          <Box size='2 1 0.05'/>
        </Shape>
      </Transform>
    </GeoLocation>
    <GeoViewpoint geoSystem='"GD" "WE"' position='37.2284 -80.4234 630' description='Drillfield Flagpole View'/>
    <Viewpoint description='Overview of Drillfield Flagpole' position='0 20 30' orientation='1 0 0 -0.5'/>
  </Scene>
</X3D>