<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <Background skyColor='0.02 0.02 0.06'/>
    <Viewpoint description='Solar System Overview' position='0 12 55' orientation='1 0 0 -0.25'/>
    <NavigationInfo headlight='false'/>

    <!-- Sun -->
    <PointLight location='0 0 0' intensity='2' radius='300' color='1 0.9 0.7'/>
    <Transform>
      <Shape>
        <Sphere radius='4'/>
        <Appearance>
          <PhysicalMaterial baseColor='1 0.7 0.2' emissiveColor='1 0.75 0.15' roughness='0.5'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Planet 1: closest, fast orbit -->
    <Transform DEF='Orbit1'>
      <Transform translation='9 0 0'>
        <Shape>
          <Sphere radius='0.7'/>
          <Appearance>
            <Material diffuseColor='0.55 0.55 0.55'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <!-- Planet 2: middle distance -->
    <Transform DEF='Orbit2'>
      <Transform translation='15 0 0'>
        <Shape>
          <Sphere radius='1.2'/>
          <Appearance>
            <Material diffuseColor='0.2 0.4 0.9'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <!-- Planet 3: farthest, slow orbit -->
    <Transform DEF='Orbit3'>
      <Transform translation='22 0 0'>
        <Shape>
          <Sphere radius='1.0'/>
          <Appearance>
            <Material diffuseColor='0.8 0.3 0.1'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <!-- Orbit clocks at different speeds -->
    <TimeSensor DEF='Clock1' cycleInterval='8' loop='true'/>
    <TimeSensor DEF='Clock2' cycleInterval='18' loop='true'/>
    <TimeSensor DEF='Clock3' cycleInterval='32' loop='true'/>

    <OrientationInterpolator DEF='Spin1' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832'/>
    <OrientationInterpolator DEF='Spin2' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832'/>
    <OrientationInterpolator DEF='Spin3' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832'/>

    <ROUTE fromNode='Clock1' fromField='fraction_changed' toNode='Spin1' toField='set_fraction'/>
    <ROUTE fromNode='Spin1' toNode='Orbit1' toField='set_rotation'/>
    <ROUTE fromNode='Clock2' fromField='fraction_changed' toNode='Spin2' toField='set_fraction'/>
    <ROUTE fromNode='Spin2' toNode='Orbit2' toField='set_rotation'/>
    <ROUTE fromNode='Clock3' fromField='fraction_changed' toNode='Spin3' toField='set_fraction'/>
    <ROUTE fromNode='Spin3' toNode='Orbit3' toField='set_rotation'/>
  </Scene>
</X3D>