<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='City Block'/>
  </head>
  <Scene>
    <Viewpoint description='A small city block with nine buildings and a blinking central tower' position='0 15 -35'/>
    <Background skyColor='0.6 0.8 1.0' groundColor='0.5 0.5 0.5'/>
    <NavigationInfo type='EXAMINE ANY'/>
    
    <!-- Streets / ground -->
    <Shape>
      <Appearance>
        <Material diffuseColor='0.5 0.5 0.5'/>
      </Appearance>
      <Box size='40 0.02 40'/>
    </Shape>
    
    <!-- 3x3 grid of buildings -->
    <Transform translation='-10 3 -10'>
      <Shape>
        <Appearance><Material diffuseColor='0.8 0.2 0.2'/></Appearance>
        <Box size='6 6 6'/>
      </Shape>
    </Transform>
    <Transform translation='0 5 -10'>
      <Shape>
        <Appearance><Material diffuseColor='0.2 0.8 0.2'/></Appearance>
        <Box size='6 10 6'/>
      </Shape>
    </Transform>
    <Transform translation='10 3.5 -10'>
      <Shape>
        <Appearance><Material diffuseColor='0.2 0.2 0.8'/></Appearance>
        <Box size='6 7 6'/>
      </Shape>
    </Transform>
    <Transform translation='-10 4.5 0'>
      <Shape>
        <Appearance><Material diffuseColor='0.8 0.8 0.2'/></Appearance>
        <Box size='6 9 6'/>
      </Shape>
    </Transform>
    <Transform translation='0 10 0'>
      <Shape>
        <Appearance><Material diffuseColor='0.7 0.7 0.9'/></Appearance>
        <Box size='4 20 4'/>
      </Shape>
      <Transform translation='0 10.1 0'>
        <Shape>
          <Appearance>
            <Material DEF='lightMaterial' emissiveColor='1 0 0' diffuseColor='0 0 0'/>
          </Appearance>
          <Box size='1 0.2 1'/>
        </Shape>
      </Transform>
    </Transform>
    <Transform translation='10 2.5 0'>
      <Shape>
        <Appearance><Material diffuseColor='0.8 0.4 0.8'/></Appearance>
        <Box size='6 5 6'/>
      </Shape>
    </Transform>
    <Transform translation='-10 2 10'>
      <Shape>
        <Appearance><Material diffuseColor='0.6 0.4 0.2'/></Appearance>
        <Box size='6 4 6'/>
      </Shape>
    </Transform>
    <Transform translation='0 6 10'>
      <Shape>
        <Appearance><Material diffuseColor='0.4 0.6 0.8'/></Appearance>
        <Box size='6 12 6'/>
      </Shape>
    </Transform>
    <Transform translation='10 4 10'>
      <Shape>
        <Appearance><Material diffuseColor='0.5 0.5 0.5'/></Appearance>
        <Box size='6 8 6'/>
      </Shape>
    </Transform>
    
    <!-- Blinking tower light -->
    <TimeSensor DEF='clock' cycleInterval='1' loop='true'/>
    <ColorInterpolator DEF='lightColor' key='0 0.5 1' keyValue='1 0 0 0.1 0 0 1 0 0'/>
    
    <ROUTE fromNode='clock' fromField='fraction_changed' toNode='lightColor' toField='set_fraction'/>
    <ROUTE fromNode='lightColor' fromField='value_changed' toNode='lightMaterial' toField='emissiveColor'/>
  </Scene>
</X3D>