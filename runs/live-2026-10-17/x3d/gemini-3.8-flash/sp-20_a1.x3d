      <!-- 150 deg -->
      <Transform translation='-6.062 3.5 0'>
        <Transform DEF='G5'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 180 deg -->
      <Transform translation='-7 0 0'>
        <Transform DEF='G6'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 210 deg -->
      <Transform translation='-6.062 -3.5 0'>
        <Transform DEF='G7'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 240 deg -->
      <Transform translation='-3.5 -6.062 0'>
        <Transform DEF='G8'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 270 deg -->
      <Transform translation='0 -7 0'>
        <Transform DEF='G9'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 300 deg -->
      <Transform translation='3.5 -6.062 0'>
        <Transform DEF='G10'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>

      <!-- 330 deg -->
      <Transform translation='6.062 -3.5 0'>
        <Transform DEF='G11'>
          <Group USE='Gondola'/>
        </Transform>
      </Transform>
    </Transform>

    <!-- Animation Clocks and Interpolators -->
    <TimeSensor DEF='WheelTimer' cycleInterval='24' loop='true'/>

    <!-- Wheel Rotation (around Z axis) -->
    <OrientationInterpolator DEF='WheelRotator' key='0 0.25 0.5 0.75 1.0' keyValue='0 0 1 0 0 0 1 1.5708 0 0 1 3.14159 0 0 1 4.71239 0 0 1 6.28319'/>

    <!-- Gondola Counter-Rotation (to stay upright) -->
    <OrientationInterpolator DEF='GondolaRotator' key='0 0.25 0.5 0.75 1.0' keyValue='0 0 1 0 0 0 1 -1.5708 0 0 1 -3.14159 0 0 1 -4.71239 0 0 1 -6.28319'/>

    <!-- Routes for Wheel Rotation -->
    <ROUTE fromField='fraction_changed' fromNode='WheelTimer' toField='set_fraction' toNode='WheelRotator'/>
    <ROUTE fromField='value_changed' fromNode='WheelRotator' toField='set_rotation' toNode='Wheel'/>

    <!-- Routes for Upright Gondolas -->
    <ROUTE fromField='fraction_changed' fromNode='WheelTimer' toField='set_fraction' toNode='GondolaRotator'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G0'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G1'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G2'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G3'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G4'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G5'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G6'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G7'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G8'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G9'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G10'/>
    <ROUTE fromField='value_changed' fromNode='GondolaRotator' toField='set_rotation' toNode='G11'/>
