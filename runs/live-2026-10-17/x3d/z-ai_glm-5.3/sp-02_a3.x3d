    <!-- Jupiter: largest planet, outermost and slowest orbit, with a flat ring -->
    <Transform DEF='JupiterOrbit'>
      <Transform translation='10.5 0 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.85 0.6 0.4'/>
          </Appearance>
