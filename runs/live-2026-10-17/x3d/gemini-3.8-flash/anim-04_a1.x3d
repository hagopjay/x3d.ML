<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='ColorCyclingSphere.x3d'/>
    <meta name='description' content='A sphere whose colour cycles red, green, blue over 6 seconds using a ColorInterpolator.'/>
  </head>
  <Scene>
    <Viewpoint description='Sphere View' position='0 0 4'/>
    <TimeSensor DEF='ColorTimer' cycleInterval='6' loop='true'/>
    <ColorInterpolator DEF='ColorChanger' key='0 0.3333 0.6667 1' keyValue='1 0 0  0 1 0  0 0 1  1 0 0'/>
    <Transform>
      <Shape>
        <Appearance>
          <Material DEF='SphereMat' diffuseColor='1 0 0' specularColor='0.3 0.3 0.3' shininess='0.2'/>
        </Appearance>
        <Sphere radius='1.2'/>
      </Shape>
    </Transform>
    <ROUTE fromNode='ColorTimer' fromField='fraction_changed' toNode='ColorChanger' toField='set_fraction'/>
    <ROUTE fromNode='ColorChanger' fromField='value_changed' toNode='SphereMat' toField='diffuseColor'/>
  </Scene>
</X3D>