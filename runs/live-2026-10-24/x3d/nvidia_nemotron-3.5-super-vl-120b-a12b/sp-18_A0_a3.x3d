      </Transform>
    </Transform>
    <ROUTE fromNode='FishTS3' fromField='fraction_changed' toNode='FishOI3' toField='set_fraction'/>
    <ROUTE fromNode='FishOI3' fromField='value_changed' toNode='FishPivot3' toField='rotation'/>

    <TimeSensor DEF='FishTS4' cycleInterval='7' loop='true'/>
    <OrientationInterpolator DEF='FishOI4' key='0 1' keyValue='0 1 0 0 0 1 0 6.283185307'/>
    <Transform DEF='FishPivot4' translation='0 2 0'>
