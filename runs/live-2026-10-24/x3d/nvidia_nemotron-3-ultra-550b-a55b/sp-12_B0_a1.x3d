<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<Scene>
<Viewpoint DEF='VP' description='Tree with apples' position='0 5 10'/>
<Background skyColor='0.5 0.7 1.0'/>
<TimeSensor DEF='Clock' cycleInterval='2' loop='true'/>
<Transform DEF='TrunkTransform' translation='0 1 0'>
<Shape>
<Appearance>
<Material DEF='TrunkMaterial' diffuseColor='0.5 0.3 0.1'/>
</Appearance>
<Cylinder radius='0.2' height='2'/>
</Shape>
</Transform>
<Transform DEF='Foliage1' translation='0 2.5 0'>
<Shape>
<Appearance>
<Material DEF='FoliageMaterial' diffuseColor='0.1 0.6 0.1'/>
</Appearance>
<Cone bottomRadius='1.5' height='2'/>
</Shape>
</Transform>
<Transform DEF='Foliage2' translation='0 3.5 0'>
<Shape>
<Appearance>
<Material USE='FoliageMaterial'/>
</Appearance>
<Cone bottomRadius='1.2' height='2'/>
</Shape>
</Transform>
<Transform DEF='Foliage3' translation='0 4.5 0'>
<Shape>
<Appearance>
<Material USE='FoliageMaterial'/>
</Appearance>
<Cone bottomRadius='0.9' height='2'/>
</Shape>
</Transform>
<Transform DEF='GroundTransform' translation='0 -0.05 0'>
<Shape>
<Appearance>
<Material DEF='GroundMaterial' diffuseColor='0.2 0.6 0.2'/>
</Appearance>
<Box size='20 0.1 20'/>
</Shape>
</Transform>
<Shape DEF='AppleShape'>
<Appearance>
<Material DEF='AppleMaterial' diffuseColor='1 0 0' emissiveColor='0.2 0 0'/>
</Appearance>
<Sphere radius='0.1'/>
</Shape>
<Transform DEF='Apple1Base' translation='0.5 3.0 0.5'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple1PI' key='0 0.5 1' keyValue='0.5 3.05 0.5 0.5 2.95 0.5 0.5 3.05 0.5'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple1PI' toField='set_fraction'/>
<ROUTE fromNode='Apple1PI' fromField='value_changed' toNode='Apple1Base' toField='set_translation'/>
<Transform DEF='Apple2Base' translation='-0.7 3.2 -0.3'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple2PI' key='0 0.5 1' keyValue='-0.7 3.25 -0.3 -0.7 3.15 -0.3 -0.7 3.25 -0.3'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple2PI' toField='set_fraction'/>
<ROUTE fromNode='Apple2PI' fromField='value_changed' toNode='Apple2Base' toField='set_translation'/>
<Transform DEF='Apple3Base' translation='1.0 3.5 -0.8'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple3PI' key='0 0.5 1' keyValue='1.0 3.55 -0.8 1.0 3.45 -0.8 1.0 3.55 -0.8'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple3PI' toField='set_fraction'/>
<ROUTE fromNode='Apple3PI' fromField='value_changed' toNode='Apple3Base' toField='set_translation'/>
<Transform DEF='Apple4Base' translation='-1.2 3.8 0.6'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple4PI' key='0 0.5 1' keyValue='-1.2 3.85 0.6 -1.2 3.75 0.6 -1.2 3.85 0.6'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple4PI' toField='set_fraction'/>
<ROUTE fromNode='Apple4PI' fromField='value_changed' toNode='Apple4Base' toField='set_translation'/>
<Transform DEF='Apple5Base' translation='0.3 4.0 -1.0'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple5PI' key='0 0.5 1' keyValue='0.3 4.05 -1.0 0.3 3.95 -1.0 0.3 4.05 -1.0'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple5PI' toField='set_fraction'/>
<ROUTE fromNode='Apple5PI' fromField='value_changed' toNode='Apple5Base' toField='set_translation'/>
<Transform DEF='Apple6Base' translation='-0.4 4.3 0.9'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple6PI' key='0 0.5 1' keyValue='-0.4 4.35 0.9 -0.4 4.25 0.9 -0.4 4.35 0.9'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple6PI' toField='set_fraction'/>
<ROUTE fromNode='Apple6PI' fromField='value_changed' toNode='Apple6Base' toField='set_translation'/>
<Transform DEF='Apple7Base' translation='0.8 4.5 -0.5'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple7PI' key='0 0.5 1' keyValue='0.8 4.55 -0.5 0.8 4.45 -0.5 0.8 4.55 -0.5'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple7PI' toField='set_fraction'/>
<ROUTE fromNode='Apple7PI' fromField='value_changed' toNode='Apple7Base' toField='set_translation'/>
<Transform DEF='Apple8Base' translation='-0.9 4.7 0.2'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple8PI' key='0 0.5 1' keyValue='-0.9 4.75 0.2 -0.9 4.65 0.2 -0.9 4.75 0.2'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple8PI' toField='set_fraction'/>
<ROUTE fromNode='Apple8PI' fromField='value_changed' toNode='Apple8Base' toField='set_translation'/>
<Transform DEF='Apple9Base' translation='0.0 5.0 -0.7'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple9PI' key='0 0.5 1' keyValue='0.0 5.05 -0.7 0.0 4.95 -0.7 0.0 5.05 -0.7'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple9PI' toField='set_fraction'/>
<ROUTE fromNode='Apple9PI' fromField='value_changed' toNode='Apple9Base' toField='set_translation'/>
<Transform DEF='Apple10Base' translation='0.6 5.2 0.4'>
<Shape USE='AppleShape'/>
</Transform>
<PositionInterpolator DEF='Apple10PI' key='0 0.5 1' keyValue='0.6 5.25 0.4 0.6 5.15 0.4 0.6 5.25 0.4'/>
<ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Apple10PI' toField='set_fraction'/>
<ROUTE fromNode='Apple10PI' fromField='value_changed' toNode='Apple10Base' toField='set_translation'/>
</Scene>
</X3D>