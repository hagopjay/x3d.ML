<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='HAnim Humanoid Right Hand Site'/>
  </head>
  <Scene>
    <DirectionalLight intensity='0.8' direction='0 -1 -0.3'/>
    <Background skyColor='0.8 0.9 1.0'/>
    <Viewpoint description='Eye level viewpoint' position='0 1.6 3' orientation='0 1 0 0'/>
    <HAnimHumanoid version='2.0'>
      <HAnimSegment name='Pelvis'>
        <HAnimJoint name='RightShoulder' jointType='ballAndSocket'>
          <HAnimSegment name='RightUpperArm'>
            <HAnimJoint name='RightElbow' jointType='hinge'>
              <HAnimSegment name='RightLowerArm'>
                <HAnimJoint name='RightWrist' jointType='ballAndSocket'>
                  <HAnimSegment name='RightHand'>
                    <HAnimSite name='RightHandSite' siteType='endpoint' translation='0 0 0.05'>
                      <Transform>
                        <Shape DEF='handSphere'>
                          <Sphere radius='0.03'/>
                          <Appearance>
                            <Material diffuseColor='1 1 0'/>
                          </Appearance>
                        </Shape>
                      </Transform>
                    </HAnimSite>
                  </HAnimSegment>
                </HAnimJoint