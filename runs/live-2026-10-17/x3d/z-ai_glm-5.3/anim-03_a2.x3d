<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
  </head>
  <Scene>
    <Viewpoint description='Front of the swinging door' position='0 1.6 4'/>
    <Background skyColor='0.55 0.7 0.9'/>

    <!-- Floor -->
    <Transform translation='0 -0.05 0'>
      <Shape>
        <Box size='6 0.1 6'/>
        <Appearance>
          <Material diffuseColor='0.45 0.4 0.35'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Door frame -->
    <Transform translation='-0.55 1.1 0'>
      <Shape>
        <Box size='0.15 2.2 0.2'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.35 0.25 0.15' roughness='0.6'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation='0.55 1.1 0'>
      <Shape>
        <Box size='0.15 2.2 0.2'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.35 0.25 0.15' roughness='0.6'/>
        </Appearance>
      </Shape>
    </Transform>
    <Transform translation='0 2.175 0'>
      <Shape>
        <Box size='1.25 0.15 0.2'/>
        <Appearance>
          <PhysicalMaterial baseColor='0.35 0.25 0.15' roughness='0.6'/>
        </Appearance>
      </Shape>
    </Transform>

    <!-- Door, hinged on its left edge -->
    <Transform DEF='DoorPivot' translation='-0.45 0 0'>
      <Transform translation='0.45 1 0'>
        <Shape>
          <Box size='0.9 2 0.06'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.55 0.3 0.12' roughness='0.5'/>
          </Appearance>
        </Shape>
      </Transform>
      <Transform translation='0.78 1 0.06'>
        <Shape>
          <Sphere radius='0.05'/>
          <Appearance>
            <PhysicalMaterial baseColor='0.8 0.75 0.2' roughness='0.3'/>
          </Appearance>
        </Shape>
      </Transform>
    </Transform>

    <!-- Swing open 90 degrees over 2 seconds at load, then stay open -->
    <TimeSensor DEF='DoorClock' cycleInterval='2' loop='false'/>
    <OrientationInterpolator DEF='DoorSwing' key='0 1' keyValue='0 1 0 0, 0 1 0 1.5708'/>
    <ROUTE fromNode='DoorClock' fromField='fraction_changed' toNode='DoorSwing' toField='set_fraction'/>
    <ROUTE fromNode='DoorSwing' fromField='value_changed' toNode='DoorPivot' toField='rotation'/>
  </Scene>
</X3D>