":"Confirmed","px:evidence":"Validates with x3d.py (X3D_STRICT_VALIDATION=1 makes warnings fail)."},{"@id":"px:s802","@type":"px:Statement","px:subject":{"@id":"px:n463"},"px:predicate":"writes","px:object":{"@id":"px:n237"},"prov":"doc","grade":"Confirmed","px:evidence":"new X3D 4.1 draft export option writing splat meshes (vertices + splat_scale/splat_rotation/splat_opacity/splat_sh*_* point attributes, mesh prop x3d_gaussian_splats) as GaussianSplats"},{"@id":"px:s803","@type":"px:Statement","px:subject":{"@id":"px:n31"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1032"},"prov":"doc","grade":"Confirmed","px:evidence":"Confirmed as a property of the file after the art thread reproduced it"},{"@id":"px:s804","@type":"px:Statement","px:subject":{"@id":"px:n1375"},"px:predicate":"uses","px:object":{"@id":"px:n884"},"prov":"doc","grade":"Confirmed","px:evidence":"renderer already sets SwiftShader and --no-sandbox flags"},{"@id":"px:s805","@type":"px:Statement","px:subject":{"@id":"px:n767"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"HagopJay, 2026-10-11 11:20Z, in the teaser thread: \"verbose logging and info density and visual density as always, mark that as permanent requirements on every future project!"},{"@id":"px:s806","@type":"px:Statement","px:subject":{"@id":"px:n413"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"HagopJay, 2026-10-11 11:20Z, in the teaser thread: \"verbose logging and info density and visual density as always, mark that as permanent requirements on every future project!"},{"@id":"px:s807","@type":"px:Statement","px:subject":{"@id":"px:n2349"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"HagopJay, 2026-10-11 11:20Z, in the teaser thread: \"verbose logging and info density and visual density as always, mark that as permanent requirements on every future project!"},{"@id":"px:s808","@type":"px:Statement","px:subject":{"@id":"px:n1155"},"px:predicate":"authored_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"i want to see the progress as its being made\"."},{"@id":"px:s809","@type":"px:Statement","px:subject":{"@id":"px:n134"},"px:predicate":"writes","px:object":{"@id":"px:n1109"},"prov":"doc","grade":"Confirmed","px:evidence":"A model writes X3D (system prompt: DSPy no-Full rule pack)."},{"@id":"px:s810","@type":"px:Statement","px:subject":{"@id":"px:n505"},"px:predicate":"uses","px:object":{"@id":"px:n2111"},"prov":"doc","grade":"Confirmed","px:evidence":"2,551 SIFT points of the start still ray-cast into the v6 X3D in Blender, each video second matched to them, solvePnPRansac with the still's focal length gives the video camera (a 22 m dolly in 8 s)."},{"@id":"px:s811","@type":"px:Statement","px:subject":{"@id":"px:n567"},"px:predicate":"renders","px:object":{"@id":"px:n1589"},"prov":"doc","grade":"Confirmed","px:evidence":"files loading in X_ITE and Castle Model Viewer."},{"@id":"px:s812","@type":"px:Statement","px:subject":{"@id":"px:n1570"},"px:predicate":"uses","px:object":{"@id":"px:n1970"},"prov":"doc","grade":"Confirmed","px:evidence":"$20 more of API spend (Gemini on Vertex for images, audio, video; OpenAI; NVIDIA), shared by both Shroud threads"},{"@id":"px:s813","@type":"px:Statement","px:subject":{"@id":"px:n174"},"px:predicate":"uses","px:object":{"@id":"px:n835"},"prov":"doc","grade":"Confirmed","px:evidence":"3 fork PR #4 fixes (ProtoInstance, Metadata, ROUTE to ProtoInstance)"},{"@id":"px:s814","@type":"px:Statement","px:subject":{"@id":"px:n517"},"px:predicate":"discovered_in","px:object":{"@id":"px:n2310"},"prov":"doc","grade":"Confirmed","px:evidence":"Rev 5 leak found: Blacksburg preset head metas name the GPU maker and say 800 m"},{"@id":"px:s815","@type":"px:Statement","px:subject":{"@id":"px:n1202"},"px:predicate":"member_of","px:object":{"@id":"px:n744"},"prov":"doc","grade":"Confirmed","px:evidence":"Michalis Kamburelis (Castle)"},{"@id":"px:s816","@type":"px:Statement","px:subject":{"@id":"px:n1622"},"px:predicate":"validates","px:object":{"@id":"px:n1672"},"prov":"doc","grade":"Confirmed","px:evidence":"Cross-check of the real 4.1 ontology against XSD 4.1 (the version in the file's namespace IRI rewritten to 4.0 so the fork's loader reads it; terms unchanged)"},{"@id":"px:s817","@type":"px:Statement","px:subject":{"@id":"px:n1985"},"px:predicate":"renders","px:object":{"@id":"px:n1235"},"prov":"doc","grade":"Confirmed","px:evidence":"Step 3: the Polys 2024 design on gpt-4o, gemini-3.8-flash and gpt-oss-20b (1,200 trials), a DSPy arm (200 trials) and a 38-trial pilot of a fourth model; rendered in X_ITE 16.5.0"},{"@id":"px:s818","@type":"px:Statement","px:subject":{"@id":"px:n1940"},"px:predicate":"uses","px:object":{"@id":"px:n73"},"prov":"doc","grade":"Confirmed","px:evidence":"Runnable demos: investor_poc (X3D 4.0 + glTF Inline, X_ITE 14.1.2 bundled)"},{"@id":"px:s819","@type":"px:Statement","px:subject":{"@id":"px:n1940"},"px:predicate":"uses","px:object":{"@id":"px:n1771"},"prov":"doc","grade":"Confirmed","px:evidence":"Runnable demos: investor_poc (X3D 4.0 + glTF Inline, X_ITE 14.1.2 bundled)"},{"@id":"px:s820","@type":"px:Statement","px:subject":{"@id":"px:n774"},"px:predicate":"cites","px:object":{"@id":"px:n1571"},"prov":"doc","grade":"Confirmed","px:evidence":"See [[library-of-polyxandria]], [[ai-tooling-explainer]]."},{"@id":"px:s821","@type":"px:Statement","px:subject":{"@id":"px:n1768"},"px:predicate":"uses","px:object":{"@id":"px:n1891"},"prov":"doc","grade":"Confirmed","px:evidence":"render.mjs Playwright harness emulating the host's rules"},{"@id":"px:s822","@type":"px:Statement","px:subject":{"@id":"px:n2320"},"px:predicate":"discovered_in","px:object":{"@id":"px:n973"},"prov":"doc","grade":"Confirmed","px:evidence":"exercised on Oct 8, 2026 to confirm construction-time validation messages and to find the JSON serializer defect described in the thesis section."},{"@id":"px:s823","@type":"px:Statement","px:subject":{"@id":"px:n248"},"px:predicate":"discovered_in","px:object":{"@id":"px:n1749"},"prov":"doc","grade":"Confirmed","px:evidence":"gemini-3.8-flash judges 97% right but names the real error 73% of the time (judge bench v2)."},{"@id":"px:s824","@type":"px:Statement","px:subject":{"@id":"px:n392"},"px:predicate":"uses","px:object":{"@id":"px:n248"},"prov":"doc","grade":"Confirmed","px:evidence":"Gemini bake-off (10 models): winner gemini-3-flash-preview (4/6 first try, 6/6 in 8 calls, $0.0026/pass); fallback gemini-3.8-flash"},{"@id":"px:s825","@type":"px:Statement","px:subject":{"@id":"px:n1033"},"px:predicate":"renders","px:object":{"@id":"px:n1163"},"prov":"doc","grade":"Confirmed","px:evidence":"Container locale en-US@posix breaks X_ITE in headless Chromium"},{"@id":"px:s826","@type":"px:Statement","px:subject":{"@id":"px:n788"},"px:predicate":"uses","px:object":{"@id":"px:n1611"},"prov":"doc","grade":"Confirmed","px:evidence":"Cut the cloud into compact spatial chunks and write an envelope: `scene.x3d` (Inline nodes)"},{"@id":"px:s827","@type":"px:Statement","px:subject":{"@id":"px:n79"},"px:predicate":"depends_on","px:object":{"@id":"px:n416"},"prov":"doc","grade":"Confirmed","px:evidence":"Origins need hosts: the SDK refuses every request whose Host is not listed, so `ALLOWED_ORIGINS` alone is a start-up error over HTTP"},{"@id":"px:s828","@type":"px:Statement","px:subject":{"@id":"px:n1206"},"px:predicate":"contains","px:object":{"@id":"px:n1066"},"prov":"doc","grade":"Confirmed","px:evidence":"| `X3D_MCP_BLOB_TOKEN` | unset | Bearer token, 32 characters or more. Read from the environment only; never logged or returned |"},{"@id":"px:s829","@type":"px:Statement","px:subject":{"@id":"px:n1206"},"px:predicate":"contains","px:object":{"@id":"px:n1931"},"prov":"doc","grade":"Confirmed","px:evidence":"| `X3D_MCP_BLOB_MAX_BYTES` | `256M` | Largest blob, decoded, and largest upload on the wire |"},{"@id":"px:s830","@type":"px:Statement","px:subject":{"@id":"px:n1206"},"px:predicate":"contains","px:object":{"@id":"px:n1336"},"prov":"doc","grade":"Confirmed","px:evidence":"| `X3D_MCP_BLOB_DIR` | unset | Spill directory for blobs beyond the RAM budget."},{"@id":"px:s831","@type":"px:Statement","px:subject":{"@id":"px:n1206"},"px:predicate":"contains","px:object":{"@id":"px:n639"},"prov":"doc","grade":"Confirmed","px:evidence":"| `X3D_MCP_BLOB_HOT_BYTES` | `64M` | Decoded copy kept for paged `blob_read` calls; `0` disables |"},{"@id":"px:s832","@type":"px:Statement","px:subject":{"@id":"px:n1206"},"px:predicate":"contains","px:object":{"@id":"px:n1136"},"prov":"doc","grade":"Confirmed","px:evidence":"| `X3D_MCP_BLOB_INLINE_MAX` | `3000000` | Largest decoded `blob_put` payload"},{"@id":"px:s833","@type":"px:Statement","px:subject":{"@id":"px:n1206"},"px:predicate":"contains","px:object":{"@id":"px:n696"},"prov":"doc","grade":"Confirmed","px:evidence":"| `X3D_MCP_TOOL_MAX_BYTES` | `96M` | Largest decoded size of a blob given to a tool as `blob_id` (checked from the stored size, before decoding)."},{"@id":"px:s834","@type":"px:Statement","px:subject":{"@id":"px:n1206"},"px:predicate":"contains","px:object":{"@id":"px:n587"},"prov":"doc","grade":"Confirmed","px:evidence":"| `X3D_MCP_TOOL_CONCURRENCY` | `2` | Tool calls on a `blob_id` that run at once; further calls wait."},{"@id":"px:s835","@type":"px:Statement","px:subject":{"@id":"px:n587"},"px:predicate":"uses","px:object":{"@id":"px:n1671"},"prov":"doc","grade":"Confirmed","px:evidence":"`convert_x3d` on JSON input always runs in the worker thread, and a vrml result expected above 64 MB is refused"},{"@id":"px:s836","@type":"px:Statement","px:subject":{"@id":"px:n1939"},"px:predicate":"depends_on_decision","px:object":{"@id":"px:n1887"},"prov":"doc","grade":"Confirmed","px:evidence":"M2 and M3 depend on decisions Dr. Polys and HagopJay have not yet made."},{"@id":"px:s837","@type":"px:Statement","px:subject":{"@id":"px:n1939"},"px:predicate":"depends_on_decision","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"M2 and M3 depend on decisions Dr. Polys and HagopJay have not yet made."},{"@id":"px:s838","@type":"px:Statement","px:subject":{"@id":"px:n567"},"px:predicate":"maintained_by","px:object":{"@id":"px:n1202"},"prov":"doc","grade":"Confirmed","px:evidence":"| [Castle Model Viewer](https://github.com/castle-engine/castle-model-viewer) (ex view3dscene) | Michalis Kamburelis |"},{"@id":"px:s839","@type":"px:Statement","px:subject":{"@id":"px:n567"},"px:predicate":"uses","px:object":{"@id":"px:n744"},"prov":"doc","grade":"Confirmed","px:evidence":"| [Castle Model Viewer](https://github.com/castle-engine/castle-model-viewer) (ex view3dscene) | Michalis Kamburelis | 5.2.0, 2024-08-29; Skin-node prerelease | 81 (last 2026-09-09) | 20 | not applicable | As the engine |"},{"@id":"px:s840","@type":"px:Statement","px:subject":{"@id":"px:n744"},"px:predicate":"implements","px:object":{"@id":"px:n1589"},"prov":"doc","grade":"Confirmed","px:evidence":"All X3D 3.3, selected 4.0 (PBR, glTF mapping, visible field)"},{"@id":"px:s841","@type":"px:Statement","px:subject":{"@id":"px:n194"},"px:predicate":"maintained_by","px:object":{"@id":"px:n1328"},"prov":"doc","grade":"Confirmed","px:evidence":"| [Xj3D](https://gitlab.nps.edu/Savage/xj3d) (Java) | Naval Postgraduate School |"},{"@id":"px:s842","@type":"px:Statement","px:subject":{"@id":"px:n148"},"px:predicate":"works_with","px:object":{"@id":"px:n299"},"prov":"doc","grade":"Confirmed","px:evidence":"John Carlson said on 21 April 2026 that the server checked only the surface of JSON; Lentz's commit 7b42d9d of 28 April 2026 (in the fork's history) replaced that \"surface-only key check\" with full JSON Schema validation"},{"@id":"px:s843","@type":"px:Statement","px:subject":{"@id":"px:n1967"},"px:predicate":"works_with","px:object":{"@id":"px:n2072"},"prov":"doc","grade":"Confirmed","px:evidence":"Khronos and Web3D liaison announced"},{"@id":"px:s844","@type":"px:Statement","px:subject":{"@id":"px:n1423"},"px:predicate":"validates","px:object":{"@id":"px:n150"},"prov":"doc","grade":"Confirmed","px:evidence":"the 'splat-start-tag-size' rule should be sized against that (validator cf84f64)."},{"@id":"px:s845","@type":"px:Statement","px:subject":{"@id":"px:n1858"},"px:predicate":"uses","px:object":{"@id":"px:n1672"},"prov":"doc","grade":"Confirmed","px:evidence":"real X3dOntology4.1.ttl predicts 348 legal parents, XSD 4.1 accepts 150, rejects 163, 35 inconclusive"},{"@id":"px:s846","@type":"px:Statement","px:subject":{"@id":"px:n2264"},"px:predicate":"uses","px:object":{"@id":"px:n237"},"prov":"doc","grade":"Confirmed","px:evidence":"Giza v2: Khufu, Sphinx today and restored, and the Osiris Shaft in one X3D 4.1 world"},{"@id":"px:s847","@type":"px:Statement","px:subject":{"@id":"px:n744"},"px:predicate":"reads","px:object":{"@id":"px:n1109"},"prov":"doc","grade":"Confirmed","px:evidence":"Castle Game Engine converts X3D to glTF."},{"@id":"px:s848","@type":"px:Statement","px:subject":{"@id":"px:n352"},"px:predicate":"uses","px:object":{"@id":"px:n2111"},"prov":"doc","grade":"Confirmed","px:evidence":"10 Shroud scenes as Blender files (research/blenderization-2026-10-17/shroud/), 10/10 X3D valid. X3D master, Blender owns the look."},{"@id":"px:s849","@type":"px:Statement","px:subject":{"@id":"px:n1655"},"px:predicate":"maintained_by","px:object":{"@id":"px:n674"},"prov":"doc","grade":"Confirmed","px:evidence":"hagopjay/x3d.ML PR #3, #4 merged."},{"@id":"px:s850","@type":"px:Statement","px:subject":{"@id":"px:n811"},"px:predicate":"uses","px:object":{"@id":"px:n134"},"prov":"doc","grade":"Confirmed","px:evidence":"\"discovering the x3d ai flywheel\": improve how to improve, A/B comparisons that surface emergent features (AI visual inspection, Blender, Google Maps, search grounding, LangGraph, DSPy). Hub = University scale thread."},{"@id":"px:s851","@type":"px:Statement","px:subject":{"@id":"px:n811"},"px:predicate":"uses","px:object":{"@id":"px:n491"},"prov":"doc","grade":"Confirmed","px:evidence":"\"discovering the x3d ai flywheel\": improve how to improve, A/B comparisons that surface emergent features (AI visual inspection, Blender, Google Maps, search grounding, LangGraph, DSPy). Hub = University scale thread."},{"@id":"px:s852","@type":"px:Statement","px:subject":{"@id":"px:n770"},"px:predicate":"validates","px:object":{"@id":"px:n612"},"prov":"doc","grade":"Confirmed","px:evidence":"24/30 pass the fixed x3d_mcp validator (fork branch integration/validator-fixes) because its profile/component check flags PhysicalMaterial and UnlitMaterial without a Shape component statement"},{"@id":"px:s853","@type":"px:Statement","px:subject":{"@id":"px:n770"},"px:predicate":"validates","px:object":{"@id":"px:n2010"},"prov":"doc","grade":"Confirmed","px:evidence":"24/30 pass the fixed x3d_mcp validator (fork branch integration/validator-fixes) because its profile/component check flags PhysicalMaterial and UnlitMaterial without a Shape component statement"},{"@id":"px:s854","@type":"px:Statement","px:subject":{"@id":"px:n2316"},"px:predicate":"discovered_in","px:object":{"@id":"px:n571"},"prov":"doc","grade":"Confirmed","px:evidence":"Lessons: the profile/component layer is the check that matters (XSD caught 1, profile caught 5, the browser caught 0); lxml truncates the expected-element list so a GeoLOD error needed a schema hint"},{"@id":"px:s855","@type":"px:Statement","px:subject":{"@id":"px:n2316"},"px:predicate":"motivates","px:object":{"@id":"px:n66"},"prov":"doc","grade":"Confirmed","px:evidence":"Update 21:20Z: both findings fixed on the fork (commit 8c0a457, 324 tests)."},{"@id":"px:s856","@type":"px:Statement","px:subject":{"@id":"px:n2101"},"px:predicate":"renders","px:object":{"@id":"px:n571"},"prov":"doc","grade":"Confirmed","px:evidence":"X_ITE 16.4.3 loads all 30 including invalid ones; 29/30 visually right (geo-02 camera at the sky)."},{"@id":"px:s857","@type":"px:Statement","px:subject":{"@id":"px:n608"},"px:predicate":"blocks","px:object":{"@id":"px:n1110"},"prov":"doc","grade":"Confirmed","px:evidence":"The artifact CSP allows the X_ITE script from a CDN but blocks its runtime fetches (fonts, components, lib), so Text nodes and lazy components fail silently."},{"@id":"px:s858","@type":"px:Statement","px:subject":{"@id":"px:n62"},"px:predicate":"implements","px:object":{"@id":"px:n1589"},"prov":"doc","grade":"Confirmed","px:evidence":"Still \"adding nodes for X3D version 4\""},{"@id":"px:s859","@type":"px:Statement","px:subject":{"@id":"px:n1305"},"px:predicate":"converts_to","px:object":{"@id":"px:n764"},"prov":"doc","grade":"Confirmed","px:evidence":"Converts glTF, OBJ, STL, PLY and SVG to X3D"},{"@id":"px:s860","@type":"px:Statement","px:subject":{"@id":"px:n1305"},"px:predicate":"converts_to","px:object":{"@id":"px:n1600"},"prov":"doc","grade":"Confirmed","px:evidence":"Converts glTF, OBJ, STL, PLY and SVG to X3D"},{"@id":"px:s861","@type":"px:Statement","px:subject":{"@id":"px:n690"},"px:predicate":"cites","px:object":{"@id":"px:n1589"},"prov":"doc","grade":"Confirmed","px:evidence":"An \"AI authoring guide for X3D 4.0\": this table, generated from the verified rules, with the glTF/three.js name map for R1 to R5"},{"@id":"px:s862","@type":"px:Statement","px:subject":{"@id":"px:n690"},"px:predicate":"uses","px:object":{"@id":"px:n73"},"prov":"doc","grade":"Confirmed","px:evidence":"with the glTF/three.js name map for R1 to R5 (F4 proposal c)."},{"@id":"px:s863","@type":"px:Statement","px:subject":{"@id":"px:n690"},"px:predicate":"uses","px:object":{"@id":"px:n1869"},"prov":"doc","grade":"Confirmed","px:evidence":"with the glTF/three.js name map for R1 to R5 (F4 proposal c)."},{"@id":"px:s864","@type":"px:Statement","px:subject":{"@id":"px:n292"},"px:predicate":"works_with","px:object":{"@id":"px:n299"},"prov":"doc","grade":"Confirmed","px:evidence":"maintained mostly by one person, Don Brutzman, with John Carlson on JSON and Jakub Floty\u0144ski on the ontology"},{"@id":"px:s865","@type":"px:Statement","px:subject":{"@id":"px:n1771"},"px:predicate":"depends_on","px:object":{"@id":"px:n884"},"prov":"doc","grade":"Confirmed","px:evidence":"Headless X_ITE 16.5.1 (SwiftShader) draws only the Background until a script binds a Viewpoint AND then sets its position (fly.mjs pattern)."},{"@id":"px:s866","@type":"px:Statement","px:subject":{"@id":"px:n1771"},"px:predicate":"implements","px:object":{"@id":"px:n917"},"prov":"doc","grade":"Confirmed","px:evidence":"Headless X_ITE 16.5.1 (SwiftShader) draws only the Background until a script binds a Viewpoint"},{"@id":"px:s867","@type":"px:Statement","px:subject":{"@id":"px:n1771"},"px:predicate":"implements","px:object":{"@id":"px:n397"},"prov":"doc","grade":"Confirmed","px:evidence":"Headless X_ITE 16.5.1 (SwiftShader) draws only the Background until a script binds a Viewpoint AND then sets its position"},{"@id":"px:s868","@type":"px:Statement","px:subject":{"@id":"px:n505"},"px:predicate":"uses","px:object":{"@id":"px:n1839"},"prov":"doc","grade":"Confirmed","px:evidence":"render the X3D at each pose (CPU Cycles 1600x900 16 spp, ~2 min)"},{"@id":"px:s869","@type":"px:Statement","px:subject":{"@id":"px:n473"},"px:predicate":"feeds","px:object":{"@id":"px:n346"},"prov":"doc","grade":"Confirmed","px:evidence":"B11 should be framed as supplying the spine-derived corpus and tier manifests to that thread, not building a second ledger framework."},{"@id":"px:s870","@type":"px:Statement","px:subject":{"@id":"px:n2043"},"px:predicate":"part_of","px:object":{"@id":"px:n346"},"prov":"doc","grade":"Confirmed","px:evidence":"The leak fixes (faceless PointSet mesh dropped with its MetadataSet, two stamped imports breaking the chain, generator meta v2.6.1 vs manifest 2.6.4) are x3d-blender-io exporter work. Hand them to the Blenderization thread"},{"@id":"px:s871","@type":"p