<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <WorldInfo title='Lighthouse at Night'/>
    <Background skyColor='0.01 0.02 0.08' />
    <Viewpoint description='Lighthouse View' position='0 10 35' orientation='1 0 0 -0.05'/>

    <DirectionalLight color='0.6 0.7 0.9' direction='-1 -0.8 -1' intensity='0.4' ambientIntensity='0.1'/>

    <Transform>
      <Shape>
        <Plane size='200 200'/>
        <Appearance>
          <Material diffuseColor='0.02 0.05 0.15' shininess='0.8' specularColor='0.2 0.3 0.5'/>
        </Appearance>
      </Shape>
    </Transform>

    <Transform translation='0 -1 0' scale='1.2 0.4 1.1'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.2 0.2' roughness='0.8'/>
        </Appearance>
        <Sphere radius='5'/>
      </Shape>
    </Transform>
    <Transform translation='2 -1.5 2' scale='1 0.5 0.8'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.15 0.15 0.15' roughness='0.9'/>
        </Appearance>
        <Sphere radius='4'/>
      </Shape>
    </Transform>
    <Transform translation='-2 -1.5 -2' scale='0.8 0.5 1.2'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.22 0.22 0.22' roughness='0.8'/>
        </Appearance>
        <Sphere radius='4.5'/>
      </Shape>
    </Transform>

    <Group>
      <Shape>
        <Appearance>
          <Material DEF='WhiteMat' diffuseColor='0.9 0.9 0.95' specularColor='1 1 1' shininess='0.1'/>
        </Appearance>
        <Extrusion spine='0 0 0, 0 2.5 0' scale='2 2, 1.7 1.7' solid='true'/>
      </Shape>
      <Shape>
        <Appearance>
          <Material DEF='RedMat' diffuseColor='0.7 0.1 0.1' specularColor='0.8 0.2 0.2' shininess='0.1'/>
        </Appearance>
        <Extrusion spine='0 2.5 0, 0 3.5 0' scale='1.7 1.7, 1.58 1.58' solid='true'/>
      </Shape>
      <Shape>
        <Appearance>
          <Material USE='WhiteMat'/>
        </Appearance>
        <Extrusion spine='0 3.5 0, 0 6 0' scale='1.58 1.58, 1.28 1.28' solid='true'/>
      </Shape>
      <Shape>
        <Appearance>
          <Material USE='RedMat'/>
        </Appearance>
        <Extrusion spine='0 6 0, 0 7 0' scale='1.28 1.28, 1.16 1.16' solid='true'/>
      </Shape>
      <Shape>
        <Appearance>
          <Material USE='WhiteMat'/>
        </Appearance>
        <Extrusion spine='0 7 0, 0 8 0' scale='1.16 1.16, 1.04 1.04' solid='true'/>
      </Shape>
    </Group>

    <Transform translation='0 8.1 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
        <Cylinder radius='1.3' height='0.2'/>
      </Shape>
    </Transform>

    <Transform translation='0 8.95 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.8 0.9 1' transparency='0.6' shininess='1.0' specularColor='1 1 1'/>
        </Appearance>
        <Cylinder radius='1.0' height='1.5'/>
      </Shape>
    </Transform>

    <Transform translation='0 10.2 0'>
      <Shape>
        <Appearance>
          <Material USE='RedMat'/>
        </Appearance>
        <Cone bottomRadius='1.4' height='1.0'/>
      </Shape>
    </Transform>
    <Transform translation='0 10.8 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
        <Sphere radius='0.2'/>
      </Shape>
    </Transform>

    <Transform translation='0 8.95 0'>
      <PointLight color='1 0.95 0.7' intensity='1.2' radius='40' ambientIntensity='0.2'/>
      <Shape>
        <Appearance>
          <Material emissiveColor='1 1 0.7' diffuseColor='0 0 0'/>
        </Appearance>
        <Sphere radius='0.3'/>
      </Shape>
    </Transform>

    <Transform translation='0 8.95 0'>
      <Transform DEF='BeamTransform'>
        <Transform translation='20 0 0'>
          <Shape>
            <Appearance>
              <Material emissiveColor='1 0.95 0.5' diffuseColor='0 0 0' transparency='0.4'/>
            </Appearance>
            <Box size='40 0.4 0.4'/>
          </Shape>
        </Transform>
      </Transform>
    </Transform>

    <TimeSensor DEF='Timer' cycleInterval='6' loop='true'/>
    <OrientationInterpolator DEF='Rotator' 
                             key='0 0.25 0.5 0.75 1' 
                             keyValue='0 1 0 0, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185'/>

    <ROUTE fromNode='Timer' fromField='fraction_changed' toNode='Rotator' toField='set_fraction'/>
    <ROUTE fromNode='Rotator' fromField='value_changed' toNode='BeamTransform' toField='set_rotation'/>
  </Scene>
</X3D>