prov.step.3" content="{&quot;input_sha256&quot;:&quot;bb053127df35824d5e5809eb8ff0c57c46b5f59c29623a0b3e20f23ab38c3a44&quot;,&quot;ms&quot;:0,&quot;op&quot;:&quot;validate&quot;,&quot;output_sha256&quot;:&quot;bb053127df35824d5e5809eb8ff0c57c46b5f59c29623a0b3e20f23ab38c3a44&quot;,&quot;prev&quot;:&quot;c3c095c81df08f0aedd905e7a1e9628c0900223c9706ac49607d4910c02eb200&quot;,&quot;semantic_error_codes&quot;:[&quot;route-invalid-from-field&quot;],&quot;validator&quot;:&quot;x3d_mcp fork&quot;,&quot;validator_ref&quot;:&quot;eb4b4b4&quot;,&quot;verdict&quot;:&quot;invalid&quot;,&quot;xsd&quot;:&quot;4.0&quot;,&quot;xsd_valid&quot;:true}"/></head>
  <Scene>
    <Viewpoint description='Red/Green Sphere' position='0 0 5'/>
    <Transform>
      <Shape>
        <Sphere radius='1'/>
        <Appearance>
          <Material DEF='SphereMaterial' diffuseColor='1 0 0'/>
        </Appearance>
      </Shape>
    </Transform>
    <TouchSensor DEF='ClickSensor' />
    <BooleanToggle DEF='Toggle' />
    <ROUTE fromNode='ClickSensor' fromField='isOver' toNode='Toggle' toField='toggle'/>
    <ROUTE fromNode='Toggle' fromField='value_changed' toNode='SphereMaterial' toField='diffuseColor'/>
  </Scene>
</X3D>