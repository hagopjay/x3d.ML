<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
<head>
<meta name='title' content='Chess Board'/>
</head>
<Scene>
<Viewpoint description='Chess board' position='0 5 10'/>
<DirectionalLight intensity='0.9' direction='0 -1 -0.3'/>

<Shape DEF='LightTile'>
  <Appearance>
    <Material diffuseColor='0.9 0.9 0.8'/>
  </Appearance>
  <Box size='1 0.1 1'/>
</Shape>

<Shape DEF='DarkTile'>
  <Appearance>
    <Material diffuseColor='0.2 0.2 0.25'/>
  </Appearance>
  <Box size='1 0.1 1'/>
</Shape>

<Transform translation='-3.5 0 -3.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-2.5 0 -3.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-1.5 0 -3.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-0.5 0 -3.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='0.5 0 -3.5'><Shape USE='LightTile'/></Transform>
<Transform translation='1.5 0 -3.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='2.5 0 -3.5'><Shape USE='LightTile'/></Transform>
<Transform translation='3.5 0 -3.5'><Shape USE='DarkTile'/></Transform>

<Transform translation='-3.5 0 -2.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-2.5 0 -2.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-1.5 0 -2.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-0.5 0 -2.5'><Shape USE='LightTile'/></Transform>
<Transform translation='0.5 0 -2.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='1.5 0 -2.5'><Shape USE='LightTile'/></Transform>
<Transform translation='2.5 0 -2.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='3.5 0 -2.5'><Shape USE='LightTile'/></Transform>

<Transform translation='-3.5 0 -1.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-2.5 0 -1.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-1.5 0 -1.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-0.5 0 -1.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='0.5 0 -1.5'><Shape USE='LightTile'/></Transform>
<Transform translation='1.5 0 -1.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='2.5 0 -1.5'><Shape USE='LightTile'/></Transform>
<Transform translation='3.5 0 -1.5'><Shape USE='DarkTile'/></Transform>

<Transform translation='-3.5 0 -0.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-2.5 0 -0.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-1.5 0 -0.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-0.5 0 -0.5'><Shape USE='LightTile'/></Transform>
<Transform translation='0.5 0 -0.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='1.5 0 -0.5'><Shape USE='LightTile'/></Transform>
<Transform translation='2.5 0 -0.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='3.5 0 -0.5'><Shape USE='LightTile'/></Transform>

<Transform translation='-3.5 0 0.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-2.5 0 0.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-1.5 0 0.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-0.5 0 0.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='0.5 0 0.5'><Shape USE='LightTile'/></Transform>
<Transform translation='1.5 0 0.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='2.5 0 0.5'><Shape USE='LightTile'/></Transform>
<Transform translation='3.5 0 0.5'><Shape USE='DarkTile'/></Transform>

<Transform translation='-3.5 0 1.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-2.5 0 1.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-1.5 0 1.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-0.5 0 1.5'><Shape USE='LightTile'/></Transform>
<Transform translation='0.5 0 1.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='1.5 0 1.5'><Shape USE='LightTile'/></Transform>
<Transform translation='2.5 0 1.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='3.5 0 1.5'><Shape USE='LightTile'/></Transform>

<Transform translation='-3.5 0 2.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-2.5 0 2.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-1.5 0 2.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-0.5 0 2.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='0.5 0 2.5'><Shape USE='LightTile'/></Transform>
<Transform translation='1.5 0 2.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='2.5 0 2.5'><Shape USE='LightTile'/></Transform>
<Transform translation='3.5 0 2.5'><Shape USE='DarkTile'/></Transform>

<Transform translation='-3.5 0 3.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-2.5 0 3.5'><Shape USE='LightTile'/></Transform>
<Transform translation='-1.5 0 3.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='-0.5 0 3.5'><Shape USE='LightTile'/></Transform>
<Transform translation='0.5 0 3.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='1.5 0 3.5'><Shape USE='LightTile'/></Transform>
<Transform translation='2.5 0 3.5'><Shape USE='DarkTile'/></Transform>
<Transform translation='3.5 0 3.5'><Shape USE='LightTile'/></Transform>
</Scene>
</X3D>