    <Transform translation='0 3.22 0'>
      <Shape>
        <Appearance>
          <Material emissiveColor='0.85 0.90 1'/>
        </Appearance>
        <Text string='"ONE SKELETON · TWO SKINS" "Click either figure to wave"'>
          <FontStyle justify='"MIDDLE" "MIDDLE"' size='0.15'/>
        </Text>
      </Shape>
    </Transform>

    <TimeSensor DEF='WaveClock' cycleInterval='4' loop='false' startTime='-1'/>
    <OrientationInterpolator DEF='ShoulderMotion'
      key='0 0.25 0.75 1'
      keyValue='0 0 1 0, 0 0 1 2.2, 0 0 1 2.2, 0 0 1 0'/>
    <OrientationInterpolator DEF='ElbowMotion'
