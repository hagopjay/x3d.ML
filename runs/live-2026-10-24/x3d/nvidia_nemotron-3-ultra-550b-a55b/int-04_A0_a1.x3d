<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Box Highlight on Hover'/>
    <meta name='description' content='A box that becomes emissive yellow when pointer is over it.'/>
  </head>
  <Scene>
    <Viewpoint description='Box highlight demo' position='0 0 5'/>
    <Transform>
      <Shape>
        <Appearance>
          <Material DEF='BoxMaterial' diffuseColor='0.8 0.8 0.8' emissiveColor='0 0 0'/>
        </Appearance>
        <Box DEF='BoxGeometry' size='2 2 2'/>
      </Shape>
      <TouchSensor DEF='TouchSensor'/>
    </Transform>
    <Script DEF='HighlightScript'>
      <field name='isOver' type='SFBool' accessType='inputOnly'/>
      <field name='emissiveColor' type='SFColor' accessType='outputOnly'/>
      <![CDATA[
        // ECMAScript
        function initialize() {
          emissiveColor = new SFColor(0, 0, 0);
        }
        function isOver(value) {
          if (value) {
            emissiveColor = new SFColor(1, 1, 0); // yellow
          } else {
            emissiveColor = new SFColor(0, 0, 0);
          }
        }
      ]]>
    </Script>
    <ROUTE fromNode='TouchSensor' fromField='isOver' toNode='HighlightScript' toField='isOver'/>
    <ROUTE fromNode='HighlightScript' fromField='emissiveColor' toNode='BoxMaterial' toField='emissiveColor'/>
  </Scene>
</X3D>