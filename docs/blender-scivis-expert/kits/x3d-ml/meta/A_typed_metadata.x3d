<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D version="4.0" profile="Interchange">
  <head>
    <meta name="title" content="metadata probe A: typed Metadata nodes as provenance and units"/>
  </head>
  <Scene>
    <Shape DEF="Heat">
      <MetadataSet name="provenance" containerField="metadata">
        <MetadataString name="data_sha256" value='"3f5a0c"' containerField="value"/>
        <MetadataString name="script_sha256" value='"9be1d2"' containerField="value"/>
        <MetadataString name="blender" value='"5.2.3 LTS e13b728c6880"' containerField="value"/>
        <MetadataString name="unit" value='"m"' containerField="value"/>
        <MetadataDouble name="vmin" value="0.0" containerField="value"/>
        <MetadataDouble name="vmax" value="100.0" containerField="value"/>
      </MetadataSet>
      <Appearance><Material diffuseColor="1 0 0"/></Appearance>
      <Box size="1 1 1"/>
    </Shape>
  </Scene>
</X3D>
