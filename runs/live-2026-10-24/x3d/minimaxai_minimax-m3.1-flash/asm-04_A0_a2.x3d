<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Street lamp with a glowing point light'/>
  </head>
  <Scene>
    <Viewpoint description='A street lamp with a glowing point light' position='4 3 6' orientation='0.35 0.65 0.67 1.2' fieldOfView='0.9'/>
    <Background color='0.015 0.02 0.04'/>

    <Transform translation='0 -0.05 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.08 0.09 0.11' specularColor='0.2 0.2 0.25' shininess='0.4'/>
        </Appearance>
        <Box size='20 0.1 20'/>
      </Shape>
    </Transform>

    <Transform>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.12 0.14 0.17' specularColor='0.5 0.55 0.6' shininess='0.7'/>
        </Appearance>
        <Cylinder radius='0.11' height='4.6'/>
      </Shape>

      <Transform translation='0 0.12 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.12 0.14 0.17' specularColor='0.5 0.55 0.6' shininess='0.7'/>
          </Appearance>
          <Cylinder radius='0.3' height='0.24'/>
        </Shape>
      </Transform>

      <Transform translation='0.55 4.45 0' rotation='0 0 1 1.5708'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.12 0.14 0.17' specularColor='0.5 0.55 0.6' shininess='0.7'/>
          </Appearance>
          <Cylinder radius='0.07' height='1.1'/>
        </Shape>
      </Transform>

      <Transform translation='1.1 4.34 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.1 0.11 0.13' specularColor='0.45 0.48 0.55' shininess='0.8'/>
          </Appearance>
          <Box size='0.5 0.18 0.5'/>
        </Shape>
      </Transform>

      <Transform translation='1.1 4.18 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.85 0.55' emissiveColor='1 0.75 0.3' specularColor='1 1 0.8' shininess='0.9'/>
          </Appearance>
          <Sphere radius='0.16'/>
        </Shape>
      </Transform>

      <DEF id='lampLight' PointLight position='1.1 4.18 0' color='1 0.8 0.45' intensity='2.5' attenuation='0.2 0.5 0.1' on='true'/>
      <DEF id='lampToggle' BooleanToggle boolean='true'/>
      <DEF id='lampTouch' TouchSensor description='Tap the lamp to toggle its light'/>
    </Transform>

    <ROUTE sensorParam='lampTouch' eventOut='touchTime' to='lampToggle' set_boolean='set_boolean'/>
    <ROUTE sensorParam='lampToggle' eventOut='toggle' to='lampLight' set_on='on'/>
  </Scene>
</X3D>