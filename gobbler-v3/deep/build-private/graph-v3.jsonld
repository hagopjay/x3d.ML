":{"@id":"px:n465"},"px:predicate":"maintained_by","px:object":{"@id":"px:n292"},"prov":"doc","grade":"Confirmed","px:evidence":"The XML side, the object model and the ontology are a coherent, machine-readable stack maintained mostly by one person, Don Brutzman"},{"@id":"px:s2068","@type":"px:Statement","px:subject":{"@id":"px:n465"},"px:predicate":"part_of","px:object":{"@id":"px:n1109"},"prov":"model_recall","grade":"Suspected"},{"@id":"px:s2069","@type":"px:Statement","px:subject":{"@id":"px:n1240"},"px:predicate":"part_of","px:object":{"@id":"px:n1293"},"prov":"doc","grade":"Confirmed","px:evidence":"# Contributing to x3d_mcp"},{"@id":"px:s2070","@type":"px:Statement","px:subject":{"@id":"px:n1293"},"px:predicate":"uses","px:object":{"@id":"px:n748"},"prov":"doc","grade":"Confirmed","px:evidence":"The Dockerfile and `docker-compose.yml` exist solely to run `pytest` in a clean container."},{"@id":"px:s2071","@type":"px:Statement","px:subject":{"@id":"px:n1467"},"px:predicate":"part_of","px:object":{"@id":"px:n2072"},"prov":"doc","grade":"Confirmed","px:evidence":"If an issue is genuinely waiting on community input from the X3D AI WG / Web3D Consortium, use `question` and explain in the issue body who you're waiting on."},{"@id":"px:s2072","@type":"px:Statement","px:subject":{"@id":"px:n1467"},"px:predicate":"watches","px:object":{"@id":"px:n296"},"prov":"doc","grade":"Confirmed","px:evidence":"The README \"Validation Pipeline\", \"Architecture\", and Dependencies sections are load-bearing \u2014 they're how the WG reviews this work."},{"@id":"px:s2073","@type":"px:Statement","px:subject":{"@id":"px:n1074"},"px:predicate":"part_of","px:object":{"@id":"px:n1293"},"prov":"doc","grade":"Confirmed","px:evidence":"The Dockerfile and `docker-compose.yml` exist solely to run `pytest` in a clean container."},{"@id":"px:s2074","@type":"px:Statement","px:subject":{"@id":"px:n296"},"px:predicate":"part_of","px:object":{"@id":"px:n1293"},"prov":"doc","grade":"Confirmed","px:e