<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='1'/>
    <meta name='title' content='Eight by Eight Chess Board'/>
  </head>
  <Scene>
    <NavigationInfo type='EXAMINE' speed='1'/>
    <Viewpoint description='Oblique view of an eight by eight chess board' position='0 9 11' orientation='1 0 0 -0.62' fieldOfView='0.8'/>
    <DirectionalLight direction='-0.4 -1 -0.5' intensity='0.9' color='1 0.96 0.9'/>
    <DirectionalLight direction='0.5 -0.6 0.7' intensity='0.35' color='0.8 0.88 1'/>

    <Shape DEF='LightTile'>
      <Appearance>
        <UnlitMaterial emissiveColor='0.94 0.92 0.84'/>
      </Appearance>
      <Box size='1 0.08 1'/>
    </Shape>

    <Shape DEF='DarkTile'>
      <Appearance>
        <UnlitMaterial emissiveColor='0.12 0.14 0.16'/>
      </Appearance>
      <Box size='1 0.08 1'/>
    </Shape>

    <Transform translation='-3.5 0 -3.5'><Shape USE='LightTile'/></Transform>
    <Transform translation='-2.5 0 -3.5'><Shape USE='DarkTile'/></Transform>
    <Transform translation='-1.5 0 -3.5'><Shape USE='LightTile'/></Transform>
    <Transform translation='-0.5 0 -3.5'><Shape USE='DarkTile'/></Transform>
    <Transform translation='0.5 0 -3.5'><Shape USE='LightTile'/></Transform>
