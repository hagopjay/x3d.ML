    <ROUTE fromNode='FishTS4' fromField='fraction_changed' toNode='FishOI4' toField='set_fraction'/>
    <ROUTE fromNode='FishOI4' fromField='value_changed' toNode='FishPivot4' toField='rotation'/>

    <TimeSensor DEF='FishTS5' cycleInterval='8' loop='true'/>
