<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <Scene>
    <WorldInfo title='Rocket Launch' info='"The rocket launches automatically." "Click the launch pad after the flight to launch again."'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
    <Viewpoint description='Launch pad and gantry' position='18 12 30' orientation='-0.33 0.94 0 0.56' fieldOfView='0.8'/>
    <Background skyColor='0.06 0.17 0.35 0.3 0.55 0.77 0.68 0.8 0.88' skyAngle='0.9 1.57' groundColor='0.17 0.2 0.17'/>
    <DirectionalLight direction='-0.5 -1 -0.4' intensity='0.95'/>
    <DirectionalLight direction='0.7 -0.4 0.7' intensity='0.4' color='0.65 0.78 1'/>

    <Transform translation='0 -0.25 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.23 0.29 0.23'/>
        </Appearance>
        <Cylinder radius='75' height='0.5'/>
      </Shape>
    </Transform>

    <Group>
      <TouchSensor DEF='PadTouch' description='Launch again after the flight'/>
      <Transform translation='0 0.2 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.32 0.35 0.38'/>
          </Appearance>
          <Box size='13 0.4 11'/>
        </Shape>
      </Transform>
      <Transform translation='0 0.55 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.12 0.14 0.17'/>
          </Appearance>
          <Cylinder radius='2.6' height='0.3'/>
        </Shape>
      </Transform>
      <Transform translation='0 0.715 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.95 0.68 0.08' emissiveColor='0.12 0.07 0'/>
          </Appearance>
          <Cylinder radius='2.25' height='0.025'/>
        </Shape>
      </Transform>
      <Transform translation='0 0.735 0'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.16 0.18 0.2'/>
          </Appearance>
          <Cylinder radius='2.05' height='0.025'/>
        </Shape>
      </Transform>
    </Group>

    <!-- Four gantry columns. -->
    <Transform translation='-4.6 5.5 -1.3'>
      <Shape DEF='TowerPost'>
        <Appearance DEF='TowerPaint'>
          <Material diffuseColor='0.55 0.17 0.09' specularColor='0.25 0.25 0.25'/>
        </Appearance>
        <Box size='0.28 10.2 0.28'/>
      </Shape>
    </Transform>
    <Transform translation='-2.8 5.5 -1.3'>
      <Shape USE='TowerPost'/>
    </Transform>
    <Transform translation='-4.6 5.5 1.3'>
      <Shape USE='TowerPost'/>
    </Transform>
    <Transform translation='-2.8 5.5 1.3'>
      <Shape USE='TowerPost'/>
    </Transform>

    <!-- Open service decks. -->
    <Transform translation='-3.7 1.8 0'>
      <Shape DEF='ServiceDeck'>
        <Appearance DEF='Steel'>
          <Material diffuseColor='0.3 0.35 0.4' specularColor='0.5 0.5 0.5' shininess='0.45'/>
        </Appearance>
        <Box size='2.3 0.18 3.1'/>
      </Shape>
    </Transform>
    <Transform translation='-3.7 4.5 0'>
      <Shape USE='ServiceDeck'/>
    </Transform>
    <Transform translation='-3.7 7.2 0'>
      <Shape USE='ServiceDeck'/>
    </Transform>
    <Transform translation='-3.7 9.9 0'>
      <Shape USE='ServiceDeck'/>
    </Transform>

    <!-- Diagonal braces on the visible side. -->
    <Transform translation='-3.7 3.15 1.3' rotation='0 0 1 -0.588'>
      <Shape DEF='DiagonalBrace'>
        <Appearance USE='TowerPaint'/>
        <Box size='0.14 3.24 0.14'/>
      </Shape>
    </Transform>
    <Transform translation='-3.7 5.85 1.3' rotation='0 0 1 0.588'>
      <Shape USE='DiagonalBrace'/>
    </Transform>
    <Transform translation='-3.7 8.55 1.3' rotation='0 0 1 -0.588'>
      <Shape USE='DiagonalBrace'/>
    </Transform>
    <Transform translation='-3.7 3.15 -1.3' rotation='0 0 1 0.588'>
      <Shape USE='DiagonalBrace'/>
    </Transform>
    <Transform translation='-3.7 5.85 -1.3' rotation='0 0 1 -0.588'>
      <Shape USE='DiagonalBrace'/>
    </Transform>
    <Transform translation='-3.7 8.55 -1.3' rotation='0 0 1 0.588'>
      <Shape USE='DiagonalBrace'/>
    </Transform>

    <Transform translation='-2.1 7.3 0'>
      <Shape>
        <Appearance USE='Steel'/>
        <Box size='1.5 0.23 1'/>
      </Shape>
    </Transform>
    <Transform translation='-3.7 10.5 0'>
      <Shape>
        <Appearance USE='TowerPaint'/>
        <Box size='2.5 0.25 3.3'/>
      </Shape>
    </Transform>

    <!-- All rocket parts, including the flame, travel together. -->
    <Transform DEF='Rocket' translation='0 0.8 0'>
      <Transform translation='0 3.1 0'>
        <Shape>
          <Appearance DEF='WhitePaint'>
            <Material diffuseColor='0.88 0.91 0.94' specularColor='0.65 0.65 0.65' shininess='0.65'/>
          </Appearance>
          <Cylinder radius='0.78' height='5.8'/>
        </Shape>
      </Transform>
      <Transform translation='0 6.8 0'>
        <Shape>
          <Appearance DEF='RedPaint'>
            <Material diffuseColor='0.78 0.06 0.035' specularColor='0.5 0.3 0.25' shininess='0.55'/>
          </Appearance>
          <Cone bottomRadius='0.78' height='1.6'/>
        </Shape>
      </Transform>
      <Transform translation='0 5.65 0'>
        <Shape>
          <Appearance USE='RedPaint'/>
          <Cylinder radius='0.793' height='0.32'/>
        </Shape>
      </Transform>
      <Transform translation='0 1.1 0'>
        <Shape>
          <Appearance USE='Steel'/>
          <Cylinder radius='0.795' height='0.28'/>
        </Shape>
      </Transform>
      <Transform translation='0 0.15 0'>
        <Shape>
          <Appearance USE='Steel'/>
          <Cone bottomRadius='0.5' height='0.6'/>
        </Shape>
      </Transform>

      <Transform translation='0 4.6 0.75' rotation='1 0 0 1.5708'>
        <Shape>
          <Appearance>
            <Material diffuseColor='0.025 0.12 0.23' emissiveColor='0.015 0.06 0.1' specularColor='0.8 0.9 1' shininess='0.9'/>
          </Appearance>
          <Cylinder radius='0.24' height='0.1'/>
        </Shape>
      </Transform>

      <Group>
        <Shape DEF='RocketFin'>
          <Appearance USE='RedPaint'/>
          <IndexedFaceSet coordIndex='0 1 2 -1 2 1 0 -1' solid='false'>
            <Coordinate point='0.65 0.3 0 1.65 0.05 0 0.65 2 0'/>
          </IndexedFaceSet>
        </Shape>
        <Transform rotation='0 1 0 1.5708'>
          <Shape USE='RocketFin'/>
        </Transform>
        <Transform rotation='0 1 0 3.14159'>
          <Shape USE='RocketFin'/>
        </Transform>
        <Transform rotation='0 1 0 4.71239'>
          <Shape USE='RocketFin'/>
        </Transform>
      </Group>

      <Transform translation='0 -1.65 0' rotation='1 0 0 3.14159'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.29 0.015' emissiveColor='1 0.19 0' transparency='0.12'/>
          </Appearance>
          <Cone bottomRadius='0.49' height='3.3'/>
        </Shape>
      </Transform>
      <Transform translation='0 -0.9 0' rotation='1 0 0 3.14159'>
        <Shape>
          <Appearance>
            <Material diffuseColor='1 0.85 0.3' emissiveColor='1 0.65 0.12'/>
          </Appearance>
          <Cone bottomRadius='0.29' height='1.8'/>
        </Shape>
      </Transform>
    </Transform>

    <TimeSensor DEF='LaunchClock' cycleInterval='18' loop='false' startTime='-1'/>
    <PositionInterpolator DEF='FlightPath'
      key='0 0.12 0.3 0.55 0.8 1'
      keyValue='0 0.8 0, 0 2.5 0, 0 12 -2, 0 37 -18, 0 80 -65, 0 145 -170'/>
    <PositionInterpolator DEF='DistanceScale'
      key='0 0.2 0.45 0.7 1'
      keyValue='1 1 1, 1 1 1, 0.75 0.75 0.75, 0.38 0.38 0.38, 0.06 0.06 0.06'/>

    <Script DEF='AutoLaunch'>
      <field name='launchTime' accessType='outputOnly' type='SFTime'/>
      <![CDATA[
ecmascript:
function initialize() {
  launchTime = new Date().getTime() / 1000;
}
      ]]>
    </Script>

    <ROUTE fromNode='AutoLaunch' fromField='launchTime' toNode='LaunchClock' toField='set_startTime'/>
    <ROUTE fromNode='PadTouch' fromField='touchTime' toNode='LaunchClock' toField='set_startTime'/>
    <ROUTE fromNode='LaunchClock' fromField='fraction_changed' toNode='FlightPath' toField='set_fraction'/>
    <ROUTE fromNode='LaunchClock' fromField='fraction_changed' toNode='DistanceScale' toField='set_fraction'/>
    <ROUTE fromNode='FlightPath' fromField='value_changed' toNode='Rocket' toField='set_translation'/>
    <ROUTE fromNode='DistanceScale' fromField='value_changed' toNode='Rocket' toField='set_scale'/>
  </Scene>
</X3D>