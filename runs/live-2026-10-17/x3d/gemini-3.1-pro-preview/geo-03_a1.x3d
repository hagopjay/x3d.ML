<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='2'/>
  </head>
  <Scene>
    <GeoViewpoint geoSystem='"GD" "WE"' position='37.2276 -80.4221 680' orientation='1 0 0 -0.785' description='Drillfield GeoViewpoint'/>
    <Viewpoint position='0 50 100' orientation='1 0 0 -0.5' description='Fallback Local Viewpoint'/>
    
    <GeoLocation geoSystem='"GD" "WE"' geoCoords='37.2276 -80.4221 610'>
      <Transform DEF='MarkerTransform' translation='0 5 0'>
        <Shape>
          <Sphere radius='2'/>
          <Appearance>
            <Material diffuseColor='1 0.8 0'/>
          </Appearance>
        </Shape>
        <TouchSensor DEF='TouchMarker' description='Touch to animate marker'/>
      </Transform>
    </GeoLocation>

    <Shape>
      <Appearance>
        <Material diffuseColor='0.6 0.4 0.2'/>
        <PixelTexture image='1 1 3 0x654321'/>
      </Appearance>
      <GeoElevationGrid geoSystem='"GD" "WE"' 
                        geoGridOrigin='37.2276 -80.4221 610' 
                        xDimension='5' 
                        zDimension='5' 
                        xSpacing='25' 
                        zSpacing='25' 
                        solid='false'
                        height='
                          610 610 610 610 610
                          610 612 613 612 610
                          610 613 615 613 610
                          610 612 613 612 610
                          610 610 610 610 610'/>
    </Shape>

    <TimeSensor DEF='Timer' cycleInterval='2' loop='false'/>
    <PositionInterpolator DEF='Bouncer' key='0 0.5 1' keyValue='0 5 0 0 15 0 0 5 0'/>

    <ROUTE fromNode='TouchMarker' fromField='touchTime' toNode='Timer' toField='startTime'/>
    <ROUTE fromNode='Timer' fromField='fraction_changed' toNode='Bouncer' toField='set_fraction'/>
    <ROUTE fromNode='Bouncer' fromField='value_changed' toNode='MarkerTransform' toField='translation'/>
  </Scene>
</X3D>